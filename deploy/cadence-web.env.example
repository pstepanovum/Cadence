# FILE: deploy/cadence-web.env.example
#
# Configuration for the hosted cadence-web service. deploy/cloudrun.sh sets
# the plain values with --set-env-vars and mounts the secrets from Secret
# Manager with --set-secrets; nothing secret is ever written to this file or
# committed. For a local run against the emulators, copy the plain values
# into .env.local and use test keys.

# --- Plain configuration ------------------------------------------------------
CADENCE_DEPLOYMENT=cloud                 # cloud: AI needs Plus, quotas and App Check apply
CADENCE_PUBLIC_ORIGIN=https://cadence.pstepanov.dev
OAUTH_ISSUER=https://cadence.pstepanov.dev
FIREBASE_PROJECT_ID=cadence-pstepanov
APP_CHECK_ENFORCE=1                      # 0 only on a staging service before the apps ship App Check
AI_DAILY_BUDGET_USD=25                   # global circuit breaker for estimated cloud AI spend
CADENCE_AI_URL=https://cadence-ai-XXXX-uc.a.run.app   # printed by `cloudrun.sh deploy-ai`
ENGINE_SCORER=cloud-run
ENGINE_TRANSCRIBER=gemini                # or whisper-cpu, per scripts/bench (docs/PLATFORM.md 6.2)
ENGINE_TTS=google-tts
ENGINE_COACH=gemini
ENGINE_GRAMMAR=gemini
GEMINI_BACKEND=vertex                    # Vertex AI with the service account; no API key in the cloud
VERTEX_REGION=us-central1
GEMINI_COACH_MODEL=gemini-2.5-flash-lite
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
TTS_CACHE_BUCKET=cadence-pstepanov-tts-cache
TTS_VOICE_US=en-US-Neural2-F
TTS_VOICE_GB=en-GB-Neural2-B
BREVO_DOI_TEMPLATE_ID=                   # printed by scripts/email/brevo-doi-template.ts
CADENCE_POSTAL_ADDRESS=                  # the postal line marketing email must carry
EMAIL_FROM="Cadence <hello@cadence.pstepanov.dev>"
EMAIL_REPLY_TO="Cadence support <support@cadence.pstepanov.dev>"

# --- Secrets (Secret Manager, mounted as env by cloudrun.sh) --------------------
# STRIPE_SECRET_KEY            secret: stripe-secret-key
# STRIPE_WEBHOOK_SECRET        secret: stripe-webhook-secret
# REVENUECAT_WEBHOOK_SECRET    secret: revenuecat-webhook-secret
# REVENUECAT_API_KEY           secret: revenuecat-api-key       (v1 secret key, for TRANSFER and deletion)
# BREVO_API_KEY                secret: brevo-api-key
# QUIZ_TOKEN_SECRET            secret: quiz-token-secret        (openssl rand -base64 48)
# EMAIL_UNSUBSCRIBE_SECRET     secret: email-unsubscribe-secret (openssl rand -base64 48)
# JOBS_SECRET                  secret: jobs-secret              (openssl rand -base64 48)
