# FILE: deploy/web-build.env.example
#
# Public Firebase web config for `deploy/cloudrun.sh build`, inlined into the
# browser bundle (Firebase console > Project settings > Your apps). These are
# not secrets. Export them in the shell that runs the build.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cadence-pstepanov.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cadence-pstepanov
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
