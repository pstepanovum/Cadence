 "grammarPoint": {
  "id": "gp.reported-questions",
  "level": "B1",
  "topicId": "topic.reported-speech",
  "title": "Reported questions",
  "summary": "Learn how to report questions someone asked, using words like \"asked if\" or \"wanted to know where,\" and keeping normal sentence word order.",
  "explanation": "When we tell someone what another person asked, we use *reported questions*. We don't use quotation marks, and the structure changes from a direct question.\n\nFor *yes/no questions* (questions that can be answered with \"yes\" or \"no\"), we use \"asked *if*\" or \"asked *whether*\". For *wh-questions* (questions starting with words like \"what,\" \"where,\" \"when,\" \"why,\" \"how\"), we use the *wh-word* itself.\n\nA key rule for reported questions is to use *normal sentence word order* (subject + verb), not question word order. Also, the verb tense often shifts back one step (e.g., present simple becomes past simple).",
  "patterns": [
   "subject + asked + if/whether + subject + verb (past tense)",
   "subject + wanted to know + if/whether + subject + verb (past tense)",
   "subject + asked + wh-word + subject + verb (past tense)",
   "subject + wanted to know + wh-word + subject + verb (past tense)"
  ],
  "examples": [
   {
    "text": "She asked if I was busy.",
    "note": "A yes/no question uses 'if', and the word order is subject + verb.",
    "source": {
     "kind": "generated"
    }
   },
   {
    "text": "He wanted to know where the library was.",
    "note": "A wh-question uses the wh-word, and the word order is subject + verb.",
    "source": {
     "kind": "generated"
    }
   },
   {
    "text": "They asked whether I had enjoyed the movie.",
    "note": "Another option for yes/no questions is 'whether', and the tense shifts.",
    "source": {
     "kind": "generated"
    }
   },
   {
    "text": "I asked what time the store opened.",
    "note": "The wh-phrase 'what time' is used, and the word order is subject + verb.",
    "source": {
     "kind": "generated"
    }
   },
   {
    "text": "My friend asked if I could help her.",
    "note": "The modal verb 'can' changes to 'could' in reported speech.",
    "source": {
     "kind": "generated"
    }
   }
  ],
  "commonErrors": [
   {
    "wrong": "He asked where was the station.",
    "right": "He asked where the station was.",
    "note": "Remember to use normal subject-verb order after the wh-word."
   },
   {
    "wrong": "She wanted to know you liked the food.",
    "right": "She wanted to know if I liked the food.",
    "note": "Use 'if' or 'whether' for reported yes/no questions."
   },
   {
    "wrong": "They asked do you want coffee.",
    "right": "They asked if I wanted coffee.",
    "note": "The auxiliary verb 'do' is not used in reported questions, and the tense shifts."
   }
  ],
  "related": []
 },
