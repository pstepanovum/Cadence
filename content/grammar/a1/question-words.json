  "title": "Question words",
  "summary": "Learn to ask for specific information using question words like what, where, when, who, why, and how.",
  "explanation": "We use *question words* to ask for particular information. They usually come at the beginning of a question.\n\n*What* asks about things or actions. *Where* asks about places. *When* asks about time. *Who* asks about people.\n\n*Why* asks about reasons. *How* asks about the way something happens or the condition of something.",
  "patterns": [
   "Question word + is/are + subject?",
   "Question word + do/does + subject + verb?"
  ],
  "examples": [
   {
    "text": "What is your favorite food?",
    "note": "Asks about a thing (food).",
    "source": {
     "kind": "generated"
    }
   },
   {
    "text": "Where do you work?",
    "note": "Asks about a place.",
    "source": {
     "kind": "generated"
    }
   },
   {
    "text": "When is your birthday?",
    "note": "Asks about a time.",
    "source": {
     "kind": "generated"
    }
   },
   {
    "text": "Who is that woman?",
    "note": "Asks about a person.",
    "source": {
     "kind": "generated"
    }
   },
   {
    "text": "Why are you learning English?",
    "note": "Asks about a reason.",
    "source": {
     "kind": "generated"
    }
   }
  ],
  "commonErrors": [
   {
    "wrong": "Where you live?",
    "right": "Where do you live?",
    "note": "Remember to use 'do' or 'does' in questions with most verbs."
   },
   {
    "wrong": "Who is he?",
    "right": "Who is he?",
    "note": "The word order for 'be' verbs is 'Question word + is/are + subject'."
   },
   {
    "wrong": "What your name is?",
    "right": "What is your name?",
    "note": "The verb 'is' comes before the subject 'your name'."
   }
  ],
