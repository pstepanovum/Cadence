 "grammarPoint": {
  "id": "gp.verb-to-be",
  "level": "A1",
  "topicId": "topic.tenses",
  "title": "The verb be",
  "summary": "Learn to use 'am', 'is', and 'are' for positive sentences, negatives, and questions to talk about people, things, and states.",
  "explanation": "The verb *be* is very common in English. It changes its form depending on the subject of the sentence. We use *am* with 'I', *is* with 'he', 'she', 'it', and singular nouns, and *are* with 'you', 'we', 'they', and plural nouns.\n\nWe use *be* to talk about who someone is, what something is, where someone or something is, or how someone feels. For example, 'I am a student' or 'She is happy'.\n\nTo make a negative sentence, we add *not* after 'am', 'is', or 'are'. For example, 'I am not tired'. For questions, we put 'am', 'is', or 'are' before the subject. For example, 'Are you ready?'.",
  "patterns": [
   "I + am (+ not)",
   "He/She/It + is (+ not)",
   "You/We/They + are (+ not)",
   "Am + I...?",
   "Is + he/she/it...?",
   "Are + you/we/they...?"
  ],
  "examples": [
   {
    "text": "I am from Spain.",
    "note": "Uses 'am' with 'I' to state origin.",
    "source": {
     "kind": "generated"
    }
   },
   {
    "text": "She is a new teacher.",
    "note": "Uses 'is' with 'she' to describe a person.",
    "source": {
     "kind": "generated"
    }
   },
   {
    "text": "They are not at home.",
    "note": "Uses 'are not' with 'they' for a negative location.",
    "source": {
     "kind": "generated"
    }
   },
   {
    "text": "Is he busy today?",
    "note": "Uses 'is' before 'he' to ask a question about his state.",
    "source": {
     "kind": "generated"
    }
   },
   {
    "text": "We are happy with the results.",
    "note": "Uses 'are' with 'we' to describe a feeling.",
    "source": {
     "kind": "generated"
    }
   }
  ],
  "commonErrors": [
   {
    "wrong": "He am a student.",
    "right": "He is a student.",
    "note": "Use 'is' with 'he', 'she', 'it', and singular nouns."
   },
   {
    "wrong": "They not ready.",
    "right": "They are not ready.",
    "note": "Always include 'am', 'is', or 'are' in negative sentences."
   },
   {
    "wrong": "You are happy?",
    "right": "Are you happy?",
    "note": "For questions, put 'am', 'is', or 'are' before the subject."
