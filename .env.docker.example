# FILE: .env.docker.example

# Public app config
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=your_brandfetch_client_id
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Cadence Cloud: Firebase web app config (Project settings > Your apps).
# Leave these empty to offer local mode only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase App Check on the web: the reCAPTCHA Enterprise site key registered
# for the web app. In development the debug provider is used instead; paste a
# registered debug token here to keep it stable (never in production).
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
# Published on /support, /privacy and /terms.
NEXT_PUBLIC_SUPPORT_EMAIL=support@cadence.pstepanov.dev

# Firebase Admin, server only. The project id is enough to verify sign-ins;
# minting session cookies and reading Firestore also need credentials: paste
# the service-account JSON on one line, or leave it empty to use Application
# Default Credentials (GOOGLE_APPLICATION_CREDENTIALS, gcloud, or Google Cloud).
FIREBASE_PROJECT_ID=your-project
FIREBASE_SERVICE_ACCOUNT=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Internal service routing
AI_ENGINE_URL=http://ai-engine:8000
AI_COACH_ENGINE_URL=http://coach-engine:8001

# AI coach
COACH_LLM_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
COACH_LLM_DEVICE=cpu
CADENCE_LOG_LEVEL=INFO
HF_TOKEN=

# Optional email config (unused by the app itself)
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_API_KEY=
