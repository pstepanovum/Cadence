ary","title":"Words B2 31: seize to sin","goal":"Learn 20 B2 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.seize","ex.vocab.seldom","ex.vocab.self","ex.vocab.selfish","ex.vocab.senior","ex.vocab.sensible","ex.vocab.sensitive","ex.vocab.severe","ex.vocab.severely","ex.vocab.sexual","ex.vocab.shallow","ex.vocab.shame","ex.vocab.shatter","ex.vocab.shed","ex.vocab.shelter","ex.vocab.shift","ex.vocab.shortage","ex.vocab.shrink","ex.vocab.significant","ex.vocab.sin"]},{"id":"lesson.b2.vocabulary-32","level":"B2","topicId":"topic.vocabulary","title":"Words B2 32: sincere to stalk","goal":"Learn 20 B2 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.sincere","ex.vocab.skilled","ex.vocab.slight","ex.vocab.sneak","ex.vocab.sober","ex.vocab.solar","ex.vocab.somewhat","ex.vocab.soul","ex.vocab.species","ex.vocab.specific","ex.vocab.spit","ex.vocab.spite","ex.vocab.split","ex.vocab.spouse","ex.vocab.sprain","ex.vocab.stab","ex.vocab.stable","ex.vocab.stain","ex.vocab.stake","ex.vocab.stalk"]},{"id":"lesson.b2.vocabulary-33","level":"B2","topicId":"topic.vocabulary","title":"Words B2 33: stall to supply","goal":"Learn 20 B2 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.stall","ex.vocab.startle","ex.vocab.status","ex.vocab.stock","ex.vocab.strand","ex.vocab.strategy","ex.vocab.stray","ex.vocab.stressful","ex.vocab.strike","ex.vocab.stroke","ex.vocab.struggle","ex.vocab.stubborn","ex.vocab.stumble","ex.vocab.stunned","ex.vocab.submit","ex.vocab.substance","ex.vocab.sue","ex.vocab.suffer","ex.vocab.superior","ex.vocab.supply"]},{"id":"lesson.b2.vocabulary-34","level":"B2","topicId":"topic.vocabulary","title":"Words B2 34: supportive to tendency","goal":"Learn 20 B2 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.supportive","ex.vocab.surface","ex.vocab.surgeon","ex.vocab.surgery","ex.vocab.surrender","ex.vocab.suspect","ex.vocab.suspend","ex.vocab.suspicion","ex.vocab.suspicious","ex.vocab.swear","ex.vocab.swell","ex.vocab.sympathetic","ex.vocab.sympathy","ex.vocab.symptom","ex.vocab.tattoo","ex.vocab.technique","ex.vocab.telescope","ex.vocab.temper","ex.vocab.tempt","ex.vocab.tendency"]},{"id":"lesson.b2.vocabulary-35","level":"B2","topicId":"topic.vocabulary","title":"Words B2 35: tense to tragedy","goal":"Learn 20 B2 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.tense","ex.vocab.terrify","ex.vocab.territory","ex.vocab.terror","ex.vocab.terrorist","ex.vocab.theft","ex.vocab.theory","ex.vocab.therapist","ex.vocab.therapy","ex.vocab.thorough","ex.vocab.threat","ex.vocab.throughout","ex.vocab.ticklish","ex.vocab.tighten","ex.vocab.timid","ex.vocab.tolerate","ex.vocab.torture","ex.vocab.toxic","ex.vocab.trace","ex.vocab.tragedy"]},{"id":"lesson.b2.vocabulary-36","level":"B2","topicId":"topic.vocabulary","title":"Words B2 36: trail to unexpected","goal":"Learn 20 B2 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.trail","ex.vocab.traitor","ex.vocab.transform","ex.vocab.trap","ex.vocab.treatment","ex.vocab.treaty","ex.vocab.tremble","ex.vocab.tribe","ex.vocab.trigger","ex.vocab.trombone","ex.vocab.truly","ex.vocab.trustworthy","ex.vocab.truthful","ex.vocab.typhoon","ex.vocab.unaware","ex.vocab.unbearable","ex.vocab.unconscious","ex.vocab.uneasy","ex.vocab.unemployment","ex.vocab.unexpected"]},{"id":"lesson.b2.vocabulary-37","level":"B2","topicId":"topic.vocabulary","title":"Words B2 37: unfair to visible","goal":"Learn 20 B2 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.unfair","ex.vocab.unimpressed","ex.vocab.unique","ex.vocab.universe","ex.vocab.unlikely","ex.vocab.unwilling","ex.vocab.upon","ex.vocab.upside","ex.vocab.urban","ex.vocab.urge","ex.vocab.urgent","ex.vocab.vacuum","ex.vocab.vain","ex.vocab.valid","ex.vocab.vast","ex.vocab.vegan","ex.vocab.verge","ex.vocab.violate","ex.vocab.violence","ex.vocab.visible"]},{"id":"lesson.b2.vocabulary-38","level":"B2","topicId":"topic.vocabulary","title":"Words B2 38: vision to wrestle","goal":"Learn 19 B2 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.vision","ex.vocab.vomit","ex.vocab.vulnerable","ex.vocab.wage","ex.vocab.warehouse","ex.vocab.weakness","ex.vocab.wealth","ex.vocab.weave","ex.vocab.whatever","ex.vocab.whatsoever","ex.vocab.whip","ex.vocab.willing","ex.vocab.wisdom","ex.vocab.within","ex.vocab.witness","ex.vocab.worship","ex.vocab.wound","ex.vocab.wounded","ex.vocab.wrestle"]},{"id":"lesson.b2.dictation","level":"B2","topicId":"topic.listening","title":"Dictation B2","goal":"Write down real English sentences you hear.","minutes":10,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.b2.dictation.57967","ex.b2.dictation.262389","ex.b2.dictation.569732","ex.b2.dictation.749342","ex.b2.dictation.1517275","ex.b2.dictation.3417265","ex.b2.dictation.3619267","ex.b2.dictation.5767528","ex.b2.dictation.6113688","ex.b2.dictation.7169304","ex.b2.dictation.7507630","ex.b2.dictation.7507676","ex.b2.dictation.8088389","ex.b2.dictation.8793455","ex.b2.dictation.9286841","ex.b2.dictation.9303672","ex.b2.dictation.10770516","ex.b2.dictation.10822657","ex.b2.dictation.10862455","ex.b2.dictation.11511061","ex.b2.dictation.11650663","ex.b2.dictation.11694307","ex.b2.dictation.11783461","ex.b2.dictation.12268209"]}],"exercises":[{"id":"ex.b2.articles-in-general-statements.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.articles-in-general-statements"],"prompt":"Choose the best answer.","question":"___ books are a great source of knowledge.","options":["A","The","An","___"],"answer":3,"explanation":"When talking about plural nouns in a general sense, we use the zero article."},{"id":"ex.b2.articles-in-general-statements.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.articles-in-general-statements"],"prompt":"Choose the best answer.","question":"___ piano is a beautiful instrument.","options":["A","The","An","___"],"answer":1,"explanation":"We use 'the' to refer to a class of instruments or inventions in general."},{"id":"ex.b2.articles-in-general-statements.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.articles-in-general-statements"],"prompt":"Choose the best answer.","question":"Many people go to ___ church on Sundays.","options":["a","the","___"],"answer":2,"explanation":"When referring to the purpose of an institution like 'church' (to worship), we use the zero article."},{"id":"ex.b2.articles-in-general-statements.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.articles-in-general-statements"],"prompt":"Choose the best answer.","question":"___ pollution is a serious global problem.","options":["A","The","___"],"answer":2,"explanation":"'Pollution' is an uncountable noun, so we use the zero article when speaking generally."},{"id":"ex.b2.articles-in-general-statements.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.articles-in-general-statements"],"prompt":"Complete the sentence.","text":"___ coffee helps me wake up in ___ morning.","answers":[["Coffee"],["the"]],"explanation":"'Coffee' is an uncountable noun used generally, so it takes the zero article. 'The morning' is a specific time of day."},{"id":"ex.b2.articles-in-general-statements.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.articles-in-general-statements"],"prompt":"Complete the sentence.","text":"___ elephant is ___ largest land animal.","answers":[["The","An"],["the"]],"explanation":"We use 'the' for a singular noun representing a whole species ('the elephant') and with superlatives ('the largest')."},{"id":"ex.b2.articles-in-general-statements.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.articles-in-general-statements"],"prompt":"Put the words in the right order.","answer":["Children","need","love","and","support","."],"distractors":["A","The"],"explanation":"When talking about 'children' in general, no article is needed. 'Love' and 'support' are uncountable nouns used generally."},{"id":"ex.b2.articles-in-general-statements.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.articles-in-general-statements"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The birds fly south for the winter.","answers":["Birds fly south for the winter."],"explanation":"When talking about 'birds' in general, no article is needed."},{"id":"ex.b2.articles-in-general-statements.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.articles-in-general-statements"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"My sister is at the work right now.","answers":["My sister is at work right now."],"explanation":"When referring to the activity of 'work', we use the zero article."},{"id":"ex.b2.articles-in-general-statements.12","kind":"transformation","level":"B2","grammarPointIds":["gp.articles-in-general-statements"],"prompt":"Rewrite the sentence.","source":"I saw a specific tiger at the zoo.","instruction":"Rewrite the sentence to talk about tigers in general.","answers":["The tiger is a powerful animal.","Tigers are powerful animals.","Tigers are majestic animals."],"explanation":"To talk about tigers in general, you can use 'the' with the singular noun or no article with the plural noun."},{"id":"ex.b2.articles-in-general-statements.13","kind":"transformation","level":"B2","grammarPointIds":["gp.articles-in-general-statements"],"prompt":"Rewrite the sentence.","source":"She is going to the specific building where lessons are taught.","instruction":"Rewrite the sentence to talk about the purpose of going to school.","answers":["She is going to school."],"explanation":"When referring to the purpose of attending 'school', the zero article is used."},{"id":"ex.b2.articles-in-general-statements.14","kind":"matching","level":"B2","grammarPointIds":["gp.articles-in-general-statements"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"Computers have changed","right":"our lives dramatically."},{"left":"The computer is","right":"a complex machine."},{"left":"He was sent to prison","right":"for his crimes."},{"left":"The prison is located","right":"on an island."}]},{"id":"ex.b2.be-used-to-and-get-used-to.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Choose the best answer.","question":"After living in the mountains for years, I'm completely ___ the quiet.","options":["used to","get used to","use to","used for"],"answer":0,"explanation":"'Be used to' describes a current state of being familiar with something. 'Used to' is the correct form here."},{"id":"ex.b2.be-used-to-and-get-used-to.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Choose the best answer.","question":"My new colleague is still ___ the company's software.","options":["getting used to","be used to","get used to","used to"],"answer":0,"explanation":"The colleague is in the process of becoming familiar, so 'getting used to' is correct."},{"id":"ex.b2.be-used-to-and-get-used-to.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Choose the best answer.","question":"It took me a month to ___ the local accent.","options":["get used to","be used to","used to","getting used to"],"answer":0,"explanation":"The phrase 'It took me a month' indicates a process of becoming familiar, so 'get used to' is appropriate."},{"id":"ex.b2.be-used-to-and-get-used-to.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Choose the best answer.","question":"Are you ___ the cold winters here?","options":["used to","get used to","using to","used for"],"answer":0,"explanation":"This question asks about a current state of familiarity, so 'be used to' (in this case, 'are used to') is correct."},{"id":"ex.b2.be-used-to-and-get-used-to.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Put the words in the right order.","answer":["She","is","used","to","the","early","mornings","."],"distractors":["get","for"],"explanation":"This sentence describes a current state of familiarity with early mornings."},{"id":"ex.b2.be-used-to-and-get-used-to.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Put the words in the right order.","answer":["It","took","him","a","while","to","get","used","to","driving","on","the","left","."],"distractors":["be","for"],"explanation":"This sentence describes the process of becoming familiar with a new driving habit."},{"id":"ex.b2.be-used-to-and-get-used-to.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I'm slowly getting used to wake up early.","answers":["I'm slowly getting used to waking up early."],"explanation":"After 'get used to', a verb must be in the -ing form (gerund)."},{"id":"ex.b2.be-used-to-and-get-used-to.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"They weren't use to the cold weather.","answers":["They weren't used to the cold weather."],"explanation":"The correct form is 'used to', not 'use to', when talking about familiarity."},{"id":"ex.b2.be-used-to-and-get-used-to.12","kind":"transformation","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Rewrite the sentence.","source":"The loud music doesn't bother me anymore.","instruction":"Rewrite using 'be used to'.","answers":["I am used to the loud music now.","I'm used to the loud music now.","I am used to the loud music."],"explanation":"'Be used to' expresses that something is no longer bothersome because you are accustomed to it."},{"id":"ex.b2.be-used-to-and-get-used-to.13","kind":"transformation","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Rewrite the sentence.","source":"It was difficult for her to adapt to the new schedule.","instruction":"Rewrite using 'get used to'.","answers":["It was difficult for her to get used to the new schedule."],"explanation":"'Get used to' describes the process of adapting or becoming familiar with something."},{"id":"ex.b2.be-used-to-and-get-used-to.14","kind":"matching","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I'm not used to","right":"eating dinner so late."},{"left":"It takes time to get used to","right":"living in a different country."},{"left":"Are you used to","right":"the humid climate?"},{"left":"My eyes are getting used to","right":"the darkness."}]},{"id":"ex.b2.be-used-to-and-get-used-to.15","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Choose the best answer.","question":"After a few weeks, I finally ___ used to the humid climate.","options":["am","get","got","was"],"answer":2,"explanation":"'Got used to' describes the completion of the process of becoming familiar in the past."},{"id":"ex.b2.be-used-to-and-get-used-to.16","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Choose the best answer.","question":"My dog isn't ___ used to being alone all day yet.","options":["get","getting","got","gets"],"answer":1,"explanation":"'Getting used to' describes an ongoing process of becoming familiar. 'Isn't getting' is the correct negative present continuous form."},{"id":"ex.b2.be-used-to-and-get-used-to.17","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Choose the best answer.","question":"She ___ used to the quiet life in the countryside.","options":["is","gets","get","got"],"answer":0,"explanation":"'Is used to' describes a current state of being familiar with something."},{"id":"ex.b2.be-used-to-and-get-used-to.18","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.be-used-to-and-get-used-to"],"prompt":"Choose the best answer.","question":"It's hard to ___ used to such a different way of working.","options":["be","get","being","getting"],"answer":1,"explanation":"'Get used to' describes the process of becoming familiar with something. 'It's hard to get used to' is a common expression."},{"id":"ex.b2.causative-have-and-get.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Choose the best answer.","question":"I need to ___ my passport renewed before my trip.","options":["have","had","having","to have"],"answer":0,"explanation":"The correct structure is 'have + object + past participle'. 'Have' is the base form needed here."},{"id":"ex.b2.causative-have-and-get.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Choose the best answer.","question":"They're going to ___ their kitchen completely redesigned.","options":["get","got","getting","to get"],"answer":0,"explanation":"After 'going to', we use the base form 'get' to form the causative structure 'get + object + past participle'."},{"id":"ex.b2.causative-have-and-get.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Choose the best answer.","question":"We ___ our old sofa delivered to charity last weekend.","options":["had","have","get","getting"],"answer":0,"explanation":"The action happened 'last weekend', so the past tense 'had' is required for the causative structure."},{"id":"ex.b2.causative-have-and-get.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Choose the best answer.","question":"Before the party, I always ___ my nails done.","options":["have","had","having","to have"],"answer":0,"explanation":"This is a regular action, so the simple present 'have' is correct for the causative structure."},{"id":"ex.b2.causative-have-and-get.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Complete the sentence.","text":"My laptop was running slowly, so I ___ it ___ by a technician.","answers":[["had","got"],["fixed","repaired"]],"explanation":"Use 'had' or 'got' for the past tense causative, and 'fixed' or 'repaired' as the past participle."},{"id":"ex.b2.causative-have-and-get.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Complete the sentence.","text":"She's planning to ___ her house ___ next month.","answers":[["have","get"],["painted","decorated"]],"explanation":"Use 'have' or 'get' for the causative, and 'painted' as the past participle."},{"id":"ex.b2.causative-have-and-get.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Complete the sentence.","text":"We usually ___ our groceries ___ to our door.","answers":[["have","get"],["delivered"]],"explanation":"Use 'have' or 'get' for the present tense causative, and 'delivered' as the past participle."},{"id":"ex.b2.causative-have-and-get.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Put the words in the right order.","answer":["I","had","my","bike","serviced","."],"distractors":["fix"],"explanation":"The correct order is 'subject + had + object + past participle'."},{"id":"ex.b2.causative-have-and-get.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Put the words in the right order.","answer":["They","are","getting","a","new","pool","built","."],"distractors":["build"],"explanation":"The correct order is 'subject + are getting + object + past participle'."},{"id":"ex.b2.causative-have-and-get.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I need to have cleaned my apartment before the guests arrive.","answers":["I need to have my apartment cleaned before the guests arrive."],"explanation":"The object 'my apartment' must come between 'have' and the past participle 'cleaned'."},{"id":"ex.b2.causative-have-and-get.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"He got his car wash yesterday.","answers":["He got his car washed yesterday."],"explanation":"The verb after the object must be in the past participle form, 'washed'."},{"id":"ex.b2.causative-have-and-get.12","kind":"transformation","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Rewrite the sentence.","source":"A professional photographer took our family portrait.","instruction":"Rewrite using 'had something done'.","answers":["We had our family portrait taken by a professional photographer.","We had our family portrait taken."],"explanation":"The original sentence describes someone doing a service for 'us'. We use 'had' + object + past participle."},{"id":"ex.b2.causative-have-and-get.13","kind":"transformation","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Rewrite the sentence.","source":"The tailor will shorten my trousers.","instruction":"Rewrite using 'get something done'.","answers":["I will get my trousers shortened by the tailor.","I will get my trousers shortened."],"explanation":"The original sentence describes a service being done for 'me'. We use 'will get' + object + past participle."},{"id":"ex.b2.causative-have-and-get.14","kind":"matching","level":"B2","grammarPointIds":["gp.causative-have-and-get"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I always have my car","right":"serviced at the same garage."},{"left":"She's going to get her hair","right":"dyed a new color next week."},{"left":"We had our old fence","right":"removed by a landscaping company."},{"left":"He needs to have his eyes","right":"checked by an optometrist soon."}]},{"id":"ex.b2.despite-and-in-spite-of.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Choose the best answer.","question":"___ the long queue, we waited patiently for our turn.","options":["Whereas","Despite","In spite"],"answer":1,"explanation":"\"Despite\" is followed by a noun phrase (\"the long queue\") to show unexpected contrast. \"In spite\" needs \"of\". \"Whereas\" introduces a clause."},{"id":"ex.b2.despite-and-in-spite-of.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Choose the best answer.","question":"The first proposal was very detailed, ___ the second one was quite brief.","options":["despite","in spite of","whereas"],"answer":2,"explanation":"\"Whereas\" is used to show a direct contrast between two clauses."},{"id":"ex.b2.despite-and-in-spite-of.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Choose the best answer.","question":"___ feeling unwell, she still came to the meeting.","options":["Whereas","In spite of","Despite of"],"answer":1,"explanation":"\"In spite of\" is followed by an -ing form (\"feeling\") to show unexpected contrast. \"Despite of\" is incorrect. \"Whereas\" introduces a clause."},{"id":"ex.b2.despite-and-in-spite-of.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Choose the best answer.","question":"Some fruits are sweet, ___ others are sour.","options":["despite","in spite of","whereas"],"answer":2,"explanation":"\"Whereas\" is used to show a direct contrast between two clauses."},{"id":"ex.b2.despite-and-in-spite-of.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Complete the sentence.","text":"He prefers working alone, ___ his colleague enjoys teamwork.","answers":[["whereas"]],"explanation":"\"Whereas\" is used to show a direct contrast between two clauses."},{"id":"ex.b2.despite-and-in-spite-of.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Put the words in the right order.","answer":["Despite","the","loud","music",",","I","managed","to","sleep","."],"distractors":["although","but"],"explanation":"\"Despite\" introduces the noun phrase \"the loud music\" to show unexpected contrast."},{"id":"ex.b2.despite-and-in-spite-of.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"In spite the difficult situation, they found a solution.","answers":["In spite of the difficult situation, they found a solution."],"explanation":"\"In spite\" must always be followed by \"of\"."},{"id":"ex.b2.despite-and-in-spite-of.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"She is very organized, despite her brother is quite messy.","answers":["She is very organized, whereas her brother is quite messy."],"explanation":"\"Despite\" is followed by a noun or -ing form, not a clause. \"Whereas\" is used to contrast two clauses."},{"id":"ex.b2.despite-and-in-spite-of.12","kind":"transformation","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Rewrite the sentence.","source":"Even though it was a holiday, the store was open.","instruction":"Use \"despite\".","answers":["Despite the holiday, the store was open."],"explanation":"\"Despite\" is followed by a noun phrase, replacing \"even though it was a holiday\"."},{"id":"ex.b2.despite-and-in-spite-of.13","kind":"transformation","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Rewrite the sentence.","source":"The first car was red, but the second one was blue.","instruction":"Use \"whereas\".","answers":["The first car was red, whereas the second one was blue."],"explanation":"\"Whereas\" connects two contrasting clauses, replacing \"but\"."},{"id":"ex.b2.despite-and-in-spite-of.14","kind":"matching","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"Despite the bad reviews,","right":"the movie was surprisingly good."},{"left":"In spite of the long wait,","right":"the food was worth it."},{"left":"He enjoys quiet evenings,","right":"whereas she loves lively parties."},{"left":"Some plants need a lot of sun,","right":"whereas others prefer shade."}]},{"id":"ex.b2.despite-and-in-spite-of.15","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Choose the best answer.","question":"The first presentation was very engaging, ___ the second one was quite dull.","options":["despite","in spite of","whereas","although"],"answer":2,"explanation":"'Whereas' is used to introduce a contrasting clause, comparing the two presentations."},{"id":"ex.b2.despite-and-in-spite-of.16","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Choose the best answer.","question":"___ the high cost, many people still choose to live in the city.","options":["Whereas","In spite","Despite","Even though"],"answer":2,"explanation":"'Despite' is followed by a noun phrase ('the high cost') to show contrast."},{"id":"ex.b2.despite-and-in-spite-of.17","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Choose the best answer.","question":"She managed to stay focused ___ all the distractions around her.","options":["whereas","in spite of","despite of","even if"],"answer":1,"explanation":"'In spite of' is correctly used here with a noun phrase to show contrast."},{"id":"ex.b2.despite-and-in-spite-of.18","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.despite-and-in-spite-of"],"prompt":"Choose the best answer.","question":"Which word best completes the sentence: \"Some cultures value individualism, ___ others prioritize community.\"","options":["despite","in spite of","whereas","but"],"answer":2,"explanation":"'Whereas' is used to contrast two clauses, highlighting the difference between cultural values."},{"id":"ex.b2.each-every-all.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.each-every-all"],"prompt":"Choose the best answer.","question":"___ participant received a small gift at the end of the conference.","options":["All","Every","Each of the"],"answer":1,"explanation":"'Every' is used with a singular countable noun to refer to all members of a group."},{"id":"ex.b2.each-every-all.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.each-every-all"],"prompt":"Choose the best answer.","question":"___ the ingredients are fresh, so the meal will be delicious.","options":["Each","Every","All"],"answer":2,"explanation":"'All' is used with plural countable nouns like 'ingredients' to refer to the entire group."},{"id":"ex.b2.each-every-all.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.each-every-all"],"prompt":"Choose the best answer.","question":"The teacher spoke to ___ child individually about their progress.","options":["all","every","each"],"answer":2,"explanation":"'Each' emphasizes individual members, which fits the idea of speaking to them 'individually'."},{"id":"ex.b2.each-every-all.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.each-every-all"],"prompt":"Choose the best answer.","question":"___ the information you need is available on our website.","options":["Each","Every","All"],"answer":2,"explanation":"'All' is used with uncountable nouns like 'information' to refer to the entire quantity."},{"id":"ex.b2.each-every-all.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.each-every-all"],"prompt":"Complete the sentence.","text":"We checked ___ the doors and windows before leaving the house.","answers":[["all"]],"explanation":"'All' is used with plural countable nouns like 'doors and windows' to refer to the entire set."},{"id":"ex.b2.each-every-all.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.each-every-all"],"prompt":"Put the words in the right order.","answer":["Each","of","the","flowers","smells","sweet","."],"distractors":["every"],"explanation":"This sentence correctly uses 'each of the' with a plural noun and a singular verb to focus on individual flowers."},{"id":"ex.b2.each-every-all.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.each-every-all"],"prompt":"Put the words in the right order.","answer":["All","the","guests","enjoyed","the","delicious","food","."],"distractors":["every"],"explanation":"This sentence correctly uses 'all the' with a plural noun to refer to the entire group of guests."},{"id":"ex.b2.each-every-all.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.each-every-all"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Every of the books on the shelf is a classic.","answers":["Each of the books on the shelf is a classic.","Every one of the books on the shelf is a classic."],"explanation":"'Every' cannot be directly followed by 'of the'. Use 'each of the' or 'every one of the'."},{"id":"ex.b2.each-every-all.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.each-every-all"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"All the student must complete the final project.","answers":["All the students must complete the final project.","Every student must complete the final project."],"explanation":"'All' with countable nouns requires a plural noun. Alternatively, 'every' can be used with a singular noun."},{"id":"ex.b2.each-every-all.12","kind":"transformation","level":"B2","grammarPointIds":["gp.each-every-all"],"prompt":"Rewrite the sentence.","source":"Every person in the room agreed with the decision.","instruction":"Rewrite using 'all'.","answers":["All the people in the room agreed with the decision."],"explanation":"To use 'all', the singular noun 'person' must become the plural 'people', and 'the' is often used."},{"id":"ex.b2.each-every-all.13","kind":"transformation","level":"B2","grammarPointIds":["gp.each-every-all"],"prompt":"Rewrite the sentence.","source":"All the children received a small toy.","instruction":"Rewrite using 'each'.","answers":["Each child received a small toy.","Each of the children received a small toy."],"explanation":"When using 'each', the plural noun 'children' becomes the singular 'child'. 'Each of the' is also an option."},{"id":"ex.b2.each-every-all.14","kind":"matching","level":"B2","grammarPointIds":["gp.each-every-all"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"Each student","right":"has a different learning style."},{"left":"Every car","right":"on the road needs insurance."},{"left":"All the furniture","right":"was delivered this morning."},{"left":"All the documents","right":"are stored in the cloud."}]},{"id":"ex.b2.emphatic-do.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Choose the best answer.","question":"Even though you think I don't care, I ___ care about your feelings.","options":["do","am","have","will"],"answer":0,"explanation":"To emphasize that the speaker cares, 'do' is used before the base verb 'care'."},{"id":"ex.b2.emphatic-do.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Choose the best answer.","question":"My brother said he didn't get the message, but he ___ get it.","options":["does","did","do","is"],"answer":1,"explanation":"For past tense emphasis, 'did' is used before the base verb 'get'."},{"id":"ex.b2.emphatic-do.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Choose the best answer.","question":"She ___ want to join us for dinner, despite what she said earlier.","options":["do","did","does","is"],"answer":2,"explanation":"For third person singular present tense emphasis, 'does' is used before the base verb 'want'."},{"id":"ex.b2.emphatic-do.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Choose the best answer.","question":"I know it sounds strange, but I ___ believe in luck.","options":["am","do","have","will"],"answer":1,"explanation":"To emphasize the speaker's belief, 'do' is used before the base verb 'believe'."},{"id":"ex.b2.emphatic-do.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Complete the sentence.","text":"You might think I forgot, but I ___ ___ remember your birthday!","answers":[["do"],["remember"]],"explanation":"To emphasize remembering, use 'do' with the base form of the verb 'remember'."},{"id":"ex.b2.emphatic-do.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Complete the sentence.","text":"He ___ ___ to finish his work on time, even with all the distractions.","answers":[["did"],["manage"]],"explanation":"For past tense emphasis, use 'did' with the base form of the verb 'manage'."},{"id":"ex.b2.emphatic-do.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Complete the sentence.","text":"My cat ___ ___ enjoy playing with that new toy.","answers":[["does"],["enjoy"]],"explanation":"For third person singular present tense emphasis, use 'does' with the base form of the verb 'enjoy'."},{"id":"ex.b2.emphatic-do.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Put the words in the right order.","answer":["I","do","appreciate","your","help","."],"explanation":"The emphatic 'do' is placed before the base form of the verb 'appreciate' to stress gratitude."},{"id":"ex.b2.emphatic-do.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Put the words in the right order.","answer":["She","did","call","you","back","."],"distractors":["calls"],"explanation":"The emphatic 'did' is placed before the base form of the verb 'call' to confirm the action in the past."},{"id":"ex.b2.emphatic-do.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"He does likes to listen to classical music.","answers":["He does like to listen to classical music."],"explanation":"After 'does', the main verb must be in its base form ('like'), not with an -s ending."},{"id":"ex.b2.emphatic-do.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"We did went to the museum yesterday.","answers":["We did go to the museum yesterday."],"explanation":"When using 'did' for emphasis, the main verb must be in its base form ('go'), not the past tense ('went')."},{"id":"ex.b2.emphatic-do.12","kind":"transformation","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Rewrite the sentence.","source":"I like your new hairstyle.","instruction":"Add emphasis to the verb 'like'.","answers":["I do like your new hairstyle."],"explanation":"To add emphasis, insert 'do' before the base form of the verb 'like'."},{"id":"ex.b2.emphatic-do.13","kind":"transformation","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Rewrite the sentence.","source":"He remembered to lock the door.","instruction":"Rewrite the sentence to emphasize that he remembered.","answers":["He did remember to lock the door."],"explanation":"To emphasize a past action, use 'did' before the base form of the verb 'remember'."},{"id":"ex.b2.emphatic-do.14","kind":"matching","level":"B2","grammarPointIds":["gp.emphatic-do"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"You think I don't care, but I","right":"do care about this project."},{"left":"They said she wasn't there, but she","right":"did attend the meeting."},{"left":"It might seem difficult, but it","right":"does get easier with practice."},{"left":"I know you're busy, but please","right":"do try to come."}]},{"id":"ex.b2.future-continuous.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.future-continuous"],"prompt":"Choose the best answer.","question":"Don't call me at 7 PM. I ___ dinner with my family.","options":["will eat","will be eating","am eating"],"answer":1,"explanation":"The future continuous describes an action that will be in progress at a specific future time."},{"id":"ex.b2.future-continuous.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.future-continuous"],"prompt":"Choose the best answer.","question":"By this time next year, she ___ her master's degree.","options":["will complete","will be completing","completes"],"answer":1,"explanation":"The future continuous shows an action that will be ongoing over a period leading up to or at a future point."},{"id":"ex.b2.future-continuous.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.future-continuous"],"prompt":"Choose the best answer.","question":"What ___ when the guests arrive?","options":["will you do","will you be doing","are you doing"],"answer":1,"explanation":"Use the future continuous to ask about an action that will be in progress at a future moment."},{"id":"ex.b2.future-continuous.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.future-continuous"],"prompt":"Choose the best answer.","question":"I can't meet you on Saturday morning. I ___ the garden.","options":["will work in","will be working in","work in"],"answer":1,"explanation":"The future continuous indicates an activity that will be ongoing at a specific future time."},{"id":"ex.b2.future-continuous.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.future-continuous"],"prompt":"Complete the sentence.","text":"___ you ___ (travel) much next month?","answers":[["Will"],["be traveling"]],"explanation":"The future continuous is used to ask about ongoing actions in the future."},{"id":"ex.b2.future-continuous.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.future-continuous"],"prompt":"Put the words in the right order.","answer":["He","will","be","studying","all","evening","."],"distractors":["studies","is"],"explanation":"This sentence uses the future continuous to describe an action that will be ongoing throughout the evening."},{"id":"ex.b2.future-continuous.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.future-continuous"],"prompt":"Put the words in the right order.","answer":["What","will","they","be","discussing","at","the","meeting","?"],"distractors":["discussed","do"],"explanation":"This question uses the future continuous to ask about an action that will be in progress at a future event."},{"id":"ex.b2.future-continuous.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.future-continuous"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"At 10 AM tomorrow, I will drive to the airport.","answers":["At 10 AM tomorrow, I will be driving to the airport."],"explanation":"Use the future continuous for an action that will be in progress at a specific future time."},{"id":"ex.b2.future-continuous.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.future-continuous"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"She won't be finish her presentation by then.","answers":["She won't be finishing her presentation by then."],"explanation":"The future continuous requires the -ing form of the main verb after 'be'."},{"id":"ex.b2.future-continuous.12","kind":"transformation","level":"B2","grammarPointIds":["gp.future-continuous"],"prompt":"Rewrite the sentence.","source":"I will watch a movie at 9 PM.","instruction":"Rewrite using the future continuous.","answers":["I will be watching a movie at 9 PM."],"explanation":"The future continuous emphasizes the ongoing nature of the action at that specific future time."},{"id":"ex.b2.future-continuous.13","kind":"transformation","level":"B2","grammarPointIds":["gp.future-continuous"],"prompt":"Rewrite the sentence.","source":"Are you going to work on Saturday?","instruction":"Rewrite using the future continuous.","answers":["Will you be working on Saturday?"],"explanation":"The future continuous can be used to ask politely about someone's plans or an ongoing activity."},{"id":"ex.b2.future-continuous.14","kind":"matching","level":"B2","grammarPointIds":["gp.future-continuous"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"This time next week,","right":"we'll be relaxing on the beach."},{"left":"Don't call me at 8,","right":"I'll be having dinner."},{"left":"When you arrive,","right":"they will be preparing for the party."},{"left":"Will you be using","right":"the car tomorrow morning?"}]},{"id":"ex.b2.future-perfect.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Choose the best answer.","question":"By the time we arrive, the concert ___.","options":["will start","will be starting","will have started","starts"],"answer":2,"explanation":"The concert will be completed (started) before our arrival, so the future perfect is correct."},{"id":"ex.b2.future-perfect.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Choose the best answer.","question":"How many books ___ by the end of the year?","options":["will you read","will you have read","are you reading","do you read"],"answer":1,"explanation":"The question asks about the completion of reading books by a future point, requiring the future perfect."},{"id":"ex.b2.future-perfect.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Choose the best answer.","question":"I'm sure they ___ the new software by Monday.","options":["will install","will have installed","are installing","install"],"answer":1,"explanation":"The action of installing will be completed before Monday, so 'will have installed' is correct."},{"id":"ex.b2.future-perfect.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Choose the best answer.","question":"Don't worry, I ___ the dishes before you wake up.","options":["will wash","will be washing","will have washed","wash"],"answer":2,"explanation":"The action of washing the dishes will be completed before the future event of you waking up."},{"id":"ex.b2.future-perfect.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Complete the sentence.","text":"She ___ ___ (not finish) her presentation before the deadline.","answers":[["will not have","finished"],["won't have","finished"]],"explanation":"The negative future perfect 'will not have finished' (or 'won't have finished') indicates the presentation will still be incomplete by the deadline."},{"id":"ex.b2.future-perfect.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Put the words in the right order.","answer":["By","next","year","we","will","have","moved","to","a","new","city."],"distractors":["moving","move"],"explanation":"The sentence uses the future perfect to show that the action of moving will be completed by next year."},{"id":"ex.b2.future-perfect.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Put the words in the right order.","answer":["He","won't","have","seen","the","movie","by","tonight."],"distractors":["see","saw"],"explanation":"This sentence uses the negative future perfect to indicate that the action of seeing the movie will not be completed by tonight."},{"id":"ex.b2.future-perfect.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"By the time you call, I will eat lunch.","answers":["By the time you call, I will have eaten lunch."],"explanation":"The action of eating lunch will be completed before the future event of you calling, so the future perfect 'will have eaten' is needed."},{"id":"ex.b2.future-perfect.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"They will have finish the report before Friday.","answers":["They will have finished the report before Friday."],"explanation":"The future perfect requires the past participle form of the main verb, which is 'finished', not 'finish'."},{"id":"ex.b2.future-perfect.12","kind":"transformation","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Rewrite the sentence.","source":"I will complete my studies in two years.","instruction":"Rewrite using 'By 2026'.","answers":["By 2026, I will have completed my studies."],"explanation":"The instruction requires expressing completion by a future date, which is the function of the future perfect."},{"id":"ex.b2.future-perfect.13","kind":"transformation","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Rewrite the sentence.","source":"The guests will arrive before 8 PM.","instruction":"Rewrite to emphasize the completion of their arrival by 8 PM.","answers":["The guests will have arrived by 8 PM.","By 8 PM, the guests will have arrived."],"explanation":"Changing to the future perfect 'will have arrived' emphasizes that the action of arriving will be completed before the specified future time."},{"id":"ex.b2.future-perfect.14","kind":"matching","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"By the end of the week, we","right":"will have reviewed all the applications."},{"left":"She won't have learned to drive","right":"before her birthday next month."},{"left":"Will they have decided on a new plan","right":"by the time the meeting starts?"},{"left":"I hope I will have saved enough money","right":"to buy a house in five years."}]},{"id":"ex.b2.future-perfect.15","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Choose the best answer.","question":"By 2030, scientists ___ a cure for many common diseases.","options":["will discover","will have discovered","will be discovering","discover"],"answer":1,"explanation":"The discovery will be completed before 2030."},{"id":"ex.b2.future-perfect.16","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Choose the best answer.","question":"She ___ her degree by next summer.","options":["will get","will have gotten","will be getting","gets"],"answer":1,"explanation":"The action of getting her degree will be completed before next summer."},{"id":"ex.b2.future-perfect.17","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Choose the best answer.","question":"___ you ___ your presentation slides before the meeting starts?","options":["Will...prepare","Will...have prepared","Will...be preparing","Do...prepare"],"answer":1,"explanation":"Asking if the preparation will be completed before the meeting."},{"id":"ex.b2.future-perfect.18","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.future-perfect"],"prompt":"Choose the best answer.","question":"I can't meet you at 5 PM. By then, I ___ work for the day.","options":["will finish","will have finished","will be finishing","finish"],"answer":1,"explanation":"The action of finishing work will be completed before 5 PM."},{"id":"ex.b2.gradable-and-extreme-adjectives.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Choose the best answer.","question":"The concert was ___ amazing; everyone loved it.","options":["very","absolutely","quite"],"answer":1,"explanation":"'Amazing' is an extreme adjective, so 'absolutely' is the correct intensifier."},{"id":"ex.b2.gradable-and-extreme-adjectives.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Choose the best answer.","question":"I felt ___ happy when I heard the good news.","options":["absolutely","very","totally"],"answer":1,"explanation":"'Happy' is a gradable adjective, so 'very' is the appropriate intensifier."},{"id":"ex.b2.gradable-and-extreme-adjectives.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Choose the best answer.","question":"The old bridge is ___ ancient; it's been there for centuries.","options":["very","absolutely","a little"],"answer":1,"explanation":"'Ancient' is an extreme adjective, meaning 'very old', so 'absolutely' is used."},{"id":"ex.b2.gradable-and-extreme-adjectives.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Choose the best answer.","question":"It's ___ difficult to learn a new language, but it's rewarding.","options":["absolutely","very","completely"],"answer":1,"explanation":"'Difficult' is a gradable adjective, so 'very' is the correct intensifier."},{"id":"ex.b2.gradable-and-extreme-adjectives.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Complete the sentence.","text":"The food at the new restaurant was ___ delicious.","answers":[["absolutely"]],"explanation":"'Delicious' is an extreme adjective, meaning 'very tasty', so 'absolutely' is the correct intensifier."},{"id":"ex.b2.gradable-and-extreme-adjectives.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Complete the sentence.","text":"I'm feeling ___ cold today; I need a warm jacket.","answers":[["very"]],"explanation":"'Cold' is a gradable adjective, so 'very' is the appropriate intensifier."},{"id":"ex.b2.gradable-and-extreme-adjectives.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Complete the sentence.","text":"The professor's lecture was ___ fascinating.","answers":[["absolutely"]],"explanation":"'Fascinating' is an extreme adjective, meaning 'very interesting', so 'absolutely' is the correct intensifier."},{"id":"ex.b2.gradable-and-extreme-adjectives.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Put the words in the right order.","answer":["The","movie","was","absolutely","hilarious","."],"explanation":"The sentence uses 'absolutely' to intensify the extreme adjective 'hilarious'."},{"id":"ex.b2.gradable-and-extreme-adjectives.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Put the words in the right order.","answer":["She","was","very","upset","about","the","news","."],"explanation":"The sentence uses 'very' to intensify the gradable adjective 'upset'."},{"id":"ex.b2.gradable-and-extreme-adjectives.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The test was absolutely hard, but I think I passed.","answers":["The test was very hard, but I think I passed."],"explanation":"'Hard' is a gradable adjective, so it should be intensified with 'very', not 'absolutely'."},{"id":"ex.b2.gradable-and-extreme-adjectives.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I was very furious when I found out what happened.","answers":["I was absolutely furious when I found out what happened."],"explanation":"'Furious' is an extreme adjective, meaning 'very angry', so it should be intensified with 'absolutely'."},{"id":"ex.b2.gradable-and-extreme-adjectives.12","kind":"transformation","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Rewrite the sentence.","source":"The weather is very bad today.","instruction":"Rewrite the sentence using an extreme adjective and the correct intensifier.","answers":["The weather is absolutely awful today.","The weather is absolutely terrible today."],"explanation":"The gradable adjective 'bad' is replaced by the extreme adjective 'awful', requiring 'absolutely' as the intensifier."},{"id":"ex.b2.gradable-and-extreme-adjectives.13","kind":"transformation","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Rewrite the sentence.","source":"The book was absolutely brilliant.","instruction":"Rewrite the sentence using a gradable adjective and the correct intensifier.","answers":["The book was very good."],"explanation":"The extreme adjective 'brilliant' is replaced by the gradable adjective 'good', requiring 'very' as the intensifier."},{"id":"ex.b2.gradable-and-extreme-adjectives.14","kind":"matching","level":"B2","grammarPointIds":["gp.gradable-and-extreme-adjectives"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"The concert was","right":"absolutely fantastic."},{"left":"I'm feeling","right":"very tired today."},{"left":"The view from the top was","right":"absolutely stunning."},{"left":"Her new apartment is","right":"very spacious."}]},{"id":"ex.b2.had-better.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Choose the best answer.","question":"It's getting late. We ___ go home soon.","options":["should","had better","must","could"],"answer":1,"explanation":"'Had better' is the best choice here because it implies a potential negative consequence (e.g., getting stuck in traffic, being too tired) if they don't go home soon, making it stronger than 'should'."},{"id":"ex.b2.had-better.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Choose the best answer.","question":"You ___ tell your boss about the mistake before it's too late.","options":["had better","should to","have better","must to"],"answer":0,"explanation":"'Had better' is correct for strong advice with a potential negative outcome. 'Should to', 'have better', and 'must to' are grammatically incorrect."},{"id":"ex.b2.had-better.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Choose the best answer.","question":"The forecast says it will rain. You ___ take an umbrella.","options":["had better","should have","might","can"],"answer":0,"explanation":"'Had better' is used for a strong warning about a future event (rain) and the consequence of not taking an umbrella (getting wet). 'Should have' refers to the past, and 'might'/'can' are less direct advice."},{"id":"ex.b2.had-better.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Choose the best answer.","question":"We ___ forget to lock the doors when we leave.","options":["had better not","shouldn't to","don't better","must not to"],"answer":0,"explanation":"'Had better not' is the correct way to form a negative warning, implying a serious consequence if the doors are not locked. The other options are grammatically incorrect."},{"id":"ex.b2.had-better.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Complete the sentence.","text":"It's a long drive. We ___ fill up the gas tank now.","answers":[["had better","'d better"]],"explanation":"'Had better' is used for strong advice to avoid running out of gas."},{"id":"ex.b2.had-better.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Complete the sentence.","text":"You ___ be late for the interview, or you might not get the job.","answers":[["had better not","'d better not"]],"explanation":"'Had better not' gives a strong warning about the negative consequence of being late."},{"id":"ex.b2.had-better.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Complete the sentence.","text":"My phone battery is low. I ___ charge it soon.","answers":[["had better","'d better"]],"explanation":"'Had better' expresses a strong personal necessity to avoid the phone dying."},{"id":"ex.b2.had-better.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Put the words in the right order.","answer":["You'd","better","wear","a","coat","today","."],"distractors":["should","to"],"explanation":"This sentence gives strong advice to wear a coat, implying it's cold or will be cold."},{"id":"ex.b2.had-better.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Put the words in the right order.","answer":["They","had","better","not","miss","the","deadline","."],"distractors":["don't","to"],"explanation":"This is a strong warning not to miss the deadline, suggesting serious consequences."},{"id":"ex.b2.had-better.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"We have better check the train schedule.","answers":["We had better check the train schedule.","We'd better check the train schedule."],"explanation":"The correct form is 'had better', not 'have better'."},{"id":"ex.b2.had-better.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"She had better to finish her homework.","answers":["She had better finish her homework.","She'd better finish her homework."],"explanation":"The base form of the verb follows 'had better' directly, without 'to'."},{"id":"ex.b2.had-better.12","kind":"transformation","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Rewrite the sentence.","source":"You should really apologize to him.","instruction":"Rewrite using 'had better' to make the advice stronger.","answers":["You had better apologize to him.","You'd better apologize to him."],"explanation":"'Had better' makes the advice stronger, implying a negative consequence if the apology isn't made."},{"id":"ex.b2.had-better.13","kind":"transformation","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Rewrite the sentence.","source":"Don't forget your keys, or you won't get in.","instruction":"Rewrite using 'had better not'.","answers":["You had better not forget your keys.","You'd better not forget your keys.","You had better not forget your keys, or you won't get in."],"explanation":"'Had better not' expresses a strong warning about forgetting the keys and the resulting problem."},{"id":"ex.b2.had-better.14","kind":"matching","level":"B2","grammarPointIds":["gp.had-better"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"It's getting dark; we'd better","right":"head back to the camp."},{"left":"You'd better not","right":"touch that hot stove."},{"left":"They had better submit","right":"their applications by Friday."},{"left":"I'd better call the restaurant","right":"to confirm our reservation."}]},{"id":"ex.b2.it-cleft-sentences.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Choose the best answer.","question":"It was the loud music ___ kept me awake all night.","options":["who","which","what"],"answer":1,"explanation":"For things, 'which' or 'that' are used. 'Who' is for people, and 'what' is not used in this structure."},{"id":"ex.b2.it-cleft-sentences.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Choose the best answer.","question":"___ the team leader who suggested the new strategy.","options":["It are","It was","They were"],"answer":1,"explanation":"The 'be' verb must agree with 'It' (singular) and the past tense 'was' is appropriate for a completed action."},{"id":"ex.b2.it-cleft-sentences.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Choose the best answer.","question":"It's the unexpected challenges ___ make life interesting.","options":["who","what","that"],"answer":2,"explanation":"For things, 'that' or 'which' are used. 'Who' is for people, and 'what' is not used in this structure."},{"id":"ex.b2.it-cleft-sentences.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Choose the best answer.","question":"It ___ my neighbor who found my lost cat.","options":["is","are","were"],"answer":0,"explanation":"The verb 'be' must agree with 'It' (singular). 'Is' is the correct present tense form."},{"id":"ex.b2.it-cleft-sentences.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Complete the sentence.","text":"___ was the strong wind ___ knocked down the old tree.","answers":[["It"],["that","which"]],"explanation":"The sentence needs 'It' to start the cleft structure, and 'that' or 'which' to refer to the 'strong wind'."},{"id":"ex.b2.it-cleft-sentences.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Complete the sentence.","text":"___ is the delicious food ___ makes this restaurant so popular.","answers":[["It"],["that","which"]],"explanation":"The sentence needs 'It' to start the cleft structure, and 'that' or 'which' to refer to the 'delicious food'."},{"id":"ex.b2.it-cleft-sentences.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Complete the sentence.","text":"___ was Sarah ___ volunteered to organize the charity event.","answers":[["It"],["who","that"]],"explanation":"The sentence needs 'It' to start the cleft structure, and 'who' or 'that' to refer to 'Sarah' (a person)."},{"id":"ex.b2.it-cleft-sentences.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Put the words in the right order.","answer":["It","was","the","manager","who","approved","the","budget","."],"distractors":["they"],"explanation":"This sentence uses an it-cleft to emphasize 'the manager' as the person who approved the budget."},{"id":"ex.b2.it-cleft-sentences.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Put the words in the right order.","answer":["It's","the","bright","colors","that","make","this","painting","unique","."],"distractors":["which"],"explanation":"This sentence uses an it-cleft to emphasize 'the bright colors' as the reason the painting is unique."},{"id":"ex.b2.it-cleft-sentences.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"It are the small details that often get overlooked.","answers":["It is the small details that often get overlooked."],"explanation":"The verb 'be' in an it-cleft sentence always agrees with 'It' (singular), so 'is' is correct, not 'are'."},{"id":"ex.b2.it-cleft-sentences.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"It was my colleague which helped me with the presentation.","answers":["It was my colleague who helped me with the presentation.","It was my colleague that helped me with the presentation."],"explanation":"For people, use 'who' or 'that' as the relative pronoun, not 'which'."},{"id":"ex.b2.it-cleft-sentences.12","kind":"transformation","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Rewrite the sentence.","source":"The heavy rain caused the flood.","instruction":"Rewrite the sentence to emphasize 'the heavy rain' using an it-cleft.","answers":["It was the heavy rain that caused the flood."],"explanation":"The original sentence is transformed into an it-cleft to highlight 'the heavy rain' as the cause."},{"id":"ex.b2.it-cleft-sentences.13","kind":"transformation","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Rewrite the sentence.","source":"My brother taught me how to play chess.","instruction":"Rewrite the sentence to emphasize 'my brother' using an it-cleft.","answers":["It was my brother who taught me how to play chess.","It was my brother that taught me how to play chess."],"explanation":"The original sentence is transformed into an it-cleft to highlight 'my brother' as the person who taught chess."},{"id":"ex.b2.it-cleft-sentences.14","kind":"matching","level":"B2","grammarPointIds":["gp.it-cleft-sentences"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"It was the unexpected guest","right":"who brought the delicious cake."},{"left":"It's the clear instructions","right":"that make this recipe easy to follow."},{"left":"It was yesterday morning","right":"that we received the good news."},{"left":"It's in the top drawer","right":"that you'll find the spare keys."}]},{"id":"ex.b2.its-time-and-would-rather.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Choose the best answer.","question":"It's time we ___ a new strategy.","options":["discuss","are discussing","discussed","will discuss"],"answer":2,"explanation":"After 'It's time + subject', we use the past simple form of the verb to refer to a present or future action."},{"id":"ex.b2.its-time-and-would-rather.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Choose the best answer.","question":"I'd rather you ___ the meeting until tomorrow.","options":["postpone","postponed","will postpone","are postponing"],"answer":1,"explanation":"To express a preference for someone else's action in the present or future, use 'would rather + subject + past simple'."},{"id":"ex.b2.its-time-and-would-rather.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Choose the best answer.","question":"My parents would rather I ___ a more stable career.","options":["chose","choose","will choose","am choosing"],"answer":0,"explanation":"When expressing a preference for someone else's action, use the past simple form after 'would rather + subject'."},{"id":"ex.b2.its-time-and-would-rather.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Choose the best answer.","question":"Would you rather ___ out tonight or stay in?","options":["to go","went","go","going"],"answer":2,"explanation":"For a personal preference, use 'would rather + base verb' (without 'to')."},{"id":"ex.b2.its-time-and-would-rather.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Complete the sentence.","text":"It's time the government ___ action on climate change.","answers":[["took"]],"explanation":"After 'It's time + subject', use the past simple form 'took' to indicate that action should happen now."},{"id":"ex.b2.its-time-and-would-rather.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Complete the sentence.","text":"I'd rather you ___ me the truth, even if it's difficult.","answers":[["told"]],"explanation":"To express a preference for someone else's action, use 'would rather + subject + past simple'. The past simple of 'tell' is 'told'."},{"id":"ex.b2.its-time-and-would-rather.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Complete the sentence.","text":"My boss ___ rather I ___ the report by Friday.","answers":[["would"],["finished"]],"explanation":"The structure 'would rather + subject + past simple' expresses a preference for someone else's action. 'Would' is the auxiliary, and 'finished' is the past simple of 'finish'."},{"id":"ex.b2.its-time-and-would-rather.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Put the words in the right order.","answer":["It's","time","we","ordered","some","food","."],"explanation":"The correct structure is 'It's time + subject + past simple' to express that something should happen now."},{"id":"ex.b2.its-time-and-would-rather.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Put the words in the right order.","answer":["I'd","rather","you","didn't","wait","for","me","."],"explanation":"To express a preference for someone else's action, use 'would rather + subject + past simple'. The negative form is 'didn't + base verb'."},{"id":"ex.b2.its-time-and-would-rather.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"It's time we start planning our vacation.","answers":["It's time we started planning our vacation."],"explanation":"After 'It's time + subject', use the past simple form of the verb ('started') to refer to a present or future action."},{"id":"ex.b2.its-time-and-would-rather.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"She'd rather he doesn't leave his shoes in the hallway.","answers":["She'd rather he didn't leave his shoes in the hallway."],"explanation":"To express a preference for someone else's action, use 'would rather + subject + past simple'. The negative past simple is 'didn't leave'."},{"id":"ex.b2.its-time-and-would-rather.12","kind":"transformation","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Rewrite the sentence.","source":"We should really go to bed now.","instruction":"Rewrite using 'It's time'.","answers":["It's time we went to bed."],"explanation":"The phrase 'It's time + subject + past simple' expresses that something should happen now. 'Went' is the past simple of 'go'."},{"id":"ex.b2.its-time-and-would-rather.13","kind":"transformation","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Rewrite the sentence.","source":"I prefer that you don't mention this to anyone.","instruction":"Rewrite using 'would rather'.","answers":["I'd rather you didn't mention this to anyone."],"explanation":"To express a preference for someone else's action, use 'would rather + subject + past simple'. The negative past simple is 'didn't mention'."},{"id":"ex.b2.its-time-and-would-rather.14","kind":"matching","level":"B2","grammarPointIds":["gp.its-time-and-would-rather"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"It's time we","right":"cleaned the apartment."},{"left":"I'd rather you","right":"didn't interrupt me."},{"left":"Would you rather I","right":"cooked dinner tonight?"},{"left":"It's time the kids","right":"helped with chores."}]},{"id":"ex.b2.mixed-conditionals.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Choose the best answer.","question":"If I ___ more careful, I wouldn't have broken my phone last week.","options":["were","had been","am","would be"],"answer":0,"explanation":"The 'if' clause describes a present, ongoing condition (being careful) that would have affected a past event. 'Were' is used for hypothetical present conditions."},{"id":"ex.b2.mixed-conditionals.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Choose the best answer.","question":"If she had accepted the promotion, she ___ a manager now.","options":["is","would be","would have been","will be"],"answer":1,"explanation":"The 'if' clause describes a past condition (accepting the promotion) that has a present result. 'Would be' expresses this present hypothetical result."},{"id":"ex.b2.mixed-conditionals.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Choose the best answer.","question":"We ___ lost if you had brought the map.","options":["wouldn't be","aren't","wouldn't have been","won't be"],"answer":0,"explanation":"The 'if' clause describes a past condition (bringing the map) that would prevent a present situation (being lost). 'Wouldn't be' is correct for a present result."},{"id":"ex.b2.mixed-conditionals.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Choose the best answer.","question":"If he ___ so busy, he would have helped us yesterday.","options":["isn't","wasn't","weren't","hadn't been"],"answer":2,"explanation":"The 'if' clause describes a hypothetical present condition (not being busy) that would have affected a past action. 'Weren't' is used for hypothetical present conditions for all subjects."},{"id":"ex.b2.mixed-conditionals.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Complete the sentence.","text":"If I ___ (not have) a meeting, I ___ (come) to your party last night.","answers":[["didn't have","did not have"],["would have come"]],"explanation":"The first gap describes a hypothetical present condition, so 'didn't have' is correct. The second gap describes a past result of that condition, requiring 'would have come'."},{"id":"ex.b2.mixed-conditionals.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Complete the sentence.","text":"If they ___ (take) the earlier train, they ___ (not be) late for work today.","answers":[["had taken"],["wouldn't be","would not be"]],"explanation":"The first gap describes a past condition, so 'had taken' is correct. The second gap describes a present result, requiring 'wouldn't be'."},{"id":"ex.b2.mixed-conditionals.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Complete the sentence.","text":"If she ___ (be) more organized, she ___ (not forget) her passport last week.","answers":[["were"],["wouldn't have forgotten","would not have forgotten"]],"explanation":"The first gap describes a hypothetical present characteristic, so 'were' is correct. The second gap describes a past result, requiring 'wouldn't have forgotten'."},{"id":"ex.b2.mixed-conditionals.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Put the words in the right order.","answer":["If","I","had","saved","money",",","I","would","be","rich","now","."],"distractors":["will","was"],"explanation":"This sentence combines a past condition ('If I had saved money') with a present result ('I would be rich now')."},{"id":"ex.b2.mixed-conditionals.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Put the words in the right order.","answer":["If","he","were","taller",",","he","would","have","joined","the","team","last","year","."],"distractors":["is","had"],"explanation":"This sentence combines a present hypothetical condition ('If he were taller') with a past result ('he would have joined the team last year')."},{"id":"ex.b2.mixed-conditionals.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"If I wasn't so tired, I would have gone to the concert last night.","answers":["If I weren't so tired, I would have gone to the concert last night."],"explanation":"For hypothetical present conditions, 'were' is used for all subjects, including 'I'."},{"id":"ex.b2.mixed-conditionals.12","kind":"transformation","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Rewrite the sentence.","source":"He didn't listen to my advice, so he's in trouble now.","instruction":"Rewrite using a mixed conditional.","answers":["If he had listened to my advice, he wouldn't be in trouble now."],"explanation":"The past action (not listening) caused a present result (being in trouble). The mixed conditional connects these with 'If + past perfect, would + base verb'."},{"id":"ex.b2.mixed-conditionals.13","kind":"transformation","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Rewrite the sentence.","source":"I don't speak French, so I didn't understand the movie.","instruction":"Rewrite using a mixed conditional.","answers":["If I spoke French, I would have understood the movie."],"explanation":"The present condition (not speaking French) affected a past event (not understanding the movie). The mixed conditional connects these with 'If + simple past, would + have + past participle'."},{"id":"ex.b2.mixed-conditionals.14","kind":"matching","level":"B2","grammarPointIds":["gp.mixed-conditionals"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"If I had saved more money,","right":"I wouldn't be struggling financially today."},{"left":"If she were more confident,","right":"she would have applied for that leadership role."},{"left":"If they hadn't missed the flight,","right":"they would be enjoying their vacation right now."},{"left":"If he didn't have a fear of heights,","right":"he would have tried bungee jumping with us."}]},{"id":"ex.b2.modal-perfects-for-deduction.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Choose the best answer.","question":"The ground is completely wet. It ___ rained heavily last night.","options":["might have","can't have","must have"],"answer":2,"explanation":"'Must have' is used for a strong deduction based on clear evidence."},{"id":"ex.b2.modal-perfects-for-deduction.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Choose the best answer.","question":"She looks very happy. She ___ received good news.","options":["can't have","must have","might have"],"answer":1,"explanation":"Her happiness is strong evidence, so 'must have' is the best deduction."},{"id":"ex.b2.modal-perfects-for-deduction.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Choose the best answer.","question":"That restaurant ___ been open yesterday; it was a national holiday.","options":["must have","might have","can't have"],"answer":2,"explanation":"A national holiday makes it highly improbable for the restaurant to be open, so 'can't have' expresses this strong impossibility."},{"id":"ex.b2.modal-perfects-for-deduction.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Put the words in the right order.","answer":["He","must","have","forgotten","his","keys","."],"explanation":"This sentence uses 'must have' to make a strong deduction about a past event."},{"id":"ex.b2.modal-perfects-for-deduction.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Put the words in the right order.","answer":["They","might","have","missed","the","train","."],"explanation":"This sentence uses 'might have' to express a possibility about a past event."},{"id":"ex.b2.modal-perfects-for-deduction.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"She must be left her phone at home.","answers":["She must have left her phone at home."],"explanation":"For past deductions, 'must' is followed by 'have' and the past participle ('left')."},{"id":"ex.b2.modal-perfects-for-deduction.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"They can't had known about the change.","answers":["They can't have known about the change."],"explanation":"The correct structure for past impossibility is 'can't have' followed by the past participle ('known')."},{"id":"ex.b2.modal-perfects-for-deduction.12","kind":"transformation","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Rewrite the sentence.","source":"I'm sure he finished the report.","instruction":"Use the words 'must have'.","answers":["He must have finished the report."],"explanation":"'Must have' expresses strong certainty about a past action."},{"id":"ex.b2.modal-perfects-for-deduction.13","kind":"transformation","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Rewrite the sentence.","source":"Perhaps she didn't receive the message.","instruction":"Rewrite using 'might have'.","answers":["She might not have received the message.","She might have not received the message."],"explanation":"'Might have' expresses a possibility about a past event. The negative can be formed with 'might not have'."},{"id":"ex.b2.modal-perfects-for-deduction.14","kind":"matching","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"The lights are off in their apartment.","right":"They must have gone out."},{"left":"She's not answering her phone.","right":"She might have been busy."},{"left":"The door was unlocked when I arrived.","right":"Someone must have forgotten to lock it."},{"left":"He looks incredibly tired today.","right":"He can't have slept well last night."}]},{"id":"ex.b2.modal-perfects-for-deduction.15","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Choose the best answer.","question":"The restaurant is closed. They ___ decided to take a day off.","options":["must have","can't have","might have","should have"],"answer":0,"explanation":"'Must have' indicates a strong deduction based on the evidence (the restaurant is closed)."},{"id":"ex.b2.modal-perfects-for-deduction.16","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Choose the best answer.","question":"I called her phone, but it went straight to voicemail. She ___ turned it off.","options":["can't have","must have","might have","would have"],"answer":1,"explanation":"'Must have' is used for a strong deduction that she turned off her phone."},{"id":"ex.b2.modal-perfects-for-deduction.17","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Choose the best answer.","question":"He didn't answer my email. He ___ received it.","options":["must have","can't have","might have","should have"],"answer":1,"explanation":"'Can't have' expresses a strong negative deduction, meaning it's highly unlikely he received it."},{"id":"ex.b2.modal-perfects-for-deduction.18","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.modal-perfects-for-deduction"],"prompt":"Choose the best answer.","question":"I'm not sure why she's late. She ___ missed her bus.","options":["must have","can't have","might have","will have"],"answer":2,"explanation":"'Might have' expresses a possibility or guess about why she is late."},{"id":"ex.b2.non-defining-relative-clauses.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.non-defining-relative-clauses"],"prompt":"Choose the best answer.","question":"My neighbor, ___ is a talented artist, painted this portrait.","options":["that","who","which","whose"],"answer":1,"explanation":"\"Who\" is used for people, and the commas indicate that the information is extra."},{"id":"ex.b2.non-defining-relative-clauses.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.non-defining-relative-clauses"],"prompt":"Choose the best answer.","question":"The Amazon River, ___ flows through South America, is the second longest river.","options":["that","where","which","who"],"answer":2,"explanation":"\"Which\" is used for things (like a river), and the commas indicate extra information."},{"id":"ex.b2.non-defining-relative-clauses.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.non-defining-relative-clauses"],"prompt":"Choose the best answer.","question":"We visited the museum, ___ was closed for renovations.","options":["that","where","which","when"],"answer":2,"explanation":"\"Which\" refers to the museum, and the clause provides extra information about it."},{"id":"ex.b2.non-defining-relative-clauses.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.non-defining-relative-clauses"],"prompt":"Choose the best answer.","question":"Sarah, ___ brother is a famous chef, gave me a cooking tip.","options":["who","which","whose","where"],"answer":2,"explanation":"\"Whose\" correctly shows possession, and the clause adds extra information about Sarah."},{"id":"ex.b2.non-defining-relative-clauses.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.non-defining-relative-clauses"],"prompt":"Complete the sentence.","text":"The old bridge, ___ was built in 1880, needs repairs.","answers":[["which"]],"explanation":"\"Which\" refers to the bridge, and the commas indicate extra information."},{"id":"ex.b2.non-defining-relative-clauses.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.non-defining-relative-clauses"],"prompt":"Complete the sentence.","text":"My cousin, ___ lives in Canada, sent me a postcard.","answers":[["who"]],"explanation":"\"Who\" refers to a person, and the commas indicate extra information."},{"id":"ex.b2.non-defining-relative-clauses.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.non-defining-relative-clauses"],"prompt":"Complete the sentence.","text":"The restaurant, ___ we had dinner last night, has amazing reviews.","answers":[["where"]],"explanation":"\"Where\" refers to the place where an action happened, providing extra detail about the restaurant."},{"id":"ex.b2.non-defining-relative-clauses.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.non-defining-relative-clauses"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"My uncle, that lives in Sydney, is coming to visit.","answers":["My uncle, who lives in Sydney, is coming to visit."],"explanation":"\"That\" cannot be used in non-defining relative clauses; \"who\" is correct for people."},{"id":"ex.b2.non-defining-relative-clauses.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.non-defining-relative-clauses"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The ancient city, which was discovered recently needs protection.","answers":["The ancient city, which was discovered recently, needs protection."],"explanation":"A non-defining clause in the middle of a sentence requires a comma before and after it."},{"id":"ex.b2.non-defining-relative-clauses.12","kind":"transformation","level":"B2","grammarPointIds":["gp.non-defining-relative-clauses"],"prompt":"Rewrite the sentence.","source":"My car is a classic model. It often breaks down.","instruction":"Combine these sentences using a non-defining relative clause.","answers":["My car, which is a classic model, often breaks down.","My car, which often breaks down, is a classic model."],"explanation":"The clause \"which is a classic model\" or \"which often breaks down\" adds extra information about \"my car\" and is set off by commas."},{"id":"ex.b2.non-defining-relative-clauses.13","kind":"transformation","level":"B2","grammarPointIds":["gp.non-defining-relative-clauses"],"prompt":"Rewrite the sentence.","source":"I met Anna yesterday. Her sister is a famous musician.","instruction":"Rewrite using 'whose'.","answers":["I met Anna, whose sister is a famous musician, yesterday."],"explanation":"\"Whose\" correctly shows possession, and the clause provides extra information about Anna, separated by commas."},{"id":"ex.b2.non-defining-relative-clauses.14","kind":"matching","level":"B2","grammarPointIds":["gp.non-defining-relative-clauses"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"My brother, who works as a doctor,","right":"is very busy."},{"left":"The old bookstore, which has been there for decades,","right":"is closing next month."},{"left":"Our vacation to Japan, when we saw Mount Fuji,","right":"was truly memorable."},{"left":"The professor, whose research is groundbreaking,","right":"will give a lecture."}]},{"id":"ex.b2.order-of-adjectives.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Choose the best answer.","question":"My aunt gave me a ___ scarf.","options":["silk lovely new","lovely new silk","new lovely silk","silk new lovely"],"answer":1,"explanation":"The correct order is Opinion (lovely), Age (new), Material (silk)."},{"id":"ex.b2.order-of-adjectives.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Choose the best answer.","question":"We visited a ___ castle.","options":["stone ancient impressive","impressive ancient stone","ancient impressive stone","impressive stone ancient"],"answer":1,"explanation":"The correct order is Opinion (impressive), Age (ancient), Material (stone)."},{"id":"ex.b2.order-of-adjectives.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Choose the best answer.","question":"They found a ___ box in the attic.","options":["small old metal","metal small old","old small metal","small metal old"],"answer":0,"explanation":"The correct order is Size (small), Age (old), Material (metal)."},{"id":"ex.b2.order-of-adjectives.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Choose the best answer.","question":"He ordered a ___ coffee table.","options":["round modern glass","glass round modern","modern round glass","round glass modern"],"answer":2,"explanation":"The correct order is Age (modern), Shape/Size (round), Material (glass)."},{"id":"ex.b2.order-of-adjectives.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Complete the sentence.","text":"They bought a ___ ___ ___ rug for their living room.","answers":[["soft","beautiful"],["large"],["wool","Persian"]],"explanation":"The correct order is Opinion (soft), Size (large), Material (wool)."},{"id":"ex.b2.order-of-adjectives.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Complete the sentence.","text":"I saw a ___ ___ ___ car parked outside.","answers":[["shiny"],["new"],["red","black"]],"explanation":"The correct order is Opinion (shiny), Age (new), Color (red)."},{"id":"ex.b2.order-of-adjectives.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"My friend has a big friendly black dog.","answers":["My friend has a friendly big black dog."],"explanation":"Opinion (friendly) should come before Size (big)."},{"id":"ex.b2.order-of-adjectives.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"They found a old beautiful wooden chest.","answers":["They found a beautiful old wooden chest."],"explanation":"Opinion (beautiful) should come before Age (old)."},{"id":"ex.b2.order-of-adjectives.12","kind":"transformation","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Rewrite the sentence.","source":"The vase is made of glass. It's small and pretty.","instruction":"Combine the sentences into one, describing the vase.","answers":["It's a pretty small glass vase.","The vase is a pretty small glass vase."],"explanation":"The correct order is Opinion (pretty), Size (small), Material (glass)."},{"id":"ex.b2.order-of-adjectives.13","kind":"transformation","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Rewrite the sentence.","source":"I need a table. It should be round and wooden.","instruction":"Rewrite the sentence using adjectives before the noun.","answers":["I need a round wooden table."],"explanation":"The correct order is Shape/Size (round), Material (wooden)."},{"id":"ex.b2.order-of-adjectives.14","kind":"matching","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"She bought a charming","right":"old ceramic bowl."},{"left":"He drives a fast","right":"red sports car."},{"left":"They live in a spacious","right":"modern brick apartment."},{"left":"I saw a tiny","right":"blue plastic toy."}]},{"id":"ex.b2.order-of-adjectives.15","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Choose the best answer.","question":"My friend adopted a ___ dog.","options":["friendly big black","big friendly black","black big friendly"],"answer":0,"explanation":"Opinion (friendly) comes before Size (big) and Color (black)."},{"id":"ex.b2.order-of-adjectives.16","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Choose the best answer.","question":"We admired the ___ sculpture.","options":["ancient stone impressive","impressive ancient stone","stone impressive ancient"],"answer":1,"explanation":"Opinion (impressive) comes before Age (ancient) and Material (stone)."},{"id":"ex.b2.order-of-adjectives.17","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Choose the best answer.","question":"The museum acquired a ___ painting.","options":["small old French oil","French small old oil","old small French oil"],"answer":0,"explanation":"Size (small) comes before Age (old), Origin (French), and Material (oil)."},{"id":"ex.b2.order-of-adjectives.18","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.order-of-adjectives"],"prompt":"Choose the best answer.","question":"She wore a ___ hat to the garden party.","options":["straw lovely wide","lovely wide straw","wide lovely straw"],"answer":1,"explanation":"Opinion (lovely) comes before Size (wide) and Material (straw)."},{"id":"ex.b2.participle-clauses.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.participle-clauses"],"prompt":"Choose the best answer.","question":"___ by the strong winds, the old tree finally fell.","options":["Weakening","Weakened","To weaken","Weakens"],"answer":1,"explanation":"The tree was affected by the winds, so the passive past participle 'weakened' is correct."},{"id":"ex.b2.participle-clauses.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.participle-clauses"],"prompt":"Choose the best answer.","question":"___ the instructions carefully, she assembled the furniture without any problems.","options":["Reading","Read","To read","Having read"],"answer":3,"explanation":"'Having read' emphasizes that the action of reading was completed before assembling the furniture."},{"id":"ex.b2.participle-clauses.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.participle-clauses"],"prompt":"Choose the best answer.","question":"The chef prepared the meal, ___ fresh ingredients.","options":["using","used","to use","uses"],"answer":0,"explanation":"The '-ing' form 'using' describes an action happening at the same time or as a consequence of the main action."},{"id":"ex.b2.participle-clauses.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.participle-clauses"],"prompt":"Choose the best answer.","question":"___ from a long journey, he decided to rest for the afternoon.","options":["Tiring","Tired","To tire","Having tired"],"answer":1,"explanation":"'Tired' is the past participle used as an adjective, indicating the reason for his rest."},{"id":"ex.b2.participle-clauses.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.participle-clauses"],"prompt":"Complete the sentence.","text":"The package, ___ (deliver) this morning, contained a new book.","answers":[["delivered"]],"explanation":"The past participle 'delivered' acts as an adjective describing the package, indicating a passive action."},{"id":"ex.b2.participle-clauses.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.participle-clauses"],"prompt":"Put the words in the right order.","answer":["Feeling","unwell",",","she","left","work","early","."],"distractors":["to","had"],"explanation":"The participle clause 'Feeling unwell' explains the reason for her leaving work early."},{"id":"ex.b2.participle-clauses.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.participle-clauses"],"prompt":"Put the words in the right order.","answer":["Built","in","the","19th","century",",","the","bridge","is","a","historic","landmark","."],"distractors":["build","was"],"explanation":"The past participle clause 'Built in the 19th century' provides descriptive information about the bridge."},{"id":"ex.b2.participle-clauses.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.participle-clauses"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Having finish the report, he submitted it to his manager.","answers":["Having finished the report, he submitted it to his manager."],"explanation":"The correct form after 'having' is the past participle 'finished'."},{"id":"ex.b2.participle-clauses.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.participle-clauses"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Opening the door, a strong wind blew in.","answers":["Opening the door, I felt a strong wind blow in.","As I opened the door, a strong wind blew in.","Opening the door, he felt a strong wind blow in."],"explanation":"The subject of 'opening' must be the same as the main clause. The original sentence implies the wind opened the door."},{"id":"ex.b2.participle-clauses.12","kind":"transformation","level":"B2","grammarPointIds":["gp.participle-clauses"],"prompt":"Rewrite the sentence.","source":"Because she was exhausted, she fell asleep quickly.","instruction":"Rewrite using a participle clause.","answers":["Exhausted, she fell asleep quickly.","Being exhausted, she fell asleep quickly."],"explanation":"The past participle 'exhausted' or 'Being exhausted' can replace 'Because she was exhausted' to show reason."},{"id":"ex.b2.participle-clauses.13","kind":"transformation","level":"B2","grammarPointIds":["gp.participle-clauses"],"prompt":"Rewrite the sentence.","source":"He walked into the room and smiled at everyone.","instruction":"Combine the sentences using a participle clause.","answers":["Walking into the room, he smiled at everyone."],"explanation":"The '-ing' participle 'Walking' shows an action happening immediately before or at the same time as the main action."},{"id":"ex.b2.participle-clauses.14","kind":"matching","level":"B2","grammarPointIds":["gp.participle-clauses"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"Not knowing the answer,","right":"I had to guess."},{"left":"Damaged by the storm,","right":"the roof needed repairs."},{"left":"Having studied all night,","right":"she felt prepared for the exam."},{"left":"The car sped away,","right":"leaving a cloud of dust."}]},{"id":"ex.b2.passive-all-tenses.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Choose the best answer.","question":"The old building ___ down next month.","options":["is pulled","will be pulled","has been pulled","is being pulled"],"answer":1,"explanation":"The action is planned for the future, so the future simple passive 'will be pulled' is correct."},{"id":"ex.b2.passive-all-tenses.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Choose the best answer.","question":"The new policy ___ by the board right now.","options":["is discussed","has been discussed","is being discussed","will be discussed"],"answer":2,"explanation":"The phrase 'right now' indicates an ongoing action, requiring the present continuous passive 'is being discussed'."},{"id":"ex.b2.passive-all-tenses.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Choose the best answer.","question":"All the tickets ___ for the concert already.","options":["have sold","have been sold","are selling","will be sold"],"answer":1,"explanation":"The action is completed and has a present result ('already'), so the present perfect passive 'have been sold' is used."},{"id":"ex.b2.passive-all-tenses.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Choose the best answer.","question":"This delicate equipment ___ carefully.","options":["must handle","must be handled","must handling","must handles"],"answer":1,"explanation":"For modal passives, the structure is 'modal + be + past participle', so 'must be handled' is correct."},{"id":"ex.b2.passive-all-tenses.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Complete the sentence.","text":"The new website ___ (design) at the moment.","answers":[["is being designed"]],"explanation":"The phrase 'at the moment' indicates a continuous action, so the present continuous passive 'is being designed' is needed."},{"id":"ex.b2.passive-all-tenses.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Complete the sentence.","text":"All the packages ___ (deliver) by 5 PM today.","answers":[["will be delivered"]],"explanation":"This describes a future action that will be completed by a specific time, requiring the future simple passive 'will be delivered'."},{"id":"ex.b2.passive-all-tenses.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Complete the sentence.","text":"The ancient ruins ___ (can / visit) by tourists every day.","answers":[["can be visited"]],"explanation":"This expresses a possibility or ability, so a modal passive with 'can' is appropriate: 'can be visited'."},{"id":"ex.b2.passive-all-tenses.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Put the words in the right order.","answer":["The","new","library","is","being","built","downtown","."],"distractors":["builds","was"],"explanation":"This sentence uses the present continuous passive to describe an ongoing construction."},{"id":"ex.b2.passive-all-tenses.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The new bridge is being build right now.","answers":["The new bridge is being built right now."],"explanation":"The past participle of 'build' is 'built', not 'build'."},{"id":"ex.b2.passive-all-tenses.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The email should send by the end of the day.","answers":["The email should be sent by the end of the day."],"explanation":"For modal passives, the structure is 'modal + be + past participle'."},{"id":"ex.b2.passive-all-tenses.12","kind":"transformation","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Rewrite the sentence.","source":"Someone is cleaning the office right now.","instruction":"Rewrite in the passive voice.","answers":["The office is being cleaned right now."],"explanation":"To change to passive, the object 'the office' becomes the subject, and the verb changes to 'be' + past participle in the same tense (present continuous)."},{"id":"ex.b2.passive-all-tenses.13","kind":"transformation","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Rewrite the sentence.","source":"They will announce the results tomorrow.","instruction":"Rewrite in the passive voice.","answers":["The results will be announced tomorrow."],"explanation":"The object 'the results' becomes the subject, and the future simple active verb 'will announce' becomes the future simple passive 'will be announced'."},{"id":"ex.b2.passive-all-tenses.14","kind":"matching","level":"B2","grammarPointIds":["gp.passive-all-tenses"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"The new software update","right":"is being rolled out to users."},{"left":"The ancient city walls","right":"have been carefully preserved."},{"left":"All the necessary documents","right":"will be prepared by the assistant."},{"left":"The delicious meal","right":"must be enjoyed while it's hot."}]},{"id":"ex.b2.purpose-clauses.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Choose the best answer.","question":"They started the project early ___ meet the deadline.","options":["so they can","in order to","so that to","for to"],"answer":1,"explanation":"'In order to' is followed by the base form of the verb and correctly expresses purpose here."},{"id":"ex.b2.purpose-clauses.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Choose the best answer.","question":"I'm learning Spanish ___ I can travel more easily in South America.","options":["in order","so that","to order","for that"],"answer":1,"explanation":"'So that' is used with a clause (I can travel) to express purpose."},{"id":"ex.b2.purpose-clauses.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Choose the best answer.","question":"She wore comfortable shoes ___ she could walk around the city all day.","options":["in order","so that","to order to","for"],"answer":1,"explanation":"'So that' correctly introduces the purpose clause with a modal verb."},{"id":"ex.b2.purpose-clauses.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Choose the best answer.","question":"He saved money ___ buy a new bicycle.","options":["so that","in order","in order to","so"],"answer":2,"explanation":"'In order to' is followed by the base verb 'buy' to express purpose."},{"id":"ex.b2.purpose-clauses.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Put the words in the right order.","answer":["He","studies","hard","in","order","to","pass","his","exams","."],"distractors":["for","passing"],"explanation":"This sentence uses 'in order to' to explain the purpose of studying hard."},{"id":"ex.b2.purpose-clauses.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Put the words in the right order.","answer":["She","wears","glasses","so","that","she","can","see","better","."],"distractors":["for","seeing"],"explanation":"This sentence uses 'so that' with a modal verb to explain the purpose of wearing glasses."},{"id":"ex.b2.purpose-clauses.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I called him so I could ask about the meeting.","answers":["I called him so that I could ask about the meeting."],"explanation":"When expressing purpose with 'so', 'that' is usually included, especially with a modal verb."},{"id":"ex.b2.purpose-clauses.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"They arrived early in order to they get good seats.","answers":["They arrived early in order to get good seats."],"explanation":"After 'in order to', use the base form of the verb, not a full clause."},{"id":"ex.b2.purpose-clauses.12","kind":"transformation","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Rewrite the sentence.","source":"He exercises daily so that he can stay healthy.","instruction":"Rewrite using 'in order to'.","answers":["He exercises daily in order to stay healthy."],"explanation":"Both 'so that' and 'in order to' can express purpose. 'In order to' is followed by the base verb."},{"id":"ex.b2.purpose-clauses.13","kind":"transformation","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Rewrite the sentence.","source":"She saved money to buy a new laptop.","instruction":"Rewrite using 'so that'.","answers":["She saved money so that she could buy a new laptop.","She saved money so that she can buy a new laptop."],"explanation":"'So that' introduces a clause with a subject and a modal verb (could/can) to express purpose."},{"id":"ex.b2.purpose-clauses.14","kind":"matching","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I set an alarm","right":"in order to wake up on time."},{"left":"She studies late","right":"so that she can finish her assignments."},{"left":"They wore warm coats","right":"so that they wouldn't get cold."},{"left":"He took a break","right":"in order to clear his mind."}]},{"id":"ex.b2.purpose-clauses.15","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Choose the best answer.","question":"The team held extra meetings ___ everyone understood the new strategy.","options":["in order to","so that","for","to"],"answer":1,"explanation":"'So that' is followed by a clause (subject + verb) to express purpose."},{"id":"ex.b2.purpose-clauses.16","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Choose the best answer.","question":"He took a cooking class ___ learn how to make pasta from scratch.","options":["so that","in order","in order to","for to"],"answer":2,"explanation":"'In order to' is followed by a base verb to express purpose."},{"id":"ex.b2.purpose-clauses.17","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Choose the best answer.","question":"We packed a picnic lunch ___ we wouldn't have to buy food at the park.","options":["in order to","so that","to","for"],"answer":1,"explanation":"'So that' is used with a clause (subject + verb) to show purpose, especially negative purpose."},{"id":"ex.b2.purpose-clauses.18","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.purpose-clauses"],"prompt":"Choose the best answer.","question":"She uses a planner ___ organize her daily tasks efficiently.","options":["so that","in order","in order to","for"],"answer":2,"explanation":"'In order to' is followed by a base verb to state the purpose of an action."},{"id":"ex.b2.remember-stop-try-forget.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Choose the best answer.","question":"I'll never forget ___ my first marathon.","options":["to run","running","run"],"answer":1,"explanation":"'Forget running' refers to a past memory that will never be forgotten."},{"id":"ex.b2.remember-stop-try-forget.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Choose the best answer.","question":"Please remember ___ your passport when you travel.","options":["bringing","to bring","bring"],"answer":1,"explanation":"'Remember to bring' refers to a necessary action for the future."},{"id":"ex.b2.remember-stop-try-forget.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Choose the best answer.","question":"The car started making a strange noise, so I stopped ___ it.","options":["driving","to drive","drive"],"answer":0,"explanation":"'Stopped driving' means ceasing the activity of driving."},{"id":"ex.b2.remember-stop-try-forget.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Choose the best answer.","question":"If you're still hungry, try ___ this new recipe.","options":["to make","making","make"],"answer":1,"explanation":"'Try making' suggests experimenting with a new recipe."},{"id":"ex.b2.remember-stop-try-forget.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Complete the sentence.","text":"I need to remember ___ the plants before I leave for vacation.","answers":[["to water"]],"explanation":"This refers to a future task that needs to be remembered."},{"id":"ex.b2.remember-stop-try-forget.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Complete the sentence.","text":"He tried ___ the heavy box, but it was too heavy. He should try ___ a friend for help.","answers":[["to lift"],["asking"]],"explanation":"'Tried to lift' means making an effort. 'Try asking' means experimenting with a solution."},{"id":"ex.b2.remember-stop-try-forget.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Complete the sentence.","text":"Don't forget ___ your keys when you go out. I remember ___ them on the table this morning.","answers":[["to take"],["seeing","leaving"]],"explanation":"'Forget to take' refers to a future task. 'Remember seeing' refers to a past memory."},{"id":"ex.b2.remember-stop-try-forget.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Put the words in the right order.","answer":["I","stopped","to","buy","some","groceries","."],"distractors":["buying","for"],"explanation":"This sentence means the speaker paused their journey or activity in order to purchase groceries."},{"id":"ex.b2.remember-stop-try-forget.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Put the words in the right order.","answer":["She","will","never","forget","traveling","to","Japan","."],"distractors":["travel"],"explanation":"This means she will always remember the experience of traveling to Japan."},{"id":"ex.b2.remember-stop-try-forget.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Did you remember turning off the lights?","answers":["Did you remember to turn off the lights?"],"explanation":"'Remember to turn off' refers to recalling a task that needed to be done."},{"id":"ex.b2.remember-stop-try-forget.12","kind":"transformation","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Rewrite the sentence.","source":"I paused my work so I could drink some water.","instruction":"Rewrite using 'stop'.","answers":["I stopped to drink some water.","I stopped working to drink some water."],"explanation":"'Stop to drink' means pausing one activity to do another."},{"id":"ex.b2.remember-stop-try-forget.14","kind":"matching","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I remember","right":"seeing that movie last year."},{"left":"Don't forget","right":"to send that email."},{"left":"He stopped","right":"to tie his shoelace."},{"left":"If you have a headache, try","right":"taking some pain relievers."}]},{"id":"ex.b2.remember-stop-try-forget.15","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Choose the best answer.","question":"I'll never forget ___ that incredible meteor shower last night.","options":["to see","seeing","see","saw"],"answer":1,"explanation":"Use the -ing form after 'forget' when referring to a past memory or experience."},{"id":"ex.b2.remember-stop-try-forget.16","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Choose the best answer.","question":"Please remember ___ the oven after you finish baking.","options":["turning off","to turn off","turn off","turned off"],"answer":1,"explanation":"Use the to-infinitive after 'remember' for an action you need to do in the future."},{"id":"ex.b2.remember-stop-try-forget.17","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Choose the best answer.","question":"The car started making a strange noise, so I stopped ___ it.","options":["to drive","driving","drive","drove"],"answer":1,"explanation":"Use the -ing form after 'stop' to indicate ceasing an activity completely."},{"id":"ex.b2.remember-stop-try-forget.18","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.remember-stop-try-forget"],"prompt":"Choose the best answer.","question":"If you can't solve the puzzle, try ___ the pieces differently.","options":["to arrange","arranging","arrange","arranged"],"answer":1,"explanation":"Use the -ing form after 'try' when suggesting an experiment or a different approach."},{"id":"ex.b2.reporting-passive.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Choose the best answer.","question":"It ___ that the company will announce its new product next week.","options":["is expected","expects","expected","is expecting"],"answer":0,"explanation":"The passive structure 'It is expected that' is used to report a general expectation."},{"id":"ex.b2.reporting-passive.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Choose the best answer.","question":"The old bridge ___ to have been built in the 19th century.","options":["is known","knows","is knowing","knew"],"answer":0,"explanation":"The passive structure 'is known to have been built' correctly reports a general belief about a past event."},{"id":"ex.b2.reporting-passive.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Choose the best answer.","question":"She ___ to be a very skilled negotiator.","options":["is said","says","said","is saying"],"answer":0,"explanation":"The passive 'is said to be' is used to report what people generally say about her."},{"id":"ex.b2.reporting-passive.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Choose the best answer.","question":"It is reported ___ the local economy is growing rapidly.","options":["that","to","for","which"],"answer":0,"explanation":"The structure 'It is reported that' introduces a clause with the reported information."},{"id":"ex.b2.reporting-passive.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Put the words in the right order.","answer":["The","manager","is","expected","to","arrive","soon","."],"distractors":["will"],"explanation":"This sentence uses the 'Subject + is expected to + infinitive' structure to report an expectation."},{"id":"ex.b2.reporting-passive.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"It is said him to be a very kind person.","answers":["He is said to be a very kind person."],"explanation":"When reporting about a specific person, that person becomes the subject of the passive verb, not 'it'."},{"id":"ex.b2.reporting-passive.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The new building is thought have been designed by a famous architect.","answers":["The new building is thought to have been designed by a famous architect."],"explanation":"The infinitive form requires 'to' before 'have been designed'."},{"id":"ex.b2.reporting-passive.12","kind":"transformation","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Rewrite the sentence.","source":"People say that the climate is changing rapidly.","instruction":"Rewrite using 'It is said that'.","answers":["It is said that the climate is changing rapidly."],"explanation":"The instruction requires transforming the active 'People say' into the passive 'It is said that'."},{"id":"ex.b2.reporting-passive.13","kind":"transformation","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Rewrite the sentence.","source":"They believe that the ancient city was located near the river.","instruction":"Rewrite using 'The ancient city is believed to...'.","answers":["The ancient city is believed to have been located near the river."],"explanation":"The instruction requires transforming the sentence into the 'Subject + is believed to + perfect infinitive' structure because the action (was located) happened in the past."},{"id":"ex.b2.reporting-passive.14","kind":"matching","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"It is reported that","right":"the flight has been delayed."},{"left":"The new software is expected","right":"to be released next quarter."},{"left":"She is believed","right":"to have won several awards."},{"left":"It is thought that","right":"the universe is constantly expanding."}]},{"id":"ex.b2.reporting-passive.15","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Choose the best answer.","question":"It ___ that the new art exhibit is very popular.","options":["is said","said","says","was saying"],"answer":0,"explanation":"The impersonal passive form 'It is said that' is used to report a general opinion or belief."},{"id":"ex.b2.reporting-passive.16","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Choose the best answer.","question":"The old legend ___ to be true by many locals.","options":["is believed","believes","is believing","believed"],"answer":0,"explanation":"The personal passive structure 'Subject + is believed to' is correct here to report a widely held belief."},{"id":"ex.b2.reporting-passive.17","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Choose the best answer.","question":"It ___ that the company will launch its new product next month.","options":["is expected","expects","expected","was expecting"],"answer":0,"explanation":"The impersonal passive 'It is expected that' is used to report a general expectation or plan."},{"id":"ex.b2.reporting-passive.18","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-passive"],"prompt":"Choose the best answer.","question":"The scientist ___ to have made a significant discovery.","options":["is known","knows","knew","is knowing"],"answer":0,"explanation":"The personal passive structure 'Subject + is known to have + past participle' is used to report a past achievement or fact about the scientist."},{"id":"ex.b2.reporting-verbs.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Choose the best answer.","question":"The manager ___ working overtime to finish the project.","options":["suggested us","suggested to work","suggested working","suggested that working"],"answer":2,"explanation":"'Suggest' is followed by a gerund (verb-ing) or a 'that' clause. \"Suggested working\" is the correct pattern here."},{"id":"ex.b2.reporting-verbs.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Choose the best answer.","question":"He ___ that he had copied the answers.","options":["refused","warned","admitted","suggested"],"answer":2,"explanation":"'Admitted' is the correct verb here, followed by a 'that' clause, indicating he confessed to something."},{"id":"ex.b2.reporting-verbs.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Choose the best answer.","question":"The sign ___ visitors not to touch the exhibits.","options":["refused","denied","warned","admitted"],"answer":2,"explanation":"'Warned' is the correct verb to indicate a caution or advice against doing something, followed by an object and a negative to-infinitive."},{"id":"ex.b2.reporting-verbs.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Choose the best answer.","question":"She ___ to apologize for her rude behavior.","options":["denied","refused","admitted","suggested"],"answer":1,"explanation":"'Refused' is followed by a to-infinitive, meaning she would not apologize."},{"id":"ex.b2.reporting-verbs.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Complete the sentence.","text":"The doctor ___ me ___ too much sugar.","answers":[["warned"],["not to eat","against eating"]],"explanation":"'Warn' can be followed by an object and a (negative) to-infinitive to advise against an action."},{"id":"ex.b2.reporting-verbs.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Put the words in the right order.","answer":["He","denied","ever","seeing","the","woman","."],"distractors":["to","said"],"explanation":"The correct structure for 'deny' is followed by a gerund (verb-ing). 'Ever' is an adverb modifying 'seeing'."},{"id":"ex.b2.reporting-verbs.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Put the words in the right order.","answer":["She","suggested","that","we","should","take","a","break","."],"distractors":["to","for"],"explanation":"'Suggest' can be followed by a 'that' clause, often with 'should' (which can also be omitted)."},{"id":"ex.b2.reporting-verbs.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The teacher warned the students about to cheat on the exam.","answers":["The teacher warned the students not to cheat on the exam.","The teacher warned the students about cheating on the exam."],"explanation":"'Warn' can take an object + to-infinitive (often negative) or 'about' + gerund/noun. \"About to cheat\" is incorrect."},{"id":"ex.b2.reporting-verbs.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"My friend refused helping me move the heavy boxes.","answers":["My friend refused to help me move the heavy boxes."],"explanation":"'Refuse' is always followed by a to-infinitive, not a gerund."},{"id":"ex.b2.reporting-verbs.12","kind":"transformation","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Rewrite the sentence.","source":"\"No, I didn't break the vase,\" said Tom.","instruction":"Rewrite using 'deny'.","answers":["Tom denied breaking the vase.","Tom denied that he had broken the vase."],"explanation":"'Deny' can be followed by a gerund or a 'that' clause to report a negative statement."},{"id":"ex.b2.reporting-verbs.13","kind":"transformation","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Rewrite the sentence.","source":"\"You should check your tires before the trip,\" she told me.","instruction":"Rewrite using 'suggest'.","answers":["She suggested checking my tires before the trip.","She suggested that I check my tires before the trip.","She suggested that I should check my tires before the trip."],"explanation":"'Suggest' can be followed by a gerund or a 'that' clause (with or without 'should')."},{"id":"ex.b2.reporting-verbs.14","kind":"matching","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"He admitted","right":"to feeling nervous before the presentation."},{"left":"The lifeguard warned us","right":"not to swim too far from the shore."},{"left":"I refused","right":"to discuss the matter any further."},{"left":"They suggested","right":"ordering pizza for dinner tonight."}]},{"id":"ex.b2.reporting-verbs.15","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Choose the best answer.","question":"The children ___ playing with the broken toy.","options":["refused","warned","denied","suggested"],"answer":2,"explanation":"'Deny' is followed by a gerund (-ing form), which fits 'playing'."},{"id":"ex.b2.reporting-verbs.16","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Choose the best answer.","question":"My friend ___ to lend me any more money.","options":["admitted","refused","suggested","denied"],"answer":1,"explanation":"'Refuse' is followed by a 'to' + infinitive, which fits 'to lend'."},{"id":"ex.b2.reporting-verbs.17","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Choose the best answer.","question":"The doctor ___ me ___ too much sugar.","options":["suggested / eating","admitted / eating","warned / not to eat","denied / eating"],"answer":2,"explanation":"'Warn' with an object is followed by 'not to' + infinitive when advising against something."},{"id":"ex.b2.reporting-verbs.18","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.reporting-verbs"],"prompt":"Choose the best answer.","question":"She ___ that she had forgotten her keys at home.","options":["refused","warned","suggested","admitted"],"answer":3,"explanation":"'Admit' can be followed by a 'that' clause, which fits the sentence structure."},{"id":"ex.b2.should-have-and-could-have.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Choose the best answer.","question":"I didn't bring an umbrella, and now I'm wet. I ___ brought one.","options":["could bring","should have brought","could have bring","should bring"],"answer":1,"explanation":"'Should have brought' expresses regret about not doing something that would have been a good idea."},{"id":"ex.b2.should-have-and-could-have.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Choose the best answer.","question":"We ___ gone to the mountains, but we decided to stay home instead.","options":["should go","could have gone","should have go","could go"],"answer":1,"explanation":"'Could have gone' indicates a past possibility or alternative that was available but not chosen."},{"id":"ex.b2.should-have-and-could-have.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Choose the best answer.","question":"You ___ told me you were coming. I would have prepared dinner.","options":["should tell","could tell","should have told","could have tell"],"answer":2,"explanation":"'Should have told' expresses criticism or regret that the person didn't inform them."},{"id":"ex.b2.should-have-and-could-have.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Choose the best answer.","question":"The team played poorly. They ___ won the game.","options":["could have","should have","could have won","should have win"],"answer":2,"explanation":"'Could have won' suggests that winning was a possibility, but it didn't happen due to their poor performance."},{"id":"ex.b2.should-have-and-could-have.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Complete the sentence.","text":"He ___ (call) me earlier if he needed help.","answers":[["could have called"]],"explanation":"'Could have called' indicates a missed opportunity for him to get help."},{"id":"ex.b2.should-have-and-could-have.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Complete the sentence.","text":"I ___ (not / eat) so much cake. Now I feel sick.","answers":[["shouldn't have eaten","should not have eaten"]],"explanation":"'Shouldn't have eaten' expresses regret about a past action."},{"id":"ex.b2.should-have-and-could-have.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Complete the sentence.","text":"They ___ (arrive) on time, but their flight was delayed.","answers":[["should have arrived","could have arrived"]],"explanation":"'Should have arrived' suggests that arriving on time was the expected or planned outcome, but it didn't happen."},{"id":"ex.b2.should-have-and-could-have.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Put the words in the right order.","answer":["You","should","have","listened","to","my","advice","."],"distractors":["will","listen"],"explanation":"This sentence expresses criticism or regret that the person didn't follow the advice."},{"id":"ex.b2.should-have-and-could-have.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Put the words in the right order.","answer":["We","could","have","visited","the","museum","."],"distractors":["can","visit"],"explanation":"This sentence indicates a missed opportunity or an alternative activity that was possible."},{"id":"ex.b2.should-have-and-could-have.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I should of told her the truth.","answers":["I should have told her the truth."],"explanation":"The correct auxiliary verb is 'have', not 'of'."},{"id":"ex.b2.should-have-and-could-have.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"He could went to the party if he wanted.","answers":["He could have gone to the party if he wanted."],"explanation":"After 'could have', we need the past participle form of the verb, which is 'gone'."},{"id":"ex.b2.should-have-and-could-have.12","kind":"transformation","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Rewrite the sentence.","source":"It was a mistake not to book tickets in advance.","instruction":"Rewrite using 'should have'.","answers":["I should have booked tickets in advance."],"explanation":"The original sentence expresses regret, which 'should have' conveys perfectly."},{"id":"ex.b2.should-have-and-could-have.13","kind":"transformation","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Rewrite the sentence.","source":"There was a chance for us to see the northern lights, but we missed it.","instruction":"Rewrite using 'could have'.","answers":["We could have seen the northern lights."],"explanation":"'Could have' is used to express a missed opportunity or possibility in the past."},{"id":"ex.b2.should-have-and-could-have.14","kind":"matching","level":"B2","grammarPointIds":["gp.should-have-and-could-have"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I should have","right":"worn a warmer coat."},{"left":"They could have","right":"finished the project on time."},{"left":"You shouldn't have","right":"eaten all the cookies."},{"left":"We couldn't have","right":"known about the traffic jam."}]},{"id":"ex.b2.the-more-the-better.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Choose the best answer.","question":"___ you practice, ___ you'll improve.","options":["The more / the more","More / more","The most / the most","More / the more"],"answer":0,"explanation":"Both parts of the structure require \"the\" followed by a comparative."},{"id":"ex.b2.the-more-the-better.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Choose the best answer.","question":"___ the project gets, ___ details we need to consider.","options":["The bigger / the more","Bigger / more","The biggest / the most","The bigger / more"],"answer":0,"explanation":"Both parts of the structure require \"the\" followed by a comparative."},{"id":"ex.b2.the-more-the-better.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Choose the best answer.","question":"___ you wait, ___ difficult it will be to find tickets.","options":["The longer / the more","Longer / more","The longest / the most","The longer / more"],"answer":0,"explanation":"Both parts of the structure require \"the\" followed by a comparative."},{"id":"ex.b2.the-more-the-better.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Choose the best answer.","question":"___ money you spend on quality, ___ you save in the long run.","options":["The more / the more","More / more","The most / the most","The more / more"],"answer":0,"explanation":"Both parts of the structure require \"the\" followed by a comparative."},{"id":"ex.b2.the-more-the-better.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Complete the sentence.","text":"___ colder it gets, ___ more layers I need to wear.","answers":[["The"],["the"]],"explanation":"Both clauses need \"the\" before the comparative to show a proportional relationship."},{"id":"ex.b2.the-more-the-better.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Complete the sentence.","text":"___ more experience you gain, ___ confident you become.","answers":[["The"],["the more"]],"explanation":"Both parts of the structure require \"the\" followed by a comparative."},{"id":"ex.b2.the-more-the-better.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Put the words in the right order.","answer":["The","harder","you","work",",","the","greater","your","reward","."],"distractors":["most","best"],"explanation":"This structure shows that increased effort leads to a larger reward."},{"id":"ex.b2.the-more-the-better.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Put the words in the right order.","answer":["The","more","I","travel",",","the","more","I","appreciate","my","home","."],"distractors":["most","much"],"explanation":"This sentence expresses that increased travel leads to a greater appreciation for home."},{"id":"ex.b2.the-more-the-better.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The more money I earn, more I can save.","answers":["The more money I earn, the more I can save."],"explanation":"The second part of the double comparative also needs \"the.\""},{"id":"ex.b2.the-more-the-better.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The faster you drive, the most dangerous it is.","answers":["The faster you drive, the more dangerous it is."],"explanation":"Use the comparative form \"more dangerous,\" not the superlative \"most dangerous.\""},{"id":"ex.b2.the-more-the-better.12","kind":"transformation","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Rewrite the sentence.","source":"If you start early, you will finish early.","instruction":"Combine these ideas using \"The..., the...\" structure.","answers":["The earlier you start, the earlier you will finish."],"explanation":"The structure \"The + comparative, the + comparative\" shows how two things change together."},{"id":"ex.b2.the-more-the-better.13","kind":"transformation","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Rewrite the sentence.","source":"When the price goes up, demand goes down.","instruction":"Rewrite this sentence using \"The..., the...\" structure.","answers":["The higher the price, the lower the demand."],"explanation":"This structure effectively shows a proportional inverse relationship between price and demand."},{"id":"ex.b2.the-more-the-better.14","kind":"matching","level":"B2","grammarPointIds":["gp.the-more-the-better"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"The higher the quality,","right":"the more expensive it is."},{"left":"The more sleep you get,","right":"the better you'll feel."},{"left":"The less time we have,","right":"the faster we need to work."},{"left":"The more people who attend,","right":"the more lively the event will be."}]},{"id":"ex.b2.third-conditional.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Choose the best answer.","question":"If he ___ the instructions carefully, he ___ the recipe correctly.","options":["had followed, would have made","followed, would make","would have followed, had made","had followed, would make"],"answer":0,"explanation":"The 'if' clause requires the past perfect ('had followed'), and the main clause requires 'would have' + past participle ('would have made')."},{"id":"ex.b2.third-conditional.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Choose the best answer.","question":"We ___ the bus if we ___ the house five minutes earlier.","options":["would have caught, had left","had caught, would have left","would catch, left","caught, would leave"],"answer":0,"explanation":"The main clause describes the imagined result ('would have caught'), and the 'if' clause describes the imagined past condition ('had left')."},{"id":"ex.b2.third-conditional.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Choose the best answer.","question":"If I ___ more time, I ___ that book you recommended.","options":["had had, would have read","had, would read","would have had, had read","have had, would read"],"answer":0,"explanation":"The 'if' clause needs the past perfect ('had had'), and the main clause needs 'would have' + past participle ('would have read')."},{"id":"ex.b2.third-conditional.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Choose the best answer.","question":"What ___ if you ___ the lottery last year?","options":["would you have done, had won","would you do, won","had you done, would have won","would you have done, would have won"],"answer":0,"explanation":"The question uses 'would have done' for the imagined result, and the 'if' clause uses the past perfect 'had won' for the imagined past condition."},{"id":"ex.b2.third-conditional.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Complete the sentence.","text":"If she ___ (not miss) the train, she ___ (arrive) on time for the meeting.","answers":[["hadn't missed","had not missed"],["would have arrived","would've arrived"]],"explanation":"The 'if' clause needs the past perfect negative ('hadn't missed'), and the main clause needs 'would have' + past participle ('would have arrived')."},{"id":"ex.b2.third-conditional.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Complete the sentence.","text":"They ___ (not get) lost if they ___ (use) a GPS.","answers":[["wouldn't have gotten","would not have gotten","wouldn't have got","would not have got"],["had used"]],"explanation":"The main clause describes the imagined negative result ('wouldn't have gotten lost'), and the 'if' clause describes the imagined past action ('had used')."},{"id":"ex.b2.third-conditional.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Complete the sentence.","text":"If I ___ (know) you were coming, I ___ (bake) a cake.","answers":[["had known"],["would have baked","would've baked"]],"explanation":"The 'if' clause requires the past perfect ('had known'), and the main clause requires 'would have' + past participle ('would have baked')."},{"id":"ex.b2.third-conditional.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Put the words in the right order.","answer":["If","we","had","left","earlier",",","we","would","have","avoided","the","traffic","."],"distractors":["will","avoid"],"explanation":"This sentence correctly forms a third conditional, describing an imagined past action and its hypothetical result."},{"id":"ex.b2.third-conditional.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Put the words in the right order.","answer":["She","wouldn't","have","been","tired","if","she","had","slept","more","."],"distractors":["sleeps","is"],"explanation":"This sentence correctly uses the third conditional to express an imagined past condition and its hypothetical outcome."},{"id":"ex.b2.third-conditional.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"If I would have seen him, I would have said hello.","answers":["If I had seen him, I would have said hello."],"explanation":"The 'if' clause in the third conditional must use the past perfect ('had seen'), not 'would have seen'."},{"id":"ex.b2.third-conditional.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"They would have won the game if they practiced harder.","answers":["They would have won the game if they had practiced harder."],"explanation":"The 'if' clause in the third conditional requires the past perfect ('had practiced'), not the simple past."},{"id":"ex.b2.third-conditional.12","kind":"transformation","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Rewrite the sentence.","source":"He didn't save money, so he couldn't buy the new car.","instruction":"Rewrite using the third conditional.","answers":["If he had saved money, he would have bought the new car."],"explanation":"The original sentence describes a past reality. The third conditional imagines the opposite past action ('had saved money') and its hypothetical result ('would have bought')."},{"id":"ex.b2.third-conditional.13","kind":"transformation","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Rewrite the sentence.","source":"I didn't bring an umbrella, and I got wet.","instruction":"Rewrite using the third conditional.","answers":["If I had brought an umbrella, I wouldn't have gotten wet.","If I had brought an umbrella, I wouldn't have got wet."],"explanation":"The third conditional expresses an imagined past action ('had brought an umbrella') and its hypothetical negative result ('wouldn't have gotten wet')."},{"id":"ex.b2.third-conditional.14","kind":"matching","level":"B2","grammarPointIds":["gp.third-conditional"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"If I had saved more money,","right":"I would have bought that car."},{"left":"If she hadn't forgotten her passport,","right":"she wouldn't have missed her flight."},{"left":"We would have finished earlier","right":"if we had started on time."},{"left":"They wouldn't have gotten lost","right":"if they had used a map."}]},{"id":"ex.b2.unless-and-as-long-as.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.unless-and-as-long-as"],"prompt":"Choose the best answer.","question":"You can borrow my bike ___ you promise to return it tomorrow.","options":["unless","as long as","if not"],"answer":1,"explanation":"'As long as' correctly expresses the condition that must be met for the bike to be borrowed."},{"id":"ex.b2.unless-and-as-long-as.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.unless-and-as-long-as"],"prompt":"Choose the best answer.","question":"We won't start the movie ___ everyone arrives.","options":["as long as","provided that","unless"],"answer":2,"explanation":"'Unless' means 'if not,' so the movie won't start if everyone hasn't arrived yet."},{"id":"ex.b2.unless-and-as-long-as.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.unless-and-as-long-as"],"prompt":"Choose the best answer.","question":"___ you have a valid ticket, you cannot enter the concert.","options":["Provided that","As long as","Unless"],"answer":2,"explanation":"'Unless' means 'if not,' so if you don't have a ticket, you can't enter."},{"id":"ex.b2.unless-and-as-long-as.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.unless-and-as-long-as"],"prompt":"Choose the best answer.","question":"The company will offer you the job ___ you pass the final interview.","options":["unless","as long as","if"],"answer":1,"explanation":"'As long as' sets a strong condition for getting the job offer."},{"id":"ex.b2.unless-and-as-long-as.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.unless-and-as-long-as"],"prompt":"Complete the sentence.","text":"I won't go to the party ___ you go with me.","answers":[["unless"]],"explanation":"'Unless' means 'if not,' so the speaker won't go if the other person doesn't go."},{"id":"ex.b2.unless-and-as-long-as.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.unless-and-as-long-as"],"prompt":"Complete the sentence.","text":"___ the weather improves, we'll have to cancel the outdoor event.","answers":[["Unless"]],"explanation":"'Unless' means 'if not,' so if the weather doesn't improve, the event will be canceled."},{"id":"ex.b2.unless-and-as-long-as.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.unless-and-as-long-as"],"prompt":"Put the words in the right order.","answer":["You","can","stay","here","as","long","as","you","are","quiet","."],"distractors":["always","then"],"explanation":"This sentence uses 'as long as' to state a condition for staying."},{"id":"ex.b2.unless-and-as-long-as.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.unless-and-as-long-as"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Unless you don't bring your ID, you can't enter.","answers":["Unless you bring your ID, you can't enter."],"explanation":"'Unless' already implies 'if not,' so 'don't' is redundant and creates a double negative."},{"id":"ex.b2.unless-and-as-long-as.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.unless-and-as-long-as"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I'll help you, provided you promise to keep it a secret.","answers":["I'll help you, provided that you promise to keep it a secret.","I'll help you, providing that you promise to keep it a secret."],"explanation":"The full phrase is 'provided that' or 'providing that' when introducing a condition."},{"id":"ex.b2.unless-and-as-long-as.12","kind":"transformation","level":"B2","grammarPointIds":["gp.unless-and-as-long-as"],"prompt":"Rewrite the sentence.","source":"If you don't apologize, she won't forgive you.","instruction":"Rewrite using 'unless'.","answers":["Unless you apologize, she won't forgive you."],"explanation":"'Unless' replaces 'if not' to express the same negative condition."},{"id":"ex.b2.unless-and-as-long-as.13","kind":"transformation","level":"B2","grammarPointIds":["gp.unless-and-as-long-as"],"prompt":"Rewrite the sentence.","source":"You can borrow my car only if you have a valid driver's license.","instruction":"Rewrite using 'as long as'.","answers":["You can borrow my car as long as you have a valid driver's license."],"explanation":"'As long as' expresses a strong, necessary condition, similar to 'only if'."},{"id":"ex.b2.unless-and-as-long-as.14","kind":"matching","level":"B2","grammarPointIds":["gp.unless-and-as-long-as"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"Unless you study hard,","right":"you won't pass the exam."},{"left":"You can use my phone","right":"as long as you don't break it."},{"left":"Provided that the weather is clear,","right":"we'll see the stars tonight."},{"left":"I won't eat this dish","right":"unless it's vegetarian."}]},{"id":"ex.b2.wish-and-if-only.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Choose the best answer.","question":"I wish I ___ a bigger apartment; this one is too small.","options":["have","had","would have","will have"],"answer":1,"explanation":"For wishes about the present, we use the past simple tense. 'Had' is the past simple of 'have'."},{"id":"ex.b2.wish-and-if-only.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Choose the best answer.","question":"If only I ___ the train, I wouldn't be late for work.","options":["didn't miss","hadn't missed","wouldn't miss","don't miss"],"answer":1,"explanation":"This expresses regret about a past event (missing the train), so we use the past perfect tense."},{"id":"ex.b2.wish-and-if-only.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Choose the best answer.","question":"My parents wish I ___ them more often.","options":["call","called","would call","had called"],"answer":2,"explanation":"When wishing for someone else's behavior to change, especially if there's a hint of annoyance or desire for action, we use 'would + base verb'."},{"id":"ex.b2.wish-and-if-only.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Choose the best answer.","question":"I wish I ___ about the party sooner; I missed all the fun!","options":["knew","had known","would know","know"],"answer":1,"explanation":"This is a regret about not knowing something in the past, so the past perfect 'had known' is correct."},{"id":"ex.b2.wish-and-if-only.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Complete the sentence.","text":"If only I ___ (be) taller, I could reach that shelf.","answers":[["were","was"]],"explanation":"For wishes about the present, we use the past simple. 'Were' is often preferred for 'be' in hypothetical situations, but 'was' is also common."},{"id":"ex.b2.wish-and-if-only.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Complete the sentence.","text":"He wishes he ___ (not spend) so much money on that old car.","answers":[["hadn't spent","had not spent"]],"explanation":"This expresses regret about a past action, so the past perfect negative 'hadn't spent' is used."},{"id":"ex.b2.wish-and-if-only.07","kind":"gap_fill","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Complete the sentence.","text":"I wish the children ___ (play) more quietly.","answers":[["would play"]],"explanation":"This expresses a desire for someone else's behavior to change, so 'would + base verb' is appropriate."},{"id":"ex.b2.wish-and-if-only.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Put the words in the right order.","answer":["I","wish","I","had","a","dog","."],"distractors":["have"],"explanation":"This sentence expresses a wish about a present situation using 'wish + past simple'."},{"id":"ex.b2.wish-and-if-only.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Put the words in the right order.","answer":["If","only","they","hadn't","left","so","early","."],"distractors":["didn't"],"explanation":"This sentence expresses regret about a past action using 'if only + past perfect'."},{"id":"ex.b2.wish-and-if-only.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I wish I would speak Spanish.","answers":["I wish I spoke Spanish."],"explanation":"We use the past simple (spoke) for wishes about our own present abilities, not 'would speak'."},{"id":"ex.b2.wish-and-if-only.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"She wishes she didn't forget her passport.","answers":["She wishes she hadn't forgotten her passport."],"explanation":"For regrets about the past, we use the past perfect tense ('hadn't forgotten')."},{"id":"ex.b2.wish-and-if-only.12","kind":"transformation","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Rewrite the sentence.","source":"It's a shame I don't live closer to the beach.","instruction":"Rewrite using 'I wish'.","answers":["I wish I lived closer to the beach."],"explanation":"To express a wish about a present situation, use 'wish + past simple'."},{"id":"ex.b2.wish-and-if-only.13","kind":"transformation","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Rewrite the sentence.","source":"I regret not telling him the truth.","instruction":"Rewrite using 'If only'.","answers":["If only I had told him the truth."],"explanation":"To express regret about a past action, use 'if only + past perfect'."},{"id":"ex.b2.wish-and-if-only.14","kind":"matching","level":"B2","grammarPointIds":["gp.wish-and-if-only"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I wish I","right":"had more free time."},{"left":"If only I","right":"hadn't lost my keys."},{"left":"She wishes her brother","right":"would visit more often."},{"left":"They wish it","right":"weren't so cold today."}]},{"id":"ex.b2.would-for-past-habits.01","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Choose the best answer.","question":"When I was a kid, I ___ spend hours building LEGO castles.","options":["would","used","was used to","would to"],"answer":0,"explanation":"'Would' is used here to describe a repeated action or habit in the past. 'Used' alone is incomplete, 'was used to' means accustomed to, and 'would to' is incorrect."},{"id":"ex.b2.would-for-past-habits.02","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Choose the best answer.","question":"My aunt ___ live in that house before she moved to the city.","options":["would","used to","would to","was used to"],"answer":1,"explanation":"'Live' is a state verb, so 'used to' must be used to describe a past state. 'Would' cannot be used for states."},{"id":"ex.b2.would-for-past-habits.03","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Choose the best answer.","question":"Every Sunday, my dad ___ make pancakes for breakfast.","options":["used","would","was used to","would to"],"answer":1,"explanation":"'Would' is correct for a repeated action or habit in the past. 'Used' is incomplete, 'was used to' means accustomed to, and 'would to' is incorrect."},{"id":"ex.b2.would-for-past-habits.04","kind":"multiple_choice","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Choose the best answer.","question":"Which sentence correctly uses 'would' for a past habit?","options":["She would know all the answers.","They would be very tall.","He would often bring flowers to his mother.","We would own a small boat."],"answer":2,"explanation":"'Bring' is an action verb, so 'would' correctly describes a repeated past action. 'Know,' 'be,' and 'own' are state verbs, which require 'used to'."},{"id":"ex.b2.would-for-past-habits.05","kind":"gap_fill","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Complete the sentence.","text":"Before smartphones, people ___ often carry paper maps when traveling.","answers":[["would"]],"explanation":"'Would' is used for a repeated action in the past. 'Used to' would also be correct here, but only 'would' is provided as an option for this exercise."},{"id":"ex.b2.would-for-past-habits.06","kind":"gap_fill","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Complete the sentence.","text":"When I was a student, I ___ always ___ my homework right after school.","answers":[["would"],["do"]],"explanation":"'Would' is followed by the base form of the verb to describe a repeated past action."},{"id":"ex.b2.would-for-past-habits.08","kind":"sentence_building","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Put the words in the right order.","answer":["On","weekends",",","we","would","go","hiking","."],"distractors":["went","used"],"explanation":"This sentence uses 'would' to describe a repeated action (going hiking) that happened regularly on weekends in the past."},{"id":"ex.b2.would-for-past-habits.09","kind":"sentence_building","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Put the words in the right order.","answer":["My","cat","would","always","sleep","on","my","desk","."],"distractors":["slept","used"],"explanation":"This sentence uses 'would' to describe a repeated action (sleeping on the desk) that the cat habitually did in the past."},{"id":"ex.b2.would-for-past-habits.10","kind":"error_correction","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"When I was young, I would have long hair.","answers":["When I was young, I used to have long hair."],"explanation":"'Have' is a state verb, so 'used to' is required instead of 'would' to describe a past state."},{"id":"ex.b2.would-for-past-habits.11","kind":"error_correction","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Every morning, the baker would baked fresh bread.","answers":["Every morning, the baker would bake fresh bread."],"explanation":"After 'would', the base form of the verb is always used, not the past participle or simple past."},{"id":"ex.b2.would-for-past-habits.12","kind":"transformation","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Rewrite the sentence.","source":"My neighbors always invited us for dinner on Fridays.","instruction":"Rewrite using 'would' for a past habit.","answers":["My neighbors would always invite us for dinner on Fridays."],"explanation":"The instruction requires changing the simple past 'invited' to 'would invite' to express a repeated past action."},{"id":"ex.b2.would-for-past-habits.13","kind":"transformation","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Rewrite the sentence.","source":"I used to play soccer every afternoon after school.","instruction":"Rewrite using 'would' if possible.","answers":["I would play soccer every afternoon after school."],"explanation":"Since 'play' is an action verb, 'used to play' can be replaced with 'would play' to describe a repeated past action."},{"id":"ex.b2.would-for-past-habits.14","kind":"matching","level":"B2","grammarPointIds":["gp.would-for-past-habits"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"Before the internet, people would often","right":"write letters to friends and family."},{"left":"My old car would always","right":"break down on long trips."},{"left":"When we lived by the lake, we would","right":"go swimming every morning."},{"left":"My grandmother would never","right":"miss her favorite TV show."}]},{"id":"ex.vocab.abandon","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"abandon","back":"(verb) To leave a place, thing, or person forever, or to stop doing something.","example":{"text":"We had to abandon our plan.","source":{"kind":"tatoeba","sentenceId":23025,"author":"CK"}},"audio":"audio/cb25a5abeba317a0.m4a"},{"id":"ex.vocab.absence","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"absence","back":"(noun) The state of being away from a place or situation.","example":{"text":"After an absence of ten months, he returned home.","source":{"kind":"tatoeba","sentenceId":73471,"author":"CM"}},"audio":"audio/a39d032f9f3971f6.m4a"},{"id":"ex.vocab.absolute","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"absolute","back":"(adjective) Complete and total; not limited in any way.","example":{"text":"That is an absolute lie.","source":{"kind":"tatoeba","sentenceId":1834046,"author":"LanguageExpert"}},"audio":"audio/b2c53737a09b2015.m4a"},{"id":"ex.vocab.absurd","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"absurd","back":"(adjective) Completely unreasonable, illogical, or ridiculous.","example":{"text":"The idea struck me as absurd.","source":{"kind":"tatoeba","sentenceId":47970,"author":"CM"}},"audio":"audio/6280659b66f2d8e3.m4a"},{"id":"ex.vocab.abuse","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"abuse","back":"(noun) The use of something in a bad or wrong way, or cruel and violent treatment.","example":{"text":"It's an abuse of power.","source":{"kind":"tatoeba","sentenceId":4530062,"author":"CK"}},"audio":"audio/70b0ca99c00cb4bc.m4a"},{"id":"ex.vocab.academic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"academic","back":"(adjective) Relating to schools, colleges, and universities, or to studying.","example":{"text":"His academic achievements are impressive.","source":{"kind":"tatoeba","sentenceId":285790,"author":"CM"}},"audio":"audio/1d10d7f775dd647a.m4a"},{"id":"ex.vocab.accompany","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"accompany","back":"(verb) To go somewhere with someone, or to happen at the same time as something else.","example":{"text":"I accompanied her on a walk.","source":{"kind":"tatoeba","sentenceId":261087,"author":"CK"}},"audio":"audio/c4c59b113a9cd7ac.m4a"},{"id":"ex.vocab.accomplish","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"accomplish","back":"(verb) To succeed in doing something after planning or trying hard.","example":{"text":"We are very proud of what we have accomplished.","source":{"kind":"tatoeba","sentenceId":2753470,"author":"Hybrid"}},"audio":"audio/4a476545ca1cc1ea.m4a"},{"id":"ex.vocab.accurate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"accurate","back":"(adjective) Correct in all details; exact.","example":{"text":"I think your answer is accurate.","source":{"kind":"tatoeba","sentenceId":5215804,"author":"AlanF_US"}},"audio":"audio/3fca8ead140592b8.m4a"},{"id":"ex.vocab.accusation","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"accusation","back":"(noun) A statement saying that someone has done something wrong or illegal.","example":{"text":"This is a serious accusation.","source":{"kind":"tatoeba","sentenceId":6735988,"author":"Hybrid"}},"audio":"audio/6af651302c6a329e.m4a"},{"id":"ex.vocab.accuse","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"accuse","back":"(verb) To say that someone has done something wrong or is guilty of a crime.","example":{"text":"He was accused of theft.","source":{"kind":"tatoeba","sentenceId":292330,"author":"CK"}},"audio":"audio/276f7af2fe60dffa.m4a"},{"id":"ex.vocab.accustomed","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"accustomed","back":"(adjective) familiar with something so that it seems normal or usual.","example":{"text":"You will soon get accustomed to living in this country.","source":{"kind":"tatoeba","sentenceId":52247,"author":"CK"}},"audio":"audio/55aac9c62df6e9fc.m4a"},{"id":"ex.vocab.acid","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"acid","back":"(noun) A chemical substance that is sour, corrosive, and reacts with metals.","example":{"text":"There is acid in lemon.","source":{"kind":"tatoeba","sentenceId":7794383,"author":"sharris123"}},"audio":"audio/d499dc77f9cd1d24.m4a"},{"id":"ex.vocab.acknowledge","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"acknowledge","back":"(verb) To accept or admit the truth or existence of something.","example":{"text":"Tom acknowledged making a mistake.","source":{"kind":"tatoeba","sentenceId":2955463,"author":"CK"}},"audio":"audio/6b7d30e39964abbe.m4a"},{"id":"ex.vocab.acquaint","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"acquaint","back":"(verb) To make someone familiar with something, or to get to know someone.","example":{"text":"You should acquaint yourself with the local customs.","source":{"kind":"tatoeba","sentenceId":69951,"author":"CM"}},"audio":"audio/2d105fc2a67a7ed1.m4a"},{"id":"ex.vocab.acquaintance","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"acquaintance","back":"(noun) Someone you know a little, but who is not a close friend.","example":{"text":"He is not a friend, but an acquaintance.","source":{"kind":"tatoeba","sentenceId":324396,"author":"CK"}},"audio":"audio/1174684e6b406171.m4a"},{"id":"ex.vocab.acquire","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"acquire","back":"(verb) To get or obtain something, often over time or through effort.","example":{"text":"We'd love to acquire it.","source":{"kind":"tatoeba","sentenceId":5745936,"author":"CM"}},"audio":"audio/f9b4bdd06ee2d613.m4a"},{"id":"ex.vocab.adapt","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"adapt","back":"(verb) To change your behavior or ideas to suit a new situation.","example":{"text":"He adapted himself to his new life.","source":{"kind":"tatoeba","sentenceId":299911,"author":"CK"}},"audio":"audio/161b4409e827e10e.m4a"},{"id":"ex.vocab.addict","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"addict","back":"(noun) A person who cannot stop doing or using something, especially something harmful.","example":{"text":"She was a coffee addict, drinking many cups a day.","source":{"kind":"generated"}},"audio":"audio/14a18842f8f002c9.m4a"},{"id":"ex.vocab.adjust","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"adjust","back":"(verb) To change something slightly to make it better or more suitable.","example":{"text":"The boy adjusted his cap.","source":{"kind":"tatoeba","sentenceId":47438,"author":"CK"}},"audio":"audio/97c98d79dd60a980.m4a"},{"id":"ex.vocab.admire","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"admire","back":"(verb) To respect and approve of someone or something.","example":{"text":"I admire you for your courage.","source":{"kind":"tatoeba","sentenceId":16872,"author":"CK"}},"audio":"audio/37593e0f9742bfbd.m4a"},{"id":"ex.vocab.advanced","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"advanced","back":"(adjective) Highly developed or complex; at a higher level than others.","example":{"text":"Their equipment is extremely advanced.","source":{"kind":"tatoeba","sentenceId":533085,"author":"CM"}},"audio":"audio/5e5e5c0dc47dabd8.m4a"},{"id":"ex.vocab.affair","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"affair","back":"(noun) A matter or situation that is connected with a particular person or thing.","example":{"text":"That is my own affair.","source":{"kind":"tatoeba","sentenceId":42376,"author":"CM"}},"audio":"audio/61181892177a504c.m4a"},{"id":"ex.vocab.agent","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"agent","back":"(noun) A person who acts for another person or group, often in business.","example":{"text":"I just got off the phone with my agent.","source":{"kind":"tatoeba","sentenceId":3922224,"author":"CK"}},"audio":"audio/2272ab350c2a9811.m4a"},{"id":"ex.vocab.aggressive","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"aggressive","back":"(adjective) Behaving in an angry or violent way towards another person or animal.","example":{"text":"This spider is pretty aggressive.","source":{"kind":"tatoeba","sentenceId":4539971,"author":"Amastan"}},"audio":"audio/0a47a1dfbbb03d09.m4a"},{"id":"ex.vocab.agricultural","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"agricultural","back":"(adjective) Related to farming or the practice of growing crops and raising animals.","example":{"text":"It was an agricultural area.","source":{"kind":"tatoeba","sentenceId":806974,"author":"Source_VOA"}},"audio":"audio/650078e2318de1f8.m4a"},{"id":"ex.vocab.agriculture","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"agriculture","back":"(noun) The practice or science of farming, including growing crops and raising animals.","example":{"text":"The country's economy depends on agriculture.","source":{"kind":"tatoeba","sentenceId":47908,"author":"CK"}},"audio":"audio/e79b83d18b89df1f.m4a"},{"id":"ex.vocab.aid","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"aid","back":"(noun) Help or support that is given to someone or something.","example":{"text":"A dictionary is an important aid in language learning.","source":{"kind":"tatoeba","sentenceId":264899,"author":"CM"}},"audio":"audio/212a8ecfd9268353.m4a"},{"id":"ex.vocab.aircraft","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"aircraft","back":"(noun) Any machine that can fly, such as an airplane or helicopter.","example":{"text":"He left too much runway before he landed the aircraft.","source":{"kind":"tatoeba","sentenceId":3889153,"author":"Amastan"}},"audio":"audio/1c3f0bddc386a37b.m4a"},{"id":"ex.vocab.alcoholic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"alcoholic","back":"(adjective) Containing alcohol; or a person who drinks too much alcohol.","example":{"text":"I don't care for alcoholic drinks.","source":{"kind":"tatoeba","sentenceId":252274,"author":"CK"}},"audio":"audio/b3f6ebafde7280df.m4a"},{"id":"ex.vocab.alibi","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"alibi","back":"(noun) Proof that you were somewhere else when a crime happened.","example":{"text":"Tom has an airtight alibi.","source":{"kind":"tatoeba","sentenceId":1440564,"author":"CK"}},"audio":"audio/bf08225a89647423.m4a"},{"id":"ex.vocab.ally","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ally","back":"(noun) A country or person that helps and supports another, especially in a difficult situation.","example":{"text":"Tom, Mary, John and Alice are allies.","source":{"kind":"tatoeba","sentenceId":7542641,"author":"CK"}},"audio":"audio/e41552dd2c42ebbc.m4a"},{"id":"ex.vocab.alternative","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"alternative","back":"(adjective) Available as another choice instead of something else.","example":{"text":"Could you suggest an alternative date?","source":{"kind":"tatoeba","sentenceId":320307,"author":"CK"}},"audio":"audio/3ea7cf8cbecd5f51.m4a"},{"id":"ex.vocab.ambition","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ambition","back":"(noun) A strong desire to achieve something, especially success, power, or wealth.","example":{"text":"His ambition is to be a lawyer.","source":{"kind":"tatoeba","sentenceId":287122,"author":"CK"}},"audio":"audio/036ae36d275a0c63.m4a"},{"id":"ex.vocab.ambitious","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ambitious","back":"(adjective) Having a strong desire to be successful, powerful, or famous.","example":{"text":"Mary is a very ambitious woman.","source":{"kind":"tatoeba","sentenceId":5937872,"author":"CK"}},"audio":"audio/9f47d8756e538713.m4a"},{"id":"ex.vocab.ancestor","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ancestor","back":"(noun) A person from whom one is descended, who lived a long time ago.","example":{"text":"Tom's ancestors came from Africa.","source":{"kind":"tatoeba","sentenceId":680192,"author":"Source_VOA"}},"audio":"audio/879fddc21a94ae3d.m4a"},{"id":"ex.vocab.anti","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"anti","back":"(adjective) Opposed to or against something.","example":{"text":"The group held an anti-pollution protest.","source":{"kind":"generated"}},"audio":"audio/f0af23f6294f0ccf.m4a"},{"id":"ex.vocab.anticipate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"anticipate","back":"(verb) To expect something to happen and prepare for it.","example":{"text":"Anticipating a cold winter, we bought a bigger stove.","source":{"kind":"tatoeba","sentenceId":21156,"author":"CK"}},"audio":"audio/e5598605a1178a63.m4a"},{"id":"ex.vocab.antique","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"antique","back":"(adjective) Old and valuable, often because of its age or quality.","example":{"text":"This antique clock is worth one thousand dollars.","source":{"kind":"tatoeba","sentenceId":59370,"author":"CK"}},"audio":"audio/647882f95e648741.m4a"},{"id":"ex.vocab.anxiety","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"anxiety","back":"(noun) A feeling of worry, nervousness, or unease about something uncertain.","example":{"text":"The dwindling supply led to great anxiety in the community.","source":{"kind":"tatoeba","sentenceId":6907485,"author":"swolesuki"}},"audio":"audio/691fa63ff060eeb4.m4a"},{"id":"ex.vocab.anxious","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"anxious","back":"(adjective) Feeling worried, nervous, or afraid about something uncertain.","example":{"text":"I am anxious about the future.","source":{"kind":"tatoeba","sentenceId":258627,"author":"CK"}},"audio":"audio/09ea5d989327b167.m4a"},{"id":"ex.vocab.apparently","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"apparently","back":"(adverb) Used to say that something seems to be true, although it is not certain.","example":{"text":"He is apparently a pianist.","source":{"kind":"tatoeba","sentenceId":293665,"author":"CK"}},"audio":"audio/ddb31bd6503262e2.m4a"},{"id":"ex.vocab.appeal","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"appeal","back":"(verb) To make a serious request for help or information, or to be attractive or interesting.","example":{"text":"The song appealed to young people.","source":{"kind":"tatoeba","sentenceId":49280,"author":"CK"}},"audio":"audio/f93ef923255c2e3d.m4a"},{"id":"ex.vocab.appearance","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"appearance","back":"(noun) The way someone or something looks.","example":{"text":"You shouldn't judge a person by his appearance.","source":{"kind":"tatoeba","sentenceId":270163,"author":"CK"}},"audio":"audio/548b6b9f226360dd.m4a"},{"id":"ex.vocab.appoint","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"appoint","back":"(verb) To choose someone for a job or position.","example":{"text":"Tom was appointed by the governor.","source":{"kind":"tatoeba","sentenceId":4529434,"author":"CK"}},"audio":"audio/fae8ed921ff36b63.m4a"},{"id":"ex.vocab.appropriate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"appropriate","back":"(adjective) Correct or suitable for a particular time, situation, or purpose.","example":{"text":"Please make a cross in the appropriate box.","source":{"kind":"tatoeba","sentenceId":1740190,"author":"Dejo"}},"audio":"audio/89ce9660ed89fec7.m4a"},{"id":"ex.vocab.approval","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"approval","back":"(noun) The feeling or statement that something is good or acceptable.","example":{"text":"Tom looked to Mary for approval.","source":{"kind":"tatoeba","sentenceId":3417723,"author":"CK"}},"audio":"audio/25fcaf9a4df1db9e.m4a"},{"id":"ex.vocab.armed","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"armed","back":"(adjective) carrying a weapon, especially a gun.","example":{"text":"Before talking with Tom, Mary armed herself with courage.","source":{"kind":"tatoeba","sentenceId":6779865,"author":"Eccles17"}},"audio":"audio/52fbd0a27767d67b.m4a"},{"id":"ex.vocab.arrogant","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"arrogant","back":"(adjective) Behaving in a proud and unpleasant way, thinking you are better than others.","example":{"text":"He tends to be arrogant.","source":{"kind":"tatoeba","sentenceId":304876,"author":"Dejo"}},"audio":"audio/54402b539dbb422f.m4a"},{"id":"ex.vocab.artificial","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"artificial","back":"(adjective) Made by people, not natural.","example":{"text":"We skied on artificial snow.","source":{"kind":"tatoeba","sentenceId":248924,"author":"CK"}},"audio":"audio/29c7419ad118bb42.m4a"},{"id":"ex.vocab.aside","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"aside","back":"(adverb) To one side, or out of the way. It can also mean to save something for later.","example":{"text":"I stepped aside for him to pass.","source":{"kind":"tatoeba","sentenceId":283211,"author":"CK"}},"audio":"audio/efcfc31e69ab6607.m4a"},{"id":"ex.vocab.assemble","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"assemble","back":"(verb) To put parts together to make a whole, or to gather people or things together.","example":{"text":"Tom is assembling a machine.","source":{"kind":"tatoeba","sentenceId":1665726,"author":"Amastan"}},"audio":"audio/6841563eff781740.m4a"},{"id":"ex.vocab.assist","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"assist","back":"(verb) To help someone to do something.","example":{"text":"I'm here to assist you.","source":{"kind":"tatoeba","sentenceId":2546590,"author":"CK"}},"audio":"audio/07a707264be88dfd.m4a"},{"id":"ex.vocab.associate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"associate","back":"(verb) To connect someone or something in your mind, or to spend time with someone.","example":{"text":"That's a picture of a monkey associated with the Year of the Monkey.","source":{"kind":"tatoeba","sentenceId":326838,"author":"shekitten"}},"audio":"audio/5fc3cd9a78122630.m4a"},{"id":"ex.vocab.assure","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"assure","back":"(verb) To tell someone confidently that something is true or will definitely happen.","example":{"text":"I assure you we're doing everything we can to find Tom.","source":{"kind":"tatoeba","sentenceId":2293463,"author":"CK"}},"audio":"audio/a6abf981055fcfe0.m4a"},{"id":"ex.vocab.astonish","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"astonish","back":"(verb) To surprise someone very much.","example":{"text":"Tom was astonished by what he saw.","source":{"kind":"tatoeba","sentenceId":2958501,"author":"CK"}},"audio":"audio/07690f65038dc987.m4a"},{"id":"ex.vocab.atmosphere","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"atmosphere","back":"(noun) The feeling or mood in a place, or the layer of gases around a planet.","example":{"text":"I like the friendly atmosphere here.","source":{"kind":"tatoeba","sentenceId":3723143,"author":"CM"}},"audio":"audio/9b8a4fbd3d801d34.m4a"},{"id":"ex.vocab.attorney","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"attorney","back":"(noun) A lawyer, especially one who represents clients in court.","example":{"text":"Tom is a great attorney.","source":{"kind":"tatoeba","sentenceId":5086053,"author":"Hybrid"}},"audio":"audio/dee3c718d619b84e.m4a"},{"id":"ex.vocab.authority","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"authority","back":"(noun) The power or right to give orders, make decisions, and enforce obedience.","example":{"text":"I don't have the authority to do that.","source":{"kind":"tatoeba","sentenceId":1887232,"author":"CK"}},"audio":"audio/84a7651434a2f821.m4a"},{"id":"ex.vocab.await","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"await","back":"(verb) To wait for something to happen.","example":{"text":"A cup of tea awaits me.","source":{"kind":"tatoeba","sentenceId":10717699,"author":"vxern"}},"audio":"audio/0b6a5af92b30cec8.m4a"},{"id":"ex.vocab.awfully","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"awfully","back":"(adverb) Very or extremely.","example":{"text":"It's an awfully big job.","source":{"kind":"tatoeba","sentenceId":3315121,"author":"CK"}},"audio":"audio/2f6155238117d911.m4a"},{"id":"ex.vocab.awkward","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"awkward","back":"(adjective) Difficult to use, do, or deal with; or causing embarrassment.","example":{"text":"Our first date was kind of awkward. I was really nervous.","source":{"kind":"tatoeba","sentenceId":3571940,"author":"Hybrid"}},"audio":"audio/a3a9343b1e0a8d96.m4a"},{"id":"ex.vocab.bachelor","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"bachelor","back":"(noun) A man who has never been married.","example":{"text":"Tom has always been a bachelor.","source":{"kind":"tatoeba","sentenceId":6350664,"author":"CK"}},"audio":"audio/4fa8eeb2e699528a.m4a"},{"id":"ex.vocab.barely","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"barely","back":"(adverb) Only just; almost not; by a very small amount.","example":{"text":"I can barely hear you.","source":{"kind":"tatoeba","sentenceId":1887101,"author":"CK"}},"audio":"audio/1c33ccecf22e4819.m4a"},{"id":"ex.vocab.basis","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"basis","back":"(noun) The main reason or principle for something, or the way something is organized.","example":{"text":"What is the basis for this claim?","source":{"kind":"tatoeba","sentenceId":6055678,"author":"mailohilohi"}},"audio":"audio/d05f101d385e581b.m4a"},{"id":"ex.vocab.beneath","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"beneath","back":"(preposition) In a lower position than something else; under.","example":{"text":"I crouched beneath the window.","source":{"kind":"tatoeba","sentenceId":8890283,"author":"CK"}},"audio":"audio/efc03f91c063bd55.m4a"},{"id":"ex.vocab.besides","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"besides","back":"(preposition) In addition to; apart from.","example":{"text":"Is anyone coming besides your friends?","source":{"kind":"tatoeba","sentenceId":70342,"author":"CK"}},"audio":"audio/954b9004dd26dd39.m4a"},{"id":"ex.vocab.blade","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"blade","back":"(noun) The flat, sharp part of a knife, sword, or tool that cuts.","example":{"text":"How long is this blade?","source":{"kind":"tatoeba","sentenceId":3872667,"author":"Amastan"}},"audio":"audio/d6700aedfdfa2025.m4a"},{"id":"ex.vocab.blessing","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"blessing","back":"(noun) Something that brings happiness, good fortune, or is very helpful.","example":{"text":"Is immortality a blessing or a curse?","source":{"kind":"tatoeba","sentenceId":11186458,"author":"ddnktr"}},"audio":"audio/8f45f35a46ddc700.m4a"},{"id":"ex.vocab.bloom","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"bloom","back":"(verb) when a flower opens or a plant produces flowers.","example":{"text":"Many pretty flowers bloom in the spring.","source":{"kind":"tatoeba","sentenceId":453669,"author":"CM"}},"audio":"audio/644edd800c610d2a.m4a"},{"id":"ex.vocab.bluff","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"bluff","back":"(verb) To pretend that you will do something or know something to trick someone.","example":{"text":"I knew Tom was bluffing.","source":{"kind":"tatoeba","sentenceId":2374837,"author":"CK"}},"audio":"audio/0a6a7123253d2e91.m4a"},{"id":"ex.vocab.bob","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"bob","back":"(verb) To move quickly up and down, or from side to side.","example":{"text":"The cork began to bob on the water.","source":{"kind":"generated"}},"audio":"audio/5170d289b61bf7cd.m4a"},{"id":"ex.vocab.bomb","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"bomb","back":"(noun) A weapon that explodes and causes damage, or a container filled with explosive material.","example":{"text":"The old bomb was safely defused.","source":{"kind":"generated"}},"audio":"audio/85666b869ec8d16b.m4a"},{"id":"ex.vocab.bond","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"bond","back":"(noun) A strong connection or feeling of friendship between people.","example":{"text":"Ziri and Rima were building such a strong bond.","source":{"kind":"tatoeba","sentenceId":10241250,"author":"Amastan"}},"audio":"audio/6cf7786fcef6c768.m4a"},{"id":"ex.vocab.bound","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"bound","back":"(adjective) Very likely or certain to happen. It can also mean tied or fastened.","example":{"text":"It's bound to rain later today.","source":{"kind":"generated"}},"audio":"audio/d7dff2f6dfab89cf.m4a"},{"id":"ex.vocab.bouquet","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"bouquet","back":"(noun) A collection of flowers arranged together.","example":{"text":"Tom bought Mary a bouquet of flowers.","source":{"kind":"tatoeba","sentenceId":7544786,"author":"CK"}},"audio":"audio/05e265b4d0c0c2d0.m4a"},{"id":"ex.vocab.brace","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"brace","back":"(noun) A device worn to support or protect a part of the body.","example":{"text":"Yanni wears a back brace all the time.","source":{"kind":"tatoeba","sentenceId":9956636,"author":"Amastan"}},"audio":"audio/ce89fc225629d6a6.m4a"},{"id":"ex.vocab.brag","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"brag","back":"(verb) To talk about your own achievements or possessions in a way that shows too much pride.","example":{"text":"I didn't want to brag.","source":{"kind":"tatoeba","sentenceId":2275950,"author":"CK"}},"audio":"audio/e505592ace9f1bc9.m4a"},{"id":"ex.vocab.brandy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"brandy","back":"(noun) a strong alcoholic drink made from wine or fruit.","example":{"text":"The recipe called for a splash of brandy.","source":{"kind":"generated"}},"audio":"audio/5ff36fb0b374af52.m4a"},{"id":"ex.vocab.breed","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"breed","back":"(verb) to produce young animals; to keep animals for the purpose of producing young.","example":{"text":"Krill like to breed in really cold water near sea ice.","source":{"kind":"tatoeba","sentenceId":5322596,"author":"Hybrid"}},"audio":"audio/177e0b2f3e9d1c49.m4a"},{"id":"ex.vocab.bribe","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"bribe","back":"(noun) Money or a gift offered to someone to persuade them to do something dishonest.","example":{"text":"Tom admitted he had accepted a bribe.","source":{"kind":"tatoeba","sentenceId":2955480,"author":"CK"}},"audio":"audio/053c2b042fcae6ff.m4a"},{"id":"ex.vocab.brilliant","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"brilliant","back":"(adjective) Extremely clever or talented, or very bright and shining.","example":{"text":"The snow was brilliant in the morning sun.","source":{"kind":"tatoeba","sentenceId":272552,"author":"CM"}},"audio":"audio/68a0fae888889458.m4a"},{"id":"ex.vocab.brutal","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"brutal","back":"(adjective) Extremely cruel, harsh, or violent.","example":{"text":"Genghis Khan was a brutal man in a brutal age.","source":{"kind":"tatoeba","sentenceId":12074995,"author":"Amastan"}},"audio":"audio/f8596e14acc6e14a.m4a"},{"id":"ex.vocab.buck","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"buck","back":"(noun) An informal word for one dollar.","example":{"text":"Can you spare a buck?","source":{"kind":"tatoeba","sentenceId":73209,"author":"CM"}},"audio":"audio/1cf9ec9249e54b41.m4a"},{"id":"ex.vocab.bullet","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"bullet","back":"(noun) A small metal object that is shot from a gun.","example":{"text":"The target had a small hole from the bullet.","source":{"kind":"generated"}},"audio":"audio/eabb9077f300a002.m4a"},{"id":"ex.vocab.burden","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"burden","back":"(noun) A heavy responsibility or problem that causes worry or difficulty.","example":{"text":"I don't want to be a burden.","source":{"kind":"tatoeba","sentenceId":5737337,"author":"CM"}},"audio":"audio/cc00721903074ba4.m4a"},{"id":"ex.vocab.burst","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"burst","back":"(verb) To break open suddenly and violently, or to move suddenly.","example":{"text":"He burst into the room.","source":{"kind":"tatoeba","sentenceId":284160,"author":"CM"}},"audio":"audio/e0cf8652475c993d.m4a"},{"id":"ex.vocab.cane","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"cane","back":"(noun) A stick that people use to help them walk, often because they are old or injured.","example":{"text":"Tom can no longer walk without a cane.","source":{"kind":"tatoeba","sentenceId":3422134,"author":"CK"}},"audio":"audio/c4aa984336396cb8.m4a"},{"id":"ex.vocab.capable","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"capable","back":"(adjective) Having the ability or qualities necessary to do something well.","example":{"text":"I tried to convince him that I was perfectly capable of it.","source":{"kind":"tatoeba","sentenceId":249829,"author":"sundown"}},"audio":"audio/69917dbc0eb539c9.m4a"},{"id":"ex.vocab.carbon","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"carbon","back":"(noun) A chemical element found in all living things and in coal and diamonds.","example":{"text":"Coal consists mostly of carbon.","source":{"kind":"tatoeba","sentenceId":272237,"author":"rul"}},"audio":"audio/6c77762abebfa767.m4a"},{"id":"ex.vocab.carve","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"carve","back":"(verb) To cut a shape or pattern into a material, or to cut cooked meat into slices.","example":{"text":"Can I carve the turkey?","source":{"kind":"tatoeba","sentenceId":8208893,"author":"CK"}},"audio":"audio/39947022970fbefb.m4a"},{"id":"ex.vocab.cast","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"cast","back":"(verb) to throw something with force; to choose actors for a play or film.","example":{"text":"He cast his line into the lake.","source":{"kind":"tatoeba","sentenceId":301694,"author":"CK"}},"audio":"audio/a7d776edfa8c49fb.m4a"},{"id":"ex.vocab.cautious","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"cautious","back":"(adjective) Careful to avoid potential problems or dangers.","example":{"text":"Tom and Mary were cautious at first.","source":{"kind":"tatoeba","sentenceId":6517573,"author":"CT"}},"audio":"audio/9b7caaa9f189ad83.m4a"},{"id":"ex.vocab.cemetery","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"cemetery","back":"(noun) A place where dead people are buried, often with gravestones.","example":{"text":"Tom went to the cemetery to put flowers on his mother's grave.","source":{"kind":"tatoeba","sentenceId":7538859,"author":"CK"}},"audio":"audio/8fbcefd124ede4f5.m4a"},{"id":"ex.vocab.champagne","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"champagne","back":"(noun) A sparkling white wine, usually drunk on special occasions.","example":{"text":"The winning team sprayed champagne.","source":{"kind":"generated"}},"audio":"audio/ba001fc6e2b2dcf2.m4a"},{"id":"ex.vocab.chaos","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"chaos","back":"(noun) A state of complete disorder and confusion.","example":{"text":"The city is in chaos.","source":{"kind":"tatoeba","sentenceId":9702731,"author":"Nylez"}},"audio":"audio/17c5de17764e807a.m4a"},{"id":"ex.vocab.charm","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"charm","back":"(noun) A quality that makes you like someone or something; or a small object worn for luck.","example":{"text":"He had a certain charm.","source":{"kind":"tatoeba","sentenceId":288909,"author":"CM"}},"audio":"audio/6209d1064198e1ba.m4a"},{"id":"ex.vocab.charming","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"charming","back":"(adjective) Very pleasant or attractive.","example":{"text":"Tom is a charming man.","source":{"kind":"tatoeba","sentenceId":5753389,"author":"CM"}},"audio":"audio/72e663e27968c955.m4a"},{"id":"ex.vocab.civil","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"civil","back":"(adjective) Polite and well-behaved, or relating to the citizens of a country.","example":{"text":"I hope Tom was civil.","source":{"kind":"tatoeba","sentenceId":11473340,"author":"CK"}},"audio":"audio/9575b1c7f611010d.m4a"},{"id":"ex.vocab.civilization","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"civilization","back":"(noun) A society with its own culture and way of life, often advanced.","example":{"text":"Tom is studying the ancient civilizations of the Mediterranean.","source":{"kind":"tatoeba","sentenceId":680195,"author":"Source_VOA"}},"audio":"audio/59670929645121a1.m4a"},{"id":"ex.vocab.clarinet","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"clarinet","back":"(noun) A woodwind musical instrument with a single reed and a straight tube.","example":{"text":"Can you play the clarinet?","source":{"kind":"tatoeba","sentenceId":6038057,"author":"mailohilohi"}},"audio":"audio/3f9d8e29750c3080.m4a"},{"id":"ex.vocab.classic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"classic","back":"(adjective) Considered to be of the highest quality and importance, or typical of a particular style.","example":{"text":"Algeria is a classic example of a bureaucratic country.","source":{"kind":"tatoeba","sentenceId":10077961,"author":"Amastan"}},"audio":"audio/a3ab29b0ad5ffb6f.m4a"},{"id":"ex.vocab.clog","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"clog","back":"(verb) To block something or become blocked, so that things cannot pass through.","example":{"text":"The sink drain is clogged.","source":{"kind":"tatoeba","sentenceId":8604920,"author":"Amastan"}},"audio":"audio/cffd6d9b939e9ecc.m4a"},{"id":"ex.vocab.cockroach","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"cockroach","back":"(noun) A flat, brown or black insect that lives in warm, dirty places.","example":{"text":"Cockroaches hide themselves during the day.","source":{"kind":"tatoeba","sentenceId":62171,"author":"CK"}},"audio":"audio/61689b39594845aa.m4a"},{"id":"ex.vocab.coincidence","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"coincidence","back":"(noun) A situation in which two or more things happen at the same time by chance.","example":{"text":"It must be a coincidence.","source":{"kind":"tatoeba","sentenceId":2645050,"author":"CK"}},"audio":"audio/3a335d71a272b8f0.m4a"},{"id":"ex.vocab.collapse","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"collapse","back":"(verb) To fall down suddenly because of weakness or damage.","example":{"text":"If there's a big earthquake, the house could really collapse!","source":{"kind":"tatoeba","sentenceId":425138,"author":"FeuDRenais"}},"audio":"audio/14e9930687a53b6b.m4a"},{"id":"ex.vocab.colony","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"colony","back":"(noun) A country or area controlled by another country, or a group of animals or plants living together.","example":{"text":"Algeria was a French colony.","source":{"kind":"tatoeba","sentenceId":8145342,"author":"Amastan"}},"audio":"audio/2fba6bee824a963e.m4a"},{"id":"ex.vocab.coma","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"coma","back":"(noun) A deep state of unconsciousness, often caused by injury or illness.","example":{"text":"Tom is still in a coma.","source":{"kind":"tatoeba","sentenceId":2645854,"author":"CK"}},"audio":"audio/ae70b11fcce7117d.m4a"},{"id":"ex.vocab.combination","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"combination","back":"(noun) A mixture of two or more things, or a sequence of numbers or letters to open a lock.","example":{"text":"Red and yellow make a bright combination.","source":{"kind":"generated"}},"audio":"audio/5a3912e66109d48a.m4a"},{"id":"ex.vocab.commercial","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"commercial","back":"(adjective) Related to buying and selling goods and services, or making money.","example":{"text":"The Algiers port is Algeria's largest commercial port.","source":{"kind":"tatoeba","sentenceId":7856682,"author":"Amastan"}},"audio":"audio/37405b815ca869dd.m4a"},{"id":"ex.vocab.commit","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"commit","back":"(verb) To do something, especially something wrong or illegal; or to promise to do something.","example":{"text":"I didn't commit myself to attend the meeting.","source":{"kind":"tatoeba","sentenceId":49186,"author":"CM"}},"audio":"audio/a192f1daef5806f5.m4a"},{"id":"ex.vocab.commitment","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"commitment","back":"(noun) A promise or firm decision to do something, or a strong belief in an idea.","example":{"text":"I had a prior commitment.","source":{"kind":"tatoeba","sentenceId":9015647,"author":"CK"}},"audio":"audio/875e8474ab0537ac.m4a"},{"id":"ex.vocab.committed","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"committed","back":"(adjective) Willing to give your time and energy to something; dedicated.","example":{"text":"Tom is committed to doing better.","source":{"kind":"tatoeba","sentenceId":6529983,"author":"CK"}},"audio":"audio/2c87f3c41538d7d5.m4a"},{"id":"ex.vocab.committee","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"committee","back":"(noun) A group of people chosen to do a particular job or make decisions.","example":{"text":"Are you on the committee?","source":{"kind":"tatoeba","sentenceId":16808,"author":"CK"}},"audio":"audio/6b4b4f82a22eae36.m4a"},{"id":"ex.vocab.competitive","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"competitive","back":"(adjective) Wanting very much to win or be more successful than others.","example":{"text":"I think Tom is too competitive.","source":{"kind":"tatoeba","sentenceId":3171921,"author":"CK"}},"audio":"audio/b5abd212b13ab658.m4a"},{"id":"ex.vocab.complex","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"complex","back":"(adjective) Having many different parts and difficult to understand or deal with.","example":{"text":"This is a complex issue.","source":{"kind":"tatoeba","sentenceId":5022701,"author":"CK"}},"audio":"audio/a6a5a8924c6ca8f8.m4a"},{"id":"ex.vocab.complicated","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"complicated","back":"(adjective) Difficult to understand or deal with because it has many parts or steps.","example":{"text":"This is all so complicated.","source":{"kind":"tatoeba","sentenceId":2892188,"author":"CK"}},"audio":"audio/b21f808aec6dded4.m4a"},{"id":"ex.vocab.compliment","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"compliment","back":"(noun) a polite expression of praise or admiration.","example":{"text":"He paid me a compliment.","source":{"kind":"tatoeba","sentenceId":297481,"author":"CM"}},"audio":"audio/dc6882d20717e0ab.m4a"},{"id":"ex.vocab.compose","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"compose","back":"(verb) To create music, poetry, or writing, or to make up something from different parts.","example":{"text":"The four-year old prodigy composed a symphony.","source":{"kind":"tatoeba","sentenceId":5794304,"author":"Eccles17"}},"audio":"audio/843f779b677b0178.m4a"},{"id":"ex.vocab.composition","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"composition","back":"(noun) The way something is put together, or a piece of music, writing, or art.","example":{"text":"Do a composition exercise, please.","source":{"kind":"tatoeba","sentenceId":26123,"author":"garynw"}},"audio":"audio/9f7c33fa63277d6e.m4a"},{"id":"ex.vocab.compromise","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"compromise","back":"(noun) an agreement reached when each side gives up something it wanted.","example":{"text":"They are negotiating to reach a satisfactory compromise.","source":{"kind":"tatoeba","sentenceId":307576,"author":"CK"}},"audio":"audio/a3f3112aee1c41e3.m4a"},{"id":"ex.vocab.con","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"con","back":"(noun) A disadvantage or a reason not to do something.","example":{"text":"We weighed the pros and cons.","source":{"kind":"tatoeba","sentenceId":5734472,"author":"CM"}},"audio":"audio/8a8421bb05417416.m4a"},{"id":"ex.vocab.concept","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"concept","back":"(noun) An idea or a general principle, often an abstract one.","example":{"text":"Capitalism can't exist without the concept of personal property.","source":{"kind":"tatoeba","sentenceId":5887836,"author":"peterius"}},"audio":"audio/844c8e204525d492.m4a"},{"id":"ex.vocab.concern","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"concern","back":"(noun) A feeling of worry or interest about something important.","example":{"text":"Thank you for your concern.","source":{"kind":"tatoeba","sentenceId":54426,"author":"CK"}},"audio":"audio/8d961d57880ef436.m4a"},{"id":"ex.vocab.concrete","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"concrete","back":"(noun) A hard building material made from cement, sand, gravel, and water.","example":{"text":"Concrete hardens after it's poured.","source":{"kind":"tatoeba","sentenceId":6695323,"author":"Hybrid"}},"audio":"audio/b845912bab25b754.m4a"},{"id":"ex.vocab.conduct","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"conduct","back":"(verb) To organize and carry out an activity or experiment.","example":{"text":"They will conduct a survey next week.","source":{"kind":"generated"}},"audio":"audio/f75d3fc9c7418c4f.m4a"},{"id":"ex.vocab.confess","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"confess","back":"(verb) To admit that you have done something wrong or illegal.","example":{"text":"Tom confessed to murdering Mary.","source":{"kind":"tatoeba","sentenceId":1029454,"author":"CK"}},"audio":"audio/5795af20fa3d7d19.m4a"},{"id":"ex.vocab.confession","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"confession","back":"(noun) A statement in which you admit that you have done something wrong or bad.","example":{"text":"I have a confession to make.","source":{"kind":"tatoeba","sentenceId":2358678,"author":"CK"}},"audio":"audio/712b851a4a36aeed.m4a"},{"id":"ex.vocab.confident","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"confident","back":"(adjective) Feeling sure about your own abilities or that something will happen.","example":{"text":"What makes you so confident?","source":{"kind":"tatoeba","sentenceId":5093633,"author":"CK"}},"audio":"audio/8de077d2854603c8.m4a"},{"id":"ex.vocab.confront","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"confront","back":"(verb) To meet someone face to face, often in a challenging way; or to deal with a problem.","example":{"text":"I think that it's time for me to confront that problem.","source":{"kind":"tatoeba","sentenceId":8181845,"author":"CK"}},"audio":"audio/14c111331019001f.m4a"},{"id":"ex.vocab.conscience","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"conscience","back":"(noun) The part of your mind that tells you if your actions are right or wrong.","example":{"text":"I have a clear conscience.","source":{"kind":"tatoeba","sentenceId":3732757,"author":"CK"}},"audio":"audio/638b7e5f0ecc5e6a.m4a"},{"id":"ex.vocab.conscious","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"conscious","back":"(adjective) Aware of something; knowing that something exists or is happening.","example":{"text":"She was conscious of being stared at by a stranger.","source":{"kind":"tatoeba","sentenceId":313489,"author":"CK"}},"audio":"audio/0907cf3b5f1a9e76.m4a"},{"id":"ex.vocab.consciousness","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"consciousness","back":"(noun) The state of being awake and aware of your surroundings and yourself.","example":{"text":"Did you lose consciousness after the accident?","source":{"kind":"tatoeba","sentenceId":9851473,"author":"NurseMeeks"}},"audio":"audio/6883d220e84c77b0.m4a"},{"id":"ex.vocab.consent","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"consent","back":"(noun) Permission to do something, or agreement to something.","example":{"text":"Tom married Mary without her parents' consent.","source":{"kind":"tatoeba","sentenceId":4597799,"author":"CK"}},"audio":"audio/02e155580c343386.m4a"},{"id":"ex.vocab.consequence","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"consequence","back":"(noun) A result or effect of an action or condition.","example":{"text":"That doctrine will no doubt lead to serious consequences.","source":{"kind":"tatoeba","sentenceId":46785,"author":"Zifre"}},"audio":"audio/f96e5f2812cc384c.m4a"},{"id":"ex.vocab.conservative","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"conservative","back":"(adjective) Not liking sudden changes or new ideas; preferring traditional ways.","example":{"text":"The choice of clothes has become conservative.","source":{"kind":"tatoeba","sentenceId":319824,"author":"Zifre"}},"audio":"audio/b35289c73b298072.m4a"},{"id":"ex.vocab.consistent","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"consistent","back":"(adjective) Always behaving or happening in the same way; steady and reliable.","example":{"text":"He's a very consistent worker. He rarely makes mistakes.","source":{"kind":"tatoeba","sentenceId":9929876,"author":"Nylez"}},"audio":"audio/77065633b635cd19.m4a"},{"id":"ex.vocab.constant","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"constant","back":"(adjective) happening all the time or very often; staying the same.","example":{"text":"We are annoyed at the constant noise.","source":{"kind":"tatoeba","sentenceId":34770,"author":"Objectivesea"}},"audio":"audio/fa8a86e3dc4f2136.m4a"},{"id":"ex.vocab.constantly","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"constantly","back":"(adverb) Happening all the time or very often without stopping.","example":{"text":"My parents are constantly arguing.","source":{"kind":"tatoeba","sentenceId":4529456,"author":"CK"}},"audio":"audio/b059cef9a252fcfb.m4a"},{"id":"ex.vocab.construct","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"construct","back":"(verb) To build or make something, often a large structure.","example":{"text":"They're constructing a bridge over the river.","source":{"kind":"tatoeba","sentenceId":273182,"author":"CK"}},"audio":"audio/fc7084ee42c80b70.m4a"},{"id":"ex.vocab.construction","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"construction","back":"(noun) The process or business of building something large, like a road or building.","example":{"text":"The new bridge is under construction.","source":{"kind":"tatoeba","sentenceId":46119,"author":"CK"}},"audio":"audio/eaafb41e407e75ab.m4a"},{"id":"ex.vocab.consult","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"consult","back":"(verb) To ask someone for advice or information.","example":{"text":"Tom consulted Mary about the matter.","source":{"kind":"tatoeba","sentenceId":1029450,"author":"CK"}},"audio":"audio/d6175f458e43cf8a.m4a"},{"id":"ex.vocab.consume","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"consume","back":"(verb) To eat, drink, or use something, or to completely destroy something.","example":{"text":"Snails are still consumed in some areas of Algeria.","source":{"kind":"tatoeba","sentenceId":7866492,"author":"Amastan"}},"audio":"audio/bc2f30460331914e.m4a"},{"id":"ex.vocab.contagious","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"contagious","back":"(adjective) (Of a disease) able to be passed from one person or animal to another by touch.","example":{"text":"It's a very contagious disease.","source":{"kind":"tatoeba","sentenceId":10004409,"author":"ddnktr"}},"audio":"audio/f42c379a7ed8ea34.m4a"},{"id":"ex.vocab.contract","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"contract","back":"(noun) A formal written agreement between two or more people or groups.","example":{"text":"They made him sign the contract.","source":{"kind":"tatoeba","sentenceId":307345,"author":"CK"}},"audio":"audio/7ccef3c19875cec2.m4a"},{"id":"ex.vocab.contribute","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"contribute","back":"(verb) To give something, especially money or time, to help a common purpose.","example":{"text":"They contributed money to the Red Cross.","source":{"kind":"tatoeba","sentenceId":306992,"author":"CK"}},"audio":"audio/3aa31b5c456feb47.m4a"},{"id":"ex.vocab.convert","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"convert","back":"(verb) To change something from one form, purpose, or system to another.","example":{"text":"How do I convert miles to kilometers?","source":{"kind":"tatoeba","sentenceId":4409786,"author":"LB"}},"audio":"audio/c210b2f0b58c9634.m4a"},{"id":"ex.vocab.convict","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"convict","back":"(verb) To officially decide in a court of law that someone is guilty of a crime.","example":{"text":"Tom hasn't been convicted of anything.","source":{"kind":"tatoeba","sentenceId":6249333,"author":"CK"}},"audio":"audio/8563a4dd3ed2826c.m4a"},{"id":"ex.vocab.cooperate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"cooperate","back":"(verb) To work together with someone else to achieve a shared goal.","example":{"text":"They want us to cooperate.","source":{"kind":"tatoeba","sentenceId":2012519,"author":"CK"}},"audio":"audio/89e7c5315bf6e627.m4a"},{"id":"ex.vocab.cope","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"cope","back":"(verb) To deal successfully with a difficult situation or problem.","example":{"text":"She is unable to cope with stress.","source":{"kind":"tatoeba","sentenceId":311014,"author":"CK"}},"audio":"audio/8ce677ba46b5d352.m4a"},{"id":"ex.vocab.coronavirus","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"coronavirus","back":"(noun) A type of virus that can cause respiratory illnesses, including the disease COVID-19.","example":{"text":"Do you have coronavirus symptoms?","source":{"kind":"tatoeba","sentenceId":8610374,"author":"Amastan"}},"audio":"audio/7952a1cdd49d5f25.m4a"},{"id":"ex.vocab.corrupt","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"corrupt","back":"(adjective) Using your power dishonestly for personal gain.","example":{"text":"These government officials are corrupt.","source":{"kind":"tatoeba","sentenceId":3555084,"author":"Hybrid"}},"audio":"audio/3d3ab9ed485e33d6.m4a"},{"id":"ex.vocab.countless","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"countless","back":"(adjective) Too many to be counted; very many.","example":{"text":"There are countless stars in space.","source":{"kind":"tatoeba","sentenceId":9022940,"author":"mccarras"}},"audio":"audio/0e0bbf48d47591f2.m4a"},{"id":"ex.vocab.courage","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"courage","back":"(noun) The ability to do something dangerous or difficult without showing fear.","example":{"text":"Tom showed his courage in the face of danger.","source":{"kind":"tatoeba","sentenceId":37164,"author":"CM"}},"audio":"audio/228dd8b630bf3645.m4a"},{"id":"ex.vocab.couscous","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"couscous","back":"(noun) A North African dish of small steamed balls of crushed durum wheat semolina.","example":{"text":"We're going to have couscous for dinner.","source":{"kind":"tatoeba","sentenceId":8047160,"author":"Amastan"}},"audio":"audio/b35d5a6a2eeec305.m4a"},{"id":"ex.vocab.coward","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"coward","back":"(noun) a person who lacks courage and avoids danger or difficulty.","example":{"text":"A coward runs at the first sign of danger.","source":{"kind":"tatoeba","sentenceId":3726365,"author":"CM"}},"audio":"audio/e22bbc9d6c77c9c7.m4a"},{"id":"ex.vocab.creepy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"creepy","back":"(adjective) causing an unpleasant feeling of fear or unease.","example":{"text":"This place is downright creepy.","source":{"kind":"tatoeba","sentenceId":4846782,"author":"CK"}},"audio":"audio/f955379317b2e488.m4a"},{"id":"ex.vocab.criminal","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"criminal","back":"(noun) A person who has committed a crime.","example":{"text":"The criminals managed to escape.","source":{"kind":"tatoeba","sentenceId":10147347,"author":"ddnktr"}},"audio":"audio/33579b2411e5b551.m4a"},{"id":"ex.vocab.crisis","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"crisis","back":"(noun) A time of great difficulty, danger, or uncertainty.","example":{"text":"The financial crisis has left many unemployed.","source":{"kind":"tatoeba","sentenceId":483068,"author":"CM"}},"audio":"audio/c236bca01bb47a62.m4a"},{"id":"ex.vocab.critic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"critic","back":"(noun) A person whose job is to give opinions about books, films, music, or art.","example":{"text":"Tom is an art critic.","source":{"kind":"tatoeba","sentenceId":5252462,"author":"Hybrid"}},"audio":"audio/9fc6b1ba921781b9.m4a"},{"id":"ex.vocab.critical","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"critical","back":"(adjective) Very important for the way things will happen; or expressing disapproval.","example":{"text":"Our situation has become critical.","source":{"kind":"tatoeba","sentenceId":4664477,"author":"CK"}},"audio":"audio/8508651ef30b4292.m4a"},{"id":"ex.vocab.criticism","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"criticism","back":"(noun) The act of expressing disapproval of someone or something.","example":{"text":"He is sensitive to criticism.","source":{"kind":"tatoeba","sentenceId":302929,"author":"CM"}},"audio":"audio/3ae1108047afd8b6.m4a"},{"id":"ex.vocab.criticize","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"criticize","back":"(verb) To say that you think someone or something is bad or wrong.","example":{"text":"Tom criticized everything Mary did.","source":{"kind":"tatoeba","sentenceId":3229860,"author":"CK"}},"audio":"audio/53dc1c74682aaec6.m4a"},{"id":"ex.vocab.crush","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"crush","back":"(verb) To press something very hard so that it is broken or damaged.","example":{"text":"The cake got crushed by the jar of juice.","source":{"kind":"tatoeba","sentenceId":680609,"author":"Source_VOA"}},"audio":"audio/079b06ab64721993.m4a"},{"id":"ex.vocab.cult","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"cult","back":"(noun) A small group of people with unusual religious or spiritual beliefs.","example":{"text":"I'm worried Tom is in a cult.","source":{"kind":"tatoeba","sentenceId":9764381,"author":"shekitten"}},"audio":"audio/1a2ebb7baffed489.m4a"},{"id":"ex.vocab.curiosity","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"curiosity","back":"(noun) A strong desire to know or learn something.","example":{"text":"Just out of curiosity, did you really have any fun?","source":{"kind":"tatoeba","sentenceId":3731268,"author":"CM"}},"audio":"audio/5fd8d537bb1775ab.m4a"},{"id":"ex.vocab.curse","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"curse","back":"(noun) A rude or offensive word, or a magical wish that something bad will happen.","example":{"text":"What curses are the most common in Holland?","source":{"kind":"tatoeba","sentenceId":2889291,"author":"AlanF_US"}},"audio":"audio/529b1a6b3d526c4b.m4a"},{"id":"ex.vocab.custody","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"custody","back":"(noun) The legal right to take care of a child, or the state of being held by the police.","example":{"text":"We haven't worked out custody of the children yet.","source":{"kind":"tatoeba","sentenceId":3240685,"author":"CK"}},"audio":"audio/536d8792be488028.m4a"},{"id":"ex.vocab.dare","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"dare","back":"(verb) To be brave enough to do something, or to challenge someone to do something.","example":{"text":"How dare you say that?","source":{"kind":"tatoeba","sentenceId":16342,"author":"Zifre"}},"audio":"audio/da3c3957ead9c423.m4a"},{"id":"ex.vocab.dawn","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"dawn","back":"(noun) The time of day when light first appears in the sky before the sun rises.","example":{"text":"We got up at dawn.","source":{"kind":"tatoeba","sentenceId":249437,"author":"CK"}},"audio":"audio/04970a6aefd38056.m4a"},{"id":"ex.vocab.deadly","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"deadly","back":"(adjective) Able to cause death, or extremely dangerous.","example":{"text":"Tigers can be a deadly threat.","source":{"kind":"tatoeba","sentenceId":8277178,"author":"Amastan"}},"audio":"audio/4b7327d55896c7b7.m4a"},{"id":"ex.vocab.deaf","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"deaf","back":"(adjective) Unable to hear, either completely or partly.","example":{"text":"Tom is completely deaf in his right ear.","source":{"kind":"tatoeba","sentenceId":3426250,"author":"CK"}},"audio":"audio/b6106e07594a9781.m4a"},{"id":"ex.vocab.debate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"debate","back":"(noun) A formal discussion on a particular subject in which opposing arguments are presented.","example":{"text":"How about holding a debate on women's rights?","source":{"kind":"tatoeba","sentenceId":267296,"author":"CM"}},"audio":"audio/aa12f1110b35f138.m4a"},{"id":"ex.vocab.debris","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"debris","back":"(noun) Scattered pieces of waste or remains, especially after something has been destroyed.","example":{"text":"We need to clear the debris from the road.","source":{"kind":"tatoeba","sentenceId":9830878,"author":"CK"}},"audio":"audio/110dee3a8750ce5a.m4a"},{"id":"ex.vocab.debt","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"debt","back":"(noun) An amount of money that you owe to a person or organization.","example":{"text":"In short, he's run off without paying off his debt.","source":{"kind":"tatoeba","sentenceId":328317,"author":"fcbond"}},"audio":"audio/00f2e1e455b0fc87.m4a"},{"id":"ex.vocab.deceive","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"deceive","back":"(verb) To make someone believe something that is not true, often to trick them.","example":{"text":"I was deceived by her appearance.","source":{"kind":"tatoeba","sentenceId":261314,"author":"CK"}},"audio":"audio/02d9ee8cb2c6f95c.m4a"},{"id":"ex.vocab.declare","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"declare","back":"(verb) To state something officially or publicly.","example":{"text":"The judge declared him the winner.","source":{"kind":"tatoeba","sentenceId":268948,"author":"AlanF_US"}},"audio":"audio/71bfc63a42aced76.m4a"},{"id":"ex.vocab.decline","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"decline","back":"(verb) To become smaller, fewer, or less; to refuse an offer or invitation.","example":{"text":"I had to decline his offer.","source":{"kind":"tatoeba","sentenceId":398539,"author":"CK"}},"audio":"audio/33c82773907566fa.m4a"},{"id":"ex.vocab.dedicated","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"dedicated","back":"(adjective) Giving a lot of time and energy to something because you believe it is important.","example":{"text":"I didn't think Tom would be so dedicated.","source":{"kind":"tatoeba","sentenceId":6666965,"author":"CK"}},"audio":"audio/9f79725f7a8c5569.m4a"},{"id":"ex.vocab.defeat","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"defeat","back":"(verb) To win a victory over someone or something in a battle, game, or election.","example":{"text":"The two parties allied to defeat the bill.","source":{"kind":"tatoeba","sentenceId":280836,"author":"sundown"}},"audio":"audio/13dcefade9723ed0.m4a"},{"id":"ex.vocab.defense","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"defense","back":"(noun) the act of protecting someone or something from attack or harm.","example":{"text":"Tom came to my defense.","source":{"kind":"tatoeba","sentenceId":3424252,"author":"CK"}},"audio":"audio/63b72105cb7246db.m4a"},{"id":"ex.vocab.delicate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"delicate","back":"(adjective) Easily broken or damaged; or needing careful handling.","example":{"text":"Can I ask you a delicate question?","source":{"kind":"tatoeba","sentenceId":4134203,"author":"CK"}},"audio":"audio/3031d0b5859334e6.m4a"},{"id":"ex.vocab.delight","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"delight","back":"(noun) A feeling of great pleasure and joy.","example":{"text":"Delight is the opposite of sorrow.","source":{"kind":"tatoeba","sentenceId":20683,"author":"helloroto"}},"audio":"audio/a34ffcf704573b57.m4a"},{"id":"ex.vocab.democracy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"democracy","back":"(noun) A system of government where the people choose their leaders by voting.","example":{"text":"Germany is a parliamentary democracy.","source":{"kind":"tatoeba","sentenceId":562321,"author":"shekitten"}},"audio":"audio/83fbcf54a5c5e560.m4a"},{"id":"ex.vocab.demon","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"demon","back":"(noun) An evil spirit or devil. It can also mean a problem or fear that causes great difficulty.","example":{"text":"I have to face my demons.","source":{"kind":"tatoeba","sentenceId":10553404,"author":"CK"}},"audio":"audio/cab5e5fadcef2e55.m4a"},{"id":"ex.vocab.demonstrate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"demonstrate","back":"(verb) To show or prove something clearly, or to show how something works.","example":{"text":"I'll demonstrate it for you.","source":{"kind":"tatoeba","sentenceId":2543680,"author":"CK"}},"audio":"audio/d697adaaf85b01a3.m4a"},{"id":"ex.vocab.deny","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"deny","back":"(verb) To say that something is not true, or that you did not do something.","example":{"text":"No one can deny the fact.","source":{"kind":"tatoeba","sentenceId":47059,"author":"CK"}},"audio":"audio/e66b4c28d719c275.m4a"},{"id":"ex.vocab.depart","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"depart","back":"(verb) To leave a place, especially to start a journey.","example":{"text":"The train will depart soon.","source":{"kind":"tatoeba","sentenceId":900939,"author":"CM"}},"audio":"audio/9bff86d3eaa034af.m4a"},{"id":"ex.vocab.dependable","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"dependable","back":"(adjective) Able to be trusted to do what is expected or needed.","example":{"text":"He is a dependable boss.","source":{"kind":"tatoeba","sentenceId":304590,"author":"CM"}},"audio":"audio/04bd7d29d0611c57.m4a"},{"id":"ex.vocab.dependent","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"dependent","back":"(adjective) Needing someone or something for support or help.","example":{"text":"He is totally dependent on his parents.","source":{"kind":"tatoeba","sentenceId":292917,"author":"CK"}},"audio":"audio/b27c107c4c4ffbe0.m4a"},{"id":"ex.vocab.deposit","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"deposit","back":"(noun) A sum of money placed in a bank account, or a payment made as security.","example":{"text":"I have a deposit of a thousand dollars here.","source":{"kind":"tatoeba","sentenceId":259677,"author":"CK"}},"audio":"audio/d549886d58469946.m4a"},{"id":"ex.vocab.depress","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"depress","back":"(verb) To make someone feel very sad and without hope.","example":{"text":"The bad news will depress him.","source":{"kind":"generated"}},"audio":"audio/ca8da96fe2a27e0d.m4a"},{"id":"ex.vocab.depression","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"depression","back":"(noun) A state of feeling very sad and hopeless for a long time.","example":{"text":"I suffer from depression during the winter.","source":{"kind":"tatoeba","sentenceId":653327,"author":"CK"}},"audio":"audio/085215efaecf5bd0.m4a"},{"id":"ex.vocab.descend","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"descend","back":"(verb) To move or go downwards from a higher place to a lower one.","example":{"text":"The plane began to descend.","source":{"kind":"tatoeba","sentenceId":3891150,"author":"Amastan"}},"audio":"audio/e6d90a47480bf277.m4a"},{"id":"ex.vocab.deserve","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"deserve","back":"(verb) To have earned something, good or bad, because of your actions or qualities.","example":{"text":"We deserve to be happy.","source":{"kind":"tatoeba","sentenceId":2044533,"author":"CK"}},"audio":"audio/17afeec6b2bc3526.m4a"},{"id":"ex.vocab.desire","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"desire","back":"(noun) A strong feeling of wanting something or wishing for something to happen.","example":{"text":"I don't have much desire for wealth.","source":{"kind":"tatoeba","sentenceId":257694,"author":"CK"}},"audio":"audio/4d163269d8b85890.m4a"},{"id":"ex.vocab.desperate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"desperate","back":"(adjective) Feeling or showing that you have lost all hope and are ready to do anything.","example":{"text":"Tom was desperate to sell his car.","source":{"kind":"tatoeba","sentenceId":3166568,"author":"CK"}},"audio":"audio/b7e22f2d6d9f8fe4.m4a"},{"id":"ex.vocab.despite","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"despite","back":"(preposition) Without being affected by; in spite of.","example":{"text":"Despite our efforts, we failed after all.","source":{"kind":"tatoeba","sentenceId":249102,"author":"CK"}},"audio":"audio/8d6a0fefb47500d8.m4a"},{"id":"ex.vocab.destiny","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"destiny","back":"(noun) The events that will happen to a person or thing in the future, often thought to be unavoidable.","example":{"text":"I forge my own destiny.","source":{"kind":"tatoeba","sentenceId":9463557,"author":"AlanF_US"}},"audio":"audio/1fa154738803766c.m4a"},{"id":"ex.vocab.determine","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"determine","back":"(verb) To find out or establish something exactly, often after research or calculation.","example":{"text":"We've been unable to determine the cause.","source":{"kind":"tatoeba","sentenceId":3310251,"author":"CK"}},"audio":"audio/688e9451d4983d79.m4a"},{"id":"ex.vocab.determined","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"determined","back":"(adjective) Having made a firm decision to do something and not letting anything stop you.","example":{"text":"I'm determined to solve this puzzle before I go home today.","source":{"kind":"tatoeba","sentenceId":2537185,"author":"CK"}},"audio":"audio/565820c38b000166.m4a"},{"id":"ex.vocab.devastate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"devastate","back":"(verb) To completely destroy something, or to make someone feel extremely shocked and sad.","example":{"text":"The news will devastate her.","source":{"kind":"generated"}},"audio":"audio/b9c1ea58fc5964b8.m4a"},{"id":"ex.vocab.devil","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"devil","back":"(noun) An evil spirit, or a very bad person.","example":{"text":"He was a little devil when he was a child.","source":{"kind":"generated"}},"audio":"audio/f35153969c739944.m4a"},{"id":"ex.vocab.devoted","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"devoted","back":"(adjective) Giving a lot of love, attention, or time to someone or something.","example":{"text":"She is devoted to sport.","source":{"kind":"tatoeba","sentenceId":311040,"author":"Dejo"}},"audio":"audio/2c6bedfa5bed48ea.m4a"},{"id":"ex.vocab.devour","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"devour","back":"(verb) To eat something quickly and completely, or to read a book with great interest.","example":{"text":"I devour books of poetry.","source":{"kind":"tatoeba","sentenceId":5937710,"author":"mailohilohi"}},"audio":"audio/1fe863796cc2f1cb.m4a"},{"id":"ex.vocab.dialect","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"dialect","back":"(noun) A form of a language spoken in a particular area or by a particular group.","example":{"text":"He speaks in a dialect.","source":{"kind":"tatoeba","sentenceId":7840481,"author":"sharris123"}},"audio":"audio/db7b656be43c1217.m4a"},{"id":"ex.vocab.dictator","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"dictator","back":"(noun) A ruler who has complete power over a country and often uses it cruelly.","example":{"text":"I refuse to be a dictator.","source":{"kind":"tatoeba","sentenceId":6092619,"author":"mailohilohi"}},"audio":"audio/dd096b844c22137a.m4a"},{"id":"ex.vocab.dinar","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"dinar","back":"(noun) A unit of money used in several countries, such as Algeria or Kuwait.","example":{"text":"He has four hundred dinars.","source":{"kind":"tatoeba","sentenceId":8179700,"author":"Amastan"}},"audio":"audio/a56b8e2dc96c0a82.m4a"},{"id":"ex.vocab.discourage","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"discourage","back":"(verb) To make someone feel less confident or enthusiastic about doing something.","example":{"text":"My parents discouraged me from traveling alone.","source":{"kind":"tatoeba","sentenceId":3341855,"author":"CK"}},"audio":"audio/70ce4f3e7ddf884f.m4a"},{"id":"ex.vocab.disease","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"disease","back":"(noun) An illness that affects people, animals, or plants.","example":{"text":"How does this disease spread?","source":{"kind":"tatoeba","sentenceId":57425,"author":"CK"}},"audio":"audio/207fa0ac58629ebf.m4a"},{"id":"ex.vocab.disgust","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"disgust","back":"(noun) a strong feeling of dislike and disapproval for something unpleasant.","example":{"text":"She felt great disgust at the messy room.","source":{"kind":"generated"}},"audio":"audio/036cd11e750d60e7.m4a"},{"id":"ex.vocab.dismiss","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"dismiss","back":"(verb) To send someone away, or to decide that something is not important.","example":{"text":"I dismissed it as something that's not important.","source":{"kind":"tatoeba","sentenceId":7961432,"author":"Amastan"}},"audio":"audio/418ef92c859cf08f.m4a"},{"id":"ex.vocab.disorder","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"disorder","back":"(noun) A state of confusion or lack of organization, or a problem with the way a body or mind works.","example":{"text":"I have an eating disorder.","source":{"kind":"tatoeba","sentenceId":2358977,"author":"CK"}},"audio":"audio/b072576a1d93b62b.m4a"},{"id":"ex.vocab.dispute","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"dispute","back":"(noun) A disagreement or argument between people or groups.","example":{"text":"We succeeded in settling the dispute.","source":{"kind":"tatoeba","sentenceId":248155,"author":"CK"}},"audio":"audio/78a9b1c1f9fb34fe.m4a"},{"id":"ex.vocab.disrespectful","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"disrespectful","back":"(adjective) Showing a lack of politeness or honor towards someone or something.","example":{"text":"What Tom said was very disrespectful.","source":{"kind":"tatoeba","sentenceId":6343137,"author":"CK"}},"audio":"audio/8128507d6669a7ba.m4a"},{"id":"ex.vocab.distinguish","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"distinguish","back":"(verb) To recognize the difference between two or more things.","example":{"text":"They sound so similar it's not easy to distinguish them.","source":{"kind":"tatoeba","sentenceId":1136727,"author":"CM"}},"audio":"audio/3a8c8163bbf4db31.m4a"},{"id":"ex.vocab.distract","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"distract","back":"(verb) To take someone's attention away from what they are doing or should be doing.","example":{"text":"Tom was too distracted by her beauty to answer the question.","source":{"kind":"tatoeba","sentenceId":2984522,"author":"Hybrid"}},"audio":"audio/2a11ca23958f7315.m4a"},{"id":"ex.vocab.disturbing","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"disturbing","back":"(adjective) Causing worry, anxiety, or upset.","example":{"text":"I've just heard a disturbing rumor.","source":{"kind":"tatoeba","sentenceId":241677,"author":"CK"}},"audio":"audio/5fa6abe3483ac2d9.m4a"},{"id":"ex.vocab.ditch","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ditch","back":"(noun) A long, narrow channel dug in the ground, often for drainage.","example":{"text":"Tom jumped over the ditch.","source":{"kind":"tatoeba","sentenceId":1164487,"author":"CK"}},"audio":"audio/d1c9943c0c8febb3.m4a"},{"id":"ex.vocab.doubt","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"doubt","back":"(noun) A feeling of not being sure about something, or a lack of certainty.","example":{"text":"There is no doubt as to who will be elected.","source":{"kind":"tatoeba","sentenceId":40424,"author":"orcrist"}},"audio":"audio/52e3d9738104001a.m4a"},{"id":"ex.vocab.drain","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"drain","back":"(verb) To make liquid flow away from something, or to empty a container.","example":{"text":"Have you drained the bathtub?","source":{"kind":"tatoeba","sentenceId":8395869,"author":"CK"}},"audio":"audio/328ad1a2f21ed66e.m4a"},{"id":"ex.vocab.drown","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"drown","back":"(verb) To die by being underwater and unable to breathe, or to kill someone this way.","example":{"text":"He drowned in the river.","source":{"kind":"tatoeba","sentenceId":300670,"author":"CK"}},"audio":"audio/903d921fbd186d1a.m4a"},{"id":"ex.vocab.dumb","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"dumb","back":"(adjective) Unable to speak, or very stupid.","example":{"text":"She was blind, deaf, and dumb.","source":{"kind":"tatoeba","sentenceId":478574,"author":"BlueLagoon"}},"audio":"audio/619ebf9d25325ad9.m4a"},{"id":"ex.vocab.dump","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"dump","back":"(verb) To get rid of something or someone you no longer want, often quickly or carelessly.","example":{"text":"She dumped him for a richer man.","source":{"kind":"tatoeba","sentenceId":887097,"author":"CK"}},"audio":"audio/234875c41c88e092.m4a"},{"id":"ex.vocab.duty","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"duty","back":"(noun) Something you must do because it is morally right or because of your job.","example":{"text":"I am on duty now.","source":{"kind":"tatoeba","sentenceId":241819,"author":"CK"}},"audio":"audio/b4b38bb5b6879ed1.m4a"},{"id":"ex.vocab.eager","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"eager","back":"(adjective) Very keen and excited to do or have something.","example":{"text":"People were eager for peace.","source":{"kind":"tatoeba","sentenceId":270506,"author":"CK"}},"audio":"audio/f649c68ae726b85c.m4a"},{"id":"ex.vocab.ease","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ease","back":"(noun) a state of comfort and relaxation, or the absence of difficulty.","example":{"text":"I can read Spanish with ease.","source":{"kind":"tatoeba","sentenceId":262110,"author":"Alkrasnov"}},"audio":"audio/b0fe631f3344bc64.m4a"},{"id":"ex.vocab.economic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"economic","back":"(adjective) Relating to the economy, trade, industry, and money of a country or region.","example":{"text":"The economic situation grew worse.","source":{"kind":"tatoeba","sentenceId":807193,"author":"Source_VOA"}},"audio":"audio/4dcf2672dac215f0.m4a"},{"id":"ex.vocab.economy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"economy","back":"(noun) The system by which a country's money, industry, and trade are organized.","example":{"text":"The economy is picking up.","source":{"kind":"tatoeba","sentenceId":237950,"author":"CK"}},"audio":"audio/20b6485c13e79ffb.m4a"},{"id":"ex.vocab.ecosystem","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ecosystem","back":"(noun) All the living things in an area and how they interact with each other and their environment.","example":{"text":"We need to study the effects of plastic waste on the Algerian ecosystem.","source":{"kind":"tatoeba","sentenceId":8589094,"author":"Amastan"}},"audio":"audio/04de92fc5c0fb59b.m4a"},{"id":"ex.vocab.edible","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"edible","back":"(adjective) Safe or fit to be eaten.","example":{"text":"The seeds are also edible.","source":{"kind":"tatoeba","sentenceId":10908147,"author":"CM"}},"audio":"audio/1844b622dfa76704.m4a"},{"id":"ex.vocab.efficient","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"efficient","back":"(adjective) Working well and quickly, without wasting time or energy.","example":{"text":"The rapid transit system is modern and efficient.","source":{"kind":"tatoeba","sentenceId":6464028,"author":"CarpeLanam"}},"audio":"audio/ed3307bde14fe243.m4a"},{"id":"ex.vocab.election","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"election","back":"(noun) A formal process where people choose their leaders or representatives by voting.","example":{"text":"He was elected to the Senate in the last election.","source":{"kind":"tatoeba","sentenceId":300718,"author":"CK"}},"audio":"audio/cd76f5e0f8407c21.m4a"},{"id":"ex.vocab.element","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"element","back":"(noun) A necessary or typical part of something larger.","example":{"text":"There's an element of luck involved.","source":{"kind":"tatoeba","sentenceId":7932369,"author":"Hybrid"}},"audio":"audio/a8df50b046a58f64.m4a"},{"id":"ex.vocab.eliminate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"eliminate","back":"(verb) To completely remove or get rid of something.","example":{"text":"We can eliminate parking fees.","source":{"kind":"tatoeba","sentenceId":5731916,"author":"CM"}},"audio":"audio/cf6b3a3c666c25b4.m4a"},{"id":"ex.vocab.embassy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"embassy","back":"(noun) The official building where an ambassador and their staff work in a foreign country.","example":{"text":"Excuse me, where's the American Embassy?","source":{"kind":"tatoeba","sentenceId":875754,"author":"CK"}},"audio":"audio/401ececf63619a3d.m4a"},{"id":"ex.vocab.embrace","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"embrace","back":"(verb) To hold someone closely in your arms; or to accept an idea or change.","example":{"text":"Tom tried to embrace Mary.","source":{"kind":"tatoeba","sentenceId":3592893,"author":"CK"}},"audio":"audio/c84e1663a7ac4a48.m4a"},{"id":"ex.vocab.emerge","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"emerge","back":"(verb) To come out from a hidden or enclosed place.","example":{"text":"The moon emerged from behind the cloud.","source":{"kind":"tatoeba","sentenceId":238778,"author":"CK"}},"audio":"audio/f27a729512976d0b.m4a"},{"id":"ex.vocab.emotional","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"emotional","back":"(adjective) Relating to feelings and emotions, or showing strong feelings.","example":{"text":"Tom was subject to physical and emotional abuse.","source":{"kind":"tatoeba","sentenceId":4630485,"author":"Amastan"}},"audio":"audio/714bc277c8e6ed0e.m4a"},{"id":"ex.vocab.encounter","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"encounter","back":"(verb) To meet someone or experience something unexpectedly.","example":{"text":"Never in his life had he encountered such a dilemma.","source":{"kind":"tatoeba","sentenceId":289979,"author":"CK"}},"audio":"audio/5d80f481d4864a3c.m4a"},{"id":"ex.vocab.endless","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"endless","back":"(adjective) Having no end, or seeming to have no end; continuing forever.","example":{"text":"He bored me with his endless tales.","source":{"kind":"tatoeba","sentenceId":285444,"author":"CK"}},"audio":"audio/03ac08ebf5babb7a.m4a"},{"id":"ex.vocab.engage","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"engage","back":"(verb) To become involved in something, or to attract and keep someone's attention.","example":{"text":"She wants to engage in teaching.","source":{"kind":"tatoeba","sentenceId":313261,"author":"rul"}},"audio":"audio/2951e1b5116f1422.m4a"},{"id":"ex.vocab.engagement","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"engagement","back":"(noun) A formal agreement to marry someone, or a planned meeting or appointment.","example":{"text":"He announced his engagement to her.","source":{"kind":"tatoeba","sentenceId":302612,"author":"CK"}},"audio":"audio/bd43aa58da16748e.m4a"},{"id":"ex.vocab.ensure","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ensure","back":"(verb) To make certain that something will happen or be the case.","example":{"text":"This medicine will ensure you a good night's sleep.","source":{"kind":"tatoeba","sentenceId":56534,"author":"CM"}},"audio":"audio/c84223f307be2f56.m4a"},{"id":"ex.vocab.enthusiasm","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"enthusiasm","back":"(noun) A strong feeling of excitement and interest in something.","example":{"text":"He shows great enthusiasm for his work.","source":{"kind":"tatoeba","sentenceId":297033,"author":"CK"}},"audio":"audio/52865fe96347b2e8.m4a"},{"id":"ex.vocab.enthusiastic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"enthusiastic","back":"(adjective) Showing great interest or excitement about something.","example":{"text":"Tom is enthusiastic about tennis.","source":{"kind":"tatoeba","sentenceId":6261340,"author":"CK"}},"audio":"audio/8dfe70f30687889d.m4a"},{"id":"ex.vocab.entirely","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"entirely","back":"(adverb) Completely and fully; in every way.","example":{"text":"It's entirely up to you.","source":{"kind":"tatoeba","sentenceId":42628,"author":"CK"}},"audio":"audio/e7653bfd42c39a9c.m4a"},{"id":"ex.vocab.environmental","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"environmental","back":"(adjective) Relating to the natural world, such as land, water, air, and the living things in it.","example":{"text":"They always give their attention to environmental problems.","source":{"kind":"tatoeba","sentenceId":680295,"author":"Source_VOA"}},"audio":"audio/19f47267d0f58fcd.m4a"},{"id":"ex.vocab.envy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"envy","back":"(noun) The unhappy feeling of wanting something that another person has.","example":{"text":"Your success excites my envy.","source":{"kind":"tatoeba","sentenceId":17022,"author":"Zifre"}},"audio":"audio/df4495f828fce40e.m4a"},{"id":"ex.vocab.era","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"era","back":"(noun) A long and distinct period of history or time.","example":{"text":"This is the beginning of a new era.","source":{"kind":"tatoeba","sentenceId":3007072,"author":"CM"}},"audio":"audio/c0528962958b4ec0.m4a"},{"id":"ex.vocab.escort","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"escort","back":"(noun) A person or group of people who go with someone to protect them or show them the way.","example":{"text":"The president arrived with a police escort.","source":{"kind":"generated"}},"audio":"audio/c060c00f2db5d21c.m4a"},{"id":"ex.vocab.essential","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"essential","back":"(adjective) Absolutely necessary or important.","example":{"text":"Food is essential to life.","source":{"kind":"tatoeba","sentenceId":268782,"author":"CK"}},"audio":"audio/2408c1f4606c17f7.m4a"},{"id":"ex.vocab.establish","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"establish","back":"(verb) To set up or create something, or to prove something to be true.","example":{"text":"A free port was established.","source":{"kind":"tatoeba","sentenceId":2264591,"author":"_undertoad"}},"audio":"audio/0c8f2b198cf613e5.m4a"},{"id":"ex.vocab.estate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"estate","back":"(noun) All the money and property owned by a particular person, especially at death.","example":{"text":"Tom wishes for his son to inherit his estate.","source":{"kind":"tatoeba","sentenceId":1140851,"author":"CK"}},"audio":"audio/388ce059e0912825.m4a"},{"id":"ex.vocab.ethnic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ethnic","back":"(adjective) Relating to a particular race, nation, or cultural group.","example":{"text":"Do you know an ethnic dance?","source":{"kind":"tatoeba","sentenceId":680847,"author":"Source_VOA"}},"audio":"audio/cb33289e93066a20.m4a"},{"id":"ex.vocab.eventually","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"eventually","back":"(adverb) In the end, especially after a long time or a lot of problems.","example":{"text":"Tom eventually found a job that he liked.","source":{"kind":"tatoeba","sentenceId":1094169,"author":"CK"}},"audio":"audio/05dda027e338ae4e.m4a"},{"id":"ex.vocab.evidence","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"evidence","back":"(noun) Facts or information that show something is true or not true.","example":{"text":"What evidence do you have?","source":{"kind":"tatoeba","sentenceId":36603,"author":"CK"}},"audio":"audio/5ff65b630bc783e5.m4a"},{"id":"ex.vocab.exaggerate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"exaggerate","back":"(verb) To make something seem larger, better, or worse than it really is.","example":{"text":"Tom does tend to exaggerate.","source":{"kind":"tatoeba","sentenceId":6078577,"author":"CK"}},"audio":"audio/4b5d32df90b78c0b.m4a"},{"id":"ex.vocab.execute","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"execute","back":"(verb) To kill someone as a legal punishment.","example":{"text":"He was executed as a spy.","source":{"kind":"tatoeba","sentenceId":290310,"author":"CK"}},"audio":"audio/c49c7c1862307176.m4a"},{"id":"ex.vocab.exist","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"exist","back":"(verb) To be real, to be present, or to live.","example":{"text":"Life cannot exist without water.","source":{"kind":"tatoeba","sentenceId":466972,"author":"Zifre"}},"audio":"audio/9195b0b936284441.m4a"},{"id":"ex.vocab.existence","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"existence","back":"(noun) The state of being real or living.","example":{"text":"I believe in the existence of ghosts.","source":{"kind":"tatoeba","sentenceId":9304065,"author":"Nylez"}},"audio":"audio/76ffdbfa20fc49a6.m4a"},{"id":"ex.vocab.expel","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"expel","back":"(verb) To force someone to leave a place or organization.","example":{"text":"After his argument, they expelled him from the club.","source":{"kind":"tatoeba","sentenceId":680881,"author":"Source_VOA"}},"audio":"audio/f6577b1404844baa.m4a"},{"id":"ex.vocab.expense","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"expense","back":"(noun) The money you spend on something, or the cost of something.","example":{"text":"We have to cut down our monthly expenses.","source":{"kind":"tatoeba","sentenceId":262984,"author":"CK"}},"audio":"audio/dab79e9dc347c3f4.m4a"},{"id":"ex.vocab.expire","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"expire","back":"(verb) To become no longer valid or usable after a certain period of time.","example":{"text":"This box of cereal has expired.","source":{"kind":"tatoeba","sentenceId":6702314,"author":"Eccles17"}},"audio":"audio/9cd08cd99498088d.m4a"},{"id":"ex.vocab.export","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"export","back":"(verb) To send goods to another country for sale.","example":{"text":"Algeria exports oil and gas.","source":{"kind":"tatoeba","sentenceId":7858760,"author":"Amastan"}},"audio":"audio/fb91355771e27e9c.m4a"},{"id":"ex.vocab.expose","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"expose","back":"(verb) To make something visible or known, or to put someone in a risky situation.","example":{"text":"It's dangerous to expose babies to strong sunlight.","source":{"kind":"tatoeba","sentenceId":272345,"author":"CM"}},"audio":"audio/8e856043d1ffe1c5.m4a"},{"id":"ex.vocab.extreme","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"extreme","back":"(adjective) Very great in degree or intensity; far beyond what is usual.","example":{"text":"The physical demands are extreme.","source":{"kind":"tatoeba","sentenceId":5726214,"author":"CM"}},"audio":"audio/9ce81df763f52ab6.m4a"},{"id":"ex.vocab.eyesight","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"eyesight","back":"(noun) The ability to see.","example":{"text":"My eyesight is not good.","source":{"kind":"tatoeba","sentenceId":4010297,"author":"Hybrid"}},"audio":"audio/3d7e82fa66c48ec9.m4a"},{"id":"ex.vocab.facility","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"facility","back":"(noun) A place, building, or equipment used for a particular purpose.","example":{"text":"Our town has excellent sports facilities.","source":{"kind":"tatoeba","sentenceId":2082274,"author":"CK"}},"audio":"audio/1d8dcc475a6972b3.m4a"},{"id":"ex.vocab.faint","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"faint","back":"(adjective) Not strong or clear; difficult to see, hear, or smell. Or feeling weak and dizzy.","example":{"text":"I have a faint recollection of the event.","source":{"kind":"tatoeba","sentenceId":50429,"author":"CM"}},"audio":"audio/15fe8bf0925fd907.m4a"},{"id":"ex.vocab.faith","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"faith","back":"(noun) Strong belief or trust in someone or something.","example":{"text":"I have faith in you.","source":{"kind":"tatoeba","sentenceId":1345046,"author":"CM"}},"audio":"audio/a8abb7ee5a1a831f.m4a"},{"id":"ex.vocab.fascinating","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"fascinating","back":"(adjective) Extremely interesting and attractive.","example":{"text":"This is an absolutely fascinating topic.","source":{"kind":"tatoeba","sentenceId":2674734,"author":"Hybrid"}},"audio":"audio/91cce891fa2a9451.m4a"},{"id":"ex.vocab.fate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"fate","back":"(noun) A power that is believed to control what happens in the future.","example":{"text":"I will accept my fate.","source":{"kind":"tatoeba","sentenceId":3723471,"author":"CM"}},"audio":"audio/9847e71013a50b4f.m4a"},{"id":"ex.vocab.fellow","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"fellow","back":"(noun) A man or boy, or a person who shares a situation or activity with you.","example":{"text":"He is a mean fellow.","source":{"kind":"tatoeba","sentenceId":25349,"author":"CM"}},"audio":"audio/f10353e3a588f1b6.m4a"},{"id":"ex.vocab.fig","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"fig","back":"(noun) A soft, sweet fruit with many small seeds, often eaten dried.","example":{"text":"Figs are very expensive right now.","source":{"kind":"tatoeba","sentenceId":8396046,"author":"CK"}},"audio":"audio/3c90e26fdb8cd04c.m4a"},{"id":"ex.vocab.filthy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"filthy","back":"(adjective) Extremely dirty.","example":{"text":"Yanni's children were completely filthy.","source":{"kind":"tatoeba","sentenceId":9331740,"author":"Amastan"}},"audio":"audio/879986e9f2b98b85.m4a"},{"id":"ex.vocab.finance","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"finance","back":"(noun) The management of money, especially by governments or large companies.","example":{"text":"Keep track of your finances.","source":{"kind":"tatoeba","sentenceId":4905007,"author":"CK"}},"audio":"audio/0a9e2b0f02acf9b0.m4a"},{"id":"ex.vocab.financial","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"financial","back":"(adjective) Relating to money or how money is managed.","example":{"text":"The financial crisis has left many unemployed.","source":{"kind":"tatoeba","sentenceId":483068,"author":"CM"}},"audio":"audio/55497eff073616d5.m4a"},{"id":"ex.vocab.flee","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"flee","back":"(verb) To run away from a place or situation of danger.","example":{"text":"The suspects fled the scene.","source":{"kind":"tatoeba","sentenceId":5736435,"author":"CM"}},"audio":"audio/6a57db6650a270eb.m4a"},{"id":"ex.vocab.fluently","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"fluently","back":"(adverb) Able to speak or write a language easily, accurately, and without hesitation.","example":{"text":"I can speak French fluently.","source":{"kind":"tatoeba","sentenceId":2628711,"author":"CK"}},"audio":"audio/214a8a1acaf76850.m4a"},{"id":"ex.vocab.flush","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"flush","back":"(verb) To clean a toilet by making water flow through it.","example":{"text":"Tom forgot to flush the toilet.","source":{"kind":"tatoeba","sentenceId":5156944,"author":"CK"}},"audio":"audio/86740d2c4e3e6f38.m4a"},{"id":"ex.vocab.foolish","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"foolish","back":"(adjective) Not sensible or wise; showing a lack of good judgment.","example":{"text":"He tried to rationalize his foolish actions.","source":{"kind":"tatoeba","sentenceId":298610,"author":"CK"}},"audio":"audio/fe0dca943a6eb061.m4a"},{"id":"ex.vocab.footprint","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"footprint","back":"(noun) The mark left by a foot or shoe; or the amount of space or impact something has.","example":{"text":"Tom and Mary have a low carbon footprint.","source":{"kind":"tatoeba","sentenceId":7781340,"author":"Hybrid"}},"audio":"audio/b4312b5de30035a9.m4a"},{"id":"ex.vocab.forbid","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"forbid","back":"(verb) To order someone not to do something, or to not allow something to happen.","example":{"text":"I forbid you to leave.","source":{"kind":"tatoeba","sentenceId":1346632,"author":"CK"}},"audio":"audio/bbb5e0c0b0a48e2a.m4a"},{"id":"ex.vocab.fortunate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"fortunate","back":"(adjective) having good luck; lucky.","example":{"text":"You are fortunate to have such loving parents.","source":{"kind":"tatoeba","sentenceId":66935,"author":"CK"}},"audio":"audio/01ced256c5fb3a75.m4a"},{"id":"ex.vocab.fortune","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"fortune","back":"(noun) A very large amount of money, or chance and luck.","example":{"text":"He made a fortune by writing a best selling novel.","source":{"kind":"tatoeba","sentenceId":292651,"author":"CK"}},"audio":"audio/fa6b3b9f9579ebe8.m4a"},{"id":"ex.vocab.fossil","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"fossil","back":"(noun) The remains of an animal or plant from a past geological age, preserved in rock.","example":{"text":"Fossil fuels won't be available forever.","source":{"kind":"tatoeba","sentenceId":25341,"author":"CK"}},"audio":"audio/6c42b19570c99d52.m4a"},{"id":"ex.vocab.foster","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"foster","back":"(verb) To help something develop or grow, or to take care of a child who is not your own.","example":{"text":"Communication fosters understanding and helps us understand each other.","source":{"kind":"tatoeba","sentenceId":5097318,"author":"Zurich899"}},"audio":"audio/acac7294cb75c217.m4a"},{"id":"ex.vocab.foundation","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"foundation","back":"(noun) The solid base on which a building is built, or the basic idea something is based on.","example":{"text":"This house has a solid foundation.","source":{"kind":"tatoeba","sentenceId":60134,"author":"CK"}},"audio":"audio/da0c62a764a5fc49.m4a"},{"id":"ex.vocab.frank","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"frank","back":"(adjective) Saying exactly what you think, even if it might upset someone.","example":{"text":"Am I being too frank?","source":{"kind":"tatoeba","sentenceId":11877592,"author":"CK"}},"audio":"audio/171b4d4c3d5a33ef.m4a"},{"id":"ex.vocab.frantic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"frantic","back":"(adjective) Feeling or showing a lot of worry and fear, often in a wild or uncontrolled way.","example":{"text":"She was frantic when she couldn't find her keys.","source":{"kind":"generated"}},"audio":"audio/f0fd53fc4bae5fb9.m4a"},{"id":"ex.vocab.freak","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"freak","back":"(noun) A person or thing that is unusual or abnormal, often in a strange or surprising way.","example":{"text":"Tom is a freak of nature.","source":{"kind":"tatoeba","sentenceId":4870450,"author":"Hybrid"}},"audio":"audio/b2c0966de213aa07.m4a"},{"id":"ex.vocab.frequently","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"frequently","back":"(adverb) Happening or doing something often.","example":{"text":"I frequently talk to Tom.","source":{"kind":"tatoeba","sentenceId":2545621,"author":"CK"}},"audio":"audio/10102e60f41d7738.m4a"},{"id":"ex.vocab.frustrated","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"frustrated","back":"(adjective) Feeling annoyed or impatient because you cannot achieve what you want.","example":{"text":"Tom started getting impatient and frustrated.","source":{"kind":"tatoeba","sentenceId":4384134,"author":"Hybrid"}},"audio":"audio/a62e28574c166d50.m4a"},{"id":"ex.vocab.fulfill","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"fulfill","back":"(verb) To do what is required or promised, or to make something happen.","example":{"text":"Try to fulfill your duty.","source":{"kind":"tatoeba","sentenceId":20029,"author":"CK"}},"audio":"audio/03369fd0cf9bd71e.m4a"},{"id":"ex.vocab.function","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"function","back":"(noun) The purpose or role of a person or thing; or how something works.","example":{"text":"The menopause is the permanent cessation of the ovaries' principal functions.","source":{"kind":"tatoeba","sentenceId":4582691,"author":"Sladey"}},"audio":"audio/1fba3a2f0205a36c.m4a"},{"id":"ex.vocab.funeral","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"funeral","back":"(noun) A ceremony held for a dead person, usually before burial or cremation.","example":{"text":"Mourners wear black at funerals.","source":{"kind":"tatoeba","sentenceId":10643332,"author":"shekitten"}},"audio":"audio/28567591d561f804.m4a"},{"id":"ex.vocab.furious","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"furious","back":"(adjective) Extremely angry.","example":{"text":"Mary would be furious if she knew.","source":{"kind":"tatoeba","sentenceId":5796800,"author":"Hybrid"}},"audio":"audio/5401b4fdd2c2b045.m4a"},{"id":"ex.vocab.further","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"further","back":"(adverb) More; to a greater degree or extent.","example":{"text":"Have you any further questions?","source":{"kind":"tatoeba","sentenceId":41735,"author":"shekitten"}},"audio":"audio/c9e0bcdbb3b5a297.m4a"},{"id":"ex.vocab.fussy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"fussy","back":"(adjective) Hard to please and only happy with very specific things.","example":{"text":"Tom was a very fussy eater when he was a child.","source":{"kind":"tatoeba","sentenceId":6724324,"author":"CK"}},"audio":"audio/e14e0cdc504e58cd.m4a"},{"id":"ex.vocab.galaxy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"galaxy","back":"(noun) A very large group of stars, gas, and dust held together by gravity.","example":{"text":"Our Milky Way is a galaxy.","source":{"kind":"tatoeba","sentenceId":8383986,"author":"cromwellt"}},"audio":"audio/ecc6f51349988260.m4a"},{"id":"ex.vocab.gamble","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"gamble","back":"(verb) To risk money on a game or race, hoping to win more money.","example":{"text":"Do you like to gamble?","source":{"kind":"tatoeba","sentenceId":3390698,"author":"CK"}},"audio":"audio/a6ada1e31caedcad.m4a"},{"id":"ex.vocab.gang","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"gang","back":"(noun) A group of friends who spend time together, or a group of criminals.","example":{"text":"The gang is all here.","source":{"kind":"tatoeba","sentenceId":2547640,"author":"CK"}},"audio":"audio/e3e75d73512ac956.m4a"},{"id":"ex.vocab.gaze","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"gaze","back":"(verb) To look steadily at someone or something for a long time.","example":{"text":"He stood gazing at the painting.","source":{"kind":"tatoeba","sentenceId":290633,"author":"CM"}},"audio":"audio/c14eea894a6d831f.m4a"},{"id":"ex.vocab.gender","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"gender","back":"(noun) The state of being male or female, or a social and cultural category.","example":{"text":"Equestrian is the only mixed-gender Olympic event.","source":{"kind":"tatoeba","sentenceId":329064,"author":"fcbond"}},"audio":"audio/59a415667f52909c.m4a"},{"id":"ex.vocab.generous","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"generous","back":"(adjective) Willing to give money, help, or time freely, or larger than usual in amount.","example":{"text":"I appreciated my neighbor's generous offer.","source":{"kind":"tatoeba","sentenceId":681618,"author":"Source_VOA"}},"audio":"audio/e7f34591572664cb.m4a"},{"id":"ex.vocab.genius","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"genius","back":"(noun) Someone who has an exceptionally high level of intelligence or a special natural ability.","example":{"text":"She is a genius at mathematics.","source":{"kind":"tatoeba","sentenceId":315281,"author":"CK"}},"audio":"audio/c51c32db06b04650.m4a"},{"id":"ex.vocab.genuinely","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"genuinely","back":"(adverb) Truly and sincerely; in a real and honest way.","example":{"text":"I'm genuinely happy for Tom.","source":{"kind":"tatoeba","sentenceId":2044665,"author":"CK"}},"audio":"audio/9b22c257696f27a9.m4a"},{"id":"ex.vocab.gifted","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"gifted","back":"(adjective) Having a natural ability to do something well.","example":{"text":"Tom is a gifted actor.","source":{"kind":"tatoeba","sentenceId":6273925,"author":"CK"}},"audio":"audio/8a1796fb380a06b8.m4a"},{"id":"ex.vocab.glare","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"glare","back":"(verb) To look at someone in an angry or fierce way, or to shine with a very strong, bright light.","example":{"text":"He was still glaring at us.","source":{"kind":"tatoeba","sentenceId":8572681,"author":"Amastan"}},"audio":"audio/d7f9a0cfa3965406.m4a"},{"id":"ex.vocab.goods","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"goods","back":"(noun) Things that are produced to be sold.","example":{"text":"That store sells a wide range of goods.","source":{"kind":"tatoeba","sentenceId":67901,"author":"Lumi_alt"}},"audio":"audio/e81e666949fb6b04.m4a"},{"id":"ex.vocab.gorgeous","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"gorgeous","back":"(adjective) Extremely beautiful or attractive.","example":{"text":"This is a gorgeous town.","source":{"kind":"tatoeba","sentenceId":57835,"author":"CM"}},"audio":"audio/7a8a93492103de06.m4a"},{"id":"ex.vocab.graduate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"graduate","back":"(verb) To complete your studies at a university, college, or school.","example":{"text":"I graduated from the school.","source":{"kind":"tatoeba","sentenceId":21479,"author":"Whiskkebarr"}},"audio":"audio/0f25418c18c4f1fd.m4a"},{"id":"ex.vocab.grammatical","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"grammatical","back":"(adjective) Following the rules of grammar.","example":{"text":"Tom made some grammatical errors.","source":{"kind":"tatoeba","sentenceId":6849289,"author":"CK"}},"audio":"audio/44fe05e0d0c13efc.m4a"},{"id":"ex.vocab.grant","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"grant","back":"(verb) To agree to give or allow something requested.","example":{"text":"Without hesitation, I granted his request.","source":{"kind":"tatoeba","sentenceId":254989,"author":"CK"}},"audio":"audio/bd708a3d7142038f.m4a"},{"id":"ex.vocab.grateful","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"grateful","back":"(adjective) Feeling or showing thanks to someone for something.","example":{"text":"We're very grateful for your hospitality.","source":{"kind":"tatoeba","sentenceId":70530,"author":"CK"}},"audio":"audio/30f3eb86abfeb5c3.m4a"},{"id":"ex.vocab.graze","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"graze","back":"(verb) When animals eat grass or other plants in a field.","example":{"text":"The cow is grazing in the field.","source":{"kind":"tatoeba","sentenceId":1798365,"author":"Amastan"}},"audio":"audio/ae3baed3797fc799.m4a"},{"id":"ex.vocab.grief","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"grief","back":"(noun) A very strong feeling of sadness, especially after someone dies.","example":{"text":"She is filled with grief.","source":{"kind":"tatoeba","sentenceId":6573939,"author":"Eccles17"}},"audio":"audio/8119d6ab55745e45.m4a"},{"id":"ex.vocab.growl","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"growl","back":"(verb) To make a low, rough sound in the throat, often showing anger or warning.","example":{"text":"The dog growled at me.","source":{"kind":"tatoeba","sentenceId":4718981,"author":"hinto4"}},"audio":"audio/ef0445c682dc62cb.m4a"},{"id":"ex.vocab.growth","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"growth","back":"(noun) The process of increasing in size, amount, or importance.","example":{"text":"We must prevent rapid population growth.","source":{"kind":"tatoeba","sentenceId":812470,"author":"FeuDRenais2"}},"audio":"audio/85a9f9a57399f6f5.m4a"},{"id":"ex.vocab.guarantee","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"guarantee","back":"(noun) A formal promise that something will be done or will happen.","example":{"text":"Nobility is no guarantee of wisdom.","source":{"kind":"tatoeba","sentenceId":2854536,"author":"Dejo"}},"audio":"audio/fff2638bfca86860.m4a"},{"id":"ex.vocab.guilt","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"guilt","back":"(noun) The unhappy feeling you have when you know you have done something wrong.","example":{"text":"I felt a lot of guilt.","source":{"kind":"tatoeba","sentenceId":8385727,"author":"CK"}},"audio":"audio/ae45077569800a4d.m4a"},{"id":"ex.vocab.gunshot","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"gunshot","back":"(noun) the sound of a gun being fired.","example":{"text":"A loud gunshot echoed through the forest.","source":{"kind":"generated"}},"audio":"audio/5f11afbdb442ec2f.m4a"},{"id":"ex.vocab.hack","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"hack","back":"(verb) To secretly get access to a computer system or network without permission.","example":{"text":"I didn't hack into anybody's computer.","source":{"kind":"tatoeba","sentenceId":2290309,"author":"CK"}},"audio":"audio/50d6867976831fc7.m4a"},{"id":"ex.vocab.harass","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"harass","back":"(verb) To annoy or trouble someone repeatedly.","example":{"text":"Tom has been accused of harassing Mary.","source":{"kind":"tatoeba","sentenceId":8045225,"author":"CK"}},"audio":"audio/65770718840aafca.m4a"},{"id":"ex.vocab.harsh","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"harsh","back":"(adjective) Difficult to live in or deal with; severe or unkind.","example":{"text":"The tundra has a harsh climate.","source":{"kind":"tatoeba","sentenceId":39741,"author":"AlanF_US"}},"audio":"audio/b952debfe77a173c.m4a"},{"id":"ex.vocab.hatred","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"hatred","back":"(noun) A very strong feeling of dislike for someone or something.","example":{"text":"Tom was consumed by hatred.","source":{"kind":"tatoeba","sentenceId":6978082,"author":"Hybrid"}},"audio":"audio/14b190e94589fd5f.m4a"},{"id":"ex.vocab.haunted","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"haunted","back":"(adjective) A place where ghosts are believed to appear regularly.","example":{"text":"I went to a haunted house.","source":{"kind":"tatoeba","sentenceId":252379,"author":"CK"}},"audio":"audio/ba8847ed27800bf6.m4a"},{"id":"ex.vocab.heartbroken","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"heartbroken","back":"(adjective) Feeling extremely sad and unhappy, often because of a loss or disappointment.","example":{"text":"Tom has to be heartbroken.","source":{"kind":"tatoeba","sentenceId":6220542,"author":"CK"}},"audio":"audio/3a3f0373efbf4325.m4a"},{"id":"ex.vocab.heather","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"heather","back":"(noun) A small, wild plant with tiny purple, pink, or white flowers that grows on hills.","example":{"text":"Most heathers are small and robust.","source":{"kind":"tatoeba","sentenceId":10860593,"author":"Amastan"}},"audio":"audio/9ea840834e5e18bc.m4a"},{"id":"ex.vocab.heavily","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"heavily","back":"(adverb) To a great degree or in large amounts.","example":{"text":"It rained heavily all day.","source":{"kind":"tatoeba","sentenceId":238490,"author":"CM"}},"audio":"audio/03b51b6f0e9657f2.m4a"},{"id":"ex.vocab.herd","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"herd","back":"(noun) A large group of animals of one kind that live and feed together.","example":{"text":"Blesboks live in large herds.","source":{"kind":"tatoeba","sentenceId":8552236,"author":"Amastan"}},"audio":"audio/d291712934578429.m4a"},{"id":"ex.vocab.hesitant","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"hesitant","back":"(adjective) Not quick or confident in acting or speaking because you are unsure or unwilling.","example":{"text":"You're hesitant to do that, aren't you?","source":{"kind":"tatoeba","sentenceId":6243886,"author":"CK"}},"audio":"audio/1361ec177b08976b.m4a"},{"id":"ex.vocab.hesitate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"hesitate","back":"(verb) To pause before doing or saying something, often because of uncertainty.","example":{"text":"Don't hesitate to ask for advice.","source":{"kind":"tatoeba","sentenceId":25792,"author":"CK"}},"audio":"audio/238a8e6b2fc29cd0.m4a"},{"id":"ex.vocab.highly","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"highly","back":"(adverb) To a great degree; very much.","example":{"text":"I think that's highly unlikely.","source":{"kind":"tatoeba","sentenceId":2408166,"author":"CK"}},"audio":"audio/764d39380146ec05.m4a"},{"id":"ex.vocab.holy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"holy","back":"(adjective) Connected with God or a religion, and considered to be very special and pure.","example":{"text":"Ramadan is a holy month.","source":{"kind":"tatoeba","sentenceId":10026016,"author":"Amastan"}},"audio":"audio/87791ae5fd944777.m4a"},{"id":"ex.vocab.honor","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"honor","back":"(noun) Respect and admiration given to someone or something.","example":{"text":"It is a great honor to be invited.","source":{"kind":"tatoeba","sentenceId":268112,"author":"CM"}},"audio":"audio/a0b435966f2cf374.m4a"},{"id":"ex.vocab.hopeless","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"hopeless","back":"(adjective) Feeling or causing a feeling that nothing good can happen or change.","example":{"text":"Tom realized that it was hopeless.","source":{"kind":"tatoeba","sentenceId":8185692,"author":"CK"}},"audio":"audio/693e09aa9088ead7.m4a"},{"id":"ex.vocab.horizon","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"horizon","back":"(noun) The line where the earth or sea seems to meet the sky.","example":{"text":"The sun appeared on the horizon.","source":{"kind":"tatoeba","sentenceId":277247,"author":"CK"}},"audio":"audio/0a6c35185b4a2866.m4a"},{"id":"ex.vocab.hostage","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"hostage","back":"(noun) A person taken by force to make others agree to demands.","example":{"text":"The negotiator worked to free the hostage.","source":{"kind":"generated"}},"audio":"audio/7cf27ceb15e8cd63.m4a"},{"id":"ex.vocab.household","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"household","back":"(noun) All the people who live together in one house or apartment.","example":{"text":"This tradition is followed in most households.","source":{"kind":"tatoeba","sentenceId":59908,"author":"CK"}},"audio":"audio/1a89211b7fbc1b17.m4a"},{"id":"ex.vocab.humanity","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"humanity","back":"(noun) all people in the world; the human race.","example":{"text":"There is hope for humanity.","source":{"kind":"tatoeba","sentenceId":6611722,"author":"mailohilohi"}},"audio":"audio/3d901a2182dbb107.m4a"},{"id":"ex.vocab.humble","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"humble","back":"(adjective) Not thinking you are more important or better than other people.","example":{"text":"Tom is a humble man.","source":{"kind":"tatoeba","sentenceId":5451990,"author":"CK"}},"audio":"audio/7d7c53888a59adfc.m4a"},{"id":"ex.vocab.identify","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"identify","back":"(verb) To recognize someone or something and say or prove who or what they are.","example":{"text":"The lost boy was identified by his clothes.","source":{"kind":"tatoeba","sentenceId":978005,"author":"CK"}},"audio":"audio/0d827f230f3f7792.m4a"},{"id":"ex.vocab.identity","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"identity","back":"(noun) who or what someone or something is.","example":{"text":"The mayor provided me with an identity card.","source":{"kind":"tatoeba","sentenceId":246162,"author":"CM"}},"audio":"audio/f97bf9a336a4e8c2.m4a"},{"id":"ex.vocab.ignorance","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ignorance","back":"(noun) A lack of knowledge or information about something.","example":{"text":"Forgive me for my ignorance.","source":{"kind":"tatoeba","sentenceId":4915742,"author":"CK"}},"audio":"audio/896ba5bfffbe5df5.m4a"},{"id":"ex.vocab.imagination","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"imagination","back":"(noun) the ability to form new ideas or images in your mind.","example":{"text":"I've got a pretty vivid imagination.","source":{"kind":"tatoeba","sentenceId":2361962,"author":"CK"}},"audio":"audio/47f2709907fccc77.m4a"},{"id":"ex.vocab.imitate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"imitate","back":"(verb) To copy the way someone or something acts, speaks, or behaves.","example":{"text":"Children often imitate their parents.","source":{"kind":"tatoeba","sentenceId":3736041,"author":"CK"}},"audio":"audio/30964ede97114aef.m4a"},{"id":"ex.vocab.immigrant","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"immigrant","back":"(noun) A person who has come to a different country to live there permanently.","example":{"text":"The United States is a country of immigrants.","source":{"kind":"tatoeba","sentenceId":3399594,"author":"Hybrid"}},"audio":"audio/2f2ae100ddf3e5fb.m4a"},{"id":"ex.vocab.impact","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"impact","back":"(noun) a powerful effect that something has on a situation or person.","example":{"text":"Skipping classes can have an enormous negative impact on your final grade.","source":{"kind":"tatoeba","sentenceId":954271,"author":"CK"}},"audio":"audio/2e014b7c08c20327.m4a"},{"id":"ex.vocab.impatient","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"impatient","back":"(adjective) Annoyed by delays, or eager to do something quickly and without waiting.","example":{"text":"Tom got impatient waiting for Mary.","source":{"kind":"tatoeba","sentenceId":2427884,"author":"CK"}},"audio":"audio/8ee7634545dd1c8a.m4a"},{"id":"ex.vocab.import","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"import","back":"(verb) To bring goods or services into a country from another country for sale.","example":{"text":"We import tea from India.","source":{"kind":"tatoeba","sentenceId":29179,"author":"CK"}},"audio":"audio/4528a069406f29c0.m4a"},{"id":"ex.vocab.impress","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"impress","back":"(verb) To make someone admire or respect you.","example":{"text":"I need to impress Tom.","source":{"kind":"tatoeba","sentenceId":2387649,"author":"CK"}},"audio":"audio/c9f0dceb6e5bdd38.m4a"},{"id":"ex.vocab.impression","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"impression","back":"(noun) An idea, feeling, or opinion about something or someone, especially one formed without much thought.","example":{"text":"His music made a deep impression on me.","source":{"kind":"tatoeba","sentenceId":260552,"author":"sundown"}},"audio":"audio/c9934862ec7cfca7.m4a"},{"id":"ex.vocab.impressive","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"impressive","back":"(adjective) Causing admiration or respect because of size, quality, or skill.","example":{"text":"His speech was very impressive. You should have been there.","source":{"kind":"tatoeba","sentenceId":285614,"author":"CK"}},"audio":"audio/8108c7caf488da8b.m4a"},{"id":"ex.vocab.inappropriate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"inappropriate","back":"(adjective) Not suitable or proper for a particular situation or occasion.","example":{"text":"What you're wearing is inappropriate.","source":{"kind":"tatoeba","sentenceId":8078844,"author":"CK"}},"audio":"audio/43b807ba41f6964f.m4a"},{"id":"ex.vocab.incident","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"incident","back":"(noun) An event, especially one that is unusual, unpleasant, or important.","example":{"text":"I haven't been back here since the incident.","source":{"kind":"tatoeba","sentenceId":953485,"author":"CK"}},"audio":"audio/900e7d886c23a304.m4a"},{"id":"ex.vocab.income","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"income","back":"(noun) Money received, especially on a regular basis, for work or through investments.","example":{"text":"He has a fair income.","source":{"kind":"tatoeba","sentenceId":284659,"author":"CM"}},"audio":"audio/3b402bd0b9bfab3c.m4a"},{"id":"ex.vocab.increasingly","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"increasingly","back":"(adverb) More and more over time.","example":{"text":"I increasingly need your help.","source":{"kind":"tatoeba","sentenceId":3610291,"author":"karloelkebekio"}},"audio":"audio/c8f3d1547461fa9a.m4a"},{"id":"ex.vocab.incredibly","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"incredibly","back":"(adverb) In a way that is very difficult to believe, or extremely.","example":{"text":"Tom can learn incredibly fast.","source":{"kind":"tatoeba","sentenceId":2630411,"author":"meerkat"}},"audio":"audio/a76ac87832d35117.m4a"},{"id":"ex.vocab.independence","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"independence","back":"(noun) freedom from control or support from others.","example":{"text":"She valued her financial independence.","source":{"kind":"generated"}},"audio":"audio/baf2bfafeb7e4226.m4a"},{"id":"ex.vocab.individual","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"individual","back":"(adjective) Relating to one single person or thing, separate from others.","example":{"text":"Each individual dog has a different character.","source":{"kind":"tatoeba","sentenceId":239167,"author":"shekitten"}},"audio":"audio/24af3e7f4cc632f0.m4a"},{"id":"ex.vocab.industrial","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"industrial","back":"(adjective) Related to industries, factories, and the production of goods.","example":{"text":"Japan is an industrial nation.","source":{"kind":"tatoeba","sentenceId":281530,"author":"CK"}},"audio":"audio/8783311875f3ee66.m4a"},{"id":"ex.vocab.inevitable","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"inevitable","back":"(adjective) Certain to happen and impossible to avoid.","example":{"text":"I guess this was inevitable.","source":{"kind":"tatoeba","sentenceId":2330098,"author":"CK"}},"audio":"audio/9a6b85c97020a1dc.m4a"},{"id":"ex.vocab.infection","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"infection","back":"(noun) A disease in a part of your body caused by bacteria or viruses.","example":{"text":"I have an ear infection.","source":{"kind":"tatoeba","sentenceId":264388,"author":"CK"}},"audio":"audio/d1b1efb5a8417a84.m4a"},{"id":"ex.vocab.inflation","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"inflation","back":"(noun) A general increase in prices and fall in the purchasing value of money.","example":{"text":"Is inflation a problem now?","source":{"kind":"tatoeba","sentenceId":7126314,"author":"CM"}},"audio":"audio/92fc29c313dfb48b.m4a"},{"id":"ex.vocab.influence","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"influence","back":"(noun) The power to affect how someone thinks or behaves, or how something develops.","example":{"text":"He has a great influence on his country.","source":{"kind":"tatoeba","sentenceId":298461,"author":"CM"}},"audio":"audio/fbdee41602e3bf94.m4a"},{"id":"ex.vocab.influential","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"influential","back":"(adjective) Having a lot of power to affect or change how people think or behave.","example":{"text":"Tom is a very influential person.","source":{"kind":"tatoeba","sentenceId":6529989,"author":"CK"}},"audio":"audio/56cc67d278b09adf.m4a"},{"id":"ex.vocab.inherit","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"inherit","back":"(verb) To receive money, property, or a title from someone after they have died.","example":{"text":"According to Tom's will, Mary will inherit his entire estate.","source":{"kind":"tatoeba","sentenceId":1030168,"author":"CK"}},"audio":"audio/6f24ec7308d8211d.m4a"},{"id":"ex.vocab.innocence","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"innocence","back":"(noun) The state of not being guilty of a crime or wrongdoing.","example":{"text":"I am convinced of his innocence.","source":{"kind":"tatoeba","sentenceId":454416,"author":"FeuDRenais"}},"audio":"audio/7211d5ba6d720998.m4a"},{"id":"ex.vocab.innocent","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"innocent","back":"(adjective) Not guilty of a crime or wrongdoing.","example":{"text":"The judge concluded that the prisoner was innocent.","source":{"kind":"tatoeba","sentenceId":244220,"author":"CK"}},"audio":"audio/cfc4c2ac841bdfbd.m4a"},{"id":"ex.vocab.insane","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"insane","back":"(adjective) Mentally ill, or extremely foolish and unreasonable.","example":{"text":"This reasoning is really insane.","source":{"kind":"tatoeba","sentenceId":5728843,"author":"CM"}},"audio":"audio/f56966c81a0a3854.m4a"},{"id":"ex.vocab.inspiration","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"inspiration","back":"(noun) A sudden good idea, or someone or something that gives you new ideas or enthusiasm.","example":{"text":"Yanni's painting gave Rima inspiration to write her novel.","source":{"kind":"tatoeba","sentenceId":10158202,"author":"Amastan"}},"audio":"audio/9a70598fac9824fc.m4a"},{"id":"ex.vocab.instantly","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"instantly","back":"(adverb) Happening immediately, without any delay.","example":{"text":"Tom knew instantly that something was wrong.","source":{"kind":"tatoeba","sentenceId":3023523,"author":"CK"}},"audio":"audio/361ffa0630574015.m4a"},{"id":"ex.vocab.instinct","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"instinct","back":"(noun) A natural tendency to behave in a particular way or to know something without learning it.","example":{"text":"I was acting on instinct.","source":{"kind":"tatoeba","sentenceId":8359699,"author":"CK"}},"audio":"audio/4982d7ab4078ddfb.m4a"},{"id":"ex.vocab.insult","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"insult","back":"(verb) To say or do something that offends someone.","example":{"text":"They insulted him and his wife.","source":{"kind":"tatoeba","sentenceId":802220,"author":"Source_VOA"}},"audio":"audio/d71dfe3686341390.m4a"},{"id":"ex.vocab.insurance","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"insurance","back":"(noun) An arrangement where you pay money regularly to a company that will pay you if something bad happens.","example":{"text":"I forgot to bring my health insurance card.","source":{"kind":"tatoeba","sentenceId":395438,"author":"CK"}},"audio":"audio/e35a9ed7200f4044.m4a"},{"id":"ex.vocab.intelligence","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"intelligence","back":"(noun) The ability to learn, understand, and apply knowledge and skills.","example":{"text":"This movie is about a squirrel who gains human-like intelligence.","source":{"kind":"tatoeba","sentenceId":3780405,"author":"Hybrid"}},"audio":"audio/17e86f9ed4b34558.m4a"},{"id":"ex.vocab.intense","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"intense","back":"(adjective) Very strong or extreme.","example":{"text":"An intense heat wave is forecast.","source":{"kind":"tatoeba","sentenceId":6820256,"author":"AlanF_US"}},"audio":"audio/f34269f2a6b3000f.m4a"},{"id":"ex.vocab.intention","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"intention","back":"(noun) A plan or aim; what you mean to do.","example":{"text":"Tom had no intention of quarreling with Mary.","source":{"kind":"tatoeba","sentenceId":1028799,"author":"CK"}},"audio":"audio/506fec15204088b6.m4a"},{"id":"ex.vocab.intentionally","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"intentionally","back":"(adverb) Done on purpose, not by accident.","example":{"text":"Did you do that intentionally?","source":{"kind":"tatoeba","sentenceId":5494876,"author":"CK"}},"audio":"audio/2913963b6a2cf992.m4a"},{"id":"ex.vocab.interfere","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"interfere","back":"(verb) To get involved in a situation that does not concern you, often in an unwanted way.","example":{"text":"You're interfering with my reading.","source":{"kind":"tatoeba","sentenceId":2238515,"author":"AlanF_US"}},"audio":"audio/407409e590dff081.m4a"},{"id":"ex.vocab.interpreter","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"interpreter","back":"(noun) A person who translates what someone is saying into another language.","example":{"text":"Do you need an interpreter?","source":{"kind":"tatoeba","sentenceId":6266862,"author":"CK"}},"audio":"audio/eff3842a800dd995.m4a"},{"id":"ex.vocab.invade","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"invade","back":"(verb) To enter a country or area with an army to take control.","example":{"text":"Why did France invade Algeria?","source":{"kind":"tatoeba","sentenceId":8258027,"author":"Amastan"}},"audio":"audio/c3abd38e39f56bc9.m4a"},{"id":"ex.vocab.investigate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"investigate","back":"(verb) To carefully examine facts or details to discover the truth about something.","example":{"text":"He investigated the whole incident.","source":{"kind":"tatoeba","sentenceId":6178856,"author":"sundown"}},"audio":"audio/3a2bd55228843b3e.m4a"},{"id":"ex.vocab.investigation","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"investigation","back":"(noun) An official examination of the facts about a situation or problem.","example":{"text":"A thorough investigation is now in progress.","source":{"kind":"tatoeba","sentenceId":268237,"author":"CK"}},"audio":"audio/cdc510663b65d156.m4a"},{"id":"ex.vocab.investment","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"investment","back":"(noun) The act of putting money into something to make a profit, or the thing you put money into.","example":{"text":"I bought this house as an investment.","source":{"kind":"tatoeba","sentenceId":1796825,"author":"CK"}},"audio":"audio/5ece88a34a7d1658.m4a"},{"id":"ex.vocab.investor","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"investor","back":"(noun) A person or organization that puts money into something to make a profit.","example":{"text":"Can Algeria attract a lot of foreign investors?","source":{"kind":"tatoeba","sentenceId":7856960,"author":"Amastan"}},"audio":"audio/5d0e85cff34bfd6b.m4a"},{"id":"ex.vocab.irresponsible","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"irresponsible","back":"(adjective) Not thinking enough about the effects of your actions, or not doing what you should.","example":{"text":"It is irresponsible of you to break your promise.","source":{"kind":"tatoeba","sentenceId":324208,"author":"CM"}},"audio":"audio/b33c0d6a1be621f4.m4a"},{"id":"ex.vocab.irritate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"irritate","back":"(verb) To make someone feel annoyed or impatient.","example":{"text":"Her way of speaking irritates us.","source":{"kind":"tatoeba","sentenceId":309871,"author":"CK"}},"audio":"audio/700e315db04b7518.m4a"},{"id":"ex.vocab.isolate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"isolate","back":"(verb) To separate someone or something from others.","example":{"text":"Tom needs to stop isolating himself from everyone else.","source":{"kind":"tatoeba","sentenceId":8555388,"author":"CK"}},"audio":"audio/c871488fae9fff51.m4a"},{"id":"ex.vocab.ivy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ivy","back":"(noun) A climbing plant with dark green, shiny leaves that grows on walls and trees.","example":{"text":"The walls are hidden by ivy.","source":{"kind":"tatoeba","sentenceId":320268,"author":"CK"}},"audio":"audio/c1ae7a91d5b1bd7c.m4a"},{"id":"ex.vocab.janitor","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"janitor","back":"(noun) A person whose job is to clean and maintain a building.","example":{"text":"I know that Tom is a school janitor.","source":{"kind":"tatoeba","sentenceId":7517743,"author":"CK"}},"audio":"audio/0bfe1f2688c4f35a.m4a"},{"id":"ex.vocab.jerk","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"jerk","back":"(noun) a quick, sudden movement; a foolish or annoying person.","example":{"text":"My boss is a jerk.","source":{"kind":"tatoeba","sentenceId":4384891,"author":"Hybrid"}},"audio":"audio/f6ec456a80990605.m4a"},{"id":"ex.vocab.judgment","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"judgment","back":"(noun) The ability to make sensible decisions or form good opinions.","example":{"text":"Do you trust Tom's judgment?","source":{"kind":"tatoeba","sentenceId":6049156,"author":"CK"}},"audio":"audio/9b3f7a79a0224e33.m4a"},{"id":"ex.vocab.junk","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"junk","back":"(noun) Things that are considered useless, worthless, or of low quality.","example":{"text":"Tom used to eat a lot of junk food.","source":{"kind":"tatoeba","sentenceId":1830450,"author":"CK"}},"audio":"audio/901f621c6d2da878.m4a"},{"id":"ex.vocab.jury","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"jury","back":"(noun) A group of citizens chosen to hear evidence in a court and decide if someone is guilty.","example":{"text":"The jury found Tom guilty.","source":{"kind":"tatoeba","sentenceId":6608803,"author":"Hybrid"}},"audio":"audio/4d0bf5232411d94b.m4a"},{"id":"ex.vocab.justify","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"justify","back":"(verb) To show or prove that something is right or reasonable.","example":{"text":"This is hard to justify.","source":{"kind":"tatoeba","sentenceId":5746041,"author":"CM"}},"audio":"audio/888a403da076c386.m4a"},{"id":"ex.vocab.kidnap","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"kidnap","back":"(verb) to take someone away illegally and keep them as a prisoner, usually to demand money.","example":{"text":"The story was about a plan to kidnap the prince.","source":{"kind":"generated"}},"audio":"audio/2914529e3f62c126.m4a"},{"id":"ex.vocab.kidney","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"kidney","back":"(noun) One of two organs in your body that remove waste products from your blood.","example":{"text":"Your kidneys are doing fine.","source":{"kind":"tatoeba","sentenceId":5599161,"author":"mailohilohi"}},"audio":"audio/8d7f6268a0ef3a11.m4a"},{"id":"ex.vocab.knowledge","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"knowledge","back":"(noun) Information and understanding gained through experience or study.","example":{"text":"Knowledge of computers is basic to all sciences.","source":{"kind":"tatoeba","sentenceId":54569,"author":"shekitten"}},"audio":"audio/98baf033ad6d85fe.m4a"},{"id":"ex.vocab.labor","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"labor","back":"(noun) Hard physical work, or the people who do this work.","example":{"text":"Plumbers are well paid for their labor.","source":{"kind":"tatoeba","sentenceId":681318,"author":"Source_VOA"}},"audio":"audio/a3f73110b2b62354.m4a"},{"id":"ex.vocab.lack","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"lack","back":"(noun) The state of not having something, or not having enough of it.","example":{"text":"The machine squealed for lack of oil.","source":{"kind":"tatoeba","sentenceId":20477,"author":"Objectivesea"}},"audio":"audio/4c65325b324272ff.m4a"},{"id":"ex.vocab.leash","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"leash","back":"(noun) A strap or rope used to control a dog or other animal.","example":{"text":"Keep pets on a leash.","source":{"kind":"tatoeba","sentenceId":6604305,"author":"Hybrid"}},"audio":"audio/91d76aa895939998.m4a"},{"id":"ex.vocab.legal","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"legal","back":"(adjective) Allowed by law, or relating to the law.","example":{"text":"I didn't know that was legal.","source":{"kind":"tatoeba","sentenceId":3724562,"author":"CM"}},"audio":"audio/45658238c71ab18e.m4a"},{"id":"ex.vocab.limited","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"limited","back":"(adjective) Restricted in size, amount, or extent.","example":{"text":"My French vocabulary is limited.","source":{"kind":"tatoeba","sentenceId":6774870,"author":"Eccles17"}},"audio":"audio/90955fa269f936b4.m4a"},{"id":"ex.vocab.limp","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"limp","back":"(verb) To walk with difficulty because one leg or foot is injured.","example":{"text":"He who limps is still walking.","source":{"kind":"tatoeba","sentenceId":2436415,"author":"Hybrid"}},"audio":"audio/726bb43c1adc1adf.m4a"},{"id":"ex.vocab.literally","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"literally","back":"(adverb) Exactly as stated; actually, without exaggeration.","example":{"text":"This Algerian town is named Tigzirt, which means literally \"the island.\"","source":{"kind":"tatoeba","sentenceId":8781548,"author":"Amastan"}},"audio":"audio/ca7fa4c21aa5c561.m4a"},{"id":"ex.vocab.literature","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"literature","back":"(noun) Written works, especially those considered to have artistic merit.","example":{"text":"Tom likes reading English literature.","source":{"kind":"tatoeba","sentenceId":681379,"author":"Source_VOA"}},"audio":"audio/a04309825351db33.m4a"},{"id":"ex.vocab.loan","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"loan","back":"(noun) An amount of money that is borrowed and must be paid back, usually with interest.","example":{"text":"He got a loan from the bank.","source":{"kind":"tatoeba","sentenceId":295545,"author":"CK"}},"audio":"audio/22d8e11167d8cb33.m4a"},{"id":"ex.vocab.log","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"log","back":"(noun) A part of a tree trunk or a large branch that has fallen or been cut down.","example":{"text":"Tom threw another log on the fire.","source":{"kind":"tatoeba","sentenceId":1092732,"author":"CK"}},"audio":"audio/b925cd3f8afee9bc.m4a"},{"id":"ex.vocab.logical","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"logical","back":"(adjective) Seeming reasonable and sensible.","example":{"text":"It seems logical to me.","source":{"kind":"tatoeba","sentenceId":3822657,"author":"CK"}},"audio":"audio/67fb57198246566b.m4a"},{"id":"ex.vocab.lover","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"lover","back":"(noun) A person with whom someone is having a romantic relationship.","example":{"text":"They were secret lovers for many years.","source":{"kind":"generated"}},"audio":"audio/3876925e830cf3a2.m4a"},{"id":"ex.vocab.lung","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"lung","back":"(noun) One of the two organs in the chest that you use for breathing.","example":{"text":"We use our lungs to breathe air.","source":{"kind":"generated"}},"audio":"audio/f3cc126a4bbe6893.m4a"},{"id":"ex.vocab.luxury","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"luxury","back":"(noun) Great comfort and expensive things that are not necessary but are pleasant.","example":{"text":"They used to live in luxury.","source":{"kind":"tatoeba","sentenceId":306983,"author":"CK"}},"audio":"audio/8b797e8daa29171c.m4a"},{"id":"ex.vocab.magnificent","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"magnificent","back":"(adjective) Extremely impressive, beautiful, or splendid.","example":{"text":"You've done a magnificent job.","source":{"kind":"tatoeba","sentenceId":3390621,"author":"CK"}},"audio":"audio/ae03dab3c6779397.m4a"},{"id":"ex.vocab.maintain","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"maintain","back":"(verb) To keep something in good condition or at the same level.","example":{"text":"He maintains his car well.","source":{"kind":"tatoeba","sentenceId":298762,"author":"CM"}},"audio":"audio/591071506d97127a.m4a"},{"id":"ex.vocab.majority","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"majority","back":"(noun) the larger part or number of people or things; more than half.","example":{"text":"She spends a majority of her time taking care of her children.","source":{"kind":"tatoeba","sentenceId":909557,"author":"CK"}},"audio":"audio/5be11b0de7622f4b.m4a"},{"id":"ex.vocab.manner","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"manner","back":"(noun) The way in which something is done, or a person's way of behaving.","example":{"text":"I don't like his rude manner.","source":{"kind":"tatoeba","sentenceId":260751,"author":"CK"}},"audio":"audio/82af93e6fdac96b3.m4a"},{"id":"ex.vocab.mansion","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"mansion","back":"(noun) A very large, impressive house.","example":{"text":"He lives in a mansion.","source":{"kind":"tatoeba","sentenceId":8748720,"author":"fishda"}},"audio":"audio/1fad08385d735a6e.m4a"},{"id":"ex.vocab.manual","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"manual","back":"(adjective) Done with the hands, or operated by hand rather than automatically.","example":{"text":"Playing the piano requires manual dexterity.","source":{"kind":"tatoeba","sentenceId":5781623,"author":"dangell"}},"audio":"audio/51c8868ae7d1be29.m4a"},{"id":"ex.vocab.mass","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"mass","back":"(noun) A large amount of something, or a large group of people or things.","example":{"text":"Their small protest triggered a mass demonstration.","source":{"kind":"tatoeba","sentenceId":305225,"author":"CK"}},"audio":"audio/6a05e10b1f1f71cb.m4a"},{"id":"ex.vocab.massive","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"massive","back":"(adjective) Extremely large, heavy, or serious.","example":{"text":"Algeria exports massive quantities of natural gas.","source":{"kind":"tatoeba","sentenceId":7852778,"author":"Amastan"}},"audio":"audio/5013d9cd8ce5359f.m4a"},{"id":"ex.vocab.master","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"master","back":"(noun) A person who has complete control over something or someone.","example":{"text":"The dog knew its master.","source":{"kind":"tatoeba","sentenceId":48242,"author":"CM"}},"audio":"audio/52a5fdb3939278ec.m4a"},{"id":"ex.vocab.mayor","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"mayor","back":"(noun) The elected head of a city or town government.","example":{"text":"He shook hands with the mayor.","source":{"kind":"tatoeba","sentenceId":297168,"author":"CK"}},"audio":"audio/5329e3d0f8db7a00.m4a"},{"id":"ex.vocab.meadow","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"meadow","back":"(noun) A field of grass, often used for hay or for animals to graze.","example":{"text":"Flowers are growing in the meadow.","source":{"kind":"tatoeba","sentenceId":3631901,"author":"patgfisher"}},"audio":"audio/f12182aa86cb64c7.m4a"},{"id":"ex.vocab.mental","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"mental","back":"(adjective) Relating to the mind or to the process of thinking.","example":{"text":"Here are some tricks to help you do mental math.","source":{"kind":"tatoeba","sentenceId":5973246,"author":"mailohilohi"}},"audio":"audio/86ccd12c249eee71.m4a"},{"id":"ex.vocab.mentally","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"mentally","back":"(adverb) In a way that relates to your mind or thoughts.","example":{"text":"David wanted his daughters to be mentally prepared for what was coming.","source":{"kind":"tatoeba","sentenceId":11500840,"author":"Amastan"}},"audio":"audio/db3b78e2395b4769.m4a"},{"id":"ex.vocab.mercury","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"mercury","back":"(noun) A heavy, silver-colored metal that is liquid at room temperature.","example":{"text":"Thermometers used to contain mercury.","source":{"kind":"generated"}},"audio":"audio/f20fa5e1445a1c97.m4a"},{"id":"ex.vocab.merely","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"merely","back":"(adverb) Only, or nothing more than.","example":{"text":"Tom is merely a child.","source":{"kind":"tatoeba","sentenceId":5753323,"author":"CM"}},"audio":"audio/656a229d64e2e127.m4a"},{"id":"ex.vocab.method","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"method","back":"(noun) A particular way of doing something.","example":{"text":"He adopted the new method.","source":{"kind":"tatoeba","sentenceId":291062,"author":"CK"}},"audio":"audio/4ba549f3622cc76b.m4a"},{"id":"ex.vocab.mid","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"mid","back":"(adjective) In the middle of a period or range.","example":{"text":"Tom is in his mid-twenties.","source":{"kind":"tatoeba","sentenceId":8735636,"author":"Hybrid"}},"audio":"audio/f2e21711fee0a772.m4a"},{"id":"ex.vocab.mineral","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"mineral","back":"(noun) A natural substance found in the earth, like salt, gold, or iron.","example":{"text":"Algeria is rich in lots of minerals.","source":{"kind":"tatoeba","sentenceId":9056111,"author":"Amastan"}},"audio":"audio/76ef60a36192a3ac.m4a"},{"id":"ex.vocab.minority","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"minority","back":"(noun) A smaller group of people or things within a larger group.","example":{"text":"Are we in the minority?","source":{"kind":"tatoeba","sentenceId":5747812,"author":"CM"}},"audio":"audio/610fe1e8b2e58be6.m4a"},{"id":"ex.vocab.miracle","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"miracle","back":"(noun) A surprising and welcome event that is not explainable by natural laws.","example":{"text":"We hoped for a miracle.","source":{"kind":"tatoeba","sentenceId":2649999,"author":"Hybrid"}},"audio":"audio/bc74a937f7a1c049.m4a"},{"id":"ex.vocab.mission","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"mission","back":"(noun) An important task or job that someone is sent to do, often involving travel.","example":{"text":"I have an important mission for all of you.","source":{"kind":"tatoeba","sentenceId":3329888,"author":"CK"}},"audio":"audio/551dd69ac4a8e6cd.m4a"},{"id":"ex.vocab.mock","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"mock","back":"(verb) To laugh at someone or something in an unkind way, often by copying them.","example":{"text":"Ziri got mocked about his Kabyle accent.","source":{"kind":"tatoeba","sentenceId":10991843,"author":"Amastan"}},"audio":"audio/4935720a9ca5ebf7.m4a"},{"id":"ex.vocab.modest","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"modest","back":"(adjective) Not too proud or boastful, or not very large, expensive, or impressive.","example":{"text":"Yanni brought up his kids in a modest home.","source":{"kind":"tatoeba","sentenceId":9726046,"author":"Amastan"}},"audio":"audio/559a8e62fd3923aa.m4a"},{"id":"ex.vocab.monitor","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"monitor","back":"(verb) To watch, observe, or check something over a period of time.","example":{"text":"We're monitoring the situation in Algeria.","source":{"kind":"tatoeba","sentenceId":8560781,"author":"Amastan"}},"audio":"audio/7ba48d1b8c598dac.m4a"},{"id":"ex.vocab.moral","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"moral","back":"(adjective) Relating to principles of right and wrong behavior.","example":{"text":"Tom has high moral standards.","source":{"kind":"tatoeba","sentenceId":4945431,"author":"Hybrid"}},"audio":"audio/92b127b9dd78622f.m4a"},{"id":"ex.vocab.motion","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"motion","back":"(noun) The act or process of moving or changing position.","example":{"text":"All her motions were graceful.","source":{"kind":"tatoeba","sentenceId":309600,"author":"Luornu"}},"audio":"audio/7ecc1176904879b8.m4a"},{"id":"ex.vocab.motivated","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"motivated","back":"(adjective) Feeling enthusiastic and having a strong reason to do something.","example":{"text":"Your problem is you're not motivated.","source":{"kind":"tatoeba","sentenceId":2663051,"author":"CK"}},"audio":"audio/d0bdad019792dba0.m4a"},{"id":"ex.vocab.motive","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"motive","back":"(noun) The reason why someone does something.","example":{"text":"What was Tom's motive for doing it?","source":{"kind":"tatoeba","sentenceId":7783830,"author":"CK"}},"audio":"audio/e99f3fb0f9be0506.m4a"},{"id":"ex.vocab.multiple","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"multiple","back":"(adjective) More than one of something, or many different ones.","example":{"text":"The test was multiple choice.","source":{"kind":"tatoeba","sentenceId":3825751,"author":"CK"}},"audio":"audio/6b09039df03f39e2.m4a"},{"id":"ex.vocab.murder","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"murder","back":"(noun) The crime of intentionally killing another person.","example":{"text":"Dan knew nothing about the murders.","source":{"kind":"tatoeba","sentenceId":4009484,"author":"Amastan"}},"audio":"audio/fb729b279c40b806.m4a"},{"id":"ex.vocab.mutual","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"mutual","back":"(adjective) Shared by two or more people or groups.","example":{"text":"True friendship is based on mutual trust.","source":{"kind":"tatoeba","sentenceId":7772943,"author":"sharris123"}},"audio":"audio/62111a1aa88e9522.m4a"},{"id":"ex.vocab.naive","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"naive","back":"(adjective) Showing a lack of experience or judgment, often trusting too easily.","example":{"text":"That's a very naive question.","source":{"kind":"tatoeba","sentenceId":2483404,"author":"Hybrid"}},"audio":"audio/954cffaf81d7d299.m4a"},{"id":"ex.vocab.native","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"native","back":"(adjective) Relating to the place where you were born or where something originally comes from.","example":{"text":"Georgia is his native state.","source":{"kind":"tatoeba","sentenceId":52978,"author":"shekitten"}},"audio":"audio/d7c215d527e3e79a.m4a"},{"id":"ex.vocab.negotiate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"negotiate","back":"(verb) To discuss something formally in order to reach an agreement.","example":{"text":"Dan didn't even negotiate the price.","source":{"kind":"tatoeba","sentenceId":3989566,"author":"Amastan"}},"audio":"audio/93a1f1c1f0bd40df.m4a"},{"id":"ex.vocab.negotiation","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"negotiation","back":"(noun) A formal discussion between people trying to reach an agreement.","example":{"text":"Both countries entered into peace negotiations.","source":{"kind":"tatoeba","sentenceId":325619,"author":"CM"}},"audio":"audio/749efeca4997df3d.m4a"},{"id":"ex.vocab.nerve","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"nerve","back":"(noun) Courage and confidence to do something difficult or dangerous.","example":{"text":"He had the nerve to say that.","source":{"kind":"tatoeba","sentenceId":300186,"author":"CK"}},"audio":"audio/091d99219557a1e3.m4a"},{"id":"ex.vocab.nervously","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"nervously","back":"(adverb) In a worried or slightly frightened way.","example":{"text":"Tom paced the room nervously.","source":{"kind":"tatoeba","sentenceId":9500558,"author":"CK"}},"audio":"audio/20c21eaa6d90316e.m4a"},{"id":"ex.vocab.nuclear","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"nuclear","back":"(adjective) Relating to the energy produced by splitting atoms, or to weapons using this energy.","example":{"text":"The town managed to thwart plans to build a nuclear power plant nearby.","source":{"kind":"tatoeba","sentenceId":5267566,"author":"Jesse"}},"audio":"audio/efc112612ab3ec6b.m4a"},{"id":"ex.vocab.numerous","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"numerous","back":"(adjective) Existing in large numbers.","example":{"text":"Tom has won numerous prizes.","source":{"kind":"tatoeba","sentenceId":6220544,"author":"CK"}},"audio":"audio/413ed413d9e93b5a.m4a"},{"id":"ex.vocab.objection","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"objection","back":"(noun) A reason for disagreeing with or opposing something.","example":{"text":"She has a strong objection to my plan.","source":{"kind":"tatoeba","sentenceId":314313,"author":"CK"}},"audio":"audio/d97a33cb67445c72.m4a"},{"id":"ex.vocab.objective","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"objective","back":"(noun) A goal or purpose that you are trying to achieve.","example":{"text":"His objective is to pass the test.","source":{"kind":"tatoeba","sentenceId":287692,"author":"CM"}},"audio":"audio/a8971723e077d8e7.m4a"},{"id":"ex.vocab.obsessed","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"obsessed","back":"(adjective) Thinking about something or someone constantly, so much that it affects your life.","example":{"text":"My wife is obsessed with cleanliness.","source":{"kind":"tatoeba","sentenceId":2250549,"author":"CK"}},"audio":"audio/9412363cf7b27642.m4a"},{"id":"ex.vocab.obstacle","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"obstacle","back":"(noun) Something that blocks your way or makes it difficult to achieve something.","example":{"text":"I saw an obstacle in the street.","source":{"kind":"tatoeba","sentenceId":7900246,"author":"shekitten"}},"audio":"audio/a6bf3a8470fad7ab.m4a"},{"id":"ex.vocab.occupy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"occupy","back":"(verb) To live or stay in a place, or to fill a space or time.","example":{"text":"Try to keep her occupied.","source":{"kind":"tatoeba","sentenceId":6726831,"author":"Hybrid"}},"audio":"audio/66bcd15d4cffc209.m4a"},{"id":"ex.vocab.occur","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"occur","back":"(verb) To happen, or to come into your mind.","example":{"text":"The accident occurred on Friday.","source":{"kind":"tatoeba","sentenceId":47106,"author":"CK"}},"audio":"audio/409d1cd72af2555d.m4a"},{"id":"ex.vocab.offend","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"offend","back":"(verb) To make someone feel upset or angry by saying or doing something rude.","example":{"text":"I don't want to offend you.","source":{"kind":"tatoeba","sentenceId":2221142,"author":"Hybrid"}},"audio":"audio/b9ccbb57eb0521cb.m4a"},{"id":"ex.vocab.officially","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"officially","back":"(adverb) In a formal or public way, often with authority.","example":{"text":"Tom and Mary are now officially engaged.","source":{"kind":"tatoeba","sentenceId":6528328,"author":"CK"}},"audio":"audio/b334b53f51a496bf.m4a"},{"id":"ex.vocab.opponent","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"opponent","back":"(noun) A person who is competing against you in a game, fight, or argument.","example":{"text":"Tom is a worthy opponent.","source":{"kind":"tatoeba","sentenceId":3728644,"author":"CM"}},"audio":"audio/366162100abd56d6.m4a"},{"id":"ex.vocab.oppose","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"oppose","back":"(verb) To disagree with something or someone and try to prevent it from happening.","example":{"text":"We opposed his plan to build a new road.","source":{"kind":"tatoeba","sentenceId":22736,"author":"Dejo"}},"audio":"audio/44643a3e850898d6.m4a"},{"id":"ex.vocab.optimistic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"optimistic","back":"(adjective) Expecting good things to happen or to be successful.","example":{"text":"I wish I could be more optimistic about what's going to happen.","source":{"kind":"tatoeba","sentenceId":3227114,"author":"CK"}},"audio":"audio/11f40f48d3601fc1.m4a"},{"id":"ex.vocab.orbit","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"orbit","back":"(noun) The curved path in space that an object follows around a planet or star.","example":{"text":"Pluto's orbit is highly elliptical.","source":{"kind":"tatoeba","sentenceId":8132814,"author":"Amastan"}},"audio":"audio/9703aaca6db3b777.m4a"},{"id":"ex.vocab.organism","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"organism","back":"(noun) A living thing, such as a plant, animal, or bacterium.","example":{"text":"A single-celled organism consists of just one cell.","source":{"kind":"tatoeba","sentenceId":10281848,"author":"sundown"}},"audio":"audio/4e594e82bc03e0ac.m4a"},{"id":"ex.vocab.origin","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"origin","back":"(noun) The point or place where something begins or comes from.","example":{"text":"This word is also French in origin.","source":{"kind":"tatoeba","sentenceId":59337,"author":"CM"}},"audio":"audio/8b1648414ffc8430.m4a"},{"id":"ex.vocab.original","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"original","back":"(adjective) The first or earliest form of something, from which copies or later versions are made.","example":{"text":"Compare this copy with the original.","source":{"kind":"tatoeba","sentenceId":2264773,"author":"_undertoad"}},"audio":"audio/2b72bc7772af8b6c.m4a"},{"id":"ex.vocab.orphanage","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"orphanage","back":"(noun) A home for children whose parents have died or cannot care for them.","example":{"text":"Tom grew up in an orphanage.","source":{"kind":"tatoeba","sentenceId":1093898,"author":"CK"}},"audio":"audio/07063dde1eb6fb44.m4a"},{"id":"ex.vocab.otherwise","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"otherwise","back":"(adverb) In a different way, or if not, then something different will happen.","example":{"text":"Hurry up, otherwise you'll be late for lunch.","source":{"kind":"tatoeba","sentenceId":19697,"author":"CK"}},"audio":"audio/de48ea3b679c92ee.m4a"},{"id":"ex.vocab.ought","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ought","back":"(verb) Used to say what is the right thing to do, or what is expected.","example":{"text":"You ought to thank him.","source":{"kind":"tatoeba","sentenceId":15838,"author":"CK"}},"audio":"audio/c04bf5a4bb9c30a6.m4a"},{"id":"ex.vocab.overcome","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"overcome","back":"(verb) To successfully deal with a problem or difficulty. Or to be strongly affected by a feeling.","example":{"text":"He helped me to overcome the difficulties.","source":{"kind":"tatoeba","sentenceId":4398846,"author":"XenoKat"}},"audio":"audio/48cfafd2db3c36d2.m4a"},{"id":"ex.vocab.overhear","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"overhear","back":"(verb) To hear what other people are saying without them knowing.","example":{"text":"I overheard what you said.","source":{"kind":"tatoeba","sentenceId":3168385,"author":"CK"}},"audio":"audio/af8e31c5465eebed.m4a"},{"id":"ex.vocab.overlook","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"overlook","back":"(verb) To fail to notice or consider something, or to have a view of something from above.","example":{"text":"He saw something the others had overlooked.","source":{"kind":"tatoeba","sentenceId":4464846,"author":"XenoKat"}},"audio":"audio/24506040ff7b2c24.m4a"},{"id":"ex.vocab.overwhelm","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"overwhelm","back":"(verb) To affect someone so strongly that they feel unable to deal with it.","example":{"text":"I feel overwhelmed by everything I have to do.","source":{"kind":"tatoeba","sentenceId":6887049,"author":"Hybrid"}},"audio":"audio/c08c197f00b7e449.m4a"},{"id":"ex.vocab.pandemic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"pandemic","back":"(noun) A disease that spreads over a whole country or the whole world.","example":{"text":"The pandemic is not over.","source":{"kind":"tatoeba","sentenceId":10152136,"author":"Hybrid"}},"audio":"audio/d7b174faf9b7b169.m4a"},{"id":"ex.vocab.parliament","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"parliament","back":"(noun) The group of people who are elected to make the laws of a country.","example":{"text":"Parliament is now in session.","source":{"kind":"tatoeba","sentenceId":241393,"author":"CK"}},"audio":"audio/a816757607c9f8c4.m4a"},{"id":"ex.vocab.participate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"participate","back":"(verb) To take part in an activity or event.","example":{"text":"How many teams participated in the championship?","source":{"kind":"tatoeba","sentenceId":1820929,"author":"Amastan"}},"audio":"audio/c333165299b6cf5c.m4a"},{"id":"ex.vocab.particular","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"particular","back":"(adjective) Special or specific; referring to one thing or person and not others.","example":{"text":"Is there any particular color that you are interested in?","source":{"kind":"tatoeba","sentenceId":280518,"author":"CM"}},"audio":"audio/c463e58f8af4b382.m4a"},{"id":"ex.vocab.passion","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"passion","back":"(noun) A very strong feeling of love, enthusiasm, or excitement for something.","example":{"text":"My work is my passion.","source":{"kind":"tatoeba","sentenceId":2054016,"author":"AlanF_US"}},"audio":"audio/30afcf6294f46804.m4a"},{"id":"ex.vocab.passionate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"passionate","back":"(adjective) Having or showing strong feelings or beliefs about something.","example":{"text":"I'm passionate about my job.","source":{"kind":"tatoeba","sentenceId":953843,"author":"CK"}},"audio":"audio/ceb282845e994ab4.m4a"},{"id":"ex.vocab.peer","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"peer","back":"(noun) A person who is of the same age, social status, or ability as you.","example":{"text":"Tom is different from his peers.","source":{"kind":"tatoeba","sentenceId":8768749,"author":"AlanF_US"}},"audio":"audio/43b81cf9eefca2b8.m4a"},{"id":"ex.vocab.penalty","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"penalty","back":"(noun) A punishment for breaking a law, rule, or agreement.","example":{"text":"There is a penalty for late payment.","source":{"kind":"generated"}},"audio":"audio/03a7f08f35f1b7f4.m4a"},{"id":"ex.vocab.permanent","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"permanent","back":"(adjective) Lasting or intended to last forever or for a very long time.","example":{"text":"I have a permanent contract.","source":{"kind":"tatoeba","sentenceId":5737254,"author":"CM"}},"audio":"audio/d666cd0afe762abd.m4a"},{"id":"ex.vocab.permit","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"permit","back":"(verb) To allow someone to do something, or to allow something to happen.","example":{"text":"The landlord won't permit him to paint the door red.","source":{"kind":"tatoeba","sentenceId":24096,"author":"CK"}},"audio":"audio/09a37b7233ffe27f.m4a"},{"id":"ex.vocab.perspective","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"perspective","back":"(noun) A particular way of thinking about something, or a point of view.","example":{"text":"Let me add my perspective.","source":{"kind":"tatoeba","sentenceId":5740668,"author":"CM"}},"audio":"audio/1cd25a7d4bc244d9.m4a"},{"id":"ex.vocab.persuade","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"persuade","back":"(verb) To make someone agree to do something by giving them good reasons.","example":{"text":"I failed to persuade her.","source":{"kind":"tatoeba","sentenceId":261370,"author":"CM"}},"audio":"audio/ace2e8fa710ca299.m4a"},{"id":"ex.vocab.pessimistic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"pessimistic","back":"(adjective) Expecting the worst possible outcome or believing that bad things will happen.","example":{"text":"Tom has a tendency to be pessimistic.","source":{"kind":"tatoeba","sentenceId":6251891,"author":"CK"}},"audio":"audio/56e5e014dfb0c2ef.m4a"},{"id":"ex.vocab.phenomenon","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"phenomenon","back":"(noun) Something that exists and can be seen, felt, or observed, especially something unusual.","example":{"text":"A rainbow is a natural phenomenon.","source":{"kind":"tatoeba","sentenceId":281038,"author":"CM"}},"audio":"audio/1d56836b88e7d640.m4a"},{"id":"ex.vocab.physical","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"physical","back":"(adjective) Relating to the body, not the mind, or relating to real things you can touch.","example":{"text":"Mental health is as important as physical health.","source":{"kind":"tatoeba","sentenceId":271907,"author":"CM"}},"audio":"audio/7e6bd70fc34e5211.m4a"},{"id":"ex.vocab.physics","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"physics","back":"(noun) The scientific study of matter, energy, and how they interact.","example":{"text":"She devoted her entire life to the study of physics.","source":{"kind":"tatoeba","sentenceId":916661,"author":"CK"}},"audio":"audio/a46f530f24cd5925.m4a"},{"id":"ex.vocab.picky","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"picky","back":"(adjective) Someone who is difficult to please and only likes certain things.","example":{"text":"He is a picky eater.","source":{"kind":"tatoeba","sentenceId":6092644,"author":"mailohilohi"}},"audio":"audio/e14ca1f04f195f5a.m4a"},{"id":"ex.vocab.pierce","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"pierce","back":"(verb) To make a hole in something with a sharp object.","example":{"text":"A bullet pierced the helmet.","source":{"kind":"tatoeba","sentenceId":276757,"author":"CM"}},"audio":"audio/e8bf778e9da06b7c.m4a"},{"id":"ex.vocab.pistol","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"pistol","back":"(noun) A small handgun that can be held and fired with one hand.","example":{"text":"Tom was holding a pistol.","source":{"kind":"tatoeba","sentenceId":10165309,"author":"CK"}},"audio":"audio/244dc009cab26ba5.m4a"},{"id":"ex.vocab.pitch","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"pitch","back":"(noun) An area of ground specially prepared for playing a sport.","example":{"text":"The football pitch was wet from the rain.","source":{"kind":"generated"}},"audio":"audio/b4963f3ab15c93ff.m4a"},{"id":"ex.vocab.pity","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"pity","back":"(noun) A feeling of sympathy and sadness for the suffering or unhappiness of others.","example":{"text":"The bishop took pity on the desperate immigrants.","source":{"kind":"tatoeba","sentenceId":266308,"author":"CM"}},"audio":"audio/789827ebe157d488.m4a"},{"id":"ex.vocab.plead","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"plead","back":"(verb) To ask for something in a very serious and emotional way.","example":{"text":"Tom pleaded with Mary not to leave.","source":{"kind":"tatoeba","sentenceId":3476690,"author":"CK"}},"audio":"audio/c57242a5ad65e8ed.m4a"},{"id":"ex.vocab.poet","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"poet","back":"(noun) A person who writes poems.","example":{"text":"He cannot be a poet.","source":{"kind":"tatoeba","sentenceId":68176,"author":"CM"}},"audio":"audio/1ceea2560fae8189.m4a"},{"id":"ex.vocab.poison","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"poison","back":"(noun) A substance that can cause illness or death if eaten, drunk, or touched.","example":{"text":"Tom had a bottle of poison in his briefcase.","source":{"kind":"tatoeba","sentenceId":2956819,"author":"CK"}},"audio":"audio/d4aaf793dbed4989.m4a"},{"id":"ex.vocab.poisonous","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"poisonous","back":"(adjective) Producing a harmful substance that can cause illness or death if eaten or touched.","example":{"text":"All these mushrooms are poisonous.","source":{"kind":"tatoeba","sentenceId":11033796,"author":"CK"}},"audio":"audio/2cdf10be016b5c70.m4a"},{"id":"ex.vocab.policy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"policy","back":"(noun) A set of rules or a plan of action agreed upon by a government, party, or business.","example":{"text":"Our policy is to build for the future, not the past.","source":{"kind":"tatoeba","sentenceId":23640,"author":"CK"}},"audio":"audio/cf8e797cc7fc448c.m4a"},{"id":"ex.vocab.political","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"political","back":"(adjective) Relating to the government, public affairs, or the way a country is run.","example":{"text":"He has no political ambition.","source":{"kind":"tatoeba","sentenceId":300364,"author":"CM"}},"audio":"audio/1a71839f9f37b497.m4a"},{"id":"ex.vocab.politics","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"politics","back":"(noun) The activities of government or people trying to influence how a country is run.","example":{"text":"Andrew became active in politics.","source":{"kind":"tatoeba","sentenceId":807136,"author":"Source_VOA"}},"audio":"audio/add874dfc6da8262.m4a"},{"id":"ex.vocab.population","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"population","back":"(noun) The total number of people living in a particular area, country, or city.","example":{"text":"The city has a large population.","source":{"kind":"tatoeba","sentenceId":45043,"author":"CK"}},"audio":"audio/16f0ce2062020598.m4a"},{"id":"ex.vocab.postpone","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"postpone","back":"(verb) To arrange for an event or activity to take place at a later time.","example":{"text":"I will postpone my trip to Scotland until it is warmer.","source":{"kind":"tatoeba","sentenceId":709241,"author":"Zifre"}},"audio":"audio/e79817e6f97ef85d.m4a"},{"id":"ex.vocab.potential","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"potential","back":"(noun) qualities or abilities that may be developed to make someone or something successful.","example":{"text":"This discovery has the potential to transform the field.","source":{"kind":"tatoeba","sentenceId":5363982,"author":"mailohilohi"}},"audio":"audio/96dee9bb69670597.m4a"},{"id":"ex.vocab.poverty","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"poverty","back":"(noun) The state of being extremely poor, without enough money for basic needs.","example":{"text":"Many people in the world still live in poverty.","source":{"kind":"tatoeba","sentenceId":2622513,"author":"Hybrid"}},"audio":"audio/b2134bb97ba264a7.m4a"},{"id":"ex.vocab.practically","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"practically","back":"(adverb) Almost; very nearly.","example":{"text":"Spanish and Portuguese are practically the same.","source":{"kind":"tatoeba","sentenceId":5218532,"author":"mailohilohi"}},"audio":"audio/e82645bf4f5e7484.m4a"},{"id":"ex.vocab.precious","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"precious","back":"(adjective) Of great value because it is rare, expensive, or important.","example":{"text":"Time is the most precious thing of all.","source":{"kind":"tatoeba","sentenceId":263981,"author":"CM"}},"audio":"audio/37da443ab65b3c60.m4a"},{"id":"ex.vocab.precisely","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"precisely","back":"(adverb) Exactly and accurately.","example":{"text":"What precisely did you do?","source":{"kind":"tatoeba","sentenceId":4016143,"author":"CK"}},"audio":"audio/be45337fae5563ef.m4a"},{"id":"ex.vocab.predict","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"predict","back":"(verb) To say that something will happen in the future, often based on knowledge or experience.","example":{"text":"It's impossible to predict earthquakes.","source":{"kind":"tatoeba","sentenceId":681777,"author":"Source_VOA"}},"audio":"audio/e745295b37b29a6e.m4a"},{"id":"ex.vocab.presence","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"presence","back":"(noun) The fact of being in a particular place or with someone.","example":{"text":"Don't talk about it in his presence.","source":{"kind":"tatoeba","sentenceId":287021,"author":"CK"}},"audio":"audio/d2933f7e3c79f067.m4a"},{"id":"ex.vocab.preserve","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"preserve","back":"(verb) To keep something in its original state or in good condition.","example":{"text":"We are to preserve nature.","source":{"kind":"tatoeba","sentenceId":22929,"author":"Whiskkebarr"}},"audio":"audio/eb5145a7c7f06074.m4a"},{"id":"ex.vocab.pressure","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"pressure","back":"(noun) The force that is produced when you press something, or a feeling of stress.","example":{"text":"Could you check the tire pressure?","source":{"kind":"tatoeba","sentenceId":41119,"author":"CK"}},"audio":"audio/dd467e216888cfcf.m4a"},{"id":"ex.vocab.prevent","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"prevent","back":"(verb) To stop something from happening, or to stop someone from doing something.","example":{"text":"The rain prevented him from coming here.","source":{"kind":"tatoeba","sentenceId":26755,"author":"CK"}},"audio":"audio/dc69285ce76ba4db.m4a"},{"id":"ex.vocab.previous","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"previous","back":"(adjective) Happening or existing before the one you are talking about now.","example":{"text":"He said he had come to Japan the previous week.","source":{"kind":"tatoeba","sentenceId":300711,"author":"CK"}},"audio":"audio/858d42c1f791055a.m4a"},{"id":"ex.vocab.prey","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"prey","back":"(noun) An animal that is hunted and killed by another animal for food.","example":{"text":"The bird is easy prey for the cat.","source":{"kind":"tatoeba","sentenceId":10715851,"author":"AlanF_US"}},"audio":"audio/ac54010b75a9ee67.m4a"},{"id":"ex.vocab.pride","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"pride","back":"(noun) A feeling of deep pleasure or satisfaction from one's own achievements or qualities.","example":{"text":"She takes pride in her looks.","source":{"kind":"tatoeba","sentenceId":314751,"author":"CM"}},"audio":"audio/1ef83b7d77ea2e62.m4a"},{"id":"ex.vocab.primary","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"primary","back":"(adjective) most important; main; earliest in time or order.","example":{"text":"Safety is the primary concern.","source":{"kind":"tatoeba","sentenceId":4665292,"author":"CK"}},"audio":"audio/4fae1a676100fd77.m4a"},{"id":"ex.vocab.prime","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"prime","back":"(adjective) most important; main; of the best possible quality.","example":{"text":"Our prime goal is to finish the project on time.","source":{"kind":"generated"}},"audio":"audio/aeccf8854c9fc614.m4a"},{"id":"ex.vocab.principal","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"principal","back":"(noun) The person who is in charge of a school or college.","example":{"text":"Tom is the principal of a high school.","source":{"kind":"tatoeba","sentenceId":3447045,"author":"CK"}},"audio":"audio/026ec23073ef16e7.m4a"},{"id":"ex.vocab.principle","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"principle","back":"(noun) A basic belief, rule, or idea that guides your actions or thoughts.","example":{"text":"It is against my principles to borrow money.","source":{"kind":"tatoeba","sentenceId":64570,"author":"CM"}},"audio":"audio/78e3ea8287072049.m4a"},{"id":"ex.vocab.prisoner","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"prisoner","back":"(noun) A person who is kept in prison as a punishment or while waiting for trial.","example":{"text":"The prisoner was brought before a judge.","source":{"kind":"tatoeba","sentenceId":317887,"author":"CK"}},"audio":"audio/237b916539007a31.m4a"},{"id":"ex.vocab.privacy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"privacy","back":"(noun) The state of being alone and not watched or disturbed by other people.","example":{"text":"I don't have any privacy.","source":{"kind":"tatoeba","sentenceId":2682210,"author":"Hybrid"}},"audio":"audio/7bca0e56b4d45d45.m4a"},{"id":"ex.vocab.production","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"production","back":"(noun) The process of making or growing things, or the amount produced.","example":{"text":"Production of rice has decreased.","source":{"kind":"tatoeba","sentenceId":320198,"author":"CK"}},"audio":"audio/afde5994c0184c76.m4a"},{"id":"ex.vocab.productive","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"productive","back":"(adjective) Producing a lot of goods, crops, or results.","example":{"text":"Algeria needs more productive land to grow food on.","source":{"kind":"tatoeba","sentenceId":10078172,"author":"Amastan"}},"audio":"audio/dc3d10651affd705.m4a"},{"id":"ex.vocab.professional","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"professional","back":"(adjective) Relating to a job that requires special training or education.","example":{"text":"Professional writers do not have a regular income.","source":{"kind":"tatoeba","sentenceId":742941,"author":"CM"}},"audio":"audio/576204e57359a301.m4a"},{"id":"ex.vocab.profile","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"profile","back":"(noun) A short description of someone or something that gives important information.","example":{"text":"Enclosed is our company profile.","source":{"kind":"tatoeba","sentenceId":320189,"author":"CM"}},"audio":"audio/9f73c55832ced705.m4a"},{"id":"ex.vocab.promote","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"promote","back":"(verb) To help something develop or increase, or to move someone to a higher position.","example":{"text":"He worked hard to promote peace.","source":{"kind":"tatoeba","sentenceId":303531,"author":"CK"}},"audio":"audio/797feae134ade399.m4a"},{"id":"ex.vocab.promotion","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"promotion","back":"(noun) The act of moving to a higher position or rank, or advertising a product.","example":{"text":"I just got a promotion.","source":{"kind":"tatoeba","sentenceId":2240395,"author":"Hybrid"}},"audio":"audio/72c323b9c5475a50.m4a"},{"id":"ex.vocab.proof","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"proof","back":"(noun) Information or evidence that shows something is true or that it has happened.","example":{"text":"Do you have any proof?","source":{"kind":"tatoeba","sentenceId":2960902,"author":"Hybrid"}},"audio":"audio/ba11e45e726abdfd.m4a"},{"id":"ex.vocab.proposal","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"proposal","back":"(noun) A formal suggestion or plan, especially one put forward for discussion.","example":{"text":"I agree to your proposal.","source":{"kind":"tatoeba","sentenceId":257119,"author":"CK"}},"audio":"audio/cfa0928c7fead205.m4a"},{"id":"ex.vocab.propose","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"propose","back":"(verb) To suggest a plan or idea for people to consider.","example":{"text":"He proposed that we should play baseball.","source":{"kind":"tatoeba","sentenceId":324085,"author":"CK"}},"audio":"audio/61a5339b2d7a5861.m4a"},{"id":"ex.vocab.punctual","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"punctual","back":"(adjective) Arriving or happening at the correct time; not late.","example":{"text":"He stressed the importance of being punctual.","source":{"kind":"tatoeba","sentenceId":298376,"author":"sundown"}},"audio":"audio/3b0d98fac0c25b4d.m4a"},{"id":"ex.vocab.purchase","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"purchase","back":"(verb) To buy something, especially something large or expensive.","example":{"text":"We purchased a new house for eighty thousand dollars.","source":{"kind":"tatoeba","sentenceId":248902,"author":"CK"}},"audio":"audio/94d96ddd71728ad5.m4a"},{"id":"ex.vocab.pursue","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"pursue","back":"(verb) To follow someone or something, usually to catch or achieve it.","example":{"text":"I will pursue my dreams.","source":{"kind":"tatoeba","sentenceId":6579400,"author":"Eccles17"}},"audio":"audio/9f9f880728636e59.m4a"},{"id":"ex.vocab.quarrel","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"quarrel","back":"(noun) An angry disagreement or argument between people.","example":{"text":"They had a small quarrel about the chores.","source":{"kind":"generated"}},"audio":"audio/7f6c0471945d26cf.m4a"},{"id":"ex.vocab.quote","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"quote","back":"(verb) To repeat the exact words someone else has said or written, or to state a price.","example":{"text":"Don't quote me on this.","source":{"kind":"tatoeba","sentenceId":869427,"author":"CK"}},"audio":"audio/7ebdb3e23c210a64.m4a"},{"id":"ex.vocab.racist","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"racist","back":"(adjective) showing prejudice, discrimination, or antagonism against someone of a different race.","example":{"text":"His comments were considered racist by many people.","source":{"kind":"generated"}},"audio":"audio/57ebdb6ab8013cf7.m4a"},{"id":"ex.vocab.rack","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"rack","back":"(noun) A frame or shelf, often with bars or hooks, used for holding things.","example":{"text":"He has a towel rack.","source":{"kind":"tatoeba","sentenceId":8597185,"author":"Amastan"}},"audio":"audio/83bcaccaa8c7fe76.m4a"},{"id":"ex.vocab.racket","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"racket","back":"(noun) A loud, unpleasant noise.","example":{"text":"I can't sleep with all this racket going on.","source":{"kind":"tatoeba","sentenceId":1103252,"author":"CK"}},"audio":"audio/fa26c66732310ea9.m4a"},{"id":"ex.vocab.rage","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"rage","back":"(noun) A feeling of very strong anger.","example":{"text":"I am full of rage.","source":{"kind":"tatoeba","sentenceId":7282522,"author":"francescaeckelkamp93"}},"audio":"audio/d378a5552fb13095.m4a"},{"id":"ex.vocab.random","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"random","back":"(adjective) Done or chosen without any particular plan, pattern, or purpose.","example":{"text":"Mary got fed up with the random encounters in the game.","source":{"kind":"tatoeba","sentenceId":6167641,"author":"sabretou"}},"audio":"audio/8540f301d80ffc6b.m4a"},{"id":"ex.vocab.range","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"range","back":"(noun) The amount or number between a minimum and maximum, or a set of similar things.","example":{"text":"The store offers a wide range of products.","source":{"kind":"generated"}},"audio":"audio/ccc06fc73c97ae86.m4a"},{"id":"ex.vocab.rapid","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"rapid","back":"(adjective) Happening or moving very quickly.","example":{"text":"Tom is not a rapid reader.","source":{"kind":"tatoeba","sentenceId":3609286,"author":"karloelkebekio"}},"audio":"audio/dceb1a83d906c07f.m4a"},{"id":"ex.vocab.rapidly","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"rapidly","back":"(adverb) Happening or moving very quickly.","example":{"text":"The situation is evolving rapidly.","source":{"kind":"tatoeba","sentenceId":4478359,"author":"Hybrid"}},"audio":"audio/1c96eba7a3327256.m4a"},{"id":"ex.vocab.rarely","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"rarely","back":"(adverb) Not often; almost never.","example":{"text":"I rarely catch a cold.","source":{"kind":"tatoeba","sentenceId":255730,"author":"CK"}},"audio":"audio/ccdf452563aef689.m4a"},{"id":"ex.vocab.rebel","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"rebel","back":"(noun) A person who fights against the government or people in authority.","example":{"text":"The rebels sabotaged the railroad.","source":{"kind":"tatoeba","sentenceId":2163170,"author":"Source_VOA"}},"audio":"audio/894754c5ec471d8a.m4a"},{"id":"ex.vocab.recall","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"recall","back":"(verb) To remember something or someone from the past.","example":{"text":"I can't recall her name.","source":{"kind":"tatoeba","sentenceId":38705,"author":"zumley"}},"audio":"audio/342fbb4879061cec.m4a"},{"id":"ex.vocab.recite","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"recite","back":"(verb) To say a poem, story, or list from memory, often in front of an audience.","example":{"text":"Mary heard Tom recite the poem.","source":{"kind":"tatoeba","sentenceId":4755720,"author":"DostKaplan"}},"audio":"audio/4a782c6f12a22517.m4a"},{"id":"ex.vocab.reckless","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"reckless","back":"(adjective) Doing something dangerous without thinking about the possible bad results.","example":{"text":"Reckless driving will lead to an accident.","source":{"kind":"tatoeba","sentenceId":240640,"author":"CM"}},"audio":"audio/755ac28d1bd635e3.m4a"},{"id":"ex.vocab.reform","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"reform","back":"(noun) the improvement or amendment of what is wrong, corrupt, or unsatisfactory.","example":{"text":"How detailed will the reform plans be?","source":{"kind":"tatoeba","sentenceId":7127355,"author":"CM"}},"audio":"audio/4f60d5c210496efa.m4a"},{"id":"ex.vocab.refugee","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"refugee","back":"(noun) A person who has been forced to leave their country, especially during a war.","example":{"text":"The refugees felt safe in their new country.","source":{"kind":"tatoeba","sentenceId":681981,"author":"Source_VOA"}},"audio":"audio/0e3ac43433b13181.m4a"},{"id":"ex.vocab.regain","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"regain","back":"(verb) To get something back that you had lost.","example":{"text":"I need to regain my strength.","source":{"kind":"tatoeba","sentenceId":7112788,"author":"CM"}},"audio":"audio/bdcdbb5b12cc2cbc.m4a"},{"id":"ex.vocab.regard","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"regard","back":"(verb) to think about someone or something in a particular way.","example":{"text":"They regarded him as the best doctor in town.","source":{"kind":"tatoeba","sentenceId":22093,"author":"CK"}},"audio":"audio/f7a135f98c2f484e.m4a"},{"id":"ex.vocab.regional","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"regional","back":"(adjective) Relating to a particular area or part of a country, rather than the whole country.","example":{"text":"Regional dialects should be preserved.","source":{"kind":"tatoeba","sentenceId":5933791,"author":"mailohilohi"}},"audio":"audio/68788ff67bed11d4.m4a"},{"id":"ex.vocab.regret","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"regret","back":"(verb) To feel sorry or sad about something you have done or not done.","example":{"text":"I regret having said so.","source":{"kind":"tatoeba","sentenceId":254070,"author":"CK"}},"audio":"audio/4c76d3bd5070fb67.m4a"},{"id":"ex.vocab.regulation","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"regulation","back":"(noun) An official rule or law that controls how something is done.","example":{"text":"We must follow the regulations.","source":{"kind":"tatoeba","sentenceId":1417118,"author":"CK"}},"audio":"audio/07b8ba35c401d1df.m4a"},{"id":"ex.vocab.reliable","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"reliable","back":"(adjective) Able to be trusted or depended on because they are consistent and honest.","example":{"text":"As far as I know, he is a reliable friend.","source":{"kind":"tatoeba","sentenceId":471251,"author":"CM"}},"audio":"audio/5be042f3ad0ef027.m4a"},{"id":"ex.vocab.relief","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"relief","back":"(noun) A feeling of happiness because something difficult or unpleasant has ended or been avoided.","example":{"text":"It's a relief to have finished the assignment on time.","source":{"kind":"tatoeba","sentenceId":266718,"author":"voxbubnya"}},"audio":"audio/1f910a657a81bfbd.m4a"},{"id":"ex.vocab.relieved","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"relieved","back":"(adjective) Feeling happy because something difficult or worrying has ended or not happened.","example":{"text":"Anyhow, I'm relieved the test is over.","source":{"kind":"tatoeba","sentenceId":37673,"author":"CM"}},"audio":"audio/77ffc4bd8d35a510.m4a"},{"id":"ex.vocab.reluctant","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"reluctant","back":"(adjective) Not wanting to do something, or slow to do it.","example":{"text":"Tom was reluctant to go.","source":{"kind":"tatoeba","sentenceId":1092360,"author":"CK"}},"audio":"audio/f4ebac46df7b6561.m4a"},{"id":"ex.vocab.remark","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"remark","back":"(noun) A short statement or comment about something.","example":{"text":"He made a few remarks on the book.","source":{"kind":"tatoeba","sentenceId":291271,"author":"CK"}},"audio":"audio/eb07305a0df3f82e.m4a"},{"id":"ex.vocab.remarkable","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"remarkable","back":"(adjective) Unusual or special in a way that makes people notice it.","example":{"text":"You've made remarkable progress in English in the past year.","source":{"kind":"tatoeba","sentenceId":70106,"author":"CK"}},"audio":"audio/d7568336e151f5f4.m4a"},{"id":"ex.vocab.remote","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"remote","back":"(adjective) Far away from other places, people, or cities.","example":{"text":"Tom's house is so remote that hardly anyone ever goes there.","source":{"kind":"tatoeba","sentenceId":7503075,"author":"CK"}},"audio":"audio/37536855e36b29f1.m4a"},{"id":"ex.vocab.renovate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"renovate","back":"(verb) To repair and improve an old building, room, or object so that it looks new again.","example":{"text":"Tom is renovating his home.","source":{"kind":"tatoeba","sentenceId":6439434,"author":"CK"}},"audio":"audio/bebada02c5a93a28.m4a"},{"id":"ex.vocab.reputation","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"reputation","back":"(noun) The opinion that people have about someone or something, based on past actions.","example":{"text":"He has a good reputation as a doctor in the town.","source":{"kind":"tatoeba","sentenceId":301601,"author":"sundown"}},"audio":"audio/0749a13eabbd7b36.m4a"},{"id":"ex.vocab.resemble","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"resemble","back":"(verb) To look like or be similar to someone or something else.","example":{"text":"The boy resembles his father.","source":{"kind":"tatoeba","sentenceId":3714847,"author":"AlanF_US"}},"audio":"audio/19398541f65c4d99.m4a"},{"id":"ex.vocab.resist","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"resist","back":"(verb) To fight against something, or to stop yourself from doing something you want to do.","example":{"text":"I just couldn't resist doing that.","source":{"kind":"tatoeba","sentenceId":2362129,"author":"CK"}},"audio":"audio/e1c4c29ee323dab0.m4a"},{"id":"ex.vocab.resolve","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"resolve","back":"(verb) To find a solution to a problem or difficulty.","example":{"text":"Tom used his communication skills to resolve the conflict.","source":{"kind":"tatoeba","sentenceId":7233005,"author":"Hybrid"}},"audio":"audio/bc84c9d8c96bf192.m4a"},{"id":"ex.vocab.resort","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"resort","back":"(noun) A place where people go for holidays or recreation.","example":{"text":"Tom works at a ski resort.","source":{"kind":"tatoeba","sentenceId":7562922,"author":"Hybrid"}},"audio":"audio/c6a92a0f73036dd1.m4a"},{"id":"ex.vocab.responsibility","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"responsibility","back":"(noun) A duty to deal with something or to have control over someone.","example":{"text":"I take full responsibility for the action.","source":{"kind":"tatoeba","sentenceId":246463,"author":"CK"}},"audio":"audio/d5d2be3b0efee4c0.m4a"},{"id":"ex.vocab.restore","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"restore","back":"(verb) To bring something back to its original condition or to a previous state.","example":{"text":"Tom restored an old barn.","source":{"kind":"tatoeba","sentenceId":8623820,"author":"Hybrid"}},"audio":"audio/7a67a2a7edbea46b.m4a"},{"id":"ex.vocab.resume","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"resume","back":"(verb) To start again after a pause.","example":{"text":"We'll resume the meeting after tea.","source":{"kind":"tatoeba","sentenceId":22474,"author":"CM"}},"audio":"audio/9c0cf62ad4a16579.m4a"},{"id":"ex.vocab.reveal","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"reveal","back":"(verb) To make something known that was previously secret or unknown.","example":{"text":"She revealed the secret to him.","source":{"kind":"tatoeba","sentenceId":887356,"author":"CK"}},"audio":"audio/e833f99dbd0b1ac2.m4a"},{"id":"ex.vocab.revenge","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"revenge","back":"(noun) Action taken to harm someone because they have harmed you.","example":{"text":"Tom is out for revenge.","source":{"kind":"tatoeba","sentenceId":7113226,"author":"CM"}},"audio":"audio/0029168ef8e9fdb8.m4a"},{"id":"ex.vocab.reverse","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"reverse","back":"(verb) To change something to the opposite direction, position, or condition.","example":{"text":"We can't reverse the process.","source":{"kind":"tatoeba","sentenceId":10081408,"author":"CK"}},"audio":"audio/3a7a652358dd794d.m4a"},{"id":"ex.vocab.revolution","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"revolution","back":"(noun) A complete change in the way people think or live, or a forceful overthrow of a government.","example":{"text":"The revolution ushered in a new era.","source":{"kind":"tatoeba","sentenceId":21658,"author":"Ivan24"}},"audio":"audio/15534a7122879680.m4a"},{"id":"ex.vocab.rid","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"rid","back":"(verb) To make yourself free of something or someone that you do not want.","example":{"text":"I want to get rid of it.","source":{"kind":"tatoeba","sentenceId":38715,"author":"CK"}},"audio":"audio/f364073777f40328.m4a"},{"id":"ex.vocab.ridiculous","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ridiculous","back":"(adjective) Very silly or unreasonable, causing laughter or scorn.","example":{"text":"Tom thinks it's a ridiculous idea.","source":{"kind":"tatoeba","sentenceId":2641830,"author":"CK"}},"audio":"audio/fd87efca25cd48d4.m4a"},{"id":"ex.vocab.risky","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"risky","back":"(adjective) Involving the possibility of danger, failure, or loss.","example":{"text":"I know it's a risky business.","source":{"kind":"tatoeba","sentenceId":5239512,"author":"CK"}},"audio":"audio/a10a58402936a780.m4a"},{"id":"ex.vocab.robbery","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"robbery","back":"(noun) The crime of stealing money or property from a bank or person, often with force.","example":{"text":"The two robberies were related.","source":{"kind":"tatoeba","sentenceId":5729830,"author":"CM"}},"audio":"audio/1bbbee77a463126f.m4a"},{"id":"ex.vocab.rot","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"rot","back":"(verb) To decay or cause something to decay, especially organic matter.","example":{"text":"This apple is starting to rot.","source":{"kind":"tatoeba","sentenceId":6900113,"author":"TingBuDong"}},"audio":"audio/9026f41e77ef0763.m4a"},{"id":"ex.vocab.ruin","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ruin","back":"(verb) To damage something so badly that it is completely destroyed or spoiled.","example":{"text":"Her day is about to be ruined.","source":{"kind":"tatoeba","sentenceId":1965366,"author":"CM"}},"audio":"audio/4cb2076038f2bb42.m4a"},{"id":"ex.vocab.rumor","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"rumor","back":"(noun) A piece of information that may or may not be true, spread by talking.","example":{"text":"The rumor turned out to be false.","source":{"kind":"tatoeba","sentenceId":34312,"author":"mailohilohi"}},"audio":"audio/5c703ecbbc1450f4.m4a"},{"id":"ex.vocab.rumour","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"rumour","back":"(noun) A piece of information or a story that is spread but not confirmed as true.","example":{"text":"In fact, it was nothing more than a rumour.","source":{"kind":"tatoeba","sentenceId":10558800,"author":"sundown"}},"audio":"audio/95302ee4b9cc0c7a.m4a"},{"id":"ex.vocab.sacrifice","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sacrifice","back":"(noun) the act of giving up something important or valuable for something else.","example":{"text":"We need to make sacrifices.","source":{"kind":"tatoeba","sentenceId":3109563,"author":"CK"}},"audio":"audio/9fce00f8b2801dc7.m4a"},{"id":"ex.vocab.saint","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"saint","back":"(noun) A person officially recognized by a Christian church as being holy and special.","example":{"text":"Saint Patrick's Day is celebrated in March.","source":{"kind":"tatoeba","sentenceId":6907664,"author":"swolesuki"}},"audio":"audio/e821e3894a3ca9f9.m4a"},{"id":"ex.vocab.sake","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sake","back":"(noun) For the purpose of; in order to help or achieve something.","example":{"text":"I'll quit my job for the sake of my health.","source":{"kind":"tatoeba","sentenceId":239020,"author":"CK"}},"audio":"audio/da7b9c281c79a4ab.m4a"},{"id":"ex.vocab.satellite","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"satellite","back":"(noun) An object that orbits a planet or star, either natural (like the moon) or artificial.","example":{"text":"The artificial satellite orbits the earth.","source":{"kind":"tatoeba","sentenceId":5870927,"author":"Luornu"}},"audio":"audio/4a96d5566b63a485.m4a"},{"id":"ex.vocab.saxophone","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"saxophone","back":"(noun) A musical wind instrument, usually made of brass, with a curved shape.","example":{"text":"I play the tenor saxophone.","source":{"kind":"tatoeba","sentenceId":814474,"author":"Zifre"}},"audio":"audio/2ee5e1ea756aa55d.m4a"},{"id":"ex.vocab.scale","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"scale","back":"(noun) A system of numbers or levels used to measure or compare things.","example":{"text":"The earthquake had a magnitude of six on the Richter scale.","source":{"kind":"tatoeba","sentenceId":5638466,"author":"mailohilohi"}},"audio":"audio/53d8d4a198c576c5.m4a"},{"id":"ex.vocab.scam","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"scam","back":"(noun) A dishonest plan for making money or getting something from people.","example":{"text":"It sounds like a scam.","source":{"kind":"tatoeba","sentenceId":3724748,"author":"CM"}},"audio":"audio/3d640e887e04dc70.m4a"},{"id":"ex.vocab.scandal","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"scandal","back":"(noun) A public event or situation that is considered morally wrong and causes outrage.","example":{"text":"He was involved in a scandal.","source":{"kind":"tatoeba","sentenceId":5064761,"author":"AlanF_US"}},"audio":"audio/999f53e6d2f56060.m4a"},{"id":"ex.vocab.scent","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"scent","back":"(noun) A pleasant smell.","example":{"text":"It has a floral scent.","source":{"kind":"tatoeba","sentenceId":10242258,"author":"LimeGreenTeknii"}},"audio":"audio/6d9867d715662bf7.m4a"},{"id":"ex.vocab.scientific","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"scientific","back":"(adjective) Relating to science, or based on careful observation and testing.","example":{"text":"Is that a scientific fact?","source":{"kind":"tatoeba","sentenceId":5322179,"author":"Hybrid"}},"audio":"audio/7f1ca009a809a7a0.m4a"},{"id":"ex.vocab.scorpion","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"scorpion","back":"(noun) A small creature with eight legs and a long tail that has a poisonous sting.","example":{"text":"Watch out. There are rattlesnakes and scorpions.","source":{"kind":"tatoeba","sentenceId":4552710,"author":"Hybrid"}},"audio":"audio/4344bc79be449b34.m4a"},{"id":"ex.vocab.screw","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"screw","back":"(noun) A metal fastener with a threaded shaft and a head, used to join things together.","example":{"text":"You have to tighten those screws.","source":{"kind":"tatoeba","sentenceId":2259946,"author":"_undertoad"}},"audio":"audio/1e9b2d1283ec1344.m4a"},{"id":"ex.vocab.sector","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sector","back":"(noun) A part or division of an area, especially in economics or society.","example":{"text":"Algeria needs to develop its agricultural sector.","source":{"kind":"tatoeba","sentenceId":7857301,"author":"Amastan"}},"audio":"audio/e70a2ce3fafbca01.m4a"},{"id":"ex.vocab.seize","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"seize","back":"(verb) To take hold of something quickly and firmly.","example":{"text":"He seized the boy by the arm.","source":{"kind":"tatoeba","sentenceId":299619,"author":"CK"}},"audio":"audio/0eec17235ab4102f.m4a"},{"id":"ex.vocab.seldom","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"seldom","back":"(adverb) Not often; rarely.","example":{"text":"I seldom go to a library.","source":{"kind":"tatoeba","sentenceId":31794,"author":"CK"}},"audio":"audio/00a458afc2ee0064.m4a"},{"id":"ex.vocab.self","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"self","back":"(noun) Your own personality or character, or the whole of your being.","example":{"text":"He was only a shadow of his former self.","source":{"kind":"tatoeba","sentenceId":1357323,"author":"Hybrid"}},"audio":"audio/ccc89fae5e66813a.m4a"},{"id":"ex.vocab.selfish","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"selfish","back":"(adjective) Caring only about yourself and your own needs, without thinking of others.","example":{"text":"It was selfish of me.","source":{"kind":"tatoeba","sentenceId":3722663,"author":"CM"}},"audio":"audio/376f3444be024f9a.m4a"},{"id":"ex.vocab.senior","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"senior","back":"(adjective) Higher in rank or status, or older and more experienced than others.","example":{"text":"The scandal could lead to the firing of some senior officials.","source":{"kind":"tatoeba","sentenceId":60973,"author":"CM"}},"audio":"audio/20d7a6710150f381.m4a"},{"id":"ex.vocab.sensible","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sensible","back":"(adjective) Showing good judgment and practical understanding.","example":{"text":"His advice is always very sensible.","source":{"kind":"tatoeba","sentenceId":287149,"author":"CK"}},"audio":"audio/6b4cd9150922d156.m4a"},{"id":"ex.vocab.sensitive","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sensitive","back":"(adjective) easily affected by things; quick to notice or feel changes.","example":{"text":"Tom is very sensitive to other people's moods.","source":{"kind":"tatoeba","sentenceId":2957353,"author":"CK"}},"audio":"audio/954affc1914f3a2e.m4a"},{"id":"ex.vocab.severe","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"severe","back":"(adjective) very serious or bad; very strict or harsh.","example":{"text":"There were severe shortages of food and fuel.","source":{"kind":"tatoeba","sentenceId":805404,"author":"Source_VOA"}},"audio":"audio/56c06dd06db117ee.m4a"},{"id":"ex.vocab.severely","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"severely","back":"(adverb) Very seriously or strictly.","example":{"text":"The argument is severely flawed.","source":{"kind":"tatoeba","sentenceId":6092632,"author":"mailohilohi"}},"audio":"audio/39300114f24f13a3.m4a"},{"id":"ex.vocab.sexual","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sexual","back":"(adjective) Relating to the physical differences between male and female, or to sex.","example":{"text":"Your sexual orientation is not something you can change.","source":{"kind":"tatoeba","sentenceId":6092720,"author":"mailohilohi"}},"audio":"audio/ba7a5426de90e4ba.m4a"},{"id":"ex.vocab.shallow","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"shallow","back":"(adjective) Not deep, or not showing serious thought or feeling.","example":{"text":"The river was shallow at that point.","source":{"kind":"tatoeba","sentenceId":273189,"author":"CK"}},"audio":"audio/ed97be2680cf689a.m4a"},{"id":"ex.vocab.shame","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"shame","back":"(noun) A painful feeling of embarrassment or guilt caused by one's own actions.","example":{"text":"Tom bowed his head in shame.","source":{"kind":"tatoeba","sentenceId":3409327,"author":"CK"}},"audio":"audio/5b465d72951a3805.m4a"},{"id":"ex.vocab.shatter","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"shatter","back":"(verb) To break suddenly into many small pieces, or to destroy something completely.","example":{"text":"Yanni kept hitting Skura's rear window until it shattered.","source":{"kind":"tatoeba","sentenceId":9970559,"author":"Amastan"}},"audio":"audio/453e97a110f5d429.m4a"},{"id":"ex.vocab.shed","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"shed","back":"(verb) To lose something naturally, or to get rid of something you do not want.","example":{"text":"Can you shed light on that?","source":{"kind":"tatoeba","sentenceId":5738429,"author":"CM"}},"audio":"audio/5437b635a491d04e.m4a"},{"id":"ex.vocab.shelter","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"shelter","back":"(noun) A place that provides protection from bad weather or danger.","example":{"text":"They looked for a place to take shelter from the rain.","source":{"kind":"tatoeba","sentenceId":3121993,"author":"Theocracy"}},"audio":"audio/cc41e086d507fedb.m4a"},{"id":"ex.vocab.shift","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"shift","back":"(verb) To move or change from one position or direction to another.","example":{"text":"The scene shifted to Chicago.","source":{"kind":"tatoeba","sentenceId":319461,"author":"shekitten"}},"audio":"audio/202fe208281ce9b8.m4a"},{"id":"ex.vocab.shortage","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"shortage","back":"(noun) A situation where there is not enough of something that is needed.","example":{"text":"There were severe shortages of food and fuel.","source":{"kind":"tatoeba","sentenceId":805404,"author":"Source_VOA"}},"audio":"audio/2d3dce0ab454ccc1.m4a"},{"id":"ex.vocab.shrink","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"shrink","back":"(verb) To become smaller in size or amount, or to make something smaller.","example":{"text":"My T-shirt shrank because I washed it.","source":{"kind":"tatoeba","sentenceId":6151702,"author":"CK"}},"audio":"audio/45bfd89a89478285.m4a"},{"id":"ex.vocab.significant","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"significant","back":"(adjective) Important, large, or noticeable.","example":{"text":"There is one significant difference.","source":{"kind":"tatoeba","sentenceId":2857318,"author":"AlanF_US"}},"audio":"audio/829e2f2d0cbe15d6.m4a"},{"id":"ex.vocab.sin","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sin","back":"(noun) An action that is considered morally wrong or against religious law.","example":{"text":"He committed many sins in his youth.","source":{"kind":"tatoeba","sentenceId":2439691,"author":"Hybrid"}},"audio":"audio/158fca5221ebb013.m4a"},{"id":"ex.vocab.sincere","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sincere","back":"(adjective) Honest and truly meaning what you say or do.","example":{"text":"He is a very sincere person.","source":{"kind":"tatoeba","sentenceId":292124,"author":"CK"}},"audio":"audio/46821e5e9e6093ae.m4a"},{"id":"ex.vocab.skilled","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"skilled","back":"(adjective) Having special abilities or training to do something well.","example":{"text":"It's obvious Tom is a skilled musician.","source":{"kind":"tatoeba","sentenceId":7212543,"author":"CK"}},"audio":"audio/f8295c96212e1433.m4a"},{"id":"ex.vocab.slight","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"slight","back":"(adjective) Small in amount or degree; not very important or serious.","example":{"text":"I have a slight cold.","source":{"kind":"tatoeba","sentenceId":261594,"author":"CK"}},"audio":"audio/60636297807e90ed.m4a"},{"id":"ex.vocab.sneak","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sneak","back":"(verb) To go somewhere quietly and secretly to avoid being seen or heard.","example":{"text":"Tom snuck out of the office.","source":{"kind":"tatoeba","sentenceId":3413099,"author":"CK"}},"audio":"audio/590dba11d2ade2bb.m4a"},{"id":"ex.vocab.sober","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sober","back":"(adjective) Not drunk, or serious and sensible.","example":{"text":"He led a sober life.","source":{"kind":"tatoeba","sentenceId":292810,"author":"CM"}},"audio":"audio/aa614cbfea753024.m4a"},{"id":"ex.vocab.solar","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"solar","back":"(adjective) Relating to the sun, or using energy from the sun.","example":{"text":"Let's talk about solar energy.","source":{"kind":"tatoeba","sentenceId":275029,"author":"CK"}},"audio":"audio/f74541a3afda52f9.m4a"},{"id":"ex.vocab.somewhat","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"somewhat","back":"(adverb) To some degree, but not a lot; a little.","example":{"text":"Tom is somewhat older than I.","source":{"kind":"tatoeba","sentenceId":3074267,"author":"ulymarrero"}},"audio":"audio/e1bc63cc0099d86f.m4a"},{"id":"ex.vocab.soul","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"soul","back":"(noun) The spiritual part of a person, often believed to live on after the body dies.","example":{"text":"May his soul rest in peace.","source":{"kind":"tatoeba","sentenceId":327018,"author":"CM"}},"audio":"audio/dc8f8680d41d30b0.m4a"},{"id":"ex.vocab.species","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"species","back":"(noun) A group of animals or plants that are able to breed with each other.","example":{"text":"The dodo is an already extinct species.","source":{"kind":"tatoeba","sentenceId":1248757,"author":"alec"}},"audio":"audio/698dc47547acd774.m4a"},{"id":"ex.vocab.specific","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"specific","back":"(adjective) clearly and exactly stated or identified; particular.","example":{"text":"Could you tell me what your specific requirements are?","source":{"kind":"tatoeba","sentenceId":747526,"author":"CM"}},"audio":"audio/ff3d002843c1acb2.m4a"},{"id":"ex.vocab.spit","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"spit","back":"(verb) To force saliva or food out of your mouth.","example":{"text":"Tom spit out his gum.","source":{"kind":"tatoeba","sentenceId":2958182,"author":"CK"}},"audio":"audio/04dceeec21d8e72f.m4a"},{"id":"ex.vocab.spite","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"spite","back":"(noun) A feeling of wanting to hurt or annoy someone.","example":{"text":"He acted out of pure spite.","source":{"kind":"generated"}},"audio":"audio/2d4e7a5fd5d9a38d.m4a"},{"id":"ex.vocab.split","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"split","back":"(verb) To divide into two or more parts, or to cause something to do this.","example":{"text":"Let's split up into groups.","source":{"kind":"tatoeba","sentenceId":2007456,"author":"CK"}},"audio":"audio/4cfe33304d6ea6fd.m4a"},{"id":"ex.vocab.spouse","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"spouse","back":"(noun) A person's husband or wife.","example":{"text":"His spouse is from Algeria.","source":{"kind":"tatoeba","sentenceId":8607081,"author":"Amastan"}},"audio":"audio/ddd829009abcc86a.m4a"},{"id":"ex.vocab.sprain","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sprain","back":"(noun) An injury to a joint, such as an ankle or wrist, caused by twisting it.","example":{"text":"You have a bad sprain.","source":{"kind":"tatoeba","sentenceId":6459807,"author":"Eccles17"}},"audio":"audio/22ef7d30dde2fe1d.m4a"},{"id":"ex.vocab.stab","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stab","back":"(verb) To push a sharp object, like a knife, into someone or something.","example":{"text":"Tom stabbed Mary in the stomach.","source":{"kind":"tatoeba","sentenceId":1867888,"author":"CK"}},"audio":"audio/e9c3e5e788463347.m4a"},{"id":"ex.vocab.stable","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stable","back":"(adjective) Not likely to change or fail; firm and steady.","example":{"text":"Tom is now in a stable relationship.","source":{"kind":"tatoeba","sentenceId":7130973,"author":"CM"}},"audio":"audio/7f85498a30a38965.m4a"},{"id":"ex.vocab.stain","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stain","back":"(noun) A dirty mark on something that is difficult to remove.","example":{"text":"This stain won't come out.","source":{"kind":"tatoeba","sentenceId":58106,"author":"CK"}},"audio":"audio/5d5a84a9ad590f81.m4a"},{"id":"ex.vocab.stake","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stake","back":"(noun) Something that can be gained or lost, especially money or a risk.","example":{"text":"A lot is at stake.","source":{"kind":"tatoeba","sentenceId":5000004,"author":"CK"}},"audio":"audio/14dc8fff59b4763b.m4a"},{"id":"ex.vocab.stalk","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stalk","back":"(verb) To follow someone or something quietly and secretly, often to catch or harm them.","example":{"text":"The bear is stalking us.","source":{"kind":"tatoeba","sentenceId":6029432,"author":"mailohilohi"}},"audio":"audio/14527470e6125c68.m4a"},{"id":"ex.vocab.stall","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stall","back":"(noun) A small shop or stand, often outdoors, where things are sold.","example":{"text":"Let's eat at that food stall across the road.","source":{"kind":"tatoeba","sentenceId":7594630,"author":"feudalism"}},"audio":"audio/bf63411096c65496.m4a"},{"id":"ex.vocab.startle","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"startle","back":"(verb) To surprise someone suddenly in a way that makes them jump or feel shocked.","example":{"text":"We don't want to startle anyone.","source":{"kind":"tatoeba","sentenceId":2014767,"author":"CK"}},"audio":"audio/ecd6f25ad2797fd5.m4a"},{"id":"ex.vocab.status","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"status","back":"(noun) The position or rank of someone or something compared to others.","example":{"text":"He should fill out his marital status in the questionnaire.","source":{"kind":"tatoeba","sentenceId":7746012,"author":"mshahriarinia"}},"audio":"audio/9399de096d667069.m4a"},{"id":"ex.vocab.stock","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stock","back":"(noun) The total amount of goods available in a shop or warehouse.","example":{"text":"We're out of stock now.","source":{"kind":"tatoeba","sentenceId":40894,"author":"CK"}},"audio":"audio/d4a383ada41e999f.m4a"},{"id":"ex.vocab.strand","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"strand","back":"(noun) A single thin piece of hair, thread, or wire.","example":{"text":"She found a long strand of hair on her coat.","source":{"kind":"generated"}},"audio":"audio/0e3f62ba45032300.m4a"},{"id":"ex.vocab.strategy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"strategy","back":"(noun) A careful plan or method used to achieve a particular goal over a long period.","example":{"text":"Your strategy seems to be working.","source":{"kind":"tatoeba","sentenceId":3831379,"author":"CK"}},"audio":"audio/783979346f885c6d.m4a"},{"id":"ex.vocab.stray","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stray","back":"(adjective) Lost or without a home, especially referring to an animal.","example":{"text":"A skunk ate the food we left out for the stray cats.","source":{"kind":"tatoeba","sentenceId":10511609,"author":"shekitten"}},"audio":"audio/232a7ffdd111577e.m4a"},{"id":"ex.vocab.stressful","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stressful","back":"(adjective) Causing a lot of worry and tension.","example":{"text":"It was a stressful day.","source":{"kind":"tatoeba","sentenceId":5012670,"author":"CK"}},"audio":"audio/92d9897a5bba218c.m4a"},{"id":"ex.vocab.strike","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"strike","back":"(verb) To hit something or someone forcefully.","example":{"text":"The tree was struck by lightning.","source":{"kind":"tatoeba","sentenceId":43809,"author":"CK"}},"audio":"audio/49e96cea830c956f.m4a"},{"id":"ex.vocab.stroke","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stroke","back":"(noun) A particular style of moving your arms and legs in swimming.","example":{"text":"I don't think Tom knows how to do the breast stroke.","source":{"kind":"tatoeba","sentenceId":6338506,"author":"CK"}},"audio":"audio/0af0b7e1122a6fda.m4a"},{"id":"ex.vocab.struggle","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"struggle","back":"(verb) To try very hard to do something difficult.","example":{"text":"Tom struggled to stay in control.","source":{"kind":"tatoeba","sentenceId":3185282,"author":"CK"}},"audio":"audio/09d9346b9e0dc2dc.m4a"},{"id":"ex.vocab.stubborn","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stubborn","back":"(adjective) Refusing to change your mind or opinion, even when others think you are wrong.","example":{"text":"My father is too stubborn to admit his faults.","source":{"kind":"tatoeba","sentenceId":251645,"author":"CM"}},"audio":"audio/1f8e949208f05008.m4a"},{"id":"ex.vocab.stumble","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stumble","back":"(verb) To hit your foot against something and almost fall, or to walk in an unsteady way.","example":{"text":"You're stumbling on level ground. Are you feeling all right?","source":{"kind":"tatoeba","sentenceId":10266906,"author":"AlanF_US"}},"audio":"audio/ef1afae1ea017fba.m4a"},{"id":"ex.vocab.stunned","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"stunned","back":"(adjective) So surprised that you cannot think clearly or react immediately.","example":{"text":"She was too stunned to talk.","source":{"kind":"tatoeba","sentenceId":2214140,"author":"Hybrid"}},"audio":"audio/e2878555a947ea91.m4a"},{"id":"ex.vocab.submit","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"submit","back":"(verb) To formally give something to someone for a decision or approval.","example":{"text":"I submitted my report to Tom.","source":{"kind":"tatoeba","sentenceId":2406816,"author":"CK"}},"audio":"audio/83fed36b4b3ce30e.m4a"},{"id":"ex.vocab.substance","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"substance","back":"(noun) A particular type of material with specific properties.","example":{"text":"Salt is a useful substance.","source":{"kind":"tatoeba","sentenceId":25748,"author":"Luornu"}},"audio":"audio/a7c867af66372cab.m4a"},{"id":"ex.vocab.sue","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sue","back":"(verb) To start a legal case against someone in court to get money because they harmed you.","example":{"text":"Why are you suing Tom?","source":{"kind":"tatoeba","sentenceId":5573360,"author":"CK"}},"audio":"audio/bbd0c146e2842ab1.m4a"},{"id":"ex.vocab.suffer","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"suffer","back":"(verb) To experience physical or mental pain, or to experience something bad.","example":{"text":"My father is suffering from a cold.","source":{"kind":"tatoeba","sentenceId":251728,"author":"CK"}},"audio":"audio/60a039518634e327.m4a"},{"id":"ex.vocab.superior","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"superior","back":"(adjective) Better than average, or better than others of the same type.","example":{"text":"This watch is superior to that one.","source":{"kind":"tatoeba","sentenceId":58940,"author":"Lumi_alt"}},"audio":"audio/10722b2d4558a165.m4a"},{"id":"ex.vocab.supply","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"supply","back":"(noun) An amount of something that is available to be used.","example":{"text":"Prices depend on supply and demand.","source":{"kind":"tatoeba","sentenceId":24422,"author":"CK"}},"audio":"audio/ceacb5da5d07f86b.m4a"},{"id":"ex.vocab.supportive","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"supportive","back":"(adjective) Giving help, encouragement, or sympathy to someone.","example":{"text":"Thank you for being so supportive.","source":{"kind":"tatoeba","sentenceId":2883037,"author":"CK"}},"audio":"audio/2dd9b6ee29d1e8d1.m4a"},{"id":"ex.vocab.surface","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"surface","back":"(noun) The outside or top layer of something.","example":{"text":"The surface of the object is fairly rough.","source":{"kind":"tatoeba","sentenceId":44132,"author":"CM"}},"audio":"audio/59b739a15b999265.m4a"},{"id":"ex.vocab.surgeon","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"surgeon","back":"(noun) A doctor who performs medical operations.","example":{"text":"The surgeon persuaded me to undergo an organ transplant operation.","source":{"kind":"tatoeba","sentenceId":21982,"author":"CK"}},"audio":"audio/97e239bac231aeeb.m4a"},{"id":"ex.vocab.surgery","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"surgery","back":"(noun) Medical treatment where doctors cut into someone's body to repair or remove something.","example":{"text":"After eye surgery, George put in eye drops every fifteen minutes.","source":{"kind":"tatoeba","sentenceId":2422285,"author":"orcrist"}},"audio":"audio/5b997b9dcd733644.m4a"},{"id":"ex.vocab.surrender","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"surrender","back":"(verb) To stop fighting and admit defeat, or to give up something you own.","example":{"text":"The soldiers were told never to surrender.","source":{"kind":"tatoeba","sentenceId":320104,"author":"CK"}},"audio":"audio/1bb9e8356fad9bb2.m4a"},{"id":"ex.vocab.suspect","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"suspect","back":"(verb) To believe that something is probably true, especially something bad, without having proof.","example":{"text":"I suspect he is ill.","source":{"kind":"tatoeba","sentenceId":303115,"author":"CM"}},"audio":"audio/c87fee02bd815b53.m4a"},{"id":"ex.vocab.suspend","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"suspend","back":"(verb) To stop something for a period of time, or to hang something from above.","example":{"text":"The peace talks have been suspended for a while.","source":{"kind":"tatoeba","sentenceId":326511,"author":"CM"}},"audio":"audio/f56527d8d21f5b88.m4a"},{"id":"ex.vocab.suspicion","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"suspicion","back":"(noun) A feeling or belief that someone is guilty of something without proof.","example":{"text":"Am I under suspicion here?","source":{"kind":"tatoeba","sentenceId":3730606,"author":"CM"}},"audio":"audio/8ca6d89af1139eb1.m4a"},{"id":"ex.vocab.suspicious","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"suspicious","back":"(adjective) Feeling that someone has done something wrong or dishonest.","example":{"text":"I am suspicious of him.","source":{"kind":"tatoeba","sentenceId":283480,"author":"CM"}},"audio":"audio/7b2c09be550208cd.m4a"},{"id":"ex.vocab.swear","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"swear","back":"(verb) To promise very strongly that something is true or that you will do something.","example":{"text":"When they got married, they both swore to never lie.","source":{"kind":"tatoeba","sentenceId":304989,"author":"CM"}},"audio":"audio/014cb98d3779c371.m4a"},{"id":"ex.vocab.swell","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"swell","back":"(verb) To become larger or rounder than usual, often because of injury or illness.","example":{"text":"His feet swell when he gets nervous.","source":{"kind":"tatoeba","sentenceId":8377394,"author":"Amastan"}},"audio":"audio/68f54a16c7e213e7.m4a"},{"id":"ex.vocab.sympathetic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sympathetic","back":"(adjective) Showing that you understand and care about someone's problems or feelings.","example":{"text":"I hope Tom is sympathetic.","source":{"kind":"tatoeba","sentenceId":6231213,"author":"CK"}},"audio":"audio/ad78bade4635fd2d.m4a"},{"id":"ex.vocab.sympathy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"sympathy","back":"(noun) The feeling of understanding and caring about someone else's problems or sadness.","example":{"text":"I felt sympathy for Tom.","source":{"kind":"tatoeba","sentenceId":5591592,"author":"CK"}},"audio":"audio/32a51e0cf6dad5dc.m4a"},{"id":"ex.vocab.symptom","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"symptom","back":"(noun) A change in your body or mind that shows you might have an illness.","example":{"text":"I have the same symptoms.","source":{"kind":"tatoeba","sentenceId":3378935,"author":"CK"}},"audio":"audio/cb28ed35f1f57238.m4a"},{"id":"ex.vocab.tattoo","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"tattoo","back":"(noun) A permanent picture or design made on the skin using needles and ink.","example":{"text":"Would you like to see my tattoo?","source":{"kind":"tatoeba","sentenceId":3123499,"author":"CK"}},"audio":"audio/830ab02248247e13.m4a"},{"id":"ex.vocab.technique","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"technique","back":"(noun) A particular method or skill used to perform an activity.","example":{"text":"Tom's technique is pretty good.","source":{"kind":"tatoeba","sentenceId":6264232,"author":"CK"}},"audio":"audio/ecc21c01cc86f309.m4a"},{"id":"ex.vocab.telescope","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"telescope","back":"(noun) An optical instrument that makes distant objects appear larger and nearer.","example":{"text":"You can see the stars using a telescope.","source":{"kind":"tatoeba","sentenceId":682146,"author":"Source_VOA"}},"audio":"audio/d5641e2cf3bd149c.m4a"},{"id":"ex.vocab.temper","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"temper","back":"(noun) A person's state of mind, especially how easily they become angry.","example":{"text":"He has a bad temper.","source":{"kind":"tatoeba","sentenceId":295112,"author":"CK"}},"audio":"audio/ac026abda6fe36f6.m4a"},{"id":"ex.vocab.tempt","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"tempt","back":"(verb) To make someone want to do something, especially something they know they should not do.","example":{"text":"I was tempted to skip class and go home early.","source":{"kind":"tatoeba","sentenceId":2952616,"author":"CK"}},"audio":"audio/d99f1eec8d4b371f.m4a"},{"id":"ex.vocab.tendency","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"tendency","back":"(noun) A way of behaving or thinking that someone often shows or that often happens.","example":{"text":"Tom has a tendency to forget things.","source":{"kind":"tatoeba","sentenceId":6074474,"author":"CK"}},"audio":"audio/294e21fdff70921d.m4a"},{"id":"ex.vocab.tense","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"tense","back":"(adjective) Feeling worried or nervous, or describing a situation that causes worry.","example":{"text":"I'm feeling a little tense.","source":{"kind":"tatoeba","sentenceId":2544207,"author":"CK"}},"audio":"audio/48c30787461fad4d.m4a"},{"id":"ex.vocab.terrify","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"terrify","back":"(verb) To make someone feel extremely frightened.","example":{"text":"The man terrified the little children.","source":{"kind":"tatoeba","sentenceId":276890,"author":"CK"}},"audio":"audio/6113a45073642cf9.m4a"},{"id":"ex.vocab.territory","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"territory","back":"(noun) an area of land, sea, or space; an area that an animal or person considers their own.","example":{"text":"The dog marked its territory.","source":{"kind":"tatoeba","sentenceId":7446390,"author":"Hybrid"}},"audio":"audio/aa2fd98c88a77f1a.m4a"},{"id":"ex.vocab.terror","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"terror","back":"(noun) A feeling of extreme fear.","example":{"text":"I can feel Tom's terror.","source":{"kind":"tatoeba","sentenceId":3726770,"author":"CM"}},"audio":"audio/89b57ed0a65ed463.m4a"},{"id":"ex.vocab.terrorist","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"terrorist","back":"(noun) a person who uses violence and threats to achieve political aims.","example":{"text":"The authorities were searching for a known terrorist.","source":{"kind":"generated"}},"audio":"audio/21798c600524511a.m4a"},{"id":"ex.vocab.theft","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"theft","back":"(noun) The act of dishonestly taking something that belongs to someone else.","example":{"text":"He is guilty of theft.","source":{"kind":"tatoeba","sentenceId":455289,"author":"CM"}},"audio":"audio/01f39494c8c0ac79.m4a"},{"id":"ex.vocab.theory","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"theory","back":"(noun) An idea or set of ideas that tries to explain something, often based on evidence.","example":{"text":"His theory is based on careful research.","source":{"kind":"tatoeba","sentenceId":287774,"author":"CK"}},"audio":"audio/211befa97a05790f.m4a"},{"id":"ex.vocab.therapist","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"therapist","back":"(noun) a person trained to help people with mental, emotional, or physical problems.","example":{"text":"She is a speech therapist by profession.","source":{"kind":"tatoeba","sentenceId":4795607,"author":"NatsuDonkey"}},"audio":"audio/b3f2cda87de197b8.m4a"},{"id":"ex.vocab.therapy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"therapy","back":"(noun) Treatment to help someone recover from an illness or injury, or to improve mental health.","example":{"text":"Yanni came to this facility to have therapy.","source":{"kind":"tatoeba","sentenceId":9133470,"author":"Amastan"}},"audio":"audio/f2096deba1e2a115.m4a"},{"id":"ex.vocab.thorough","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"thorough","back":"(adjective) Complete and careful, paying attention to every detail.","example":{"text":"He made a thorough analysis of the problem.","source":{"kind":"tatoeba","sentenceId":291350,"author":"CM"}},"audio":"audio/d3f5ea96080d26af.m4a"},{"id":"ex.vocab.threat","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"threat","back":"(noun) A statement or action that shows someone might cause harm or danger.","example":{"text":"The local ecosystems are under threat.","source":{"kind":"tatoeba","sentenceId":2790600,"author":"Hybrid"}},"audio":"audio/bbc3e90f6dd2fe3e.m4a"},{"id":"ex.vocab.throughout","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"throughout","back":"(preposition) In every part of a place, or during the whole of a period of time.","example":{"text":"I have lived in many houses and slept in many beds throughout my life.","source":{"kind":"tatoeba","sentenceId":5260326,"author":"kanbutsu"}},"audio":"audio/4435fa9db6f2c266.m4a"},{"id":"ex.vocab.ticklish","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"ticklish","back":"(adjective) Sensitive to light touches, causing a tingling or laughing sensation.","example":{"text":"I used to be ticklish.","source":{"kind":"tatoeba","sentenceId":6356727,"author":"CK"}},"audio":"audio/a898cfd20e8193ee.m4a"},{"id":"ex.vocab.tighten","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"tighten","back":"(verb) To make something firmer, less loose, or more secure.","example":{"text":"Yanni tightened up the screws.","source":{"kind":"tatoeba","sentenceId":9966954,"author":"Amastan"}},"audio":"audio/13a04fedfc90cdb3.m4a"},{"id":"ex.vocab.timid","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"timid","back":"(adjective) Easily frightened; shy and lacking courage.","example":{"text":"He is a timid man.","source":{"kind":"tatoeba","sentenceId":7819959,"author":"sharris123"}},"audio":"audio/0e4c2b35fcbc52ac.m4a"},{"id":"ex.vocab.tolerate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"tolerate","back":"(verb) To allow something to happen or exist, even if you do not like it.","example":{"text":"I can't tolerate this noise any longer.","source":{"kind":"tatoeba","sentenceId":58021,"author":"CK"}},"audio":"audio/02f33188c4a2a3fa.m4a"},{"id":"ex.vocab.torture","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"torture","back":"(noun) extreme physical or mental pain, or the act of causing it.","example":{"text":"Waiting for the results was pure torture.","source":{"kind":"generated"}},"audio":"audio/42cf42295e8ed63b.m4a"},{"id":"ex.vocab.toxic","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"toxic","back":"(adjective) Containing poison; or very harmful and unpleasant.","example":{"text":"Lead is a toxic metal.","source":{"kind":"tatoeba","sentenceId":5748292,"author":"CM"}},"audio":"audio/b03b6f5c3370a504.m4a"},{"id":"ex.vocab.trace","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"trace","back":"(noun) A very small amount of something, or a sign that something existed or happened.","example":{"text":"Tom disappeared without a trace.","source":{"kind":"tatoeba","sentenceId":1026233,"author":"CK"}},"audio":"audio/3ad9d3e7756eaeb3.m4a"},{"id":"ex.vocab.tragedy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"tragedy","back":"(noun) A very sad event or situation that causes a lot of suffering or death.","example":{"text":"It was a great tragedy for them to lose their only son.","source":{"kind":"tatoeba","sentenceId":27604,"author":"CK"}},"audio":"audio/4f6e25f7cca5837d.m4a"},{"id":"ex.vocab.trail","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"trail","back":"(noun) A path or track through a wild or natural area.","example":{"text":"My house is near a bike trail.","source":{"kind":"tatoeba","sentenceId":6003990,"author":"mailohilohi"}},"audio":"audio/3579b6af8ddc54f5.m4a"},{"id":"ex.vocab.traitor","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"traitor","back":"(noun) A person who betrays their country, group, or a person they should be loyal to.","example":{"text":"Tom called Mary a traitor.","source":{"kind":"tatoeba","sentenceId":1029546,"author":"CK"}},"audio":"audio/a834ef2b76f3caef.m4a"},{"id":"ex.vocab.transform","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"transform","back":"(verb) To change completely in appearance, character, or nature.","example":{"text":"This will transform your life.","source":{"kind":"tatoeba","sentenceId":8257857,"author":"Amastan"}},"audio":"audio/906a2eb90f71bcbd.m4a"},{"id":"ex.vocab.trap","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"trap","back":"(noun) A device or trick used to catch animals or people.","example":{"text":"Using a trap, they caught the fox.","source":{"kind":"tatoeba","sentenceId":544110,"author":"CK"}},"audio":"audio/9075d32904aa6502.m4a"},{"id":"ex.vocab.treatment","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"treatment","back":"(noun) The way you deal with or behave towards someone or something, or medical care.","example":{"text":"Tom needs proper medical treatment.","source":{"kind":"tatoeba","sentenceId":2957522,"author":"CK"}},"audio":"audio/97a5b9d62295c3a1.m4a"},{"id":"ex.vocab.treaty","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"treaty","back":"(noun) A formal written agreement between two or more countries.","example":{"text":"The two countries negotiated a treaty.","source":{"kind":"tatoeba","sentenceId":325617,"author":"CK"}},"audio":"audio/a2ef31b288e43b14.m4a"},{"id":"ex.vocab.tremble","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"tremble","back":"(verb) To shake slightly and quickly, often because you are cold, scared, or excited.","example":{"text":"I felt my hands tremble.","source":{"kind":"tatoeba","sentenceId":258447,"author":"CM"}},"audio":"audio/79c5633e4d99a3bb.m4a"},{"id":"ex.vocab.tribe","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"tribe","back":"(noun) A group of people, often with a shared culture, language, and history, living together.","example":{"text":"What tribe are you from?","source":{"kind":"tatoeba","sentenceId":5745884,"author":"CM"}},"audio":"audio/6aaf3e63289dd573.m4a"},{"id":"ex.vocab.trigger","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"trigger","back":"(verb) To cause something to start or happen.","example":{"text":"The loud noise triggered a reaction.","source":{"kind":"generated"}},"audio":"audio/4bc1fe26ce621036.m4a"},{"id":"ex.vocab.trombone","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"trombone","back":"(noun) A large brass musical instrument that you play by blowing into it and moving a slide.","example":{"text":"Do you play the trombone?","source":{"kind":"tatoeba","sentenceId":3819086,"author":"CK"}},"audio":"audio/ee3d008b804cfd58.m4a"},{"id":"ex.vocab.truly","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"truly","back":"(adverb) Really and sincerely.","example":{"text":"I'm truly sorry for having offended you.","source":{"kind":"tatoeba","sentenceId":1656649,"author":"Dejo"}},"audio":"audio/26b1a33803c97d93.m4a"},{"id":"ex.vocab.trustworthy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"trustworthy","back":"(adjective) Able to be relied on as honest or truthful.","example":{"text":"I think Tom is trustworthy.","source":{"kind":"tatoeba","sentenceId":3184198,"author":"CK"}},"audio":"audio/c3b500c7f531c0ca.m4a"},{"id":"ex.vocab.truthful","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"truthful","back":"(adjective) Always telling the truth; honest.","example":{"text":"I am a truthful person.","source":{"kind":"tatoeba","sentenceId":6110552,"author":"mailohilohi"}},"audio":"audio/0bbf0cd2fea9a03a.m4a"},{"id":"ex.vocab.typhoon","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"typhoon","back":"(noun) A very violent tropical storm with extremely strong winds and heavy rain.","example":{"text":"The meeting was canceled because of the typhoon.","source":{"kind":"tatoeba","sentenceId":22564,"author":"CK"}},"audio":"audio/a4e4b54247bc09a1.m4a"},{"id":"ex.vocab.unaware","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"unaware","back":"(adjective) Not knowing or realizing something.","example":{"text":"I was unaware of the problem.","source":{"kind":"tatoeba","sentenceId":2543176,"author":"CK"}},"audio":"audio/9e6f80cf34658c80.m4a"},{"id":"ex.vocab.unbearable","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"unbearable","back":"(adjective) So unpleasant or difficult that you cannot continue to experience it.","example":{"text":"Tom was in unbearable pain.","source":{"kind":"tatoeba","sentenceId":2958550,"author":"CK"}},"audio":"audio/cc986631d91d4f67.m4a"},{"id":"ex.vocab.unconscious","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"unconscious","back":"(adjective) in a state like sleep, usually caused by injury or illness, where you are not aware.","example":{"text":"He was unconscious for a brief period.","source":{"kind":"generated"}},"audio":"audio/132ac2ab11fca95f.m4a"},{"id":"ex.vocab.uneasy","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"uneasy","back":"(adjective) Feeling worried or slightly afraid because you think something bad might happen.","example":{"text":"Tom seemed uneasy in my presence.","source":{"kind":"tatoeba","sentenceId":7812442,"author":"Hybrid"}},"audio":"audio/af99883d632b586e.m4a"},{"id":"ex.vocab.unemployment","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"unemployment","back":"(noun) The state of not having a job, or the number of people without jobs.","example":{"text":"The unemployment level is high.","source":{"kind":"tatoeba","sentenceId":6942373,"author":"AlanF_US"}},"audio":"audio/a0745ed630a5fb6c.m4a"},{"id":"ex.vocab.unexpected","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"unexpected","back":"(adjective) Not expected or foreseen; surprising because it was not planned or predicted.","example":{"text":"Tom encountered some unexpected problems.","source":{"kind":"tatoeba","sentenceId":3171591,"author":"CK"}},"audio":"audio/ed7150ebb6b0022f.m4a"},{"id":"ex.vocab.unfair","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"unfair","back":"(adjective) Not right or reasonable; not treating everyone equally or justly.","example":{"text":"The new company rule was unfair to older workers.","source":{"kind":"tatoeba","sentenceId":269180,"author":"CM"}},"audio":"audio/d7a815ce4191419a.m4a"},{"id":"ex.vocab.unimpressed","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"unimpressed","back":"(adjective) Not feeling admiration or respect for someone or something.","example":{"text":"You seem to be unimpressed.","source":{"kind":"tatoeba","sentenceId":6353451,"author":"CK"}},"audio":"audio/7592cbc90e4f4a08.m4a"},{"id":"ex.vocab.unique","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"unique","back":"(adjective) Being the only one of its kind; very special or unusual.","example":{"text":"Every website has a unique address.","source":{"kind":"tatoeba","sentenceId":682397,"author":"Source_VOA"}},"audio":"audio/0db998cb43e8613f.m4a"},{"id":"ex.vocab.universe","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"universe","back":"(noun) All of space and everything in it, including stars, planets, and galaxies.","example":{"text":"How old is the universe?","source":{"kind":"tatoeba","sentenceId":682266,"author":"Source_VOA"}},"audio":"audio/47b83da0c16988b8.m4a"},{"id":"ex.vocab.unlikely","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"unlikely","back":"(adjective) Not probable; not expected to happen or be true.","example":{"text":"They are unlikely to marry.","source":{"kind":"tatoeba","sentenceId":306436,"author":"sundown"}},"audio":"audio/52543f90ee5f0b1f.m4a"},{"id":"ex.vocab.unwilling","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"unwilling","back":"(adjective) Not wanting to do something; reluctant.","example":{"text":"He was unwilling to go.","source":{"kind":"tatoeba","sentenceId":296350,"author":"CK"}},"audio":"audio/3222de7584844c61.m4a"},{"id":"ex.vocab.upon","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"upon","back":"(preposition) On something, or used to show that something is based on another thing.","example":{"text":"Discussion is based upon mutual respect.","source":{"kind":"tatoeba","sentenceId":19983,"author":"fishda"}},"audio":"audio/a629ebcdb08f019f.m4a"},{"id":"ex.vocab.upside","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"upside","back":"(noun) The positive or advantageous aspect of a situation.","example":{"text":"The upside of working from home is flexibility.","source":{"kind":"generated"}},"audio":"audio/a161da08281cf0ea.m4a"},{"id":"ex.vocab.urban","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"urban","back":"(adjective) Relating to a city or town, or found in a city or town.","example":{"text":"Traffic is a major urban problem.","source":{"kind":"tatoeba","sentenceId":240309,"author":"CM"}},"audio":"audio/cb6694d24e3234f4.m4a"},{"id":"ex.vocab.urge","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"urge","back":"(noun) A strong desire or impulse to do something.","example":{"text":"From time to time, she feels an urge to write poetry.","source":{"kind":"tatoeba","sentenceId":2278626,"author":"_undertoad"}},"audio":"audio/369a5c47fb053899.m4a"},{"id":"ex.vocab.urgent","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"urgent","back":"(adjective) Needing immediate attention or action.","example":{"text":"There is an urgent need for a new system.","source":{"kind":"tatoeba","sentenceId":903686,"author":"CK"}},"audio":"audio/8a42dc46186d5656.m4a"},{"id":"ex.vocab.vacuum","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"vacuum","back":"(noun) A space that is completely empty of matter, or a cleaning machine.","example":{"text":"Astronauts float in the vacuum of space.","source":{"kind":"generated"}},"audio":"audio/07f28d46ec31f73c.m4a"},{"id":"ex.vocab.vain","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"vain","back":"(adjective) without success; useless; too proud of your own appearance or achievements.","example":{"text":"All their efforts were in vain.","source":{"kind":"tatoeba","sentenceId":305272,"author":"CK"}},"audio":"audio/90ec86e923640e6c.m4a"},{"id":"ex.vocab.valid","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"valid","back":"(adjective) Based on truth or sound reasoning; acceptable or officially legal.","example":{"text":"Tom has a valid point.","source":{"kind":"tatoeba","sentenceId":5009337,"author":"CK"}},"audio":"audio/839c647c2fc4d04b.m4a"},{"id":"ex.vocab.vast","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"vast","back":"(adjective) Of very great extent or quantity; enormous.","example":{"text":"You don’t see a vast sea?","source":{"kind":"tatoeba","sentenceId":8799578,"author":"jimkillock"}},"audio":"audio/adb80dfd88ace91e.m4a"},{"id":"ex.vocab.vegan","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"vegan","back":"(adjective) Not eating or using any animal products, such as meat, dairy, or leather.","example":{"text":"Tom makes the best vegan sausage.","source":{"kind":"tatoeba","sentenceId":8911124,"author":"shekitten"}},"audio":"audio/5c855c4656ec1fc0.m4a"},{"id":"ex.vocab.verge","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"verge","back":"(noun) The edge or border of something, or the point at which something is about to happen.","example":{"text":"I was on the verge of tears.","source":{"kind":"tatoeba","sentenceId":4826137,"author":"Hybrid"}},"audio":"audio/e32251926ff6672b.m4a"},{"id":"ex.vocab.violate","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"violate","back":"(verb) To break or fail to follow a rule, law, or agreement.","example":{"text":"I didn't know I was violating any laws.","source":{"kind":"tatoeba","sentenceId":6344500,"author":"CK"}},"audio":"audio/45559d8ba5e04040.m4a"},{"id":"ex.vocab.violence","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"violence","back":"(noun) Physical force intended to hurt, damage, or kill someone or something.","example":{"text":"Tom committed multiple acts of violence.","source":{"kind":"tatoeba","sentenceId":4630584,"author":"Amastan"}},"audio":"audio/bd7671fa7e51c89c.m4a"},{"id":"ex.vocab.visible","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"visible","back":"(adjective) Able to be seen.","example":{"text":"The scars are barely visible.","source":{"kind":"tatoeba","sentenceId":3239484,"author":"Hybrid"}},"audio":"audio/27468ef27bdfc311.m4a"},{"id":"ex.vocab.vision","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"vision","back":"(noun) The ability to see; or a clear idea of what the future could be like.","example":{"text":"He presented his vision of a way for solving the crisis.","source":{"kind":"tatoeba","sentenceId":3469262,"author":"Objectivesea"}},"audio":"audio/8bc692a0e9b34731.m4a"},{"id":"ex.vocab.vomit","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"vomit","back":"(verb) To bring food or drink up from the stomach and out through the mouth.","example":{"text":"I think I'm going to vomit.","source":{"kind":"tatoeba","sentenceId":5738227,"author":"CM"}},"audio":"audio/c3c58d9ff9949ee1.m4a"},{"id":"ex.vocab.vulnerable","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"vulnerable","back":"(adjective) Easy to hurt or attack, either physically or emotionally.","example":{"text":"A baby giraffe is extremely vulnerable to predators.","source":{"kind":"tatoeba","sentenceId":8546763,"author":"Amastan"}},"audio":"audio/dbfb4f216e1ee22f.m4a"},{"id":"ex.vocab.wage","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"wage","back":"(noun) The money a person earns for the work they do, usually paid weekly.","example":{"text":"Can you get by on your wages?","source":{"kind":"tatoeba","sentenceId":16147,"author":"CM"}},"audio":"audio/ef37b1116f49daa8.m4a"},{"id":"ex.vocab.warehouse","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"warehouse","back":"(noun) A large building used for storing goods before they are sold or moved.","example":{"text":"The package left the warehouse yesterday.","source":{"kind":"tatoeba","sentenceId":10740842,"author":"megamanenm"}},"audio":"audio/3cabee441d45aa26.m4a"},{"id":"ex.vocab.weakness","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"weakness","back":"(noun) A fault or disadvantage, or a lack of strength or power.","example":{"text":"That's one of my weaknesses.","source":{"kind":"tatoeba","sentenceId":4999046,"author":"CK"}},"audio":"audio/075d64c308acb2ee.m4a"},{"id":"ex.vocab.wealth","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"wealth","back":"(noun) A large amount of valuable possessions or money.","example":{"text":"For all his wealth, he was still unhappy.","source":{"kind":"tatoeba","sentenceId":295516,"author":"CM"}},"audio":"audio/18132ef4d001dad4.m4a"},{"id":"ex.vocab.weave","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"weave","back":"(verb) To make cloth or baskets by crossing threads or strips of material over and under each other.","example":{"text":"I am weaving a carpet.","source":{"kind":"tatoeba","sentenceId":2720115,"author":"Amastan"}},"audio":"audio/dda8a825ad64cd00.m4a"},{"id":"ex.vocab.whatever","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"whatever","back":"(determiner) Any or every thing of a particular type, no matter what it is.","example":{"text":"Whatever happens, you have to stay calm.","source":{"kind":"tatoeba","sentenceId":25157,"author":"sundown"}},"audio":"audio/8eef875c3493982e.m4a"},{"id":"ex.vocab.whatsoever","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"whatsoever","back":"(adverb) Used after a negative phrase to emphasize that there is nothing of that kind.","example":{"text":"She felt no sympathy whatsoever.","source":{"kind":"tatoeba","sentenceId":10268631,"author":"sundown"}},"audio":"audio/cd9523721b0c14aa.m4a"},{"id":"ex.vocab.whip","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"whip","back":"(verb) To mix food very quickly with a whisk or mixer.","example":{"text":"Can you whip the cream for the cake?","source":{"kind":"generated"}},"audio":"audio/7cf59108329f9ee5.m4a"},{"id":"ex.vocab.willing","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"willing","back":"(adjective) Ready and happy to do something, or not objecting to doing it.","example":{"text":"I'm willing to help him.","source":{"kind":"tatoeba","sentenceId":20659,"author":"CK"}},"audio":"audio/6e70dc8e36c32826.m4a"},{"id":"ex.vocab.wisdom","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"wisdom","back":"(noun) The ability to use your experience and knowledge to make good decisions.","example":{"text":"He is a man of wisdom.","source":{"kind":"tatoeba","sentenceId":296030,"author":"CM"}},"audio":"audio/627c35905bffaa6d.m4a"},{"id":"ex.vocab.within","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"within","back":"(preposition) Inside something, or before a particular period of time has passed.","example":{"text":"Come back within a month.","source":{"kind":"tatoeba","sentenceId":73238,"author":"CK"}},"audio":"audio/a34eadd1a33596ad.m4a"},{"id":"ex.vocab.witness","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"witness","back":"(noun) A person who sees an event happen, especially a crime or accident.","example":{"text":"Tom is in the witness box.","source":{"kind":"tatoeba","sentenceId":2957135,"author":"CK"}},"audio":"audio/ddbd6b02b334c546.m4a"},{"id":"ex.vocab.worship","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"worship","back":"(verb) To show great respect and love for a god, or to admire someone greatly.","example":{"text":"He worships the ground Skura walks on.","source":{"kind":"tatoeba","sentenceId":8417555,"author":"Amastan"}},"audio":"audio/55565f68c07c3098.m4a"},{"id":"ex.vocab.wound","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"wound","back":"(noun) An injury to the body, especially a cut or deep hole in the skin.","example":{"text":"Let me see your wound.","source":{"kind":"tatoeba","sentenceId":267360,"author":"Auride"}},"audio":"audio/28851037558e1702.m4a"},{"id":"ex.vocab.wounded","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"wounded","back":"(adjective) Injured, especially by a weapon or in an accident.","example":{"text":"The bird had a wounded wing and couldn't fly.","source":{"kind":"generated"}},"audio":"audio/08a79820bfa7b56e.m4a"},{"id":"ex.vocab.wrestle","kind":"flashcard","level":"B2","grammarPointIds":[],"prompt":"Do you know this word?","front":"wrestle","back":"(verb) To fight by holding and throwing someone to the ground, or to struggle with a problem.","example":{"text":"Tom and his dog wrestled playfully for the ball.","source":{"kind":"tatoeba","sentenceId":6622070,"author":"Hybrid"}},"audio":"audio/aa9716a1621896d7.m4a"},{"id":"ex.b2.dictation.57967","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"This word is derived from German.","audio":"audio/fefa472b1f83c533.m4a","source":{"kind":"tatoeba","sentenceId":57967,"author":"AlanF_US"}},{"id":"ex.b2.dictation.262389","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"They had great fun at my expense.","audio":"audio/9e165c65fb5eac7a.m4a","source":{"kind":"tatoeba","sentenceId":262389,"author":"CK"}},{"id":"ex.b2.dictation.569732","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"The house collapsed a week later.","audio":"audio/05577144fd40152a.m4a","source":{"kind":"tatoeba","sentenceId":569732,"author":"kebukebu"}},{"id":"ex.b2.dictation.749342","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"We carry the responsibility for the losses.","audio":"audio/680f0554b20e8b87.m4a","source":{"kind":"tatoeba","sentenceId":749342,"author":"Serhiy"}},{"id":"ex.b2.dictation.1517275","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Are you trying to distract me?","audio":"audio/cf4036ffac0b7571.m4a","source":{"kind":"tatoeba","sentenceId":1517275,"author":"CM"}},{"id":"ex.b2.dictation.3417265","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Tom is very courageous, isn't he?","audio":"audio/361329d44b86e0a2.m4a","source":{"kind":"tatoeba","sentenceId":3417265,"author":"CK"}},{"id":"ex.b2.dictation.3619267","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Let me put a fresh bandage on your arm.","audio":"audio/a4b9a2e77cec1299.m4a","source":{"kind":"tatoeba","sentenceId":3619267,"author":"CK"}},{"id":"ex.b2.dictation.5767528","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"I can't log in to my account.","audio":"audio/d6a5a4dbcd989ed9.m4a","source":{"kind":"tatoeba","sentenceId":5767528,"author":"mailohilohi"}},{"id":"ex.b2.dictation.6113688","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Tom doesn't have a smartphone.","audio":"audio/16385f219d70fedd.m4a","source":{"kind":"tatoeba","sentenceId":6113688,"author":"CK"}},{"id":"ex.b2.dictation.7169304","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"I think that Tom won the election.","audio":"audio/5f1b672a19c54e0f.m4a","source":{"kind":"tatoeba","sentenceId":7169304,"author":"CK"}},{"id":"ex.b2.dictation.7507630","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"You ought let to Tom know you'll probably be late.","audio":"audio/90bc3b5b833785a4.m4a","source":{"kind":"tatoeba","sentenceId":7507630,"author":"CK"}},{"id":"ex.b2.dictation.7507676","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Tom told everybody he had been abducted by aliens.","audio":"audio/f474fca69da5a7c8.m4a","source":{"kind":"tatoeba","sentenceId":7507676,"author":"CK"}},{"id":"ex.b2.dictation.8088389","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"I couldn't give her the life that she deserved.","audio":"audio/c3f586250941a5c7.m4a","source":{"kind":"tatoeba","sentenceId":8088389,"author":"Amastan"}},{"id":"ex.b2.dictation.8793455","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"They accompanied Skura to Algiers.","audio":"audio/ae43be78e7b4ffb8.m4a","source":{"kind":"tatoeba","sentenceId":8793455,"author":"Amastan"}},{"id":"ex.b2.dictation.9286841","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Yanni flipped off the lights and got out of there.","audio":"audio/1b0fa1ddbcd41e5f.m4a","source":{"kind":"tatoeba","sentenceId":9286841,"author":"Amastan"}},{"id":"ex.b2.dictation.9303672","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Yesterday I saw you at the convenience store.","audio":"audio/01ff7659acd29493.m4a","source":{"kind":"tatoeba","sentenceId":9303672,"author":"Nylez"}},{"id":"ex.b2.dictation.10770516","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Stop getting yourself wound up.","audio":"audio/8397d8e37d204dbf.m4a","source":{"kind":"tatoeba","sentenceId":10770516,"author":"AlanF_US"}},{"id":"ex.b2.dictation.10822657","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"My dog suddenly became aggressive.","audio":"audio/683eb6974e57ddad.m4a","source":{"kind":"tatoeba","sentenceId":10822657,"author":"Amastan"}},{"id":"ex.b2.dictation.10862455","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Toxic people drag other people down to their level.","audio":"audio/6db77f8a63746316.m4a","source":{"kind":"tatoeba","sentenceId":10862455,"author":"Amastan"}},{"id":"ex.b2.dictation.11511061","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Two heavily armed guys stood at James's door.","audio":"audio/a8698b75ff209b5f.m4a","source":{"kind":"tatoeba","sentenceId":11511061,"author":"Amastan"}},{"id":"ex.b2.dictation.11650663","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"This spaceship is humanity’s last hope.","audio":"audio/7e7a7ed14e66e5a0.m4a","source":{"kind":"tatoeba","sentenceId":11650663,"author":"Amastan"}},{"id":"ex.b2.dictation.11694307","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"The lights turned off, ruining the moment.","audio":"audio/95f49f38ff768866.m4a","source":{"kind":"tatoeba","sentenceId":11694307,"author":"Amastan"}},{"id":"ex.b2.dictation.11783461","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Leaves were constantly falling from the trees.","audio":"audio/ce636532e98ed4cd.m4a","source":{"kind":"tatoeba","sentenceId":11783461,"author":"Amastan"}},{"id":"ex.b2.dictation.12268209","kind":"dictation","level":"B2","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Did you like spinach as a kid?","audio":"audio/79acfc8df9e1d5f8.m4a","source":{"kind":"tatoeba","sentenceId":12268209,"author":"sundown"}}]}