cab.remove","ex.vocab.repair","ex.vocab.replace","ex.vocab.reply","ex.vocab.report","ex.vocab.request","ex.vocab.require"]},{"id":"lesson.b1.vocabulary-29","level":"B1","topicId":"topic.vocabulary","title":"Words B1 29: rescue to row","goal":"Learn 20 B1 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.rescue","ex.vocab.research","ex.vocab.resource","ex.vocab.respect","ex.vocab.respond","ex.vocab.response","ex.vocab.responsible","ex.vocab.result","ex.vocab.retire","ex.vocab.rich","ex.vocab.rise","ex.vocab.risk","ex.vocab.rob","ex.vocab.role","ex.vocab.roll","ex.vocab.romantic","ex.vocab.root","ex.vocab.rope","ex.vocab.rough","ex.vocab.row"]},{"id":"lesson.b1.vocabulary-30","level":"B1","topicId":"topic.vocabulary","title":"Words B1 30: rude to sense","goal":"Learn 20 B1 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.rude","ex.vocab.rule","ex.vocab.rush","ex.vocab.safety","ex.vocab.sail","ex.vocab.salary","ex.vocab.satisfy","ex.vocab.scare","ex.vocab.scene","ex.vocab.schedule","ex.vocab.scientist","ex.vocab.scold","ex.vocab.score","ex.vocab.scratch","ex.vocab.scream","ex.vocab.search","ex.vocab.secret","ex.vocab.security","ex.vocab.seek","ex.vocab.sense"]},{"id":"lesson.b1.vocabulary-31","level":"B1","topicId":"topic.vocabulary","title":"Words B1 31: sentence to sight","goal":"Learn 20 B1 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.sentence","ex.vocab.separate","ex.vocab.serious","ex.vocab.seriously","ex.vocab.serve","ex.vocab.service","ex.vocab.settle","ex.vocab.several","ex.vocab.sex","ex.vocab.shall","ex.vocab.sharp","ex.vocab.shave","ex.vocab.sheep","ex.vocab.shock","ex.vocab.shocked","ex.vocab.shoot","ex.vocab.shout","ex.vocab.shut","ex.vocab.shy","ex.vocab.sight"]},{"id":"lesson.b1.vocabulary-32","level":"B1","topicId":"topic.vocabulary","title":"Words B1 32: silence to someday","goal":"Learn 20 B1 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.silence","ex.vocab.silent","ex.vocab.similar","ex.vocab.simply","ex.vocab.single","ex.vocab.site","ex.vocab.situation","ex.vocab.skill","ex.vocab.skip","ex.vocab.slam","ex.vocab.slice","ex.vocab.slightly","ex.vocab.slip","ex.vocab.snore","ex.vocab.social","ex.vocab.society","ex.vocab.soldier","ex.vocab.solution","ex.vocab.solve","ex.vocab.someday"]},{"id":"lesson.b1.vocabulary-33","level":"B1","topicId":"topic.vocabulary","title":"Words B1 33: sometime to stove","goal":"Learn 20 B1 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.sometime","ex.vocab.sort","ex.vocab.source","ex.vocab.spare","ex.vocab.speaker","ex.vocab.speech","ex.vocab.spill","ex.vocab.spirit","ex.vocab.spoil","ex.vocab.spot","ex.vocab.spread","ex.vocab.spy","ex.vocab.squirrel","ex.vocab.stage","ex.vocab.stare","ex.vocab.starve","ex.vocab.state","ex.vocab.statement","ex.vocab.steal","ex.vocab.stove"]},{"id":"lesson.b1.vocabulary-34","level":"B1","topicId":"topic.vocabulary","title":"Words B1 34: strength to switch","goal":"Learn 20 B1 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.strength","ex.vocab.stress","ex.vocab.stretch","ex.vocab.strict","ex.vocab.stuff","ex.vocab.stupid","ex.vocab.style","ex.vocab.succeed","ex.vocab.success","ex.vocab.successful","ex.vocab.sudden","ex.vocab.suddenly","ex.vocab.suggest","ex.vocab.suggestion","ex.vocab.support","ex.vocab.suppose","ex.vocab.surround","ex.vocab.survive","ex.vocab.sweat","ex.vocab.switch"]},{"id":"lesson.b1.vocabulary-35","level":"B1","topicId":"topic.vocabulary","title":"Words B1 35: system to till","goal":"Learn 20 B1 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.system","ex.vocab.talent","ex.vocab.talented","ex.vocab.tap","ex.vocab.task","ex.vocab.tax","ex.vocab.tear","ex.vocab.tease","ex.vocab.technology","ex.vocab.tend","ex.vocab.term","ex.vocab.themselves","ex.vocab.thick","ex.vocab.thief","ex.vocab.though","ex.vocab.threaten","ex.vocab.throat","ex.vocab.tie","ex.vocab.tight","ex.vocab.till"]},{"id":"lesson.b1.vocabulary-36","level":"B1","topicId":"topic.vocabulary","title":"Words B1 36: tip to uncomfortable","goal":"Learn 20 B1 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.tip","ex.vocab.tire","ex.vocab.tongue","ex.vocab.total","ex.vocab.totally","ex.vocab.tough","ex.vocab.track","ex.vocab.trade","ex.vocab.traditional","ex.vocab.training","ex.vocab.translate","ex.vocab.translation","ex.vocab.treat","ex.vocab.trick","ex.vocab.trunk","ex.vocab.trust","ex.vocab.truth","ex.vocab.tune","ex.vocab.unable","ex.vocab.uncomfortable"]},{"id":"lesson.b1.vocabulary-37","level":"B1","topicId":"topic.vocabulary","title":"Words B1 37: unfortunately to weapon","goal":"Learn 20 B1 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.unfortunately","ex.vocab.unless","ex.vocab.unusual","ex.vocab.upset","ex.vocab.valuable","ex.vocab.value","ex.vocab.various","ex.vocab.vegetarian","ex.vocab.vehicle","ex.vocab.victim","ex.vocab.view","ex.vocab.violin","ex.vocab.volunteer","ex.vocab.vote","ex.vocab.wander","ex.vocab.warn","ex.vocab.warning","ex.vocab.waste","ex.vocab.wealthy","ex.vocab.weapon"]},{"id":"lesson.b1.vocabulary-38","level":"B1","topicId":"topic.vocabulary","title":"Words B1 38: wedding to yell","goal":"Learn 19 B1 words with example sentences.","minutes":8,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.vocab.wedding","ex.vocab.weed","ex.vocab.weigh","ex.vocab.weight","ex.vocab.weird","ex.vocab.whenever","ex.vocab.whether","ex.vocab.whisper","ex.vocab.whistle","ex.vocab.whole","ex.vocab.windshield","ex.vocab.wing","ex.vocab.wipe","ex.vocab.wise","ex.vocab.wish","ex.vocab.wonder","ex.vocab.worth","ex.vocab.wrap","ex.vocab.yell"]},{"id":"lesson.b1.dictation","level":"B1","topicId":"topic.listening","title":"Dictation B1","goal":"Write down real English sentences you hear.","minutes":10,"grammarPointIds":[],"soundIds":[],"exerciseIds":["ex.b1.dictation.250296","ex.b1.dictation.403304","ex.b1.dictation.1708918","ex.b1.dictation.1893745","ex.b1.dictation.2360861","ex.b1.dictation.2540613","ex.b1.dictation.2541535","ex.b1.dictation.3310967","ex.b1.dictation.3328508","ex.b1.dictation.3724991","ex.b1.dictation.5604807","ex.b1.dictation.5850565","ex.b1.dictation.6256118","ex.b1.dictation.6353456","ex.b1.dictation.6508283","ex.b1.dictation.6627468","ex.b1.dictation.7653673","ex.b1.dictation.7803178","ex.b1.dictation.7900286","ex.b1.dictation.8999508","ex.b1.dictation.11506211","ex.b1.dictation.11690893","ex.b1.dictation.11757311","ex.b1.dictation.13853818"]}],"exercises":[{"id":"ex.b1.although-however-though.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Choose the best answer.","question":"The weather was terrible. ___, we still had a great time at the beach.","options":["Although","However","Though"],"answer":1,"explanation":"'However' is used here to connect two separate sentences and show contrast."},{"id":"ex.b1.although-however-though.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Choose the best answer.","question":"___ she studied hard, she didn't pass the exam.","options":["However","Although","But"],"answer":1,"explanation":"'Although' is a conjunction that can start a sentence to introduce a contrasting idea."},{"id":"ex.b1.although-however-though.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Choose the best answer.","question":"I don't usually like spicy food, ___ I really enjoyed this curry.","options":["however","though","so"],"answer":1,"explanation":"'Though' is an informal conjunction that can connect two contrasting clauses within a sentence."},{"id":"ex.b1.although-however-though.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Choose the best answer.","question":"He promised to help me; ___, he never showed up.","options":["although","however","despite"],"answer":1,"explanation":"'However' is correctly used here after a semicolon and before a comma to connect two contrasting independent clauses."},{"id":"ex.b1.although-however-though.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Complete the sentence.","text":"The movie was very long; ___, it was quite entertaining.","answers":[["however"]],"explanation":"'However' is used to connect two independent clauses, preceded by a semicolon and followed by a comma."},{"id":"ex.b1.although-however-though.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Put the words in the right order.","answer":["He","was","tired",".","However",",","he","finished","the","report","."],"distractors":["then"],"explanation":"This sentence correctly uses 'however' to connect two contrasting sentences."},{"id":"ex.b1.although-however-though.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I like the city. However it is too noisy.","answers":["I like the city; however, it is too noisy.","I like the city. However, it is too noisy."],"explanation":"'However' needs a semicolon before it and a comma after when connecting two independent clauses, or a full stop before and a comma after when starting a new sentence."},{"id":"ex.b1.although-however-though.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Though the weather was bad, however we still went hiking.","answers":["Though the weather was bad, we still went hiking.","Although the weather was bad, we still went hiking."],"explanation":"You should not use 'though' and 'however' together to express contrast in the same sentence."},{"id":"ex.b1.although-however-though.12","kind":"transformation","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Rewrite the sentence.","source":"It was raining, but we still went for a walk.","instruction":"Rewrite using 'although'.","answers":["Although it was raining, we still went for a walk.","We still went for a walk, although it was raining."],"explanation":"'Although' can replace 'but' to connect the two contrasting ideas within one sentence."},{"id":"ex.b1.although-however-though.13","kind":"transformation","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Rewrite the sentence.","source":"She didn't study much. She passed the test.","instruction":"Combine into one sentence using 'however'.","answers":["She didn't study much; however, she passed the test."],"explanation":"'However' can connect two independent clauses, preceded by a semicolon and followed by a comma."},{"id":"ex.b1.although-however-though.14","kind":"matching","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"Although the food was delicious,","right":"it was quite expensive."},{"left":"He tried to fix the car;","right":"however, he couldn't do it."},{"left":"The concert was amazing,","right":"though it started late."},{"left":"It was a difficult decision.","right":"However, she made the right choice."}]},{"id":"ex.b1.although-however-though.15","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Choose the best answer.","question":"The concert tickets were very expensive. ___, we bought them anyway.","options":["Although","Though","However","Despite"],"answer":2,"explanation":"\"However\" is used to connect two independent sentences, showing a contrast."},{"id":"ex.b1.although-however-though.16","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Choose the best answer.","question":"___ the weather was cold, we still enjoyed our picnic.","options":["However","Although","But","In spite of"],"answer":1,"explanation":"\"Although\" introduces a dependent clause that contrasts with the main clause."},{"id":"ex.b1.although-however-though.17","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Choose the best answer.","question":"She said she would be late. She arrived on time, ___.","options":["although","however","though","but"],"answer":2,"explanation":"\"Though\" can be used informally at the end of a sentence to add a contrasting idea."},{"id":"ex.b1.although-however-though.18","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.although-however-though"],"prompt":"Choose the best answer.","question":"The book was quite long. ___, I finished it in one day.","options":["Although","Despite","However","Even if"],"answer":2,"explanation":"\"However\" connects two independent sentences, indicating a contrast."},{"id":"ex.b1.as-as-comparisons.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Choose the best answer.","question":"The new restaurant is ___ popular as the old one.","options":["as","more","less"],"answer":0,"explanation":"To show equality, we use 'as...as'. 'As popular as' means they are equally popular."},{"id":"ex.b1.as-as-comparisons.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Choose the best answer.","question":"I don't feel ___ energetic as I did yesterday.","options":["so","as","more"],"answer":1,"explanation":"For negative comparisons of equality, use 'not as...as'."},{"id":"ex.b1.as-as-comparisons.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Choose the best answer.","question":"She drives ___ carefully as her instructor.","options":["more","as","less"],"answer":1,"explanation":"To show equal care in driving, use 'as carefully as'."},{"id":"ex.b1.as-as-comparisons.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Choose the best answer.","question":"This book is ___ interesting as the movie.","options":["not as","not so","less"],"answer":0,"explanation":"To express inequality, use 'not as...as'. 'Not as interesting as' means the book is less interesting than the movie."},{"id":"ex.b1.as-as-comparisons.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Put the words in the right order.","answer":["The","weather","today","is","as","cold","as","yesterday","."],"distractors":["more"],"explanation":"This sentence compares the equal coldness of today's weather to yesterday's."},{"id":"ex.b1.as-as-comparisons.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Put the words in the right order.","answer":["My","sister","doesn't","sing","as","loudly","as","I","do","."],"distractors":["more"],"explanation":"This sentence shows that the sister sings less loudly than the speaker."},{"id":"ex.b1.as-as-comparisons.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"This coffee is not so hot as I like it.","answers":["This coffee is not as hot as I like it."],"explanation":"For negative comparisons, the correct structure is 'not as...as', not 'not so...as'."},{"id":"ex.b1.as-as-comparisons.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"She works as hard than her manager.","answers":["She works as hard as her manager."],"explanation":"The correct preposition to complete the comparison 'as...as' is 'as', not 'than'."},{"id":"ex.b1.as-as-comparisons.12","kind":"transformation","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Rewrite the sentence.","source":"My old phone was very slow. My new phone is also very slow.","instruction":"Combine into one sentence using 'as...as'.","answers":["My new phone is as slow as my old phone."],"explanation":"The 'as...as' structure shows that both phones share the same quality (slowness) to an equal degree."},{"id":"ex.b1.as-as-comparisons.13","kind":"transformation","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Rewrite the sentence.","source":"The blue car is faster than the red car.","instruction":"Rewrite using 'not as...as'.","answers":["The red car is not as fast as the blue car."],"explanation":"To show that the red car is less fast than the blue car, we use 'not as fast as'."},{"id":"ex.b1.as-as-comparisons.14","kind":"matching","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"The concert wasn't","right":"as exciting as I hoped."},{"left":"He can speak French","right":"as fluently as a native speaker."},{"left":"My new shoes are","right":"as comfortable as my old ones."},{"left":"The exam questions were","right":"not as difficult as I expected."}]},{"id":"ex.b1.as-as-comparisons.15","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Choose the best answer.","question":"The new park is ___ large as the old one, but it has more trees.","options":["so","as","very"],"answer":1,"explanation":"We use 'as...as' to make an equal comparison. 'As' is needed before 'large'."},{"id":"ex.b1.as-as-comparisons.16","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Choose the best answer.","question":"My current job isn't ___ challenging as my previous role.","options":["so","as","too"],"answer":1,"explanation":"For negative comparisons, we use 'not as...as' to show something is less."},{"id":"ex.b1.as-as-comparisons.17","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Choose the best answer.","question":"Could you please speak ___ clearly as you can?","options":["more","as","most"],"answer":1,"explanation":"The structure 'as + adverb + as' is used for equal comparison or to express the maximum possible."},{"id":"ex.b1.as-as-comparisons.18","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.as-as-comparisons"],"prompt":"Choose the best answer.","question":"This recipe is ___ easy to follow as the one we tried last week.","options":["as","so","more"],"answer":0,"explanation":"To show that two things are equally easy, we use 'as...as'."},{"id":"ex.b1.both-either-neither.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Choose the best answer.","question":"My parents are coming to visit. ___ of them has seen my new apartment yet.","options":["Both","Either","Neither"],"answer":2,"explanation":"'Neither' is correct because the verb 'has seen' is singular, and it implies that not one and not the other parent has seen the apartment."},{"id":"ex.b1.both-either-neither.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Choose the best answer.","question":"We have two tickets for the concert. ___ of us can go.","options":["Both","Either","Neither"],"answer":0,"explanation":"'Both' is correct because it refers to two people (us) and the verb 'can go' implies that both are able to attend."},{"id":"ex.b1.both-either-neither.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Choose the best answer.","question":"You can choose ___ coffee or tea with your breakfast.","options":["both","either","neither"],"answer":1,"explanation":"'Either... or...' is used to present two choices."},{"id":"ex.b1.both-either-neither.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Choose the best answer.","question":"The two books were very interesting. I enjoyed ___ of them.","options":["both","either","neither"],"answer":0,"explanation":"'Both' is correct because it means you enjoyed the two books together."},{"id":"ex.b1.both-either-neither.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Complete the sentence.","text":"I asked two friends to help, but ___ of them was available.","answers":[["neither"]],"explanation":"'Neither' is correct because it means not one and not the other friend was available, and it takes a singular verb 'was'."},{"id":"ex.b1.both-either-neither.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Complete the sentence.","text":"___ my brother ___ my sister likes spicy food.","answers":[["Neither"],["nor"]],"explanation":"'Neither... nor...' is used to say that two things are not true. The verb 'likes' agrees with 'sister'."},{"id":"ex.b1.both-either-neither.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Put the words in the right order.","answer":["Both","my","parents","speak","French","."],"distractors":["every","speaks"],"explanation":"This sentence correctly uses 'both' to refer to two parents, followed by a plural verb."},{"id":"ex.b1.both-either-neither.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Put the words in the right order.","answer":["You","can","take","either","the","bus","or","the","train","."],"distractors":["and","nor"],"explanation":"This sentence uses 'either... or...' to offer two transportation choices."},{"id":"ex.b1.both-either-neither.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Neither of the options are acceptable.","answers":["Neither of the options is acceptable."],"explanation":"When 'neither' is the subject, the verb should be singular."},{"id":"ex.b1.both-either-neither.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I like both coffee or tea.","answers":["I like both coffee and tea."],"explanation":"When using 'both' to connect two items, use 'and', not 'or'."},{"id":"ex.b1.both-either-neither.12","kind":"transformation","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Rewrite the sentence.","source":"I don't want the red shirt, and I don't want the blue shirt.","instruction":"Rewrite using 'neither'.","answers":["I want neither the red shirt nor the blue shirt.","I want neither of the shirts."],"explanation":"'Neither... nor...' is used to express that two negative options are true. 'Neither of the shirts' is a more concise alternative."},{"id":"ex.b1.both-either-neither.13","kind":"transformation","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Rewrite the sentence.","source":"The two restaurants are closed today.","instruction":"Rewrite using 'both'.","answers":["Both restaurants are closed today.","Both of the restaurants are closed today."],"explanation":"'Both' refers to the two restaurants, and the verb 'are closed' is plural."},{"id":"ex.b1.both-either-neither.14","kind":"matching","level":"B1","grammarPointIds":["gp.both-either-neither"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"Both my parents","right":"work in the medical field."},{"left":"You can choose either","right":"apples or oranges for your snack."},{"left":"Neither of the movies","right":"was very interesting."},{"left":"They both","right":"decided to stay home."}]},{"id":"ex.b1.defining-relative-clauses.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Choose the best answer.","question":"The restaurant ___ serves the best pizza is always crowded.","options":["who","where","which","what"],"answer":2,"explanation":"The restaurant is a thing, so 'which' is the correct relative pronoun. 'That' would also be correct here."},{"id":"ex.b1.defining-relative-clauses.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Choose the best answer.","question":"Do you remember the day ___ we first met?","options":["who","which","where","when"],"answer":3,"explanation":"While 'where' is for places, 'when' is used for time. 'The day' refers to a point in time, so 'when' is appropriate. 'That' could also be used here."},{"id":"ex.b1.defining-relative-clauses.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Choose the best answer.","question":"I need to find the person ___ can help me with this problem.","options":["which","where","who","what"],"answer":2,"explanation":"'The person' is a human, so 'who' is the correct relative pronoun. 'That' would also be correct here."},{"id":"ex.b1.defining-relative-clauses.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Choose the best answer.","question":"This is the library ___ I study every weekend.","options":["who","which","that","where"],"answer":3,"explanation":"'The library' is a place, so 'where' is the correct relative pronoun to introduce the clause about an activity happening there."},{"id":"ex.b1.defining-relative-clauses.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Complete the sentence.","text":"The movie ___ we watched last night was very exciting.","answers":[["that","which"]],"explanation":"'The movie' is a thing, so 'that' or 'which' are correct."},{"id":"ex.b1.defining-relative-clauses.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Complete the sentence.","text":"She knows a painter ___ work is displayed in the gallery.","answers":[["whose"]],"explanation":"'Whose' is used to show possession for people or things. The work belongs to the painter."},{"id":"ex.b1.defining-relative-clauses.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Complete the sentence.","text":"The cafe ___ has outdoor seating is my favorite.","answers":[["that","which"]],"explanation":"'The cafe' is a place/thing, so 'that' or 'which' are correct."},{"id":"ex.b1.defining-relative-clauses.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Put the words in the right order.","answer":["The","man","who","lives","next","door","is","a","teacher."],"distractors":["where"],"explanation":"The relative clause 'who lives next door' identifies which man is being discussed."},{"id":"ex.b1.defining-relative-clauses.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Put the words in the right order.","answer":["I","love","the","shoes","that","you","bought","yesterday."],"distractors":["who"],"explanation":"The relative clause 'that you bought yesterday' specifies which shoes are loved."},{"id":"ex.b1.defining-relative-clauses.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"This is the park which we play soccer.","answers":["This is the park where we play soccer."],"explanation":"'The park' is a place, so 'where' is the correct relative pronoun to describe an activity happening there."},{"id":"ex.b1.defining-relative-clauses.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The student, who got the highest score, received a scholarship.","answers":["The student who got the highest score received a scholarship."],"explanation":"This is a defining relative clause, providing essential information, so no commas are needed."},{"id":"ex.b1.defining-relative-clauses.12","kind":"transformation","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Rewrite the sentence.","source":"I met a woman. She works at the university.","instruction":"Combine into one sentence using 'who'.","answers":["I met a woman who works at the university."],"explanation":"The relative pronoun 'who' connects the two sentences, identifying the woman."},{"id":"ex.b1.defining-relative-clauses.13","kind":"transformation","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Rewrite the sentence.","source":"The car broke down. It was parked outside.","instruction":"Combine into one sentence using 'that'.","answers":["The car that was parked outside broke down.","The car which was parked outside broke down."],"explanation":"The relative pronoun 'that' (or 'which') connects the two sentences, identifying the car."},{"id":"ex.b1.defining-relative-clauses.14","kind":"matching","level":"B1","grammarPointIds":["gp.defining-relative-clauses"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I visited the city","right":"where my grandparents were born."},{"left":"The book","right":"that I'm reading is very interesting."},{"left":"She knows a chef","right":"who creates amazing desserts."},{"left":"I need to find the keys","right":"which I left on the table."}]},{"id":"ex.b1.dont-have-to-vs-mustnt.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Choose the best answer.","question":"You ___ park your car here; it's a no-parking zone.","options":["don't have to","mustn't","doesn't have to"],"answer":1,"explanation":"'Mustn't' is correct because parking in a no-parking zone is forbidden."},{"id":"ex.b1.dont-have-to-vs-mustnt.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Choose the best answer.","question":"We ___ buy tickets in advance; we can get them at the door.","options":["mustn't","don't have to","doesn't have to"],"answer":1,"explanation":"'Don't have to' is correct because buying tickets in advance is not necessary."},{"id":"ex.b1.dont-have-to-vs-mustnt.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Choose the best answer.","question":"She ___ tell anyone about the surprise party.","options":["doesn't have to","mustn't","don't have to"],"answer":1,"explanation":"'Mustn't' is correct because telling people about a surprise party is forbidden."},{"id":"ex.b1.dont-have-to-vs-mustnt.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Choose the best answer.","question":"You ___ come to the meeting if you're too busy.","options":["mustn't","don't have to","doesn't have to"],"answer":1,"explanation":"'Don't have to' is correct because coming to the meeting is not obligatory if you're busy."},{"id":"ex.b1.dont-have-to-vs-mustnt.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Complete the sentence.","text":"He ___ work on Saturdays, but he often chooses to.","answers":[["doesn't have to"]],"explanation":"Working on Saturdays is not necessary for him, so he has a choice."},{"id":"ex.b1.dont-have-to-vs-mustnt.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Complete the sentence.","text":"We ___ make a lot of noise in the library, but we ___ whisper.","answers":[["mustn't","must not"],["don't have to"]],"explanation":"Making noise is forbidden, but whispering is not necessary."},{"id":"ex.b1.dont-have-to-vs-mustnt.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Put the words in the right order.","answer":["You","don't","have","to","pay","for","the","extra","baggage","."],"explanation":"This sentence means paying for extra baggage is not necessary.","alternatives":[["You","don't","have","to","pay","extra","for","the","baggage","."]]},{"id":"ex.b1.dont-have-to-vs-mustnt.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Put the words in the right order.","answer":["Students","mustn't","use","their","phones","during","class","."],"distractors":["not","should"],"explanation":"This sentence means using phones during class is forbidden for students."},{"id":"ex.b1.dont-have-to-vs-mustnt.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"You mustn't get up early tomorrow, it's a holiday.","answers":["You don't have to get up early tomorrow, it's a holiday."],"explanation":"Getting up early is not necessary on a holiday, not forbidden."},{"id":"ex.b1.dont-have-to-vs-mustnt.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Visitors don't have to feed the animals at the zoo.","answers":["Visitors mustn't feed the animals at the zoo."],"explanation":"Feeding zoo animals is usually forbidden for their safety and health."},{"id":"ex.b1.dont-have-to-vs-mustnt.12","kind":"transformation","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Rewrite the sentence.","source":"It is not necessary for us to bring a gift.","instruction":"Rewrite using 'don't have to'.","answers":["We don't have to bring a gift."],"explanation":"The instruction requires changing 'it is not necessary' to 'don't have to'."},{"id":"ex.b1.dont-have-to-vs-mustnt.13","kind":"transformation","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Rewrite the sentence.","source":"Smoking is forbidden inside the building.","instruction":"Rewrite using 'mustn't'.","answers":["You mustn't smoke inside the building."],"explanation":"The instruction requires changing 'forbidden' to 'mustn't'."},{"id":"ex.b1.dont-have-to-vs-mustnt.14","kind":"matching","level":"B1","grammarPointIds":["gp.dont-have-to-vs-mustnt"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"You don't have to","right":"finish the report today if you're busy."},{"left":"We mustn't","right":"talk during the performance."},{"left":"She doesn't have to","right":"attend the optional workshop."},{"left":"They mustn't","right":"cross the road when the light is red."}]},{"id":"ex.b1.few-little-a-few-a-little.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Choose the best answer.","question":"We only have ___ eggs left, so I can't make an omelet for everyone.","options":["a little","little","a few","few"],"answer":3,"explanation":"'Eggs' are countable, and the sentence implies a negative situation (not enough for everyone), so 'few' is correct."},{"id":"ex.b1.few-little-a-few-a-little.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Choose the best answer.","question":"I need ___ advice about my new project.","options":["a few","few","a little","little"],"answer":2,"explanation":"'Advice' is an uncountable noun, and the speaker wants 'some' advice, so 'a little' is correct."},{"id":"ex.b1.few-little-a-few-a-little.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Choose the best answer.","question":"Despite the rain, there were still ___ tourists visiting the museum.","options":["little","few","a little","a few"],"answer":3,"explanation":"'Tourists' are countable. The phrase 'despite the rain' suggests that having 'some' tourists is a positive or surprising fact, so 'a few' is correct."},{"id":"ex.b1.few-little-a-few-a-little.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Choose the best answer.","question":"He has ___ patience for people who are always late.","options":["a few","few","a little","little"],"answer":3,"explanation":"'Patience' is an uncountable noun. The sentence implies he has 'not much' patience, which is a negative idea, so 'little' is correct."},{"id":"ex.b1.few-little-a-few-a-little.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Complete the sentence.","text":"Could you add just ___ salt to the soup?","answers":[["a little"]],"explanation":"'Salt' is uncountable, and the request is for 'some' (a small amount), so 'a little' is correct."},{"id":"ex.b1.few-little-a-few-a-little.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Complete the sentence.","text":"There were ___ chairs available, so some people had to stand.","answers":[["few"]],"explanation":"'Chairs' are countable, and the situation is negative (not enough chairs), so 'few' is correct."},{"id":"ex.b1.few-little-a-few-a-little.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Complete the sentence.","text":"I've made ___ progress on my essay, but I still have a lot to do.","answers":[["a little"]],"explanation":"'Progress' is uncountable. 'A little' indicates 'some' progress, which is a positive step, even if there's more work ahead."},{"id":"ex.b1.few-little-a-few-a-little.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Put the words in the right order.","answer":["She","has","a","few","good","ideas","."],"distractors":["little"],"explanation":"This sentence uses 'a few' with the countable noun 'ideas' to mean 'some good ideas'."},{"id":"ex.b1.few-little-a-few-a-little.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Put the words in the right order.","answer":["We","have","little","information","about","the","incident","."],"distractors":["few"],"explanation":"This sentence uses 'little' with the uncountable noun 'information' to mean 'not much information', implying a lack."},{"id":"ex.b1.few-little-a-few-a-little.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"There was a few traffic on the road this morning.","answers":["There was a little traffic on the road this morning."],"explanation":"'Traffic' is an uncountable noun, so 'a little' should be used instead of 'a few'."},{"id":"ex.b1.few-little-a-few-a-little.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"He has a little friends in his new city.","answers":["He has a few friends in his new city."],"explanation":"'Friends' are countable, so 'a few' should be used instead of 'a little'."},{"id":"ex.b1.few-little-a-few-a-little.12","kind":"transformation","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Rewrite the sentence.","source":"I don't have much time to finish this task.","instruction":"Rewrite using 'little'.","answers":["I have little time to finish this task."],"explanation":"'Little' means 'not much' and is used with uncountable nouns like 'time'."},{"id":"ex.b1.few-little-a-few-a-little.13","kind":"transformation","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Rewrite the sentence.","source":"There are some chairs available, but not many.","instruction":"Rewrite using 'a few'.","answers":["There are a few chairs available."],"explanation":"'A few' means 'some' and is used with countable nouns like 'chairs'."},{"id":"ex.b1.few-little-a-few-a-little.14","kind":"matching","level":"B1","grammarPointIds":["gp.few-little-a-few-a-little"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I only have a few","right":"coins in my pocket."},{"left":"She needs a little","right":"help with her homework."},{"left":"There were few","right":"options left for dinner."},{"left":"He has little","right":"interest in politics."}]},{"id":"ex.b1.first-conditional.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Choose the best answer.","question":"If you ___ late, you will miss the beginning of the movie.","options":["arrive","will arrive","arrived","are arriving"],"answer":0,"explanation":"In the 'if' clause of a first conditional, we use the present simple tense."},{"id":"ex.b1.first-conditional.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Choose the best answer.","question":"What will happen if the train is delayed?","options":["I miss my appointment.","I will miss my appointment.","I would miss my appointment.","I missed my appointment."],"answer":1,"explanation":"For a real future possibility, the result clause uses 'will' + base verb."},{"id":"ex.b1.first-conditional.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Choose the best answer.","question":"If she ___ enough money, she will buy a new laptop.","options":["has","will have","had","is having"],"answer":0,"explanation":"The 'if' clause requires the present simple tense."},{"id":"ex.b1.first-conditional.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Choose the best answer.","question":"They ___ happy if you visit them next weekend.","options":["are","will be","would be","were"],"answer":1,"explanation":"The main clause of a first conditional uses 'will' + base verb to express a future result."},{"id":"ex.b1.first-conditional.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Complete the sentence.","text":"If it ___ sunny tomorrow, we ___ to the beach.","answers":[["is"],["will go","willgo"]],"explanation":"The 'if' clause uses present simple ('is'), and the main clause uses 'will' + base verb ('will go')."},{"id":"ex.b1.first-conditional.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Complete the sentence.","text":"You ___ better if you ___ more water.","answers":[["will feel","willfeel"],["drink"]],"explanation":"The main clause uses 'will' + base verb ('will feel'), and the 'if' clause uses present simple ('drink')."},{"id":"ex.b1.first-conditional.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Complete the sentence.","text":"If I ___ time, I ___ you with your homework.","answers":[["have"],["will help","willhelp"]],"explanation":"The 'if' clause uses present simple ('have'), and the main clause uses 'will' + base verb ('will help')."},{"id":"ex.b1.first-conditional.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Put the words in the right order.","answer":["If","you","don't","eat","breakfast",",","you","will","be","hungry","."],"distractors":["ate","are"],"explanation":"This sentence correctly forms a first conditional, stating a possible future condition and its result."},{"id":"ex.b1.first-conditional.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Put the words in the right order.","answer":["She","will","pass","the","test","if","she","studies","hard","."],"distractors":["passed","study"],"explanation":"This sentence correctly forms a first conditional, with the 'will' clause first."},{"id":"ex.b1.first-conditional.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"If he will arrive early, we can start the meeting.","answers":["If he arrives early, we can start the meeting."],"explanation":"The 'if' clause in the first conditional uses the present simple, not 'will'."},{"id":"ex.b1.first-conditional.12","kind":"transformation","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Rewrite the sentence.","source":"It might rain, so I'll bring an umbrella.","instruction":"Rewrite using the first conditional.","answers":["If it rains, I will bring an umbrella."],"explanation":"The first conditional connects a possible future condition ('if it rains') with its likely result ('I will bring an umbrella')."},{"id":"ex.b1.first-conditional.13","kind":"transformation","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Rewrite the sentence.","source":"If you don't practice, you won't improve.","instruction":"Rewrite starting with 'You won't improve...'","answers":["You won't improve if you don't practice."],"explanation":"The order of the clauses can be reversed without changing the meaning. No comma is needed when the 'will' clause comes first."},{"id":"ex.b1.first-conditional.14","kind":"matching","level":"B1","grammarPointIds":["gp.first-conditional"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"If I save enough money,","right":"I will buy a new bicycle."},{"left":"She will be upset","right":"if you forget her birthday."},{"left":"If the restaurant is full,","right":"we will find another place to eat."},{"left":"You will feel much better","right":"if you get some rest."}]},{"id":"ex.b1.gerund-or-infinitive.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Choose the best answer.","question":"My brother avoids ___ fast food.","options":["to eat","eating","eat"],"answer":1,"explanation":"The verb 'avoid' is followed by the -ing form."},{"id":"ex.b1.gerund-or-infinitive.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Choose the best answer.","question":"We plan ___ a new project next month.","options":["starting","to start","start"],"answer":1,"explanation":"The verb 'plan' is followed by 'to' + infinitive."},{"id":"ex.b1.gerund-or-infinitive.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Choose the best answer.","question":"Do you mind ___ the window? It's a bit cold.","options":["closing","to close","close"],"answer":0,"explanation":"The verb 'mind' is followed by the -ing form."},{"id":"ex.b1.gerund-or-infinitive.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Choose the best answer.","question":"I need ___ some groceries after work.","options":["buying","to buy","buy"],"answer":1,"explanation":"The verb 'need' is followed by 'to' + infinitive."},{"id":"ex.b1.gerund-or-infinitive.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Complete the sentence.","text":"She suggested ___ (go) to the park.","answers":[["going"]],"explanation":"'Suggest' is followed by the -ing form."},{"id":"ex.b1.gerund-or-infinitive.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Complete the sentence.","text":"They agreed ___ (meet) at 7 PM.","answers":[["to meet"]],"explanation":"'Agree' is followed by 'to' + infinitive."},{"id":"ex.b1.gerund-or-infinitive.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Complete the sentence.","text":"He finished ___ (read) the book yesterday.","answers":[["reading"]],"explanation":"'Finish' is followed by the -ing form."},{"id":"ex.b1.gerund-or-infinitive.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Put the words in the right order.","answer":["I","want","to","visit","Paris","."],"distractors":["visiting"],"explanation":"'Want' is followed by 'to' + infinitive."},{"id":"ex.b1.gerund-or-infinitive.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Put the words in the right order.","answer":["She","enjoys","listening","to","music","."],"distractors":["to listen"],"explanation":"'Enjoy' is followed by the -ing form."},{"id":"ex.b1.gerund-or-infinitive.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"We decided buying a new car.","answers":["We decided to buy a new car."],"explanation":"'Decide' is followed by 'to' + infinitive."},{"id":"ex.b1.gerund-or-infinitive.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"He avoids to answer difficult questions.","answers":["He avoids answering difficult questions."],"explanation":"'Avoid' is followed by the -ing form."},{"id":"ex.b1.gerund-or-infinitive.12","kind":"transformation","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Rewrite the sentence.","source":"I like to swim in the ocean.","instruction":"Use the verb 'enjoy'.","answers":["I enjoy swimming in the ocean."],"explanation":"'Enjoy' takes the -ing form."},{"id":"ex.b1.gerund-or-infinitive.13","kind":"transformation","level":"B1","grammarPointIds":["gp.gerund-or-infinitive"],"prompt":"Rewrite the sentence.","source":"They want to travel next year.","instruction":"Use the verb 'plan'.","answers":["They plan to travel next year."],"explanation":"'Plan' takes 'to' + infinitive."},{"id":"ex.b1.indirect-questions.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Choose the best answer.","question":"Excuse me, could you tell me where ___?","options":["is the post office","the post office is","does the post office is"],"answer":1,"explanation":"After 'Could you tell me where', we use statement word order: subject ('the post office') followed by the verb ('is')."},{"id":"ex.b1.indirect-questions.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Choose the best answer.","question":"Do you know what time ___?","options":["the concert starts","does the concert start","starts the concert"],"answer":0,"explanation":"Indirect questions use statement word order (subject + verb) and do not include 'do' or 'does'."},{"id":"ex.b1.indirect-questions.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Choose the best answer.","question":"Could you tell me ___?","options":["how much costs this shirt","how much this shirt costs","how much does this shirt cost"],"answer":1,"explanation":"The correct structure for an indirect question is 'question word + subject + verb', so 'how much this shirt costs'."},{"id":"ex.b1.indirect-questions.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Choose the best answer.","question":"I'd like to know ___.","options":["when the next bus arrives","when does the next bus arrive","when arrives the next bus"],"answer":0,"explanation":"The phrase 'I'd like to know' also introduces an indirect question, requiring statement word order: 'the next bus arrives'."},{"id":"ex.b1.indirect-questions.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Complete the sentence.","text":"Could you tell me where the nearest ATM ___?","answers":[["is"]],"explanation":"After 'where the nearest ATM', we need the verb 'is' to complete the statement word order."},{"id":"ex.b1.indirect-questions.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Complete the sentence.","text":"Do you know what time the store ___ on Sundays?","answers":[["opens"]],"explanation":"For an indirect question, we use statement word order (subject + verb) and omit 'does'. So, 'the store opens'."},{"id":"ex.b1.indirect-questions.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Complete the sentence.","text":"Could you tell me how I ___ to the train station from here?","answers":[["can get","get"]],"explanation":"The modal verb 'can' comes after the subject 'I' in statement word order."},{"id":"ex.b1.indirect-questions.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Put the words in the right order.","answer":["Could","you","tell","me","what","your","name","is","?"],"distractors":["are"],"explanation":"The correct order for an indirect question is 'Could you tell me + question word + subject + verb'."},{"id":"ex.b1.indirect-questions.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Put the words in the right order.","answer":["Do","you","know","when","the","movie","starts","?"],"distractors":["start"],"explanation":"After 'Do you know when', the sentence uses statement word order: 'the movie starts'."},{"id":"ex.b1.indirect-questions.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Could you tell me where is the exit?","answers":["Could you tell me where the exit is?"],"explanation":"In an indirect question, the verb ('is') comes after the subject ('the exit')."},{"id":"ex.b1.indirect-questions.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Do you know what time does the bank open?","answers":["Do you know what time the bank opens?"],"explanation":"We do not use 'do', 'does', or 'did' in indirect questions. The verb 'open' becomes 'opens' for third person singular."},{"id":"ex.b1.indirect-questions.12","kind":"transformation","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Rewrite the sentence.","source":"Where is the nearest supermarket?","instruction":"Rewrite as an indirect question starting with 'Could you tell me...'.","answers":["Could you tell me where the nearest supermarket is?"],"explanation":"Change the direct question into an indirect one by using 'Could you tell me' and statement word order (subject + verb)."},{"id":"ex.b1.indirect-questions.13","kind":"transformation","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Rewrite the sentence.","source":"What time does the flight depart?","instruction":"Rewrite as an indirect question starting with 'Do you know...'.","answers":["Do you know what time the flight departs?"],"explanation":"Use 'Do you know' and change the question to statement word order, removing 'does' and adding 's' to the verb 'depart'."},{"id":"ex.b1.indirect-questions.14","kind":"matching","level":"B1","grammarPointIds":["gp.indirect-questions"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"Could you tell me where","right":"the bus stop is?"},{"left":"Do you know what time","right":"the library closes?"},{"left":"I'd like to know how","right":"I can get a taxi."},{"left":"Could you explain why","right":"the meeting was canceled?"}]},{"id":"ex.b1.might-may-could-for-possibility.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Choose the best answer.","question":"I'm not sure, but I ___ visit my aunt next month.","options":["can","might","should"],"answer":1,"explanation":"'Might' expresses possibility, which fits the uncertainty of the sentence."},{"id":"ex.b1.might-may-could-for-possibility.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Choose the best answer.","question":"The restaurant ___ be closed on Mondays, so let's check online.","options":["must","may","will"],"answer":1,"explanation":"'May' indicates a possibility that needs to be confirmed."},{"id":"ex.b1.might-may-could-for-possibility.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Choose the best answer.","question":"If you don't hurry, you ___ miss your flight.","options":["could","must","would"],"answer":0,"explanation":"'Could' expresses a possible negative outcome if a condition isn't met."},{"id":"ex.b1.might-may-could-for-possibility.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Choose the best answer.","question":"It's cloudy, so it ___ rain later this afternoon.","options":["will","may","has to"],"answer":1,"explanation":"'May' is used to talk about a future possibility based on current conditions."},{"id":"ex.b1.might-may-could-for-possibility.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Put the words in the right order.","answer":["We","might","go","camping","this","summer","."],"distractors":["will","to"],"explanation":"This sentence expresses a future possibility using 'might'."},{"id":"ex.b1.might-may-could-for-possibility.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Put the words in the right order.","answer":["It","could","be","a","good","idea","."],"distractors":["is","have"],"explanation":"This sentence uses 'could' to suggest a possibility."},{"id":"ex.b1.might-may-could-for-possibility.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"They may to cancel the event.","answers":["They may cancel the event."],"explanation":"Modal verbs are followed directly by the base form of the verb, without 'to'."},{"id":"ex.b1.might-may-could-for-possibility.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"He might not comes to the meeting.","answers":["He might not come to the meeting."],"explanation":"After a modal verb, the main verb always stays in its base form, even in negative sentences."},{"id":"ex.b1.might-may-could-for-possibility.12","kind":"transformation","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Rewrite the sentence.","source":"Perhaps she is at home.","instruction":"Rewrite using 'may'.","answers":["She may be at home."],"explanation":"'May' expresses possibility, replacing 'perhaps she is'."},{"id":"ex.b1.might-may-could-for-possibility.13","kind":"transformation","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Rewrite the sentence.","source":"It's possible that they won't accept our offer.","instruction":"Rewrite using 'might not'.","answers":["They might not accept our offer."],"explanation":"'Might not' expresses a negative possibility."},{"id":"ex.b1.might-may-could-for-possibility.14","kind":"matching","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I'm not sure, but I might","right":"order pizza tonight."},{"left":"The bus may","right":"be late due to traffic."},{"left":"If you don't study, you could","right":"fail the exam."},{"left":"She might not","right":"have enough time."}]},{"id":"ex.b1.might-may-could-for-possibility.15","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Choose the best answer.","question":"I'm not sure, but the new cafe ___ open next week.","options":["might","is","will"],"answer":0,"explanation":"'Might' expresses possibility or uncertainty about a future event."},{"id":"ex.b1.might-may-could-for-possibility.16","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Choose the best answer.","question":"Where's David? He ___ be in the library studying.","options":["can","could","must"],"answer":1,"explanation":"'Could' is used here to suggest a possibility about David's current location. 'Can' is for ability, 'must' for strong deduction."},{"id":"ex.b1.might-may-could-for-possibility.17","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.might-may-could-for-possibility"],"prompt":"Choose the best answer.","question":"We ___ not have enough time to visit the museum.","options":["may","will","should"],"answer":0,"explanation":"'May not' expresses a negative possibility or uncertainty."},{"id":"ex.b1.must-and-cant-for-deduction.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Choose the best answer.","question":"The lights are off and the door is locked. They ___ be out.","options":["can't","must","might"],"answer":1,"explanation":"'Must' is used for a strong logical conclusion based on the evidence."},{"id":"ex.b1.must-and-cant-for-deduction.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Choose the best answer.","question":"She just ate a huge dinner. She ___ be hungry.","options":["must","can't","is"],"answer":1,"explanation":"'Can't' is used to express strong certainty that something is not true."},{"id":"ex.b1.must-and-cant-for-deduction.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Choose the best answer.","question":"Look at all the snow! It ___ be very cold outside.","options":["can't","must","is"],"answer":1,"explanation":"'Must' is used to make a strong deduction based on the visual evidence."},{"id":"ex.b1.must-and-cant-for-deduction.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Choose the best answer.","question":"He's only five years old. He ___ be the new manager.","options":["must","can't","is"],"answer":1,"explanation":"'Can't' expresses that it's impossible for a five-year-old to be a manager."},{"id":"ex.b1.must-and-cant-for-deduction.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Complete the sentence.","text":"My neighbor's car isn't here. He ___ be on vacation.","answers":[["must"]],"explanation":"'Must' indicates a strong deduction based on the car's absence."},{"id":"ex.b1.must-and-cant-for-deduction.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Complete the sentence.","text":"That ___ be the right answer; it doesn't make any sense.","answers":[["can't"]],"explanation":"'Can't' expresses strong certainty that something is incorrect."},{"id":"ex.b1.must-and-cant-for-deduction.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Complete the sentence.","text":"She's been studying all night. She ___ ___ tired.","answers":[["must"],["be"]],"explanation":"'Must be' is used to deduce her current state based on her actions."},{"id":"ex.b1.must-and-cant-for-deduction.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Put the words in the right order.","answer":["It","must","be","a","mistake","."],"distractors":["not"],"explanation":"This sentence uses 'must be' to express a strong deduction that something is incorrect."},{"id":"ex.b1.must-and-cant-for-deduction.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Put the words in the right order.","answer":["They","can't","be","serious","about","that","."],"distractors":["will"],"explanation":"'Can't be' shows strong disbelief or impossibility regarding their seriousness."},{"id":"ex.b1.must-and-cant-for-deduction.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"He must not be home, his lights are off.","answers":["He can't be home, his lights are off."],"explanation":"Use 'can't be' for a deduction that something is not true, not 'must not be' (which implies prohibition)."},{"id":"ex.b1.must-and-cant-for-deduction.12","kind":"transformation","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Rewrite the sentence.","source":"I'm sure he is at the library.","instruction":"Rewrite using 'must'.","answers":["He must be at the library."],"explanation":"'Must be' expresses strong certainty, replacing 'I'm sure he is'."},{"id":"ex.b1.must-and-cant-for-deduction.13","kind":"transformation","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Rewrite the sentence.","source":"It's impossible that she knows the answer.","instruction":"Rewrite using 'can't'.","answers":["She can't know the answer."],"explanation":"'Can't know' expresses strong certainty that something is impossible, replacing 'It's impossible that she knows'."},{"id":"ex.b1.must-and-cant-for-deduction.14","kind":"matching","level":"B1","grammarPointIds":["gp.must-and-cant-for-deduction"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"The music is very loud.","right":"They must be having a party."},{"left":"He's never late for work.","right":"He can't be stuck in traffic."},{"left":"She looks very happy.","right":"She must have received good news."},{"left":"That story sounds unbelievable.","right":"It can't be true."}]},{"id":"ex.b1.passive-present-and-past.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Choose the best answer.","question":"The city's main library ___ in 1950.","options":["is built","was built","builds"],"answer":1,"explanation":"The action happened in the past ('in 1950'), so the past simple passive 'was built' is correct."},{"id":"ex.b1.passive-present-and-past.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Choose the best answer.","question":"These delicious cookies ___ fresh every morning.","options":["are baked","were baked","bake"],"answer":0,"explanation":"The action happens regularly ('every morning'), so the present simple passive 'are baked' is correct."},{"id":"ex.b1.passive-present-and-past.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Choose the best answer.","question":"The famous painting ___ by a student.","options":["was discovered","discovered","is discovering"],"answer":0,"explanation":"The painting received the action of being discovered, and 'by a student' indicates the passive voice. The past tense is implied."},{"id":"ex.b1.passive-present-and-past.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Choose the best answer.","question":"English ___ in many countries around the world.","options":["speaks","is spoken","was spoken"],"answer":1,"explanation":"This is a general fact, so the present simple passive 'is spoken' is correct."},{"id":"ex.b1.passive-present-and-past.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Complete the sentence.","text":"The old bridge ___ ___ last month.","answers":[["was"],["repaired"]],"explanation":"The action happened in the past ('last month'), so the past simple passive 'was repaired' is needed."},{"id":"ex.b1.passive-present-and-past.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Complete the sentence.","text":"New cars ___ ___ at this factory.","answers":[["are"],["produced","made"]],"explanation":"This is a general fact about the factory, so the present simple passive 'are produced' is correct."},{"id":"ex.b1.passive-present-and-past.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Complete the sentence.","text":"The report ___ ___ by the manager.","answers":[["was","is"],["written"]],"explanation":"The report received the action, and 'by the manager' indicates the passive voice. The past tense is implied."},{"id":"ex.b1.passive-present-and-past.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Put the words in the right order.","answer":["The","new","rules","are","explained","clearly","."],"distractors":["explains"],"explanation":"This sentence uses the present simple passive to describe how the rules are explained.","alternatives":[["The","new","rules","are","clearly","explained","."]]},{"id":"ex.b1.passive-present-and-past.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Put the words in the right order.","answer":["The","ancient","city","was","discovered","in","1870","."],"distractors":["discover"],"explanation":"This sentence uses the past simple passive to describe when the city was discovered."},{"id":"ex.b1.passive-present-and-past.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Many houses was damaged by the storm.","answers":["Many houses were damaged by the storm."],"explanation":"For a plural subject ('houses') in the past simple passive, use 'were' instead of 'was'."},{"id":"ex.b1.passive-present-and-past.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The bread is bake every morning.","answers":["The bread is baked every morning."],"explanation":"The passive voice requires the past participle form of the verb, which is 'baked'."},{"id":"ex.b1.passive-present-and-past.12","kind":"transformation","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Rewrite the sentence.","source":"A famous artist painted this portrait.","instruction":"Rewrite in the passive voice.","answers":["This portrait was painted by a famous artist."],"explanation":"To change to passive, the object ('this portrait') becomes the subject, and the verb changes to 'was + past participle'. We can add 'by + agent' to keep the information about the artist."},{"id":"ex.b1.passive-present-and-past.13","kind":"transformation","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Rewrite the sentence.","source":"They clean the museum every week.","instruction":"Rewrite in the passive voice.","answers":["The museum is cleaned every week."],"explanation":"To change to passive, the object ('the museum') becomes the subject, and the verb changes to 'is + past participle'. The original doer ('they') is often omitted in passive sentences when unimportant."},{"id":"ex.b1.passive-present-and-past.14","kind":"matching","level":"B1","grammarPointIds":["gp.passive-present-and-past"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"The new bridge","right":"was opened last month."},{"left":"These delicious cakes","right":"are made in our bakery."},{"left":"The old letters","right":"were found in the attic."},{"left":"Fresh vegetables","right":"are delivered daily."}]},{"id":"ex.b1.past-perfect.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Choose the best answer.","question":"By the time we reached the airport, our flight ___.","options":["departed","was departing","had departed"],"answer":2,"explanation":"The flight's departure happened before we reached the airport, so the past perfect 'had departed' is correct."},{"id":"ex.b1.past-perfect.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Choose the best answer.","question":"I couldn't believe what I ___.","options":["saw","had seen","was seeing"],"answer":1,"explanation":"The act of seeing happened before the speaker couldn't believe it, making 'had seen' the correct past perfect choice."},{"id":"ex.b1.past-perfect.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Choose the best answer.","question":"She finally understood the problem after her friend ___ it to her.","options":["explained","had explained","explains"],"answer":1,"explanation":"Her friend's explanation happened before she understood the problem, so 'had explained' is correct."},{"id":"ex.b1.past-perfect.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Choose the best answer.","question":"Before he moved to London, he ___ in a small village.","options":["lived","had lived","was living"],"answer":1,"explanation":"Living in the village happened before he moved to London, so 'had lived' is the correct past perfect form."},{"id":"ex.b1.past-perfect.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Complete the sentence.","text":"When I called her, she ___ already ___ (leave) for work.","answers":[["had"],["left"]],"explanation":"Her leaving happened before I called, so 'had left' is the correct past perfect."},{"id":"ex.b1.past-perfect.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Complete the sentence.","text":"They realized they ___ (forget) their tickets at home.","answers":[["had forgotten"]],"explanation":"Forgetting the tickets happened before they realized it, so 'had forgotten' is correct."},{"id":"ex.b1.past-perfect.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Complete the sentence.","text":"He ___ never ___ (try) sushi before his trip to Japan.","answers":[["had"],["tried"]],"explanation":"Never trying sushi happened before his trip, so 'had never tried' is the correct past perfect."},{"id":"ex.b1.past-perfect.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Put the words in the right order.","answer":["She","had","finished","her","book","before","dinner","."],"distractors":["will","read"],"explanation":"The past perfect 'had finished' shows that finishing the book happened before dinner."},{"id":"ex.b1.past-perfect.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Put the words in the right order.","answer":["I","realized","I","had","met","him","before","."],"distractors":["meet","will"],"explanation":"The past perfect 'had met' indicates that meeting him happened at an earlier time than realizing it."},{"id":"ex.b1.past-perfect.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"When I arrived, the store already closed.","answers":["When I arrived, the store had already closed."],"explanation":"The store closing happened before I arrived, so 'had closed' is the correct past perfect."},{"id":"ex.b1.past-perfect.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"He was tired because he worked all night.","answers":["He was tired because he had worked all night."],"explanation":"Working all night happened before he was tired, so 'had worked' is the correct past perfect."},{"id":"ex.b1.past-perfect.12","kind":"transformation","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Rewrite the sentence.","source":"First, she packed her suitcase. Then, she called a taxi.","instruction":"Combine these sentences using the past perfect.","answers":["She called a taxi after she had packed her suitcase.","After she had packed her suitcase, she called a taxi."],"explanation":"Packing the suitcase happened before calling the taxi, so 'had packed' is used for the earlier action."},{"id":"ex.b1.past-perfect.13","kind":"transformation","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Rewrite the sentence.","source":"I didn't recognize him because he changed his hairstyle.","instruction":"Rewrite the sentence using the past perfect.","answers":["I didn't recognize him because he had changed his hairstyle."],"explanation":"Changing his hairstyle happened before I didn't recognize him, so 'had changed' is the correct past perfect."},{"id":"ex.b1.past-perfect.14","kind":"matching","level":"B1","grammarPointIds":["gp.past-perfect"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"She couldn't find her keys because she","right":"had left them at home."},{"left":"By the time the police arrived,","right":"the thieves had already escaped."},{"left":"He understood the instructions after he","right":"had read them twice."},{"left":"I was surprised because I","right":"had never heard that story before."}]},{"id":"ex.b1.phrasal-verbs-basics.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.phrasal-verbs-basics"],"prompt":"Choose the best answer.","question":"I need to ___ this form before Friday.","options":["fill in","fill it in","fill in it","fill"],"answer":0,"explanation":"'Fill in' is a separable phrasal verb. 'Fill in this form' is correct. 'Fill it in' would also be correct if 'it' replaced 'this form'."},{"id":"ex.b1.phrasal-verbs-basics.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.phrasal-verbs-basics"],"prompt":"Choose the best answer.","question":"My sister is going to ___ my cat while I'm on vacation.","options":["look","look for","look after","look at"],"answer":2,"explanation":"'Look after' is an inseparable phrasal verb meaning to take care of someone or something."},{"id":"ex.b1.phrasal-verbs-basics.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.phrasal-verbs-basics"],"prompt":"Choose the best answer.","question":"The meeting was ___ until next week.","options":["put off","put it off","put off it","put"],"answer":0,"explanation":"'Put off' is a separable phrasal verb meaning to postpone. In the passive voice, the verb and particle stay together."},{"id":"ex.b1.phrasal-verbs-basics.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.phrasal-verbs-basics"],"prompt":"Choose the best answer.","question":"Could you please ___ the music? It's too loud.","options":["turn down","turn it down","turn down it","turn"],"answer":0,"explanation":"'Turn down' is a separable phrasal verb. 'Turn down the music' is correct. 'Turn the music down' or 'Turn it down' would also be correct."},{"id":"ex.b1.phrasal-verbs-basics.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.phrasal-verbs-basics"],"prompt":"Complete the sentence.","text":"I need to ___ ___ my old clothes.","answers":[["give"],["away"]],"explanation":"'Give away' is a separable phrasal verb meaning to donate or get rid of something."},{"id":"ex.b1.phrasal-verbs-basics.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.phrasal-verbs-basics"],"prompt":"Complete the sentence.","text":"We should ___ ___ the new plan carefully.","answers":[["go"],["over"]],"explanation":"'Go over' is an inseparable phrasal verb meaning to review or examine something."},{"id":"ex.b1.phrasal-verbs-basics.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.phrasal-verbs-basics"],"prompt":"Complete the sentence.","text":"Please ___ ___ the TV when you're finished watching.","answers":[["turn"],["off"]],"explanation":"'Turn off' is a separable phrasal verb meaning to stop a device from working."},{"id":"ex.b1.phrasal-verbs-basics.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.phrasal-verbs-basics"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I will call back you later.","answers":["I will call you back later."],"explanation":"The pronoun 'you' must go between the verb and particle for separable phrasal verbs like 'call back'."},{"id":"ex.b1.phrasal-verbs-basics.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.phrasal-verbs-basics"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"She is looking her keys for.","answers":["She is looking for her keys."],"explanation":"'Look for' is an inseparable phrasal verb, so the object 'her keys' always comes after the particle."},{"id":"ex.b1.phrasal-verbs-basics.12","kind":"transformation","level":"B1","grammarPointIds":["gp.phrasal-verbs-basics"],"prompt":"Rewrite the sentence.","source":"I need to search for my wallet.","instruction":"Use a phrasal verb with 'look'.","answers":["I need to look for my wallet."],"explanation":"'Look for' is an inseparable phrasal verb that means to search for something."},{"id":"ex.b1.phrasal-verbs-basics.13","kind":"transformation","level":"B1","grammarPointIds":["gp.phrasal-verbs-basics"],"prompt":"Rewrite the sentence.","source":"Can you reduce the volume of the TV?","instruction":"Use a separable phrasal verb.","answers":["Can you turn down the TV?","Can you turn the TV down?"],"explanation":"'Turn down' is a separable phrasal verb meaning to reduce the volume. The noun object can go after the particle or between the verb and particle."},{"id":"ex.b1.phrasal-verbs-basics.14","kind":"matching","level":"B1","grammarPointIds":["gp.phrasal-verbs-basics"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I need to fill","right":"out this application form."},{"left":"Don't forget to pick","right":"up your dry cleaning."},{"left":"She always looks","right":"after her younger brother."},{"left":"We had to put","right":"off the meeting until Friday."}]},{"id":"ex.b1.present-perfect-continuous.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Choose the best answer.","question":"My eyes are tired because I ___ on the computer all day.","options":["am working","have been working","worked","have worked"],"answer":1,"explanation":"The action started in the past ('all day') and has just stopped or continues, with a visible result ('tired eyes')."},{"id":"ex.b1.present-perfect-continuous.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Choose the best answer.","question":"How long ___ for the bus?","options":["are you waiting","you have waited","have you been waiting","did you wait"],"answer":2,"explanation":"This question asks about the duration of an ongoing activity, requiring the present perfect continuous."},{"id":"ex.b1.present-perfect-continuous.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Choose the best answer.","question":"It ___ all morning, but now the sun is out.","options":["has rained","is raining","has been raining","rained"],"answer":2,"explanation":"The rain started in the past ('all morning') and continued until recently, with a clear end point mentioned ('but now the sun is out')."},{"id":"ex.b1.present-perfect-continuous.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Choose the best answer.","question":"He looks exhausted. He ___ for his exam.","options":["studies","has studied","has been studying","is studying"],"answer":2,"explanation":"His exhaustion is a result of a recent, continuous activity (studying) that has just stopped or is still ongoing."},{"id":"ex.b1.present-perfect-continuous.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Put the words in the right order.","answer":["They","have","been","traveling","for","weeks","."],"distractors":["travel","are"],"explanation":"This sentence describes an activity that started in the past and is still ongoing, emphasizing its duration."},{"id":"ex.b1.present-perfect-continuous.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Put the words in the right order.","answer":["He","hasn't","been","sleeping","well","lately","."],"distractors":["sleeps","did"],"explanation":"This sentence describes a continuous activity that has not been happening successfully recently."},{"id":"ex.b1.present-perfect-continuous.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The kids are playing video games for hours.","answers":["The kids have been playing video games for hours."],"explanation":"For an activity that started in the past and continues for a duration, use the present perfect continuous."},{"id":"ex.b1.present-perfect-continuous.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I'm tired because I have run.","answers":["I'm tired because I have been running."],"explanation":"The present perfect continuous emphasizes the recent activity that caused the current state (tiredness)."},{"id":"ex.b1.present-perfect-continuous.12","kind":"transformation","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Rewrite the sentence.","source":"She started reading that book two hours ago and is still reading it.","instruction":"Rewrite using the present perfect continuous.","answers":["She has been reading that book for two hours."],"explanation":"The present perfect continuous effectively combines the past start and ongoing nature of the action."},{"id":"ex.b1.present-perfect-continuous.13","kind":"transformation","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Rewrite the sentence.","source":"My car is making a strange noise. It started yesterday.","instruction":"Combine into one sentence using the present perfect continuous.","answers":["My car has been making a strange noise since yesterday."],"explanation":"The present perfect continuous shows that the noise started in the past and continues up to the present."},{"id":"ex.b1.present-perfect-continuous.14","kind":"matching","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I'm out of breath because","right":"I've been climbing the stairs."},{"left":"They look happy because","right":"they've been celebrating their anniversary."},{"left":"The garden is wet because","right":"it has been raining all night."},{"left":"He's very skilled because","right":"he has been practicing for years."}]},{"id":"ex.b1.present-perfect-continuous.15","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Choose the best answer.","question":"Why is the ground so muddy? It ___ all night.","options":["is raining","has rained","has been raining","rained"],"answer":2,"explanation":"The muddy ground is the result of an activity (raining) that started in the past and continued for a period, possibly just stopping."},{"id":"ex.b1.present-perfect-continuous.16","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Choose the best answer.","question":"I'm exhausted because I ___ on this report since morning.","options":["am working","have worked","have been working","worked"],"answer":2,"explanation":"The exhaustion is a result of an activity (working) that started in the past and continued until now."},{"id":"ex.b1.present-perfect-continuous.17","kind":"gap_fill","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Complete the sentence.","text":"The team ___ ___ ___ hard to prepare for the competition.","answers":[["have","has"],["been"],["working"]],"explanation":"The team started working hard in the past and is still working hard, or just finished, with the preparation as a result."},{"id":"ex.b1.present-perfect-continuous.18","kind":"gap_fill","level":"B1","grammarPointIds":["gp.present-perfect-continuous"],"prompt":"Complete the sentence.","text":"How long ___ you ___ ___ for your new laptop?","answers":[["have"],["been"],["saving","waiting"]],"explanation":"This asks about the duration of an ongoing activity (saving money)."},{"id":"ex.b1.present-perfect-for-and-since.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Choose the best answer.","question":"My brother has been traveling ___ six months.","options":["since","for","in"],"answer":1,"explanation":"'For' is used to express a duration of time, like 'six months'."},{"id":"ex.b1.present-perfect-for-and-since.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Choose the best answer.","question":"We haven't seen our neighbors ___ Christmas.","options":["for","since","during"],"answer":1,"explanation":"'Since' is used to indicate a specific starting point in time, like 'Christmas'."},{"id":"ex.b1.present-perfect-for-and-since.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Choose the best answer.","question":"How long have you worked here? I've worked here ___ 2020.","options":["for","ago","since"],"answer":2,"explanation":"'Since' is used with a specific year to show when something started."},{"id":"ex.b1.present-perfect-for-and-since.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Choose the best answer.","question":"They have been married ___ over ten years.","options":["since","for","at"],"answer":1,"explanation":"'For' is used to express a duration, such as 'over ten years'."},{"id":"ex.b1.present-perfect-for-and-since.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Complete the sentence.","text":"I have been learning Spanish ___ three years.","answers":[["for"]],"explanation":"'Three years' is a duration, so 'for' is the correct choice."},{"id":"ex.b1.present-perfect-for-and-since.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Complete the sentence.","text":"She hasn't eaten anything ___ breakfast this morning.","answers":[["since"]],"explanation":"'Breakfast this morning' is a specific starting point, so 'since' is correct."},{"id":"ex.b1.present-perfect-for-and-since.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Complete the sentence.","text":"We ___ lived in this town ___ we were kids.","answers":[["have"],["since"]],"explanation":"The present perfect 'have lived' is needed, and 'since' indicates the starting point 'we were kids'."},{"id":"ex.b1.present-perfect-for-and-since.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Put the words in the right order.","answer":["He","has","been","a","doctor","for","many","years","."],"distractors":["is"],"explanation":"This sentence uses 'for' to express the duration of his profession."},{"id":"ex.b1.present-perfect-for-and-since.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Put the words in the right order.","answer":["They","haven't","spoken","since","their","argument","."],"distractors":["for"],"explanation":"This sentence uses 'since' to indicate the specific event when they stopped speaking."},{"id":"ex.b1.present-perfect-for-and-since.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I am waiting for the train since an hour.","answers":["I have been waiting for the train for an hour."],"explanation":"Use present perfect continuous for an ongoing action and 'for' for a duration."},{"id":"ex.b1.present-perfect-for-and-since.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"She has been sick for last Tuesday.","answers":["She has been sick since last Tuesday."],"explanation":"'Last Tuesday' is a specific starting point, so 'since' is correct."},{"id":"ex.b1.present-perfect-for-and-since.12","kind":"transformation","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Rewrite the sentence.","source":"They started their project three weeks ago. They are still working on it.","instruction":"Combine the sentences using 'for'.","answers":["They have been working on their project for three weeks."],"explanation":"The present perfect continuous with 'for' shows an action that started in the past and continues now, specifying the duration."},{"id":"ex.b1.present-perfect-for-and-since.13","kind":"transformation","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Rewrite the sentence.","source":"I moved to Paris in 2019. I still live here.","instruction":"Combine the sentences using 'since'.","answers":["I have lived in Paris since 2019.","I've lived in Paris since 2019."],"explanation":"The present perfect with 'since' shows a state that started in the past and continues now, specifying the starting point."},{"id":"ex.b1.present-perfect-for-and-since.14","kind":"matching","level":"B1","grammarPointIds":["gp.present-perfect-for-and-since"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I haven't seen him","right":"for a long time."},{"left":"She's been learning French","right":"since last year."},{"left":"We've lived in this city","right":"for over twenty years."},{"left":"He's been traveling","right":"since his graduation."}]},{"id":"ex.b1.present-perfect-vs-past-simple.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Choose the best answer.","question":"My sister ___ to Japan three times.","options":["went","has gone","has been","goes"],"answer":2,"explanation":"\"Has been\" is used for completed visits or experiences, meaning she went and came back. \"Has gone\" implies she is still there."},{"id":"ex.b1.present-perfect-vs-past-simple.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Choose the best answer.","question":"We ___ a new car last month.","options":["bought","have bought","buy","are buying"],"answer":0,"explanation":"\"Last month\" indicates a specific, finished time in the past, so the past simple is correct."},{"id":"ex.b1.present-perfect-vs-past-simple.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Choose the best answer.","question":"How long ___ you ___ in this city?","options":["did...live","have...lived","do...live","are...living"],"answer":1,"explanation":"\"How long\" asks about a duration up to the present, requiring the present perfect."},{"id":"ex.b1.present-perfect-vs-past-simple.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Choose the best answer.","question":"I ___ my keys. I can't find them anywhere.","options":["lost","have lost","lose","am losing"],"answer":1,"explanation":"The action of losing happened in the past, but the result (can't find them) is relevant now."},{"id":"ex.b1.present-perfect-vs-past-simple.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Complete the sentence.","text":"They ___ (visit) their grandparents every summer when they were children.","answers":[["visited"]],"explanation":"\"When they were children\" refers to a finished period in the past, so past simple is needed."},{"id":"ex.b1.present-perfect-vs-past-simple.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Complete the sentence.","text":"Sarah ___ (just move) to a new apartment. She's very excited.","answers":[["has just moved"]],"explanation":"\"Just\" indicates a very recent action with a present result or relevance, so present perfect is appropriate."},{"id":"ex.b1.present-perfect-vs-past-simple.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Put the words in the right order.","answer":["I","have","never","seen","such","a","beautiful","sunset","."],"distractors":["saw","see"],"explanation":"This sentence uses the present perfect to describe an experience up to the present moment."},{"id":"ex.b1.present-perfect-vs-past-simple.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Put the words in the right order.","answer":["They","traveled","to","Italy","in","2022","."],"distractors":["have","travel"],"explanation":"This sentence uses the past simple for a completed action at a specific past time."},{"id":"ex.b1.present-perfect-vs-past-simple.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I have seen him yesterday at the park.","answers":["I saw him yesterday at the park."],"explanation":"\"Yesterday\" is a specific finished time, so the past simple \"saw\" is correct."},{"id":"ex.b1.present-perfect-vs-past-simple.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"She didn't eat anything since this morning.","answers":["She hasn't eaten anything since this morning.","She has not eaten anything since this morning."],"explanation":"\"Since this morning\" indicates a period of time up to the present, requiring the present perfect."},{"id":"ex.b1.present-perfect-vs-past-simple.12","kind":"transformation","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Rewrite the sentence.","source":"I visited Rome in 2019.","instruction":"Rewrite to talk about the experience up to now, without a specific time.","answers":["I have visited Rome."],"explanation":"Removing the specific past time \"in 2019\" allows the use of the present perfect to talk about the experience at an unspecified time up to now."},{"id":"ex.b1.present-perfect-vs-past-simple.13","kind":"transformation","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Rewrite the sentence.","source":"I finished my work an hour ago.","instruction":"Rewrite using the present perfect.","answers":["I have finished my work."],"explanation":"The present perfect is used to show that the action is complete and has a result now, without specifying when it happened."},{"id":"ex.b1.present-perfect-vs-past-simple.14","kind":"matching","level":"B1","grammarPointIds":["gp.present-perfect-vs-past-simple"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I saw that movie","right":"last night."},{"left":"She has lived in this town","right":"for ten years."},{"left":"We visited the museum","right":"on Saturday."},{"left":"He has never traveled","right":"outside his country."}]},{"id":"ex.b1.question-tags.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Choose the best answer.","question":"It's a lovely evening, ___?","options":["isn't it","is it","doesn't it","wasn't it"],"answer":0,"explanation":"The statement is positive (\"It's\"), so the tag must be negative (\"isn't\"). The verb is \"is\", so the tag uses \"is\"."},{"id":"ex.b1.question-tags.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Choose the best answer.","question":"You don't like broccoli, ___?","options":["don't you","do you","are you","didn't you"],"answer":1,"explanation":"The statement is negative (\"don't like\"), so the tag must be positive (\"do\"). The auxiliary verb is \"do\"."},{"id":"ex.b1.question-tags.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Choose the best answer.","question":"They went to the concert last night, ___?","options":["didn't they","did they","weren't they","don't they"],"answer":0,"explanation":"The statement is positive (\"went\" - past simple), so the tag must be negative (\"didn't\")."},{"id":"ex.b1.question-tags.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Choose the best answer.","question":"She can't swim very well, ___?","options":["can she","can't she","does she","is she"],"answer":0,"explanation":"The statement is negative (\"can't\"), so the tag must be positive (\"can\"). The modal verb is \"can\"."},{"id":"ex.b1.question-tags.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Complete the sentence.","text":"You live near the park, ___ ___?","answers":[["don't"],["you"]],"explanation":"The statement \"You live near the park\" is positive and in the present simple, so the tag is negative \"don't you\"."},{"id":"ex.b1.question-tags.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Complete the sentence.","text":"He wasn't at the meeting, ___ ___?","answers":[["was"],["he"]],"explanation":"The statement \"He wasn't at the meeting\" is negative and uses \"was\", so the tag is positive \"was he\"."},{"id":"ex.b1.question-tags.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Complete the sentence.","text":"They've finished their project, ___ ___?","answers":[["haven't"],["they"]],"explanation":"The statement \"They've finished their project\" is positive and uses \"have\", so the tag is negative \"haven't they\"."},{"id":"ex.b1.question-tags.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Put the words in the right order.","answer":["It's","a","beautiful","day",",","isn't","it","?"],"distractors":["is","not"],"explanation":"This sentence uses a positive statement with a negative question tag to invite agreement."},{"id":"ex.b1.question-tags.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Put the words in the right order.","answer":["You","didn't","forget","your","keys",",","did","you","?"],"distractors":["do","forgetting"],"explanation":"This sentence uses a negative statement with a positive question tag to check information."},{"id":"ex.b1.question-tags.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"She is a doctor, is she?","answers":["She is a doctor, isn't she?"],"explanation":"A positive statement requires a negative question tag."},{"id":"ex.b1.question-tags.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"They don't like vegetables, don't they?","answers":["They don't like vegetables, do they?"],"explanation":"A negative statement requires a positive question tag."},{"id":"ex.b1.question-tags.12","kind":"transformation","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Rewrite the sentence.","source":"You like classical music.","instruction":"Add a question tag to invite agreement.","answers":["You like classical music, don't you?"],"explanation":"The statement is positive present simple, so the tag is negative \"don't you\"."},{"id":"ex.b1.question-tags.13","kind":"transformation","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Rewrite the sentence.","source":"He didn't call you back.","instruction":"Add a question tag to check this information.","answers":["He didn't call you back, did he?"],"explanation":"The statement is negative past simple, so the tag is positive \"did he\"."},{"id":"ex.b1.question-tags.14","kind":"matching","level":"B1","grammarPointIds":["gp.question-tags"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"It's getting late,","right":"isn't it?"},{"left":"You can help me,","right":"can't you?"},{"left":"They didn't arrive,","right":"did they?"},{"left":"She works here,","right":"doesn't she?"}]},{"id":"ex.b1.reflexive-pronouns.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.reflexive-pronouns"],"prompt":"Choose the best answer.","question":"The cat cleaned ___ thoroughly after its meal.","options":["it","itself","its","by itself"],"answer":1,"explanation":"The cat is both the subject and the object of the action, so 'itself' is correct."},{"id":"ex.b1.reflexive-pronouns.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.reflexive-pronouns"],"prompt":"Choose the best answer.","question":"My colleagues and I often send ___ emails about project updates.","options":["ourselves","us","each other","them"],"answer":2,"explanation":"When two or more people perform an action to one another, 'each other' is used."},{"id":"ex.b1.reflexive-pronouns.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.reflexive-pronouns"],"prompt":"Choose the best answer.","question":"She enjoys hiking in the mountains ___.","options":["by her","herself","by herself","her"],"answer":2,"explanation":"'By herself' means she hikes alone, which fits the context of enjoying hiking."},{"id":"ex.b1.reflexive-pronouns.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.reflexive-pronouns"],"prompt":"Choose the best answer.","question":"Be careful with that hot pan, you might burn ___!","options":["you","yourself","your own","by yourself"],"answer":1,"explanation":"The subject 'you' is performing the action to 'yourself'."},{"id":"ex.b1.reflexive-pronouns.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.reflexive-pronouns"],"prompt":"Complete the sentence.","text":"We really enjoyed ___ at the concert last night.","answers":[["ourselves"]],"explanation":"The subject 'we' enjoyed 'ourselves'."},{"id":"ex.b1.reflexive-pronouns.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.reflexive-pronouns"],"prompt":"Complete the sentence.","text":"My sister and I always help ___ with our homework.","answers":[["each other"]],"explanation":"The action of helping is reciprocal between the sister and 'I'."},{"id":"ex.b1.reflexive-pronouns.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.reflexive-pronouns"],"prompt":"Put the words in the right order.","answer":["She","taught","herself","to","play","the","piano","."],"distractors":["her","alone"],"explanation":"The sentence describes the subject 'She' teaching 'herself' a skill."},{"id":"ex.b1.reflexive-pronouns.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.reflexive-pronouns"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I accidentally locked me out of the house.","answers":["I accidentally locked *myself* out of the house.","I accidentally locked myself out of the house."],"explanation":"The subject 'I' is performing the action to 'myself'."},{"id":"ex.b1.reflexive-pronouns.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.reflexive-pronouns"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The two friends always support themselves during difficult times.","answers":["The two friends always support *each other* during difficult times.","The two friends always support each other during difficult times."],"explanation":"When two people support one another, 'each other' is the correct pronoun."},{"id":"ex.b1.reflexive-pronouns.12","kind":"transformation","level":"B1","grammarPointIds":["gp.reflexive-pronouns"],"prompt":"Rewrite the sentence.","source":"He lives alone in a small apartment.","instruction":"Use 'by himself'.","answers":["He lives *by himself* in a small apartment.","He lives by himself in a small apartment."],"explanation":"'By himself' means 'alone', fitting the original sentence's meaning."},{"id":"ex.b1.reflexive-pronouns.13","kind":"transformation","level":"B1","grammarPointIds":["gp.reflexive-pronouns"],"prompt":"Rewrite the sentence.","source":"My colleagues and I often share ideas.","instruction":"Use 'each other'.","answers":["My colleagues and I often share ideas with *each other*.","My colleagues and I often share ideas with each other."],"explanation":"The phrase 'with each other' shows that the sharing of ideas is reciprocal."},{"id":"ex.b1.reflexive-pronouns.14","kind":"matching","level":"B1","grammarPointIds":["gp.reflexive-pronouns"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"The cat licked","right":"itself clean."},{"left":"We introduced","right":"ourselves to the new neighbors."},{"left":"They built the fence","right":"by themselves."},{"left":"My parents always help","right":"each other."}]},{"id":"ex.b1.reported-questions.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Choose the best answer.","question":"The teacher asked the students ___ understood the instructions.","options":["if they","did they","if did they"],"answer":0,"explanation":"For a reported yes/no question, use 'if' followed by normal subject-verb order."},{"id":"ex.b1.reported-questions.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Choose the best answer.","question":"My colleague wanted to know ___ the meeting was.","options":["when was","when the meeting","when the meeting was"],"answer":2,"explanation":"After a wh-word in a reported question, use normal subject-verb order."},{"id":"ex.b1.reported-questions.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Choose the best answer.","question":"I asked him ___ he could help me with my project.","options":["that","if","what"],"answer":1,"explanation":"For a reported yes/no question (Can you help me?), use 'if' or 'whether'."},{"id":"ex.b1.reported-questions.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Choose the best answer.","question":"She asked me ___ I was going.","options":["where","where was","where did"],"answer":0,"explanation":"Use the wh-word 'where' followed by subject-verb order for a reported wh-question."},{"id":"ex.b1.reported-questions.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Complete the sentence.","text":"He asked ___ I ___ free on Saturday.","answers":[["if","whether"],["was"]],"explanation":"For a reported yes/no question, use 'if' or 'whether' and shift the verb 'am' to 'was'."},{"id":"ex.b1.reported-questions.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Complete the sentence.","text":"My sister wanted to know ___ I ___ her book.","answers":[["where","if"],["put","had seen"]],"explanation":"For a reported wh-question, use the wh-word 'where' and shift 'did you put' to 'I put'."},{"id":"ex.b1.reported-questions.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Complete the sentence.","text":"The tourist asked ___ the museum ___.","answers":[["when","where"],["opened","was"]],"explanation":"Use the wh-word 'when' and shift 'does the museum open' to 'the museum opened' with normal word order."},{"id":"ex.b1.reported-questions.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Put the words in the right order.","answer":["He","asked","if","I","needed","any","help","."],"distractors":["did"],"explanation":"The correct order for a reported yes/no question is 'asked if' followed by subject + verb."},{"id":"ex.b1.reported-questions.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Put the words in the right order.","answer":["She","wanted","to","know","what","my","favorite","color","was","."],"distractors":["is"],"explanation":"For a reported wh-question, use the wh-word followed by subject + verb."},{"id":"ex.b1.reported-questions.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"My friend asked me where was the party.","answers":["My friend asked me where the party was."],"explanation":"In reported questions, the word order after the wh-word should be subject + verb, not verb + subject."},{"id":"ex.b1.reported-questions.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The manager wanted to know you finished the report.","answers":["The manager wanted to know if I finished the report.","The manager wanted to know whether I finished the report.","The manager wanted to know if you finished the report."],"explanation":"For reported yes/no questions, you must use 'if' or 'whether' after the reporting verb."},{"id":"ex.b1.reported-questions.12","kind":"transformation","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Rewrite the sentence.","source":"Direct question: \"Are you coming to the concert?\"","instruction":"Report the question starting with \"He asked...\"","answers":["He asked if I was coming to the concert.","He asked whether I was coming to the concert."],"explanation":"Use 'if' or 'whether' for a reported yes/no question, and change the tense and pronoun."},{"id":"ex.b1.reported-questions.13","kind":"transformation","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Rewrite the sentence.","source":"Direct question: \"When did they arrive?\"","instruction":"Report the question starting with \"She wanted to know...\"","answers":["She wanted to know when they had arrived."],"explanation":"Use the wh-word 'when' and shift the past simple tense to past perfect in reported speech."},{"id":"ex.b1.reported-questions.14","kind":"matching","level":"B1","grammarPointIds":["gp.reported-questions"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"He asked","right":"if I liked coffee."},{"left":"She wanted to know","right":"where I lived."},{"left":"I asked them","right":"what their names were."},{"left":"They asked","right":"whether I had seen the movie."}]},{"id":"ex.b1.reported-statements.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Choose the best answer.","question":"My sister ___ that she was going to visit next month.","options":["told","said","tell","say"],"answer":1,"explanation":"Since there is no object (like 'me' or 'him') after the verb, 'said' is the correct choice."},{"id":"ex.b1.reported-statements.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Choose the best answer.","question":"He ___ me that he had finished his homework.","options":["said","say","told","tell"],"answer":2,"explanation":"Because there is an object ('me') after the verb, 'told' is the correct choice."},{"id":"ex.b1.reported-statements.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Choose the best answer.","question":"The teacher said that the exam ___ difficult.","options":["is","was","will be","has been"],"answer":1,"explanation":"The original statement 'The exam is difficult' changes to past simple in reported speech."},{"id":"ex.b1.reported-statements.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Choose the best answer.","question":"They told us that they ___ to the beach the next day.","options":["go","will go","would go","are going"],"answer":2,"explanation":"The original statement 'We will go to the beach tomorrow' changes 'will go' to 'would go' and 'tomorrow' to 'the next day'."},{"id":"ex.b1.reported-statements.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Complete the sentence.","text":"She ___ me that she ___ busy.","answers":[["told"],["was"]],"explanation":"Use 'told' because there is an object 'me'. The original 'I am busy' becomes 'she was busy'."},{"id":"ex.b1.reported-statements.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Complete the sentence.","text":"He ___ that he ___ call later.","answers":[["said"],["would"]],"explanation":"Use 'said' as there is no object. The original 'I will call later' becomes 'he would call later'."},{"id":"ex.b1.reported-statements.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Complete the sentence.","text":"They ___ that they ___ seen that movie before.","answers":[["said"],["had"]],"explanation":"Use 'said' as there is no object. The original 'We saw that movie before' or 'We have seen that movie before' becomes 'they had seen that movie before'."},{"id":"ex.b1.reported-statements.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Put the words in the right order.","answer":["He","said","he","was","feeling","better","."],"explanation":"This sentence reports what someone said, changing the tense from present continuous ('I am feeling better') to past continuous."},{"id":"ex.b1.reported-statements.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Put the words in the right order.","answer":["She","told","him","she","could","meet","at","six","."],"explanation":"This sentence reports a statement using 'told' with an object, and changes 'can' to 'could'."},{"id":"ex.b1.reported-statements.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"My mom told that she was proud of me.","answers":["My mom said that she was proud of me."],"explanation":"When there is no object after the verb, use 'said' instead of 'told'."},{"id":"ex.b1.reported-statements.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"He said he will finish the report tomorrow.","answers":["He said he would finish the report the next day.","He said he would finish the report tomorrow."],"explanation":"In reported speech, 'will' changes to 'would'. 'Tomorrow' can also change to 'the next day'."},{"id":"ex.b1.reported-statements.12","kind":"transformation","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Rewrite the sentence.","source":"Direct speech: \"I am going to the gym.\"","instruction":"Report this statement using 'She said'.","answers":["She said that she was going to the gym.","She said she was going to the gym."],"explanation":"The present continuous 'am going' changes to past continuous 'was going' in reported speech."},{"id":"ex.b1.reported-statements.13","kind":"transformation","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Rewrite the sentence.","source":"Direct speech: \"We can meet on Friday.\"","instruction":"Report this statement using 'They told me'.","answers":["They told me that they could meet on Friday.","They told me they could meet on Friday."],"explanation":"The modal verb 'can' changes to 'could' in reported speech, and 'told me' is used with the object."},{"id":"ex.b1.reported-statements.14","kind":"matching","level":"B1","grammarPointIds":["gp.reported-statements"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"He said that he","right":"was feeling tired."},{"left":"She told me that she","right":"would call later."},{"left":"They mentioned they","right":"had visited Rome."},{"left":"The student said he","right":"could not understand."}]},{"id":"ex.b1.second-conditional.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Choose the best answer.","question":"If I ___ a car, I would drive to work every day.","options":["have","had","will have"],"answer":1,"explanation":"For the second conditional, we use the past simple form of the verb in the 'if' clause."},{"id":"ex.b1.second-conditional.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Choose the best answer.","question":"What ___ you do if you found a wallet on the street?","options":["will","would","do"],"answer":1,"explanation":"We use 'would' in the main clause to talk about the hypothetical result."},{"id":"ex.b1.second-conditional.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Choose the best answer.","question":"If it ___ sunny tomorrow, we could go for a picnic.","options":["is","was","will be"],"answer":1,"explanation":"Even for a future imagined situation, we use the past simple ('was' or 'were') in the 'if' clause for the second conditional."},{"id":"ex.b1.second-conditional.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Choose the best answer.","question":"They ___ happier if they lived in a bigger apartment.","options":["are","will be","would be"],"answer":2,"explanation":"The main clause of a second conditional uses 'would' + base verb to describe the hypothetical result."},{"id":"ex.b1.second-conditional.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Complete the sentence.","text":"If I ___ (know) her number, I ___ (call) her.","answers":[["knew"],["would call","would've called"]],"explanation":"Use the past simple 'knew' in the 'if' clause and 'would call' in the main clause for the second conditional. 'would've called' is also acceptable as a common contraction for 'would have called', though 'would call' is the primary form for the second conditional."},{"id":"ex.b1.second-conditional.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Complete the sentence.","text":"She ___ (not be) so tired if she ___ (go) to bed earlier.","answers":[["would not be","wouldn't be"],["went"]],"explanation":"The main clause uses 'would not be' for the hypothetical result, and the 'if' clause uses the past simple 'went'."},{"id":"ex.b1.second-conditional.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Complete the sentence.","text":"If we ___ (have) more money, we ___ (buy) a new car.","answers":[["had"],["would buy","would've bought"]],"explanation":"The 'if' clause requires the past simple 'had', and the main clause uses 'would buy' for the hypothetical outcome. 'would've bought' is also acceptable as a common contraction for 'would have bought', though 'would buy' is the primary form for the second conditional."},{"id":"ex.b1.second-conditional.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Put the words in the right order.","answer":["If","I","were","you",",","I","would","take","that","job","."],"explanation":"This sentence uses the second conditional to give advice about a hypothetical situation."},{"id":"ex.b1.second-conditional.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Put the words in the right order.","answer":["He","would","travel","more","if","he","had","more","vacation","time","."],"distractors":["will","traveling"],"explanation":"This sentence describes a hypothetical situation and its imagined result, with the 'if' clause at the end."},{"id":"ex.b1.second-conditional.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"If I will live in a big city, I would visit museums often.","answers":["If I lived in a big city, I would visit museums often."],"explanation":"The 'if' clause of a second conditional requires the past simple verb, not 'will live'."},{"id":"ex.b1.second-conditional.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"She would be very happy if she would get a promotion.","answers":["She would be very happy if she got a promotion."],"explanation":"Do not use 'would' in the 'if' clause; use the past simple verb 'got'."},{"id":"ex.b1.second-conditional.12","kind":"transformation","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Rewrite the sentence.","source":"I don't have a map, so I can't find the way.","instruction":"Rewrite using the second conditional.","answers":["If I had a map, I would find the way.","If I had a map, I could find the way."],"explanation":"The second conditional expresses an imagined situation (having a map) and its hypothetical result (finding the way)."},{"id":"ex.b1.second-conditional.13","kind":"transformation","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Rewrite the sentence.","source":"He doesn't speak French, so he won't understand them.","instruction":"Rewrite using the second conditional.","answers":["If he spoke French, he would understand them.","If he spoke French, he could understand them."],"explanation":"This transforms a real present situation into an imagined one, showing a hypothetical outcome."},{"id":"ex.b1.second-conditional.14","kind":"matching","level":"B1","grammarPointIds":["gp.second-conditional"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"If I had more money,","right":"I would buy a new laptop."},{"left":"She would learn to cook","right":"if she had more time."},{"left":"If it rained tomorrow,","right":"we would stay home."},{"left":"What would you do","right":"if you lost your phone?"}]},{"id":"ex.b1.so-and-such.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Choose the best answer.","question":"The concert was ___ loud that my ears hurt.","options":["such","so","such a"],"answer":1,"explanation":"'So' is used before an adjective like 'loud'."},{"id":"ex.b1.so-and-such.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Choose the best answer.","question":"It was ___ beautiful day for a picnic.","options":["so","such","such a"],"answer":2,"explanation":"'Such a' is used before a singular countable noun phrase like 'beautiful day'."},{"id":"ex.b1.so-and-such.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Choose the best answer.","question":"They had ___ many questions that the meeting ran late.","options":["so","such","such a"],"answer":0,"explanation":"'So' is used before 'many' or 'much' when followed by a noun."},{"id":"ex.b1.so-and-such.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Choose the best answer.","question":"The presentation was ___ interesting that everyone paid attention.","options":["such","so","such an"],"answer":1,"explanation":"'So' is used before an adjective like 'interesting'."},{"id":"ex.b1.so-and-such.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Complete the sentence.","text":"The traffic was ___ bad ___ we arrived an hour late.","answers":[["so"],["that"]],"explanation":"'So' emphasizes the adjective 'bad', and 'that' introduces the result clause."},{"id":"ex.b1.so-and-such.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Complete the sentence.","text":"It was ___ difficult decision to make.","answers":[["such a"]],"explanation":"'Such a' is used before a singular countable noun phrase like 'difficult decision'."},{"id":"ex.b1.so-and-such.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Complete the sentence.","text":"She has ___ good ideas ___ she's always asked to lead projects.","answers":[["such"],["that"]],"explanation":"'Such' is used before a plural noun phrase like 'good ideas', and 'that' introduces the result."},{"id":"ex.b1.so-and-such.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Put the words in the right order.","answer":["It","was","such","a","long","journey","that","we","were","exhausted","."],"distractors":["very"],"explanation":"This sentence uses 'such + a + noun phrase + that-clause' to show a result."},{"id":"ex.b1.so-and-such.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"He is such a talented that he won the competition.","answers":["He is so talented that he won the competition."],"explanation":"'So' should be used before the adjective 'talented' when followed by a 'that-clause'."},{"id":"ex.b1.so-and-such.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"The movie was so a sad story.","answers":["The movie was such a sad story."],"explanation":"'Such a' is used before a singular countable noun phrase like 'sad story'."},{"id":"ex.b1.so-and-such.12","kind":"transformation","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Rewrite the sentence.","source":"The problem was very complicated. We couldn't solve it.","instruction":"Combine the sentences using 'so...that'.","answers":["The problem was so complicated that we couldn't solve it."],"explanation":"Use 'so' before the adjective 'complicated' and 'that' to connect the result."},{"id":"ex.b1.so-and-such.13","kind":"transformation","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Rewrite the sentence.","source":"It was a very exciting game. Everyone cheered loudly.","instruction":"Combine the sentences using 'such...that'.","answers":["It was such an exciting game that everyone cheered loudly."],"explanation":"Use 'such an' before the noun phrase 'exciting game' and 'that' to connect the result."},{"id":"ex.b1.so-and-such.14","kind":"matching","level":"B1","grammarPointIds":["gp.so-and-such"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"The music was so loud","right":"that I couldn't hear myself think."},{"left":"It was such a beautiful view","right":"that we took many photos."},{"left":"They had so much fun","right":"that they didn't want to leave."},{"left":"She gave such good advice","right":"that I followed it immediately."}]},{"id":"ex.b1.subject-and-object-questions.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Choose the best answer.","question":"Someone left a message. ___?","options":["Who did leave a message?","Who left a message?","Who a message left?"],"answer":1,"explanation":"This is a subject question because 'who' is the one who left the message. We don't use 'did' in subject questions."},{"id":"ex.b1.subject-and-object-questions.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Choose the best answer.","question":"You saw something interesting. ___?","options":["What saw you?","What did you see?","What you saw?"],"answer":1,"explanation":"This is an object question because 'what' is the thing you saw. We use 'did' and the base form of the verb."},{"id":"ex.b1.subject-and-object-questions.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Choose the best answer.","question":"___ broke the coffee machine?","options":["Who did","Who","Who does"],"answer":1,"explanation":"This is a subject question because 'who' performed the action of breaking. No 'do/did' is needed."},{"id":"ex.b1.subject-and-object-questions.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Choose the best answer.","question":"___ did you talk to at the conference?","options":["What","Who","Which"],"answer":1,"explanation":"This is an object question about a person, so 'who' is the correct word. 'You' did the talking."},{"id":"ex.b1.subject-and-object-questions.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Complete the sentence.","text":"___ ate the last piece of cake?","answers":[["Who"]],"explanation":"This is a subject question; 'who' performed the action of eating. No 'do/did' is needed."},{"id":"ex.b1.subject-and-object-questions.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Complete the sentence.","text":"___ did you ___ for your birthday?","answers":[["What"],["get","buy"]],"explanation":"This is an object question; 'what' is the thing you received. We use 'did' and the base form of the verb."},{"id":"ex.b1.subject-and-object-questions.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Complete the sentence.","text":"___ caused the delay?","answers":[["What"]],"explanation":"This is a subject question; 'what' performed the action of causing the delay. No 'do/did' is needed."},{"id":"ex.b1.subject-and-object-questions.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Put the words in the right order.","answer":["Who","sent","that","email","?"],"explanation":"This is a subject question. 'Who' is the sender, so no 'did' is used."},{"id":"ex.b1.subject-and-object-questions.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Put the words in the right order.","answer":["What","did","you","read","?"],"explanation":"This is an object question. 'What' is the thing you read, so 'did' is used."},{"id":"ex.b1.subject-and-object-questions.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Who did win the competition?","answers":["Who won the competition?"],"explanation":"This is a subject question, so 'did' is not used. The verb 'win' should be in the past simple form 'won'."},{"id":"ex.b1.subject-and-object-questions.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"What you want for dinner?","answers":["What do you want for dinner?"],"explanation":"This is an object question, so 'do' is needed before the subject 'you'."},{"id":"ex.b1.subject-and-object-questions.12","kind":"transformation","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Rewrite the sentence.","source":"Someone helped Maria with her homework.","instruction":"Ask a question about 'someone'.","answers":["Who helped Maria with her homework?"],"explanation":"This is a subject question, asking about the person who performed the action. No 'do/did' is used."},{"id":"ex.b1.subject-and-object-questions.13","kind":"transformation","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Rewrite the sentence.","source":"They bought a new car.","instruction":"Ask a question about 'a new car'.","answers":["What did they buy?"],"explanation":"This is an object question, asking about the thing they bought. 'Did' is used because 'what' is the object."},{"id":"ex.b1.subject-and-object-questions.14","kind":"matching","level":"B1","grammarPointIds":["gp.subject-and-object-questions"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"Who wants","right":"to go first?"},{"left":"What did you","right":"do last weekend?"},{"left":"Who broke","right":"the coffee cup?"},{"left":"What happened","right":"after the meeting?"}]},{"id":"ex.b1.time-clauses.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Choose the best answer.","question":"We'll start the meeting ___ everyone is here.","options":["when will","when","when is","when will be"],"answer":1,"explanation":"After 'when' in a time clause referring to the future, we use the present simple tense. 'Everyone is here' is the correct present simple form."},{"id":"ex.b1.time-clauses.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Choose the best answer.","question":"Please don't open the box ___ I tell you.","options":["until I will tell","until I told","until I tell","until I am telling"],"answer":2,"explanation":"For future actions in time clauses with 'until', use the present simple. 'I tell' is the correct form."},{"id":"ex.b1.time-clauses.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Choose the best answer.","question":"She'll practice her presentation ___ she feels confident.","options":["before she will feel","before she feels","before she felt","before she is feeling"],"answer":1,"explanation":"In a time clause with 'before' referring to the future, use the present simple. 'She feels' is the correct present simple form for a third-person singular subject."},{"id":"ex.b1.time-clauses.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Choose the best answer.","question":"___ you are cooking dinner, I'll set the table.","options":["When","As soon as","While","Until"],"answer":2,"explanation":"'While' is used for actions happening at the same time. 'Cooking dinner' and 'setting the table' are simultaneous actions."},{"id":"ex.b1.time-clauses.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Complete the sentence.","text":"As soon as the concert ___ (start), we'll find our seats.","answers":[["starts"]],"explanation":"For a future event in a time clause with 'as soon as', use the present simple. 'Starts' is the correct form for 'the concert'."},{"id":"ex.b1.time-clauses.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Complete the sentence.","text":"I'll wait here until my train ___ (arrive).","answers":[["arrives"]],"explanation":"After 'until' in a time clause referring to the future, use the present simple. 'Arrives' is the correct form for 'my train'."},{"id":"ex.b1.time-clauses.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Complete the sentence.","text":"Before you ___ (leave) for work, please water the plants.","answers":[["leave"]],"explanation":"In a time clause with 'before' referring to the future, use the present simple. 'Leave' is the correct form for 'you'."},{"id":"ex.b1.time-clauses.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Put the words in the right order.","answer":["I'll","call","you","when","I","get","home","."],"explanation":"The main clause 'I'll call you' is in the future, and the time clause 'when I get home' uses the present simple for a future action."},{"id":"ex.b1.time-clauses.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Put the words in the right order.","answer":["As","soon","as","it","stops","raining",",","we'll","go","outside","."],"distractors":["will","stopped"],"explanation":"The time clause 'As soon as it stops raining' uses the present simple for a future event, followed by the future main clause."},{"id":"ex.b1.time-clauses.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"We will have dinner when Dad will arrive.","answers":["We will have dinner when Dad arrives."],"explanation":"In a time clause referring to the future, use the present simple, not 'will'."},{"id":"ex.b1.time-clauses.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Don't forget to turn off the lights before you will leave.","answers":["Don't forget to turn off the lights before you leave."],"explanation":"The time clause with 'before' uses the present simple for a future action."},{"id":"ex.b1.time-clauses.12","kind":"transformation","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Rewrite the sentence.","source":"I will finish my work. Then I will go to the gym.","instruction":"Combine these sentences using 'as soon as'.","answers":["As soon as I finish my work, I'll go to the gym.","I'll go to the gym as soon as I finish my work.","As soon as I finish my work, I will go to the gym."],"explanation":"Use 'as soon as' to connect the two future actions, with the present simple in the time clause."},{"id":"ex.b1.time-clauses.13","kind":"transformation","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Rewrite the sentence.","source":"You can't watch TV now. You must wait until your homework is done.","instruction":"Rewrite using 'until'.","answers":["You can't watch TV until your homework is done."],"explanation":"The time clause with 'until' uses the present simple 'is done' to refer to a future state."},{"id":"ex.b1.time-clauses.14","kind":"matching","level":"B1","grammarPointIds":["gp.time-clauses"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I'll call you","right":"when I get to the office."},{"left":"She won't start the movie","right":"until her friends arrive."},{"left":"As soon as the bell rings,","right":"the students will leave."},{"left":"While you are packing,","right":"I'll make some sandwiches."}]},{"id":"ex.b1.used-to.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Choose the best answer.","question":"When I was younger, I ___ play video games all the time.","options":["use to","used to","am used to"],"answer":1,"explanation":"'Used to' is correct for a past habit. 'Use to' is for questions/negatives, and 'am used to' means accustomed to."},{"id":"ex.b1.used-to.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Choose the best answer.","question":"There ___ a lot of trees here, but they were cut down.","options":["used to be","use to be","would be"],"answer":0,"explanation":"'Used to be' correctly describes a past state that no longer exists. 'Use to be' is incorrect in a positive statement."},{"id":"ex.b1.used-to.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Choose the best answer.","question":"My sister ___ like coffee, but now she drinks it every morning.","options":["didn't used to","didn't use to","wouldn't use to"],"answer":1,"explanation":"For negative sentences, we use 'didn't use to' (without the 'd' on 'use')."},{"id":"ex.b1.used-to.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Choose the best answer.","question":"___ you ___ wear glasses when you were a child?","options":["Did / used to","Did / use to","Were / used to"],"answer":1,"explanation":"In questions with 'Did', we use the base form 'use to'."},{"id":"ex.b1.used-to.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Complete the sentence.","text":"My family ___ ___ live in a big city, but now we prefer the countryside.","answers":[["used"],["to"]],"explanation":"'Used to' describes a past state that is no longer true."},{"id":"ex.b1.used-to.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Complete the sentence.","text":"I ___ ___ play the guitar, but I stopped practicing years ago.","answers":[["used"],["to"]],"explanation":"'Used to' describes a past habit that no longer happens."},{"id":"ex.b1.used-to.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Complete the sentence.","text":"___ your brother ___ ___ enjoy hiking before he moved?","answers":[["Did"],["use"],["to"]],"explanation":"For questions, we use 'Did + subject + use to + base verb'."},{"id":"ex.b1.used-to.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Put the words in the right order.","answer":["She","used","to","work","at","the","library","."],"distractors":["working","is"],"explanation":"This sentence describes a past habit or state that is no longer true."},{"id":"ex.b1.used-to.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Put the words in the right order.","answer":["They","didn't","use","to","like","spicy","food","."],"distractors":["used","likes"],"explanation":"This sentence describes a past preference that has changed."},{"id":"ex.b1.used-to.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"My cat use to sleep on my bed.","answers":["My cat used to sleep on my bed."],"explanation":"In positive statements, 'used to' needs the 'd'."},{"id":"ex.b1.used-to.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"Did you used to visit your grandparents often?","answers":["Did you use to visit your grandparents often?"],"explanation":"In questions with 'Did', 'used to' becomes 'use to'."},{"id":"ex.b1.used-to.12","kind":"transformation","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Rewrite the sentence.","source":"When I was young, I often rode my bike to the park.","instruction":"Rewrite using 'used to'.","answers":["When I was young, I used to ride my bike to the park."],"explanation":"'Used to' replaces 'often rode' to express a past habit."},{"id":"ex.b1.used-to.13","kind":"transformation","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Rewrite the sentence.","source":"There was a cinema in our town, but it closed last year.","instruction":"Rewrite using 'used to'.","answers":["There used to be a cinema in our town, but it closed last year."],"explanation":"'Used to be' expresses a past state that no longer exists."},{"id":"ex.b1.used-to.14","kind":"matching","level":"B1","grammarPointIds":["gp.used-to"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I used to live in the city,","right":"but now I prefer the quiet countryside."},{"left":"Did you use to play any sports","right":"when you were in high school?"},{"left":"There didn't use to be so many cars","right":"on this road in the mornings."},{"left":"My brother used to have a pet rabbit,","right":"but it ran away a few years ago."}]},{"id":"ex.b1.verb-object-infinitive.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Choose the best answer.","question":"My parents ___ me to study harder for my exams.","options":["want","wanting","wants","wanted"],"answer":0,"explanation":"The base form 'want' is correct here, matching the subject 'My parents' and followed by 'me to study'."},{"id":"ex.b1.verb-object-infinitive.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Choose the best answer.","question":"The manager ___ us to arrive on time for the meeting.","options":["ask","asked","asking","asks"],"answer":1,"explanation":"The past tense 'asked' fits the context of a completed request. 'Asks' would also be grammatically correct but 'asked' is a common choice for a general statement."},{"id":"ex.b1.verb-object-infinitive.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Choose the best answer.","question":"Please don't ___ me to do that again.","options":["tell","telling","told","tells"],"answer":0,"explanation":"After 'don't', we use the base form of the verb, 'tell'."},{"id":"ex.b1.verb-object-infinitive.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Choose the best answer.","question":"She ___ her friend to lend her a book.","options":["want","asked","told","wants"],"answer":1,"explanation":"'Asked' is the most natural fit for requesting a loan. 'Wants' would also work but 'asked' implies a direct request."},{"id":"ex.b1.verb-object-infinitive.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Complete the sentence.","text":"I ___ my neighbor ___ water my plants while I'm away.","answers":[["want","asked"],["to"]],"explanation":"You can either 'want' or 'ask' your neighbor to water your plants. The structure requires 'to' before the action verb."},{"id":"ex.b1.verb-object-infinitive.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Complete the sentence.","text":"The coach ___ the team ___ practice every day.","answers":[["told"],["to"]],"explanation":"'Told' is the most appropriate verb for a coach giving an instruction to a team. The structure requires 'to' before the action verb."},{"id":"ex.b1.verb-object-infinitive.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Complete the sentence.","text":"Did you ___ them ___ bring their own snacks?","answers":[["ask"],["to"]],"explanation":"'Ask' is used for making a request. The structure requires 'to' before the action verb."},{"id":"ex.b1.verb-object-infinitive.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Put the words in the right order.","answer":["She","asked","me","to","call","her","later","."],"distractors":["called","then"],"explanation":"The correct order is 'She asked me to call her later.', following the pattern 'ask + object + to + verb'."},{"id":"ex.b1.verb-object-infinitive.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"My boss told me working late tonight.","answers":["My boss told me to work late tonight."],"explanation":"The correct structure is 'tell + object + to + verb', so 'working' should be 'to work'."},{"id":"ex.b1.verb-object-infinitive.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"I want you helping me with this project.","answers":["I want you to help me with this project."],"explanation":"The correct structure is 'want + object + to + verb', so 'helping' should be 'to help'."},{"id":"ex.b1.verb-object-infinitive.12","kind":"transformation","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Rewrite the sentence.","source":"Could you please close the window?","instruction":"Rewrite using 'I want you to'.","answers":["I want you to close the window."],"explanation":"The instruction changes a polite request into a direct statement of desire using the target structure."},{"id":"ex.b1.verb-object-infinitive.13","kind":"transformation","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Rewrite the sentence.","source":"The teacher said, \"Everyone, read page 20.\"","instruction":"Rewrite using 'The teacher told us to'.","answers":["The teacher told us to read page 20."],"explanation":"The instruction changes a direct command into a reported instruction using the target structure."},{"id":"ex.b1.verb-object-infinitive.14","kind":"matching","level":"B1","grammarPointIds":["gp.verb-object-infinitive"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"I want you","right":"to listen carefully."},{"left":"He asked his sister","right":"to lend him her car."},{"left":"The doctor told me","right":"to get more rest."},{"left":"They don't want us","right":"to make too much noise."}]},{"id":"ex.b1.zero-conditional.01","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Choose the best answer.","question":"If you mix red and blue, you ___ purple.","options":["get","will get","got"],"answer":0,"explanation":"The zero conditional uses the present simple in both clauses to describe a general truth."},{"id":"ex.b1.zero-conditional.02","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Choose the best answer.","question":"When the sun sets, it ___ dark.","options":["gets","will get","got"],"answer":0,"explanation":"This is a natural phenomenon that always happens, so we use the present simple."},{"id":"ex.b1.zero-conditional.03","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Choose the best answer.","question":"If I eat too much chocolate, I ___ a stomachache.","options":["get","will get","am getting"],"answer":0,"explanation":"This describes a consistent personal reaction, requiring the present simple in both clauses."},{"id":"ex.b1.zero-conditional.04","kind":"multiple_choice","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Choose the best answer.","question":"What happens if you don't water plants?","options":["They die.","They will die.","They died."],"answer":0,"explanation":"This is a general truth about plants, so the present simple is used in the result clause."},{"id":"ex.b1.zero-conditional.05","kind":"gap_fill","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Complete the sentence.","text":"If you ___ (freeze) water, it ___ (turn) into ice.","answers":[["freeze"],["turns"]],"explanation":"This is a scientific fact, so both verbs must be in the present simple."},{"id":"ex.b1.zero-conditional.06","kind":"gap_fill","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Complete the sentence.","text":"When I ___ (feel) stressed, I usually ___ (listen) to music.","answers":[["feel"],["listen"]],"explanation":"This describes a regular habit, so both verbs are in the present simple."},{"id":"ex.b1.zero-conditional.07","kind":"gap_fill","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Complete the sentence.","text":"People ___ (get) thirsty if they ___ (not drink) enough water.","answers":[["get"],["don't drink","do not drink"]],"explanation":"This is a general truth about human physiology, requiring the present simple in both clauses."},{"id":"ex.b1.zero-conditional.08","kind":"sentence_building","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Put the words in the right order.","answer":["If","you","don't","wear","a","coat,","you","get","cold","."],"distractors":["will","would"],"explanation":"This sentence describes a general consequence of not wearing a coat."},{"id":"ex.b1.zero-conditional.09","kind":"sentence_building","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Put the words in the right order.","answer":["When","it","rains,","the","streets","get","wet","."],"distractors":["will","is"],"explanation":"This describes a natural and consistent outcome when it rains."},{"id":"ex.b1.zero-conditional.10","kind":"error_correction","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"If you will touch fire, you get burned.","answers":["If you touch fire, you get burned."],"explanation":"In the zero conditional, the 'if' clause uses the present simple, not the future simple."},{"id":"ex.b1.zero-conditional.11","kind":"error_correction","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Find the mistake and write the sentence correctly.","sentence":"When I am hungry, I will eat something.","answers":["When I am hungry, I eat something."],"explanation":"For general truths or habits, both clauses in the zero conditional use the present simple."},{"id":"ex.b1.zero-conditional.12","kind":"transformation","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Rewrite the sentence.","source":"When you heat metal, it expands.","instruction":"Rewrite using 'if'.","answers":["If you heat metal, it expands."],"explanation":"'If' and 'when' can often be used interchangeably in the zero conditional to express general truths."},{"id":"ex.b1.zero-conditional.13","kind":"transformation","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Rewrite the sentence.","source":"Plants don't grow without sunlight.","instruction":"Rewrite using 'if'.","answers":["If plants don't get sunlight, they don't grow.","If plants don't get sunlight, they die."],"explanation":"The instruction requires forming a zero conditional sentence with an 'if' clause and a result clause, both in the present simple."},{"id":"ex.b1.zero-conditional.14","kind":"matching","level":"B1","grammarPointIds":["gp.zero-conditional"],"prompt":"Match the beginnings and endings.","pairs":[{"left":"If you drop a glass,","right":"it breaks."},{"left":"When I travel,","right":"I always pack light."},{"left":"If you don't brush your teeth,","right":"you get cavities."},{"left":"The alarm rings","right":"if there's a fire."}]},{"id":"ex.vocab.ability","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"ability","back":"(noun) The power or knowledge to do something.","example":{"text":"I have confidence in your ability to win.","source":{"kind":"tatoeba","sentenceId":252882,"author":"CK"}},"audio":"audio/af8c934bd7ee4b48.m4a"},{"id":"ex.vocab.abroad","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"abroad","back":"(adverb) In or to a foreign country.","example":{"text":"I want to go abroad.","source":{"kind":"tatoeba","sentenceId":21938,"author":"CK"}},"audio":"audio/08f6cb9a916cf7b8.m4a"},{"id":"ex.vocab.absent","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"absent","back":"(adjective) Not present in a place where you are expected to be.","example":{"text":"I was absent from the party.","source":{"kind":"tatoeba","sentenceId":29009,"author":"CK"}},"audio":"audio/05e6912e93c1558b.m4a"},{"id":"ex.vocab.absolutely","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"absolutely","back":"(adverb) Completely and without any doubt.","example":{"text":"I agree with you absolutely.","source":{"kind":"tatoeba","sentenceId":321772,"author":"CK"}},"audio":"audio/29874c34d6d5ba27.m4a"},{"id":"ex.vocab.accent","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"accent","back":"(noun) The way someone pronounces words, showing where they are from or their social class.","example":{"text":"Tom has an Australian accent.","source":{"kind":"tatoeba","sentenceId":1904473,"author":"CK"}},"audio":"audio/0bfe290e26a3f7a8.m4a"},{"id":"ex.vocab.accept","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"accept","back":"(verb) To agree to take something or to believe that something is true.","example":{"text":"All right. I'll accept your offer.","source":{"kind":"tatoeba","sentenceId":29872,"author":"CK"}},"audio":"audio/1c46fd82221451f5.m4a"},{"id":"ex.vocab.access","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"access","back":"(noun) The right or opportunity to use or see something, or to enter a place.","example":{"text":"This gate allows access to the garden.","source":{"kind":"tatoeba","sentenceId":56640,"author":"CM"}},"audio":"audio/47e32afb21d1ae06.m4a"},{"id":"ex.vocab.accident","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"accident","back":"(noun) An unexpected event that causes damage, injury, or death.","example":{"text":"We didn't actually see the accident.","source":{"kind":"tatoeba","sentenceId":23183,"author":"CK"}},"audio":"audio/9fd1c9e02f21868d.m4a"},{"id":"ex.vocab.accidentally","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"accidentally","back":"(adverb) Happening by chance or without planning, not on purpose.","example":{"text":"She accidentally tore the page.","source":{"kind":"tatoeba","sentenceId":3143195,"author":"CK"}},"audio":"audio/a553c2e315a9fbed.m4a"},{"id":"ex.vocab.according","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"according","back":"(preposition) As stated by or in agreement with something.","example":{"text":"Everything went according to plan.","source":{"kind":"tatoeba","sentenceId":51658,"author":"CK"}},"audio":"audio/b2374889397e6e75.m4a"},{"id":"ex.vocab.account","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"account","back":"(noun) A record of money kept in a bank, or a description of an event.","example":{"text":"The accounts have been audited.","source":{"kind":"tatoeba","sentenceId":22466,"author":"CK"}},"audio":"audio/d5d3531ed19c52d5.m4a"},{"id":"ex.vocab.achieve","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"achieve","back":"(verb) To successfully reach a desired goal or result, often after effort.","example":{"text":"She has achieved her goals.","source":{"kind":"tatoeba","sentenceId":1577181,"author":"sundown"}},"audio":"audio/9f77a4231f8aeb05.m4a"},{"id":"ex.vocab.actually","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"actually","back":"(adverb) Used to emphasize that something is true or real, or to correct a misunderstanding.","example":{"text":"I actually saw a ghost.","source":{"kind":"tatoeba","sentenceId":261766,"author":"CK"}},"audio":"audio/c4dceac3cacb002e.m4a"},{"id":"ex.vocab.admit","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"admit","back":"(verb) To agree that something is true, especially unwillingly.","example":{"text":"I admit that he is right.","source":{"kind":"tatoeba","sentenceId":283927,"author":"CK"}},"audio":"audio/71e7f560fd619a44.m4a"},{"id":"ex.vocab.adopt","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"adopt","back":"(verb) To legally take another person's child into your own family.","example":{"text":"Tom and Mary adopted a child from Russia.","source":{"kind":"tatoeba","sentenceId":2730748,"author":"Hybrid"}},"audio":"audio/b11d48242ca1474b.m4a"},{"id":"ex.vocab.advance","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"advance","back":"(verb) To move forward or make progress.","example":{"text":"The officer told his men to advance.","source":{"kind":"tatoeba","sentenceId":245289,"author":"CM"}},"audio":"audio/68f07ee1b3744012.m4a"},{"id":"ex.vocab.advantage","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"advantage","back":"(noun) Something that helps you to be more successful than others.","example":{"text":"It's to your advantage to learn everything you can.","source":{"kind":"tatoeba","sentenceId":24962,"author":"CK"}},"audio":"audio/22f229a5200159c6.m4a"},{"id":"ex.vocab.advice","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"advice","back":"(noun) Suggestions about what you should do in a particular situation.","example":{"text":"My advice is for you to go home.","source":{"kind":"tatoeba","sentenceId":24241,"author":"CK"}},"audio":"audio/f9843393deae6c32.m4a"},{"id":"ex.vocab.advise","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"advise","back":"(verb) To tell someone what you think they should do in a particular situation.","example":{"text":"The doctor advised him to do more exercise.","source":{"kind":"tatoeba","sentenceId":27943,"author":"CK"}},"audio":"audio/00393df0fc0b9236.m4a"},{"id":"ex.vocab.affect","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"affect","back":"(verb) To have an influence on someone or something, causing a change.","example":{"text":"A damp, cold day affects a person's health.","source":{"kind":"tatoeba","sentenceId":53220,"author":"CM"}},"audio":"audio/06a87ea363b8ccae.m4a"},{"id":"ex.vocab.afford","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"afford","back":"(verb) To have enough money to buy or do something.","example":{"text":"I can't afford a car.","source":{"kind":"tatoeba","sentenceId":249843,"author":"CK"}},"audio":"audio/b51966c64c0b924b.m4a"},{"id":"ex.vocab.against","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"against","back":"(preposition) Opposed to something or someone; in contact with something.","example":{"text":"Don't go against the rules.","source":{"kind":"tatoeba","sentenceId":20230,"author":"fishda"}},"audio":"audio/d83411c8622703c3.m4a"},{"id":"ex.vocab.agree","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"agree","back":"(verb) To have the same opinion as someone else, or to say yes to a plan.","example":{"text":"Everybody agreed with his idea.","source":{"kind":"tatoeba","sentenceId":32168,"author":"CK"}},"audio":"audio/0b32fd6a6fdecc03.m4a"},{"id":"ex.vocab.agreement","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"agreement","back":"(noun) A situation where people have the same opinion, or a formal decision between groups.","example":{"text":"We are all in agreement.","source":{"kind":"tatoeba","sentenceId":23124,"author":"CK"}},"audio":"audio/44585ddd5b9d7042.m4a"},{"id":"ex.vocab.ahead","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"ahead","back":"(adverb) In front of someone or something, or in the future.","example":{"text":"Don't go too far ahead of me.","source":{"kind":"tatoeba","sentenceId":250203,"author":"sundown"}},"audio":"audio/7e4cb408926e79ab.m4a"},{"id":"ex.vocab.aim","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"aim","back":"(verb) To point a weapon or object at something, or to try to achieve something.","example":{"text":"The hunter aimed a shotgun at the flock of birds.","source":{"kind":"tatoeba","sentenceId":34953,"author":"CK"}},"audio":"audio/c0286ccef93f3c56.m4a"},{"id":"ex.vocab.alarm","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"alarm","back":"(noun) A sudden feeling of fear or worry; a device that makes a loud sound to warn of danger.","example":{"text":"Tom forgot to set his alarm clock.","source":{"kind":"tatoeba","sentenceId":1025735,"author":"CK"}},"audio":"audio/98d97ec4b7601ba9.m4a"},{"id":"ex.vocab.album","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"album","back":"(noun) A book for keeping photographs, stamps, or other collections; a collection of songs.","example":{"text":"I tore the picture out of the album.","source":{"kind":"tatoeba","sentenceId":253039,"author":"CK"}},"audio":"audio/fb4f18c60ae867e4.m4a"},{"id":"ex.vocab.alcohol","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"alcohol","back":"(noun) A clear liquid that can make people drunk, found in drinks like beer and wine.","example":{"text":"Many adults enjoy drinks with alcohol.","source":{"kind":"generated"}},"audio":"audio/008f651661f06c82.m4a"},{"id":"ex.vocab.alien","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"alien","back":"(noun) A creature from another planet; a foreigner who is not a citizen of the country they live in.","example":{"text":"Tom claims he was once abducted by aliens.","source":{"kind":"tatoeba","sentenceId":4496557,"author":"CK"}},"audio":"audio/822b6e7364aa11e7.m4a"},{"id":"ex.vocab.alive","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"alive","back":"(adjective) Living; not dead.","example":{"text":"None of them is alive.","source":{"kind":"tatoeba","sentenceId":276648,"author":"CK"}},"audio":"audio/28f1cd7dd58c64d4.m4a"},{"id":"ex.vocab.allergic","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"allergic","back":"(adjective) Having a bad reaction to certain foods, plants, or other substances.","example":{"text":"He is allergic to dust.","source":{"kind":"tatoeba","sentenceId":292732,"author":"CK"}},"audio":"audio/6eb4da2132b3d8df.m4a"},{"id":"ex.vocab.allow","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"allow","back":"(verb) To let someone do something, or to let something happen.","example":{"text":"You must not allow the children to play here.","source":{"kind":"tatoeba","sentenceId":245790,"author":"CK"}},"audio":"audio/b6ed134b6e9bb264.m4a"},{"id":"ex.vocab.although","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"although","back":"(conjunction) Used to introduce a statement that makes the main statement seem surprising.","example":{"text":"Although my car is very old, it still runs very well.","source":{"kind":"tatoeba","sentenceId":251084,"author":"CK"}},"audio":"audio/02a83ff027b0fa84.m4a"},{"id":"ex.vocab.ambulance","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"ambulance","back":"(noun) A special vehicle used for taking sick or injured people to a hospital.","example":{"text":"Do you need an ambulance?","source":{"kind":"tatoeba","sentenceId":19591,"author":"CK"}},"audio":"audio/8ea8922f7d0e6e1e.m4a"},{"id":"ex.vocab.among","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"among","back":"(preposition) In the middle of a group of people or things.","example":{"text":"He was among those chosen.","source":{"kind":"tatoeba","sentenceId":26627,"author":"CK"}},"audio":"audio/7a2bb24d067337e4.m4a"},{"id":"ex.vocab.amuse","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"amuse","back":"(verb) To make someone laugh or smile, or to keep them interested and happy.","example":{"text":"He amused us with funny stories.","source":{"kind":"tatoeba","sentenceId":354461,"author":"Hautis"}},"audio":"audio/2143c97ba6b123ef.m4a"},{"id":"ex.vocab.ancient","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"ancient","back":"(adjective) Belonging to a period of history that is thousands of years in the past.","example":{"text":"Do you like ancient history?","source":{"kind":"tatoeba","sentenceId":680196,"author":"Source_VOA"}},"audio":"audio/c2e2bccf6ee52cbe.m4a"},{"id":"ex.vocab.anger","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"anger","back":"(noun) A strong feeling of displeasure or hostility.","example":{"text":"I couldn't control my anger.","source":{"kind":"tatoeba","sentenceId":259649,"author":"CK"}},"audio":"audio/144df22576d8cf80.m4a"},{"id":"ex.vocab.announce","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"announce","back":"(verb) To tell people about something officially or publicly.","example":{"text":"It was announced that the meeting would be put off.","source":{"kind":"tatoeba","sentenceId":22497,"author":"CK"}},"audio":"audio/05d8120739b50c0a.m4a"},{"id":"ex.vocab.anytime","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"anytime","back":"(adverb) At any time; whenever you want.","example":{"text":"You can call me anytime you want.","source":{"kind":"tatoeba","sentenceId":5588327,"author":"CK"}},"audio":"audio/ddd51f092a22815b.m4a"},{"id":"ex.vocab.anyway","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"anyway","back":"(adverb) Used to change the subject or to return to an earlier subject.","example":{"text":"Anyway, I won't take up any more of your time.","source":{"kind":"tatoeba","sentenceId":870595,"author":"CM"}},"audio":"audio/2f4bfb4a8b678609.m4a"},{"id":"ex.vocab.apart","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"apart","back":"(adverb) Separated by a distance, or into pieces.","example":{"text":"I sat apart from them.","source":{"kind":"tatoeba","sentenceId":260820,"author":"sundown"}},"audio":"audio/bc5270ec7f5b007f.m4a"},{"id":"ex.vocab.apologize","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"apologize","back":"(verb) To say that you are sorry for something you have done wrong.","example":{"text":"He apologized to me for stepping on my foot.","source":{"kind":"tatoeba","sentenceId":301015,"author":"CK"}},"audio":"audio/f0eeed10547798d6.m4a"},{"id":"ex.vocab.apply","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"apply","back":"(verb) To formally ask for something, like a job or a permit.","example":{"text":"I applied for a visa.","source":{"kind":"tatoeba","sentenceId":34786,"author":"CK"}},"audio":"audio/7355c20ce65cc34a.m4a"},{"id":"ex.vocab.appointment","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"appointment","back":"(noun) A formal arrangement to meet someone at a specific time and place.","example":{"text":"Will you make an appointment with Mr Ito?","source":{"kind":"tatoeba","sentenceId":28311,"author":"Dejo"}},"audio":"audio/abce0d5dfd95d91d.m4a"},{"id":"ex.vocab.appreciate","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"appreciate","back":"(verb) To be grateful for something, or to understand the value of something.","example":{"text":"We appreciate your hard work.","source":{"kind":"tatoeba","sentenceId":262637,"author":"CK"}},"audio":"audio/02de057b54fb9d30.m4a"},{"id":"ex.vocab.approach","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"approach","back":"(verb) To come nearer to someone or something in distance or time.","example":{"text":"He approached the boy reading a book.","source":{"kind":"tatoeba","sentenceId":303801,"author":"CK"}},"audio":"audio/9f82cb0ccf0d6b73.m4a"},{"id":"ex.vocab.approve","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"approve","back":"(verb) To officially agree to or accept something.","example":{"text":"The minister approved the building plans.","source":{"kind":"tatoeba","sentenceId":275746,"author":"CK"}},"audio":"audio/58b38af09559e2f2.m4a"},{"id":"ex.vocab.argue","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"argue","back":"(verb) To speak angrily to someone because you disagree with them.","example":{"text":"Have you ever argued with your parents?","source":{"kind":"tatoeba","sentenceId":269727,"author":"CK"}},"audio":"audio/c52269ec0d390741.m4a"},{"id":"ex.vocab.argument","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"argument","back":"(noun) A disagreement, or a set of reasons that show something is true or false.","example":{"text":"Let's patch up our argument.","source":{"kind":"tatoeba","sentenceId":31391,"author":"CarpeLanam"}},"audio":"audio/801d85ae243f5e50.m4a"},{"id":"ex.vocab.army","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"army","back":"(noun) A large organized group of soldiers who fight on land.","example":{"text":"I went into the army.","source":{"kind":"tatoeba","sentenceId":262188,"author":"CK"}},"audio":"audio/c8efd700780f37cd.m4a"},{"id":"ex.vocab.arrange","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"arrange","back":"(verb) To put things in a particular order or position; to plan or organize something.","example":{"text":"I'm going to arrange these flowers.","source":{"kind":"tatoeba","sentenceId":2267208,"author":"_undertoad"}},"audio":"audio/962ed8fcccb67a36.m4a"},{"id":"ex.vocab.arrest","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"arrest","back":"(verb) To take someone to a police station because they are believed to have committed a crime.","example":{"text":"The security guard had to arrest the man for entering the restricted area.","source":{"kind":"generated"}},"audio":"audio/aaf7a7bff74dbf5f.m4a"},{"id":"ex.vocab.article","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"article","back":"(noun) A piece of writing in a newspaper, magazine, or on a website.","example":{"text":"Have you read this article?","source":{"kind":"tatoeba","sentenceId":70090,"author":"CK"}},"audio":"audio/a25ffc01c9bb2ca5.m4a"},{"id":"ex.vocab.ashamed","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"ashamed","back":"(adjective) Feeling embarrassed or guilty about something you have done or about a situation.","example":{"text":"You ought to be ashamed of yourself.","source":{"kind":"tatoeba","sentenceId":69098,"author":"CK"}},"audio":"audio/62788cc7640a4174.m4a"},{"id":"ex.vocab.assume","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"assume","back":"(verb) To believe something is true without having proof.","example":{"text":"He assumed that the train would be on time.","source":{"kind":"tatoeba","sentenceId":279214,"author":"CK"}},"audio":"audio/c383a8848657f119.m4a"},{"id":"ex.vocab.attack","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"attack","back":"(verb) To use violence against someone or something, or to criticize strongly.","example":{"text":"The team decided to attack the problem from a new angle.","source":{"kind":"generated"}},"audio":"audio/b0567953524c8615.m4a"},{"id":"ex.vocab.attempt","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"attempt","back":"(verb) To try to do something, especially something difficult.","example":{"text":"They're attempting to contact her.","source":{"kind":"tatoeba","sentenceId":680290,"author":"Source_VOA"}},"audio":"audio/2e9d380070664c1a.m4a"},{"id":"ex.vocab.attend","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"attend","back":"(verb) To go to an event, meeting, or class.","example":{"text":"I can't attend the meeting.","source":{"kind":"tatoeba","sentenceId":22534,"author":"CK"}},"audio":"audio/25b918b1e567499e.m4a"},{"id":"ex.vocab.attention","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"attention","back":"(noun) The act of carefully listening to, looking at, or thinking about something.","example":{"text":"You must pay attention to him.","source":{"kind":"tatoeba","sentenceId":15817,"author":"CK"}},"audio":"audio/5d65c3d86eaa7648.m4a"},{"id":"ex.vocab.attic","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"attic","back":"(noun) A space or room directly under the roof of a house, often used for storage.","example":{"text":"Have you already carried the boxes up to the attic?","source":{"kind":"tatoeba","sentenceId":2776944,"author":"CK"}},"audio":"audio/f945fd29fd2d53d6.m4a"},{"id":"ex.vocab.attitude","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"attitude","back":"(noun) The way you think or feel about something, which affects how you behave.","example":{"text":"She approaches everything with a businesslike attitude.","source":{"kind":"tatoeba","sentenceId":1343770,"author":"Chrikaru"}},"audio":"audio/2c7d1e08ab78084e.m4a"},{"id":"ex.vocab.attract","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"attract","back":"(verb) To make someone or something come closer or be interested in something.","example":{"text":"His concert attracted many people.","source":{"kind":"tatoeba","sentenceId":285337,"author":"CK"}},"audio":"audio/8fb1a012a3b899a5.m4a"},{"id":"ex.vocab.attractive","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"attractive","back":"(adjective) Pleasing or appealing to the senses or mind.","example":{"text":"He's smart, cool and attractive.","source":{"kind":"tatoeba","sentenceId":2571294,"author":"Hybrid"}},"audio":"audio/8a0b8248d71de581.m4a"},{"id":"ex.vocab.audience","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"audience","back":"(noun) A group of people who watch or listen to a performance, speech, or show.","example":{"text":"We had a large audience.","source":{"kind":"tatoeba","sentenceId":274920,"author":"CK"}},"audio":"audio/42d651d8b440ba2d.m4a"},{"id":"ex.vocab.author","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"author","back":"(noun) A person who writes books, articles, or other written works.","example":{"text":"Who is your favorite author?","source":{"kind":"tatoeba","sentenceId":70681,"author":"CK"}},"audio":"audio/91c45bc10801b09a.m4a"},{"id":"ex.vocab.available","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"available","back":"(adjective) Ready for use or able to be found.","example":{"text":"This book is available at one shop only.","source":{"kind":"tatoeba","sentenceId":57023,"author":"CK"}},"audio":"audio/c5ad688665a8f875.m4a"},{"id":"ex.vocab.average","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"average","back":"(adjective) Normal or typical; not special or unusual.","example":{"text":"He was a man of average height.","source":{"kind":"tatoeba","sentenceId":303524,"author":"CK"}},"audio":"audio/4e04736c1fd07c51.m4a"},{"id":"ex.vocab.avoid","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"avoid","back":"(verb) To stay away from someone or something, or to prevent something from happening.","example":{"text":"Try to avoid bad company.","source":{"kind":"tatoeba","sentenceId":28519,"author":"CK"}},"audio":"audio/f84ff977f38445d5.m4a"},{"id":"ex.vocab.awake","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"awake","back":"(adjective) Not sleeping.","example":{"text":"I lay awake in bed.","source":{"kind":"tatoeba","sentenceId":255556,"author":"CK"}},"audio":"audio/12ddad574bb98ae9.m4a"},{"id":"ex.vocab.aware","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"aware","back":"(adjective) Knowing about something; having knowledge or understanding of a situation.","example":{"text":"I am aware of the fact.","source":{"kind":"tatoeba","sentenceId":254425,"author":"CK"}},"audio":"audio/b93861749f9edf03.m4a"},{"id":"ex.vocab.balcony","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"balcony","back":"(noun) A platform built on the outside wall of a building, with a wall or rail.","example":{"text":"I ate breakfast on my balcony.","source":{"kind":"tatoeba","sentenceId":5277814,"author":"CK"}},"audio":"audio/ca5ba192100a2da9.m4a"},{"id":"ex.vocab.ban","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"ban","back":"(verb) To officially say that something is not allowed.","example":{"text":"They banned French as a language of instruction at schools.","source":{"kind":"tatoeba","sentenceId":3856923,"author":"Amastan"}},"audio":"audio/93b07af46b0c9f3d.m4a"},{"id":"ex.vocab.bark","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"bark","back":"(verb) To make the loud, sharp sound that a dog or other animal makes.","example":{"text":"Does it bark at her?","source":{"kind":"tatoeba","sentenceId":42156,"author":"AlanF_US"}},"audio":"audio/5a32941812c3fcf4.m4a"},{"id":"ex.vocab.base","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"base","back":"(noun) The lowest part of something, or a main place where a person or organization operates.","example":{"text":"The base of the statue was made of stone.","source":{"kind":"generated"}},"audio":"audio/c0dbeccd5943405c.m4a"},{"id":"ex.vocab.battery","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"battery","back":"(noun) A device that produces electricity to power electronic devices or vehicles.","example":{"text":"My cell phone battery doesn't work anymore.","source":{"kind":"tatoeba","sentenceId":3410309,"author":"magnificentgoddess"}},"audio":"audio/4be69554dc9b9c0e.m4a"},{"id":"ex.vocab.battle","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"battle","back":"(noun) A fight between two armies or groups of people.","example":{"text":"They won the battle at the cost of many lives.","source":{"kind":"tatoeba","sentenceId":307076,"author":"CM"}},"audio":"audio/6bee8d1c7603b97d.m4a"},{"id":"ex.vocab.bear","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"bear","back":"(verb) To accept or deal with something difficult or unpleasant.","example":{"text":"I cannot bear the pain any more.","source":{"kind":"tatoeba","sentenceId":18382,"author":"CK"}},"audio":"audio/d69ce5c734b0dacf.m4a"},{"id":"ex.vocab.beat","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"beat","back":"(verb) To hit something repeatedly, or to defeat someone in a game or competition.","example":{"text":"My heart is beating fast.","source":{"kind":"tatoeba","sentenceId":268999,"author":"CK"}},"audio":"audio/e6f55f429c155410.m4a"},{"id":"ex.vocab.beauty","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"beauty","back":"(noun) The quality of being pleasing to the senses or mind, often visually.","example":{"text":"The beauty of the lake was beyond description.","source":{"kind":"tatoeba","sentenceId":48131,"author":"CM"}},"audio":"audio/5c419a9231eb05a8.m4a"},{"id":"ex.vocab.beetle","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"beetle","back":"(noun) An insect with a hard, shiny back and wings.","example":{"text":"The beetle is on the table.","source":{"kind":"tatoeba","sentenceId":8321508,"author":"Amastan"}},"audio":"audio/ed5c05bbb0d11433.m4a"},{"id":"ex.vocab.beg","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"beg","back":"(verb) To ask for something in a very serious or emotional way.","example":{"text":"The boy begged for a new bicycle.","source":{"kind":"tatoeba","sentenceId":276853,"author":"CK"}},"audio":"audio/8d19f9414dc3c6bc.m4a"},{"id":"ex.vocab.behave","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"behave","back":"(verb) To act in a particular way, especially in a good or bad way.","example":{"text":"You must not behave so.","source":{"kind":"tatoeba","sentenceId":41326,"author":"Dejo"}},"audio":"audio/d860f218a507f10d.m4a"},{"id":"ex.vocab.behavior","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"behavior","back":"(noun) The way someone acts or conducts themselves.","example":{"text":"I was ashamed of my behavior.","source":{"kind":"tatoeba","sentenceId":258250,"author":"CK"}},"audio":"audio/3ec75dd519a615b7.m4a"},{"id":"ex.vocab.belly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"belly","back":"(noun) The front part of the body below the chest, containing the stomach and other organs.","example":{"text":"Tom's dog likes to get his belly rubbed.","source":{"kind":"tatoeba","sentenceId":7413926,"author":"Hybrid"}},"audio":"audio/aa0fb8ffcbedddcd.m4a"},{"id":"ex.vocab.belong","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"belong","back":"(verb) To be owned by someone or something.","example":{"text":"This pen belongs to me.","source":{"kind":"tatoeba","sentenceId":60535,"author":"CK"}},"audio":"audio/3b0f35b8d5f4b6f9.m4a"},{"id":"ex.vocab.bend","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"bend","back":"(verb) To move the top part of your body forward and down.","example":{"text":"Tom bent over and picked the coin up.","source":{"kind":"tatoeba","sentenceId":2539379,"author":"CK"}},"audio":"audio/85422cd968286b08.m4a"},{"id":"ex.vocab.benefit","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"benefit","back":"(noun) An advantage or good thing that you get from something.","example":{"text":"Rainforests provide the earth with many benefits.","source":{"kind":"tatoeba","sentenceId":282141,"author":"CK"}},"audio":"audio/3778acc9cd1ec67d.m4a"},{"id":"ex.vocab.bet","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"bet","back":"(verb) To risk money on the result of a game, race, or other event.","example":{"text":"I bet ten dollars on that horse.","source":{"kind":"tatoeba","sentenceId":252961,"author":"CK"}},"audio":"audio/17d3f316daf4303c.m4a"},{"id":"ex.vocab.beyond","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"beyond","back":"(preposition) Further away than something; on the other side of something.","example":{"text":"The small village is just beyond those hills.","source":{"kind":"generated"}},"audio":"audio/32baa0f331578b8f.m4a"},{"id":"ex.vocab.birth","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"birth","back":"(noun) The time when a baby or young animal comes out of its mother's body.","example":{"text":"Write the date of your birth.","source":{"kind":"tatoeba","sentenceId":70428,"author":"CS"}},"audio":"audio/e2b9d4c25262c389.m4a"},{"id":"ex.vocab.bite","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"bite","back":"(verb) To cut or hold something with your teeth.","example":{"text":"The bear is quite tame and doesn't bite.","source":{"kind":"tatoeba","sentenceId":48604,"author":"Dejo"}},"audio":"audio/36bcbdf33d336372.m4a"},{"id":"ex.vocab.blame","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"blame","back":"(verb) To say or think that someone or something is responsible for something bad.","example":{"text":"I don't blame you for doing that.","source":{"kind":"tatoeba","sentenceId":18020,"author":"CK"}},"audio":"audio/afae1d3369a38328.m4a"},{"id":"ex.vocab.bleed","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"bleed","back":"(verb) To lose blood from your body, for example from a cut or injury.","example":{"text":"His wounded leg began to bleed again.","source":{"kind":"tatoeba","sentenceId":287445,"author":"CK"}},"audio":"audio/bb4ac2a22d8d4ee1.m4a"},{"id":"ex.vocab.blind","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"blind","back":"(adjective) Unable to see.","example":{"text":"He became blind because of the accident.","source":{"kind":"tatoeba","sentenceId":627219,"author":"CM"}},"audio":"audio/dca66fd062ce0b54.m4a"},{"id":"ex.vocab.block","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"block","back":"(noun) A solid piece of material, or a city street with buildings on both sides.","example":{"text":"Go two blocks along this street and turn left.","source":{"kind":"tatoeba","sentenceId":57795,"author":"CK"}},"audio":"audio/23f07f0adce55478.m4a"},{"id":"ex.vocab.blood","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"blood","back":"(noun) The red liquid that flows inside the bodies of people and animals.","example":{"text":"A small cut on my finger made some blood appear.","source":{"kind":"generated"}},"audio":"audio/ce2d757bce0a8fd7.m4a"},{"id":"ex.vocab.border","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"border","back":"(noun) The official line that separates two countries or areas.","example":{"text":"Germany shares a border with France.","source":{"kind":"tatoeba","sentenceId":591223,"author":"CK"}},"audio":"audio/396591a9e8bfcc27.m4a"},{"id":"ex.vocab.bother","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"bother","back":"(verb) To annoy someone, or to cause trouble or difficulty for them.","example":{"text":"You need to stop doing things that bother Tom.","source":{"kind":"tatoeba","sentenceId":1023714,"author":"CK"}},"audio":"audio/55957b980187d557.m4a"},{"id":"ex.vocab.branch","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"branch","back":"(noun) A part of a tree that grows out from the main trunk and has leaves, flowers, or fruit.","example":{"text":"Don't break off the branch.","source":{"kind":"tatoeba","sentenceId":246311,"author":"shekitten"}},"audio":"audio/559f2b8201150652.m4a"},{"id":"ex.vocab.brave","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"brave","back":"(adjective) Showing no fear when facing danger or difficulty.","example":{"text":"Brave people feel fear, but that doesn't stop them.","source":{"kind":"tatoeba","sentenceId":680416,"author":"Source_VOA"}},"audio":"audio/622647b6626ff347.m4a"},{"id":"ex.vocab.breath","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"breath","back":"(noun) The air that you take in and let out of your lungs.","example":{"text":"I ran out of breath.","source":{"kind":"tatoeba","sentenceId":259206,"author":"CK"}},"audio":"audio/b4c252b634b91951.m4a"},{"id":"ex.vocab.bug","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"bug","back":"(noun) A small insect, or a hidden microphone, or a problem in computer code.","example":{"text":"The developers quickly fixed the bug.","source":{"kind":"tatoeba","sentenceId":4976724,"author":"Hybrid"}},"audio":"audio/416a83886623f988.m4a"},{"id":"ex.vocab.bully","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"bully","back":"(noun) A person who uses their strength or power to hurt or frighten weaker people.","example":{"text":"That guy is a bully.","source":{"kind":"tatoeba","sentenceId":4494888,"author":"CK"}},"audio":"audio/2b3327152ea4d0d1.m4a"},{"id":"ex.vocab.bunch","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"bunch","back":"(noun) A group of things of the same type that are held or grow together.","example":{"text":"I gave a bunch of roses to her in return for her hospitality.","source":{"kind":"tatoeba","sentenceId":261236,"author":"CK"}},"audio":"audio/949d096ab5f5c870.m4a"},{"id":"ex.vocab.burn","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"burn","back":"(verb) To be on fire, or to destroy or damage something with fire.","example":{"text":"The fish is burnt black.","source":{"kind":"tatoeba","sentenceId":19368,"author":"Dejo"}},"audio":"audio/87f4e7352b047967.m4a"},{"id":"ex.vocab.bury","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"bury","back":"(verb) To put something or someone into the ground and cover it with earth.","example":{"text":"I buried my dog at the pet cemetery.","source":{"kind":"tatoeba","sentenceId":6048,"author":"Zifre"}},"audio":"audio/198d2b750a812d41.m4a"},{"id":"ex.vocab.bush","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"bush","back":"(noun) A plant that is smaller than a tree, with many branches growing from the ground.","example":{"text":"A small bird flew out of the bush.","source":{"kind":"generated"}},"audio":"audio/1ae133c9dbc185aa.m4a"},{"id":"ex.vocab.cabin","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"cabin","back":"(noun) A small house, especially one made of wood, or a room on a ship or plane.","example":{"text":"I want a log cabin.","source":{"kind":"tatoeba","sentenceId":5788453,"author":"Eccles17"}},"audio":"audio/2b50157123016730.m4a"},{"id":"ex.vocab.calm","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"calm","back":"(adjective) Not excited, angry, or nervous; peaceful and quiet.","example":{"text":"When I contemplate the sea, I feel calm.","source":{"kind":"tatoeba","sentenceId":22215,"author":"auxitt"}},"audio":"audio/7c8b503f0fed59f5.m4a"},{"id":"ex.vocab.cancel","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"cancel","back":"(verb) To decide that something planned will not happen.","example":{"text":"Can I cancel this ticket?","source":{"kind":"tatoeba","sentenceId":58172,"author":"CK"}},"audio":"audio/53f2da96bc802d64.m4a"},{"id":"ex.vocab.cancer","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"cancer","back":"(noun) A serious illness caused by cells in the body growing in an uncontrolled way.","example":{"text":"Many organizations raise money for research into cancer.","source":{"kind":"generated"}},"audio":"audio/fb1c7f1037ad7e73.m4a"},{"id":"ex.vocab.capital","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"capital","back":"(noun) The most important city in a country or region, where the government is.","example":{"text":"The capital of the Ukraine is Kiev.","source":{"kind":"tatoeba","sentenceId":660368,"author":"shekitten"}},"audio":"audio/21e61842506788d0.m4a"},{"id":"ex.vocab.capture","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"capture","back":"(verb) To catch a person or animal, especially in a war or by force.","example":{"text":"He was captured and held for trial.","source":{"kind":"tatoeba","sentenceId":803095,"author":"Source_VOA"}},"audio":"audio/7b9370a2387db50c.m4a"},{"id":"ex.vocab.career","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"career","back":"(noun) The series of jobs that a person has in a particular area of work.","example":{"text":"Mary wants both a career and a family.","source":{"kind":"tatoeba","sentenceId":2025922,"author":"CK"}},"audio":"audio/f6bd8d61f2c6c1a5.m4a"},{"id":"ex.vocab.careless","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"careless","back":"(adjective) Not paying enough attention to what you are doing, often causing mistakes.","example":{"text":"The car crashed because the driver was careless.","source":{"kind":"tatoeba","sentenceId":26600,"author":"CK"}},"audio":"audio/77625fae2ee029df.m4a"},{"id":"ex.vocab.cause","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"cause","back":"(noun) The reason why something happens, especially something bad.","example":{"text":"We must make a close analysis of the causes of the accident.","source":{"kind":"tatoeba","sentenceId":22941,"author":"CK"}},"audio":"audio/1dcbb8663689c2f1.m4a"},{"id":"ex.vocab.cave","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"cave","back":"(noun) A large natural hole in the side of a cliff or mountain, or underground.","example":{"text":"Tom came out of the cave.","source":{"kind":"tatoeba","sentenceId":2956202,"author":"CK"}},"audio":"audio/f593b2596be36459.m4a"},{"id":"ex.vocab.cell","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"cell","back":"(noun) A small room, often in a prison, or a small device for mobile communication.","example":{"text":"Tom answered his cell phone.","source":{"kind":"tatoeba","sentenceId":2543424,"author":"CK"}},"audio":"audio/2a606d4906ffc39f.m4a"},{"id":"ex.vocab.century","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"century","back":"(noun) A period of one hundred years.","example":{"text":"My grandparents were born in the last century.","source":{"kind":"tatoeba","sentenceId":3436403,"author":"patgfisher"}},"audio":"audio/28c6f527a8681ace.m4a"},{"id":"ex.vocab.certain","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"certain","back":"(adjective) Knowing something is true without any doubt; sure.","example":{"text":"Please make certain your seat belt is fastened.","source":{"kind":"tatoeba","sentenceId":19168,"author":"CK"}},"audio":"audio/0917fea6e141363f.m4a"},{"id":"ex.vocab.certainly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"certainly","back":"(adverb) Without a doubt; definitely.","example":{"text":"She is certainly over forty.","source":{"kind":"tatoeba","sentenceId":579771,"author":"CK"}},"audio":"audio/6966ead22a5f552f.m4a"},{"id":"ex.vocab.chain","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"chain","back":"(noun) A series of connected metal rings, or a group of stores or hotels owned by one company.","example":{"text":"Aldi is a German discount supermarket chain.","source":{"kind":"tatoeba","sentenceId":4442247,"author":"Hybrid"}},"audio":"audio/98d574f3452e8e57.m4a"},{"id":"ex.vocab.challenge","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"challenge","back":"(noun) A new or difficult task that tests your abilities.","example":{"text":"Tom is facing a challenge.","source":{"kind":"tatoeba","sentenceId":680925,"author":"Source_VOA"}},"audio":"audio/71609f0ee68ae704.m4a"},{"id":"ex.vocab.chance","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"chance","back":"(noun) A possibility or opportunity to do something.","example":{"text":"You have a good chance to get well.","source":{"kind":"tatoeba","sentenceId":16341,"author":"Zifre"}},"audio":"audio/c9a77bd48d8b9a2c.m4a"},{"id":"ex.vocab.channel","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"channel","back":"(noun) A television station; a narrow passage of water.","example":{"text":"Can I change the channel?","source":{"kind":"tatoeba","sentenceId":40189,"author":"CK"}},"audio":"audio/2914a48251d10d25.m4a"},{"id":"ex.vocab.character","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"character","back":"(noun) The qualities that make a person or thing different from others.","example":{"text":"Which of your parents do you take after in character?","source":{"kind":"tatoeba","sentenceId":17028,"author":"Zifre"}},"audio":"audio/4a6d4a00d81eb05b.m4a"},{"id":"ex.vocab.charge","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"charge","back":"(verb) To ask someone to pay a particular amount of money for something.","example":{"text":"The restaurant will charge you for extra bread.","source":{"kind":"generated"}},"audio":"audio/6f3d86d762149c07.m4a"},{"id":"ex.vocab.chase","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"chase","back":"(verb) To run after someone or something in order to catch them.","example":{"text":"My dog likes chasing squirrels.","source":{"kind":"tatoeba","sentenceId":2517279,"author":"Hybrid"}},"audio":"audio/35b445240f8d6b38.m4a"},{"id":"ex.vocab.cheat","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"cheat","back":"(verb) To act dishonestly to gain an advantage, often in a game, test, or relationship.","example":{"text":"We all consider it wrong to cheat in an examination.","source":{"kind":"tatoeba","sentenceId":263432,"author":"sundown"}},"audio":"audio/8d5e0a38ee79a7b2.m4a"},{"id":"ex.vocab.cheer","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"cheer","back":"(verb) To shout loudly to show support, approval, or happiness.","example":{"text":"The crowd cheered when he appeared.","source":{"kind":"tatoeba","sentenceId":284040,"author":"CK"}},"audio":"audio/358159b345947bdc.m4a"},{"id":"ex.vocab.childhood","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"childhood","back":"(noun) The period of a person's life when they are a child.","example":{"text":"I had a happy childhood.","source":{"kind":"tatoeba","sentenceId":257385,"author":"CK"}},"audio":"audio/5a1b9f8a38033654.m4a"},{"id":"ex.vocab.chop","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"chop","back":"(verb) To cut something into small pieces with a sharp tool.","example":{"text":"I like to chop wood.","source":{"kind":"tatoeba","sentenceId":1762362,"author":"Amastan"}},"audio":"audio/b2de688e02109277.m4a"},{"id":"ex.vocab.cigarette","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"cigarette","back":"(noun) A small roll of tobacco wrapped in paper that people smoke.","example":{"text":"He lit a cigarette after dinner.","source":{"kind":"generated"}},"audio":"audio/d5e355921e874f0c.m4a"},{"id":"ex.vocab.citizen","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"citizen","back":"(noun) A person who legally belongs to a particular country and has rights and duties there.","example":{"text":"He's a citizen of China.","source":{"kind":"tatoeba","sentenceId":680510,"author":"Source_VOA"}},"audio":"audio/298dadf8bee4d20f.m4a"},{"id":"ex.vocab.claim","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"claim","back":"(verb) To say that something is true, even if you cannot prove it.","example":{"text":"He claims that he is a painter.","source":{"kind":"tatoeba","sentenceId":288920,"author":"CK"}},"audio":"audio/9c61640acf92401d.m4a"},{"id":"ex.vocab.clearly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"clearly","back":"(adverb) In a way that is easy to see, hear, or understand.","example":{"text":"Oh, I can hear you clearly.","source":{"kind":"tatoeba","sentenceId":67442,"author":"Lumi_alt"}},"audio":"audio/556512d5bd72452c.m4a"},{"id":"ex.vocab.climate","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"climate","back":"(noun) The usual weather conditions in a particular place over a long period.","example":{"text":"The climate here is mild.","source":{"kind":"tatoeba","sentenceId":61699,"author":"CK"}},"audio":"audio/520f578fc1c2e120.m4a"},{"id":"ex.vocab.closet","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"closet","back":"(noun) A small room or space, usually with a door, used for storing clothes or other things.","example":{"text":"Tom took his coat out of the closet and put it on.","source":{"kind":"tatoeba","sentenceId":2741283,"author":"CK"}},"audio":"audio/78c6e02442a9bc6e.m4a"},{"id":"ex.vocab.coach","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"coach","back":"(noun) A person who trains a sports team or athlete, or teaches a skill.","example":{"text":"Tom Jackson is one of the coaches on my soccer team.","source":{"kind":"tatoeba","sentenceId":3734423,"author":"CK"}},"audio":"audio/5eaffffe4262de61.m4a"},{"id":"ex.vocab.collection","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"collection","back":"(noun) A group of similar things that someone has gathered, often as a hobby.","example":{"text":"Tom showed me his collection of old coins.","source":{"kind":"tatoeba","sentenceId":3735943,"author":"CK"}},"audio":"audio/54119fd70131f8bf.m4a"},{"id":"ex.vocab.college","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"college","back":"(noun) A place of higher education where students study after high school.","example":{"text":"Do you go to college?","source":{"kind":"tatoeba","sentenceId":69120,"author":"CK"}},"audio":"audio/bd05686ee9bf2b17.m4a"},{"id":"ex.vocab.comfort","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"comfort","back":"(noun) A state of physical ease and freedom from pain, or a feeling of being less sad.","example":{"text":"My uncle now lives in comfort.","source":{"kind":"tatoeba","sentenceId":65065,"author":"CK"}},"audio":"audio/fec561da16434b7b.m4a"},{"id":"ex.vocab.comfortable","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"comfortable","back":"(adjective) Feeling relaxed and at ease, or providing a pleasant physical feeling.","example":{"text":"The hotel where we stayed was very comfortable.","source":{"kind":"tatoeba","sentenceId":247277,"author":"CK"}},"audio":"audio/f2397fb6ae6194d4.m4a"},{"id":"ex.vocab.comic","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"comic","back":"(adjective) Causing laughter; funny.","example":{"text":"The play was very comic and made everyone laugh.","source":{"kind":"generated"}},"audio":"audio/19e513a81d7ffe19.m4a"},{"id":"ex.vocab.comment","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"comment","back":"(noun) A spoken or written opinion or remark about something.","example":{"text":"There are no comments yet.","source":{"kind":"tatoeba","sentenceId":388349,"author":"CK"}},"audio":"audio/9510290d91fe683f.m4a"},{"id":"ex.vocab.common","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"common","back":"(adjective) Happening often or existing in many places; shared by many people.","example":{"text":"Is that a common name?","source":{"kind":"tatoeba","sentenceId":42798,"author":"CK"}},"audio":"audio/5c9d41be229d8714.m4a"},{"id":"ex.vocab.communicate","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"communicate","back":"(verb) To share information, ideas, or feelings with others, for example by speaking or writing.","example":{"text":"Languages enable us to communicate with other people.","source":{"kind":"tatoeba","sentenceId":239732,"author":"CM"}},"audio":"audio/cd775b5361dcd303.m4a"},{"id":"ex.vocab.community","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"community","back":"(noun) A group of people living in the same place or having a particular characteristic in common.","example":{"text":"The flood caused a disaster in their community.","source":{"kind":"tatoeba","sentenceId":680704,"author":"Source_VOA"}},"audio":"audio/7ae1b46044759618.m4a"},{"id":"ex.vocab.company","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"company","back":"(noun) A business organization that makes or sells goods or services.","example":{"text":"I work for a shipping company.","source":{"kind":"tatoeba","sentenceId":22213,"author":"CK"}},"audio":"audio/837e2e6171b60c80.m4a"},{"id":"ex.vocab.compare","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"compare","back":"(verb) To look at two or more things to see how they are similar or different.","example":{"text":"I compared my car with his.","source":{"kind":"tatoeba","sentenceId":258294,"author":"CK"}},"audio":"audio/50ac53fdc6ed39ed.m4a"},{"id":"ex.vocab.competition","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"competition","back":"(noun) A situation where people or groups try to be more successful than others.","example":{"text":"There's a lot of competition in business.","source":{"kind":"tatoeba","sentenceId":2268716,"author":"_undertoad"}},"audio":"audio/c185b5b73bd1d916.m4a"},{"id":"ex.vocab.complain","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"complain","back":"(verb) To say that you are not happy or satisfied with something or someone.","example":{"text":"We complained about the poor service.","source":{"kind":"tatoeba","sentenceId":54199,"author":"CK"}},"audio":"audio/5128b98c6def93a2.m4a"},{"id":"ex.vocab.complaint","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"complaint","back":"(noun) A statement that you are unhappy or not satisfied with something.","example":{"text":"Do you have any complaints?","source":{"kind":"tatoeba","sentenceId":913912,"author":"CK"}},"audio":"audio/d96e04916e034b10.m4a"},{"id":"ex.vocab.completely","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"completely","back":"(adverb) In every way; totally.","example":{"text":"This area has changed completely.","source":{"kind":"tatoeba","sentenceId":61359,"author":"CK"}},"audio":"audio/e5f5e1b6fca8105f.m4a"},{"id":"ex.vocab.concentrate","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"concentrate","back":"(verb) To give all your attention to one thing and not think about other things.","example":{"text":"I can't concentrate on my work because of the noise.","source":{"kind":"tatoeba","sentenceId":244948,"author":"CK"}},"audio":"audio/aa8a38f3e2354a37.m4a"},{"id":"ex.vocab.condition","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"condition","back":"(noun) The state that something or someone is in.","example":{"text":"Environmental pollution is causing abnormal weather conditions.","source":{"kind":"tatoeba","sentenceId":21016,"author":"CK"}},"audio":"audio/0eb87973bd707725.m4a"},{"id":"ex.vocab.conference","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"conference","back":"(noun) A formal meeting where people discuss a particular topic.","example":{"text":"The conference ended at five.","source":{"kind":"tatoeba","sentenceId":478193,"author":"CK"}},"audio":"audio/e3d423129951f081.m4a"},{"id":"ex.vocab.confidence","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"confidence","back":"(noun) A feeling of belief in yourself or in someone else's ability.","example":{"text":"I have complete confidence in Tom and his abilities.","source":{"kind":"tatoeba","sentenceId":2361598,"author":"CK"}},"audio":"audio/9fc81b8830631ebf.m4a"},{"id":"ex.vocab.confirm","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"confirm","back":"(verb) To state that something is true or correct, or to make an arrangement definite.","example":{"text":"The spokesman confirmed that the report was true.","source":{"kind":"tatoeba","sentenceId":51648,"author":"CM"}},"audio":"audio/44e9221ca09bf915.m4a"},{"id":"ex.vocab.confused","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"confused","back":"(adjective) Unable to think clearly or understand what is happening.","example":{"text":"I think Tom is confused.","source":{"kind":"tatoeba","sentenceId":2408258,"author":"CK"}},"audio":"audio/f34bbd1d1ecf6b28.m4a"},{"id":"ex.vocab.consider","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"consider","back":"(verb) To think carefully about something, especially before making a decision.","example":{"text":"The plan is worth considering.","source":{"kind":"tatoeba","sentenceId":48525,"author":"CK"}},"audio":"audio/e12bb552f0c7ea95.m4a"},{"id":"ex.vocab.contact","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"contact","back":"(noun) The state of touching or communicating with someone or something.","example":{"text":"We were unable to make contact with them until it was too late.","source":{"kind":"tatoeba","sentenceId":23498,"author":"CK"}},"audio":"audio/f3ea13c08c90dd5c.m4a"},{"id":"ex.vocab.contain","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"contain","back":"(verb) To have something inside; to hold or include something.","example":{"text":"Carrots contain a lot of vitamin A.","source":{"kind":"tatoeba","sentenceId":270365,"author":"CK"}},"audio":"audio/9c5917f35a094f99.m4a"},{"id":"ex.vocab.content","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"content","back":"(adjective) Feeling pleased and satisfied with what you have or are doing.","example":{"text":"He is content with his life as a baseball player.","source":{"kind":"tatoeba","sentenceId":304271,"author":"CM"}},"audio":"audio/a1bcba59fa15b9bb.m4a"},{"id":"ex.vocab.contest","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"contest","back":"(noun) A competition in which people try to win something by being the best.","example":{"text":"I had the fortune to win the first prize in the speech contest.","source":{"kind":"tatoeba","sentenceId":257372,"author":"CM"}},"audio":"audio/b6712a4b84dbfc56.m4a"},{"id":"ex.vocab.control","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"control","back":"(noun) The power to make decisions about something or someone, or to make something happen.","example":{"text":"His company is under his control.","source":{"kind":"tatoeba","sentenceId":285759,"author":"CM"}},"audio":"audio/a3a517c389841d40.m4a"},{"id":"ex.vocab.convince","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"convince","back":"(verb) To make someone believe that something is true, or to persuade them to do something.","example":{"text":"I could not convince him of his mistake.","source":{"kind":"tatoeba","sentenceId":28943,"author":"CM"}},"audio":"audio/5cfefd639628b8db.m4a"},{"id":"ex.vocab.cop","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"cop","back":"(noun) An informal word for a police officer.","example":{"text":"Tom could be a cop.","source":{"kind":"tatoeba","sentenceId":1868410,"author":"CK"}},"audio":"audio/aae2665a49182742.m4a"},{"id":"ex.vocab.correctly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"correctly","back":"(adverb) In a way that is right or accurate.","example":{"text":"Am I pronouncing your name correctly?","source":{"kind":"tatoeba","sentenceId":3424129,"author":"CK"}},"audio":"audio/8bce9fb71bca6080.m4a"},{"id":"ex.vocab.costume","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"costume","back":"(noun) A set of clothes worn by an actor or for a special event like Halloween.","example":{"text":"Tom was wearing a Superman costume.","source":{"kind":"tatoeba","sentenceId":3722948,"author":"CM"}},"audio":"audio/c47cfd29fdd3e6c5.m4a"},{"id":"ex.vocab.counter","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"counter","back":"(noun) A long, flat surface in a shop, kitchen, or bank where you serve customers or prepare food.","example":{"text":"Tom walked up to the counter and ordered a drink.","source":{"kind":"tatoeba","sentenceId":3157887,"author":"CK"}},"audio":"audio/0529938093a8c8aa.m4a"},{"id":"ex.vocab.court","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"court","back":"(noun) An area where legal cases are heard, or a place for playing sports.","example":{"text":"Let's take it to court.","source":{"kind":"tatoeba","sentenceId":244211,"author":"CM"}},"audio":"audio/b81e0fea6f284f7c.m4a"},{"id":"ex.vocab.crack","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"crack","back":"(verb) To break something so that lines appear on its surface, but it does not separate completely.","example":{"text":"He cracked the walnut with his teeth.","source":{"kind":"tatoeba","sentenceId":2054011,"author":"AlanF_US"}},"audio":"audio/8120df6c1d7beaca.m4a"},{"id":"ex.vocab.crash","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"crash","back":"(verb) To hit something hard, often causing damage or a loud noise.","example":{"text":"The bridge crashed under the pressure.","source":{"kind":"tatoeba","sentenceId":18997,"author":"jmfcomo"}},"audio":"audio/785b0ddab9733958.m4a"},{"id":"ex.vocab.crawl","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"crawl","back":"(verb) To move forward on your hands and knees, or with your body close to the ground.","example":{"text":"Babies crawl before they walk.","source":{"kind":"tatoeba","sentenceId":272408,"author":"CK"}},"audio":"audio/2383e4fe21ad5e44.m4a"},{"id":"ex.vocab.create","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"create","back":"(verb) To make something new exist or happen.","example":{"text":"We don't want to create any new problems.","source":{"kind":"tatoeba","sentenceId":2026968,"author":"CK"}},"audio":"audio/05357b0e7a5866c1.m4a"},{"id":"ex.vocab.creative","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"creative","back":"(adjective) Having the ability to make new things or think of new ideas.","example":{"text":"Tom is a very creative guy.","source":{"kind":"tatoeba","sentenceId":4015662,"author":"CK"}},"audio":"audio/ccd94bb9917bfd3a.m4a"},{"id":"ex.vocab.creature","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"creature","back":"(noun) Any living thing that is not a plant, especially an animal.","example":{"text":"No creature can live without air.","source":{"kind":"tatoeba","sentenceId":3672869,"author":"luci"}},"audio":"audio/0c1c3a43a2160e1e.m4a"},{"id":"ex.vocab.credit","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"credit","back":"(noun) Money that a bank or business allows you to use, or praise for doing something good.","example":{"text":"Can I pay on credit?","source":{"kind":"tatoeba","sentenceId":62762,"author":"CK"}},"audio":"audio/59ed7e2b61ad4188.m4a"},{"id":"ex.vocab.crime","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"crime","back":"(noun) An illegal act that can be punished by law.","example":{"text":"He must pay for his crimes.","source":{"kind":"tatoeba","sentenceId":3106111,"author":"Hybrid"}},"audio":"audio/2510c25f98c13113.m4a"},{"id":"ex.vocab.crowd","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"crowd","back":"(noun) A large group of people gathered together in one place.","example":{"text":"I managed to get out of the crowd.","source":{"kind":"tatoeba","sentenceId":36039,"author":"CM"}},"audio":"audio/19234c3c8a8a34f2.m4a"},{"id":"ex.vocab.culture","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"culture","back":"(noun) The customs, arts, social institutions, and achievements of a particular nation or group.","example":{"text":"I learned about Greek culture.","source":{"kind":"tatoeba","sentenceId":63102,"author":"CK"}},"audio":"audio/72ecef8ad5f6ee93.m4a"},{"id":"ex.vocab.curious","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"curious","back":"(adjective) Wanting to know or learn about something.","example":{"text":"She is always curious about what I am doing.","source":{"kind":"tatoeba","sentenceId":312464,"author":"CK"}},"audio":"audio/6b40110f09692114.m4a"},{"id":"ex.vocab.current","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"current","back":"(adjective) Happening or existing now; belonging to the present time.","example":{"text":"Tom, how is the current situation?","source":{"kind":"tatoeba","sentenceId":5289493,"author":"SnowyDoll"}},"audio":"audio/e612a9b4a9ac4209.m4a"},{"id":"ex.vocab.currently","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"currently","back":"(adverb) At the present time; now.","example":{"text":"She is currently in danger.","source":{"kind":"tatoeba","sentenceId":895784,"author":"pauldhunt"}},"audio":"audio/e06575f2cf86baa5.m4a"},{"id":"ex.vocab.cycle","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"cycle","back":"(noun) A series of events that happen again and again in the same order.","example":{"text":"This cycle of suspicion and discord must end.","source":{"kind":"tatoeba","sentenceId":376865,"author":"saeb"}},"audio":"audio/e8564d0ce98ddedb.m4a"},{"id":"ex.vocab.damage","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"damage","back":"(noun) Physical harm that makes something less valuable or useful.","example":{"text":"I paid for the damage.","source":{"kind":"tatoeba","sentenceId":259253,"author":"CK"}},"audio":"audio/b2f55f02a119fa17.m4a"},{"id":"ex.vocab.data","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"data","back":"(noun) Facts or information, especially when collected and used to understand something.","example":{"text":"The scientists analyzed the data.","source":{"kind":"tatoeba","sentenceId":3295376,"author":"Hybrid"}},"audio":"audio/1605f55b2c73c80b.m4a"},{"id":"ex.vocab.deal","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"deal","back":"(noun) A business agreement or arrangement.","example":{"text":"They made a good deal on the new car.","source":{"kind":"generated"}},"audio":"audio/7f15920b6b3a07d2.m4a"},{"id":"ex.vocab.dear","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"dear","back":"(adjective) Loved or liked very much.","example":{"text":"His daughter is very dear to him.","source":{"kind":"tatoeba","sentenceId":284925,"author":"Lumi"}},"audio":"audio/ff810b71a0ed824f.m4a"},{"id":"ex.vocab.death","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"death","back":"(noun) The end of life for a person, animal, or plant.","example":{"text":"The number of deaths is increasing.","source":{"kind":"tatoeba","sentenceId":8637198,"author":"Hybrid"}},"audio":"audio/474059db67377488.m4a"},{"id":"ex.vocab.decision","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"decision","back":"(noun) A choice or judgment that you make after thinking about something.","example":{"text":"You made a good decision.","source":{"kind":"tatoeba","sentenceId":42790,"author":"CK"}},"audio":"audio/750127cdadf03a65.m4a"},{"id":"ex.vocab.decorate","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"decorate","back":"(verb) To make something look more attractive by adding things to it.","example":{"text":"Mary helped her mother decorate the Christmas tree.","source":{"kind":"tatoeba","sentenceId":3711912,"author":"Hybrid"}},"audio":"audio/a9270327240f308e.m4a"},{"id":"ex.vocab.deeply","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"deeply","back":"(adverb) Very much, or far down below the surface.","example":{"text":"I was deeply touched by the story.","source":{"kind":"tatoeba","sentenceId":254634,"author":"CK"}},"audio":"audio/ec0e02d0a957b09e.m4a"},{"id":"ex.vocab.defend","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"defend","back":"(verb) To protect someone or something from attack or harm.","example":{"text":"I had to defend myself.","source":{"kind":"tatoeba","sentenceId":2331773,"author":"CK"}},"audio":"audio/b03dad21acfe02a7.m4a"},{"id":"ex.vocab.definitely","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"definitely","back":"(adverb) In a way that is certain or without any doubt.","example":{"text":"If you don't study harder, you'll definitely fail.","source":{"kind":"tatoeba","sentenceId":832083,"author":"CK"}},"audio":"audio/6c996258d7dd2a30.m4a"},{"id":"ex.vocab.degree","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"degree","back":"(noun) A qualification given by a university after a student finishes a course of study.","example":{"text":"He has a doctor's degree in psychology.","source":{"kind":"tatoeba","sentenceId":299850,"author":"CK"}},"audio":"audio/9159b4b6a7688a86.m4a"},{"id":"ex.vocab.delay","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"delay","back":"(noun) A situation in which something happens later than planned or expected.","example":{"text":"After several delays, the plane finally left.","source":{"kind":"tatoeba","sentenceId":24488,"author":"CK"}},"audio":"audio/9d1e59492c0e6d8f.m4a"},{"id":"ex.vocab.delete","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"delete","back":"(verb) To remove something, especially written words or computer data.","example":{"text":"Tom deleted all the pictures from his phone.","source":{"kind":"tatoeba","sentenceId":6240516,"author":"CK"}},"audio":"audio/1982d299abe1a6cf.m4a"},{"id":"ex.vocab.deliver","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"deliver","back":"(verb) To take goods, letters, or messages to a person or place.","example":{"text":"Letters are delivered here about noon.","source":{"kind":"tatoeba","sentenceId":61601,"author":"CK"}},"audio":"audio/63fe382594d4929e.m4a"},{"id":"ex.vocab.demand","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"demand","back":"(verb) To ask for something very firmly, expecting to get it.","example":{"text":"The policeman demanded their names and addresses.","source":{"kind":"tatoeba","sentenceId":238091,"author":"CM"}},"audio":"audio/07dbde393e1c52e4.m4a"},{"id":"ex.vocab.department","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"department","back":"(noun) A section of a large organization, such as a government, business, or store.","example":{"text":"He's in charge of the sales department.","source":{"kind":"tatoeba","sentenceId":284101,"author":"CK"}},"audio":"audio/41328c23ebcace1a.m4a"},{"id":"ex.vocab.depend","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"depend","back":"(verb) To need someone or something in order to live or succeed, or to be controlled by something.","example":{"text":"It depends on the context.","source":{"kind":"tatoeba","sentenceId":1333,"author":"CK"}},"audio":"audio/38a789fb8ed9a62e.m4a"},{"id":"ex.vocab.design","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"design","back":"(noun) A plan or drawing that shows how something will be made or how it works.","example":{"text":"She's studying French and web design.","source":{"kind":"tatoeba","sentenceId":961601,"author":"CK"}},"audio":"audio/fc3984a9b3cdb221.m4a"},{"id":"ex.vocab.destroy","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"destroy","back":"(verb) To damage something so badly that it no longer exists or cannot be used.","example":{"text":"The white building was destroyed by the earthquake.","source":{"kind":"tatoeba","sentenceId":67862,"author":"CM"}},"audio":"audio/96072bb5530920d7.m4a"},{"id":"ex.vocab.detail","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"detail","back":"(noun) A small, specific fact or piece of information.","example":{"text":"Let me know the details.","source":{"kind":"tatoeba","sentenceId":268239,"author":"CK"}},"audio":"audio/110d5579a72043d1.m4a"},{"id":"ex.vocab.detective","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"detective","back":"(noun) A person, often a police officer, whose job is to investigate crimes and find criminals.","example":{"text":"She hired a private detective to inquire into the case.","source":{"kind":"tatoeba","sentenceId":311265,"author":"CK"}},"audio":"audio/f29f57da089df30b.m4a"},{"id":"ex.vocab.develop","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"develop","back":"(verb) To grow or change into something bigger, stronger, or more advanced.","example":{"text":"Education aims to develop potential abilities.","source":{"kind":"tatoeba","sentenceId":19115,"author":"CK"}},"audio":"audio/4e5074faee0444eb.m4a"},{"id":"ex.vocab.development","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"development","back":"(noun) The process of growing, changing, or becoming more advanced.","example":{"text":"Recent developments caused them to change their travel plans.","source":{"kind":"tatoeba","sentenceId":681862,"author":"Source_VOA"}},"audio":"audio/ccca14b4c0dea10c.m4a"},{"id":"ex.vocab.diamond","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"diamond","back":"(noun) A very hard, clear, and valuable stone, often used in jewelry.","example":{"text":"Tom put a diamond ring on Mary's finger.","source":{"kind":"tatoeba","sentenceId":1028164,"author":"CK"}},"audio":"audio/5a61598ebca8aef0.m4a"},{"id":"ex.vocab.diet","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"diet","back":"(noun) The food and drink a person usually eats, or a special plan of eating.","example":{"text":"She is on a diet.","source":{"kind":"tatoeba","sentenceId":315104,"author":"CK"}},"audio":"audio/a0cd3b95240adabc.m4a"},{"id":"ex.vocab.difficulty","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"difficulty","back":"(noun) A problem or something that is not easy to do or understand.","example":{"text":"I had no difficulty finding your house.","source":{"kind":"tatoeba","sentenceId":70793,"author":"CK"}},"audio":"audio/5393382cf15b44af.m4a"},{"id":"ex.vocab.direct","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"direct","back":"(adjective) Going straight from one place to another without stopping or changing direction.","example":{"text":"Is it a direct flight?","source":{"kind":"tatoeba","sentenceId":42219,"author":"CK"}},"audio":"audio/b82c9642b02d9ed5.m4a"},{"id":"ex.vocab.disagree","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"disagree","back":"(verb) To have a different opinion from someone else.","example":{"text":"Many people disagreed with the judge's decision.","source":{"kind":"tatoeba","sentenceId":681265,"author":"Source_VOA"}},"audio":"audio/e04b6579210587dd.m4a"},{"id":"ex.vocab.disappointed","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"disappointed","back":"(adjective) Unhappy because something you hoped for did not happen, or someone was not as good as you expected.","example":{"text":"I was disappointed in her.","source":{"kind":"tatoeba","sentenceId":261190,"author":"CK"}},"audio":"audio/58b0b635af3b4029.m4a"},{"id":"ex.vocab.discuss","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"discuss","back":"(verb) To talk about something with another person or a group to share ideas or make a decision.","example":{"text":"We discussed the matter with each other.","source":{"kind":"tatoeba","sentenceId":28802,"author":"CK"}},"audio":"audio/5117a1c0524323de.m4a"},{"id":"ex.vocab.discussion","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"discussion","back":"(noun) The process of talking about something with other people, often to make a decision.","example":{"text":"They entered into a discussion about the issue.","source":{"kind":"tatoeba","sentenceId":305857,"author":"CM"}},"audio":"audio/5171c116f236fcc0.m4a"},{"id":"ex.vocab.distance","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"distance","back":"(noun) The amount of space between two places or things.","example":{"text":"I saw land in the distance.","source":{"kind":"tatoeba","sentenceId":25821,"author":"CK"}},"audio":"audio/3fc402a472f1ad44.m4a"},{"id":"ex.vocab.disturb","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"disturb","back":"(verb) To interrupt someone or something, or to make someone worried.","example":{"text":"I'm sorry to have disturbed you.","source":{"kind":"tatoeba","sentenceId":53056,"author":"CK"}},"audio":"audio/4dc19f54794f81e9.m4a"},{"id":"ex.vocab.dive","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"dive","back":"(verb) To jump into water head first, or to go quickly downwards.","example":{"text":"Mayuko dived into the cold water.","source":{"kind":"tatoeba","sentenceId":32365,"author":"Dejo"}},"audio":"audio/698c54a82416f172.m4a"},{"id":"ex.vocab.divide","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"divide","back":"(verb) To separate something into smaller parts or groups.","example":{"text":"The exam was divided into two parts.","source":{"kind":"tatoeba","sentenceId":47306,"author":"CK"}},"audio":"audio/573aabcc351a0faa.m4a"},{"id":"ex.vocab.divorce","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"divorce","back":"(noun) The legal ending of a marriage.","example":{"text":"Their divorce was finalized last month.","source":{"kind":"generated"}},"audio":"audio/23085fa6b9b8c66f.m4a"},{"id":"ex.vocab.document","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"document","back":"(noun) An official paper or file that gives information or proof.","example":{"text":"We checked the document again.","source":{"kind":"tatoeba","sentenceId":46658,"author":"CK"}},"audio":"audio/813f254b3de70f21.m4a"},{"id":"ex.vocab.donate","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"donate","back":"(verb) To give money, goods, or time to a charity or organization.","example":{"text":"How much money did Tom donate to charity last year?","source":{"kind":"tatoeba","sentenceId":2911965,"author":"CK"}},"audio":"audio/44165e9b44d4ab5c.m4a"},{"id":"ex.vocab.double","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"double","back":"(adjective) Twice as much or as many; having two parts or two times the usual amount.","example":{"text":"I'd like a double room.","source":{"kind":"tatoeba","sentenceId":40600,"author":"CK"}},"audio":"audio/cc33f67ca90ac434.m4a"},{"id":"ex.vocab.drag","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"drag","back":"(verb) To pull something heavy along the ground.","example":{"text":"I'm not going to drag their luggage around.","source":{"kind":"tatoeba","sentenceId":2510187,"author":"AlanF_US"}},"audio":"audio/b641a08624afef1d.m4a"},{"id":"ex.vocab.drug","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"drug","back":"(noun) A medicine or other substance that affects the body or mind.","example":{"text":"The doctor prescribed a new drug for her cough.","source":{"kind":"generated"}},"audio":"audio/c92e70751dac9520.m4a"},{"id":"ex.vocab.drunk","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"drunk","back":"(adjective) Having consumed too much alcohol, making one unable to think or act normally.","example":{"text":"He felt dizzy and lightheaded, as if he were drunk.","source":{"kind":"generated"}},"audio":"audio/70481328b634d289.m4a"},{"id":"ex.vocab.due","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"due","back":"(adjective) Expected to happen or arrive at a certain time, or owed as a payment.","example":{"text":"Payment of this bill is due today.","source":{"kind":"tatoeba","sentenceId":58221,"author":"sundown"}},"audio":"audio/962d9d8ae29cd6fb.m4a"},{"id":"ex.vocab.dust","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"dust","back":"(noun) Dry powder made of very small pieces of dirt or other matter.","example":{"text":"The floor was covered with dust.","source":{"kind":"tatoeba","sentenceId":268093,"author":"CK"}},"audio":"audio/f91620500b15c82e.m4a"},{"id":"ex.vocab.earn","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"earn","back":"(verb) To get money by working, or to get something because you deserve it.","example":{"text":"He earns a great deal.","source":{"kind":"tatoeba","sentenceId":289396,"author":"CK"}},"audio":"audio/f30f74ed6ac8e34f.m4a"},{"id":"ex.vocab.earthquake","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"earthquake","back":"(noun) A sudden violent shaking of the ground, often causing great destruction.","example":{"text":"The earthquake shook the houses.","source":{"kind":"tatoeba","sentenceId":45136,"author":"CK"}},"audio":"audio/e97eb7ccf64943b1.m4a"},{"id":"ex.vocab.edge","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"edge","back":"(noun) The part of an object or area that is furthest from its center.","example":{"text":"They camped at the water's edge.","source":{"kind":"tatoeba","sentenceId":306944,"author":"CK"}},"audio":"audio/17899227db9853b4.m4a"},{"id":"ex.vocab.education","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"education","back":"(noun) The process of teaching or learning, usually at a school or university.","example":{"text":"The government has been reforming education.","source":{"kind":"tatoeba","sentenceId":271461,"author":"CK"}},"audio":"audio/7831a2ad1b278409.m4a"},{"id":"ex.vocab.effect","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"effect","back":"(noun) A change that happens because of something else; a result.","example":{"text":"That won't have an effect.","source":{"kind":"tatoeba","sentenceId":531887,"author":"CM"}},"audio":"audio/c0969a23a611e822.m4a"},{"id":"ex.vocab.effort","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"effort","back":"(noun) The physical or mental energy that you use to do something.","example":{"text":"With a little more effort.","source":{"kind":"tatoeba","sentenceId":31588,"author":"Mar1L"}},"audio":"audio/0bcf05bbf267a5fe.m4a"},{"id":"ex.vocab.either","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"either","back":"(determiner) One or the other of two things or people.","example":{"text":"Either Tom or I must go.","source":{"kind":"tatoeba","sentenceId":37412,"author":"CK"}},"audio":"audio/f613dc516595405f.m4a"},{"id":"ex.vocab.elect","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"elect","back":"(verb) To choose someone for a public office or position by voting.","example":{"text":"We elected him our leader.","source":{"kind":"tatoeba","sentenceId":249261,"author":"CS"}},"audio":"audio/f2fde6a0e55f8447.m4a"},{"id":"ex.vocab.electric","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"electric","back":"(adjective) Using or producing electricity.","example":{"text":"Where can I charge my electric car?","source":{"kind":"tatoeba","sentenceId":3123170,"author":"patgfisher"}},"audio":"audio/ce24200c2fbdb22e.m4a"},{"id":"ex.vocab.embarrassed","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"embarrassed","back":"(adjective) Feeling shy, awkward, or ashamed about something.","example":{"text":"I was embarrassed by what she said.","source":{"kind":"tatoeba","sentenceId":309263,"author":"CK"}},"audio":"audio/7823ffa04f5c6f11.m4a"},{"id":"ex.vocab.emergency","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"emergency","back":"(noun) A serious or dangerous situation that needs immediate action.","example":{"text":"I had a family emergency.","source":{"kind":"tatoeba","sentenceId":2331574,"author":"CK"}},"audio":"audio/87024e231eabec92.m4a"},{"id":"ex.vocab.employee","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"employee","back":"(noun) A person who is paid to work for someone else or for a company.","example":{"text":"He treats his employees well.","source":{"kind":"tatoeba","sentenceId":299342,"author":"CK"}},"audio":"audio/92aea22e4307b554.m4a"},{"id":"ex.vocab.encourage","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"encourage","back":"(verb) To give someone support, confidence, or hope to do something.","example":{"text":"Tom encouraged Mary to take ukulele lessons.","source":{"kind":"tatoeba","sentenceId":1028971,"author":"CK"}},"audio":"audio/415300deacc149b1.m4a"},{"id":"ex.vocab.enemy","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"enemy","back":"(noun) A person or group that hates and tries to harm another.","example":{"text":"I regard him as an enemy.","source":{"kind":"tatoeba","sentenceId":260969,"author":"CK"}},"audio":"audio/fcedb7e490ce3274.m4a"},{"id":"ex.vocab.energy","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"energy","back":"(noun) The ability to do work or be active; power from fuel or other sources.","example":{"text":"I spent all my energy on that project.","source":{"kind":"tatoeba","sentenceId":259142,"author":"CK"}},"audio":"audio/c9a19f4de4072cbd.m4a"},{"id":"ex.vocab.engineer","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"engineer","back":"(noun) A person who designs, builds, or maintains engines, machines, or structures.","example":{"text":"The engineer told us how to use the machine.","source":{"kind":"tatoeba","sentenceId":48755,"author":"CK"}},"audio":"audio/c9a4e098ac02acdb.m4a"},{"id":"ex.vocab.entire","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"entire","back":"(adjective) Including every part of something; whole.","example":{"text":"She wept the entire night.","source":{"kind":"tatoeba","sentenceId":453216,"author":"FeuDRenais"}},"audio":"audio/fa5a057d03e7ed38.m4a"},{"id":"ex.vocab.entrance","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"entrance","back":"(noun) A door or gate where you can enter a place, or the act of coming in.","example":{"text":"Please wait for me at the entrance of the building.","source":{"kind":"tatoeba","sentenceId":48320,"author":"CK"}},"audio":"audio/743616d5521dc77e.m4a"},{"id":"ex.vocab.environment","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"environment","back":"(noun) The natural world around us, or the conditions in which a person lives.","example":{"text":"The destruction of the rainforests affects our environment.","source":{"kind":"tatoeba","sentenceId":282137,"author":"Dejo"}},"audio":"audio/356b323a76317612.m4a"},{"id":"ex.vocab.error","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"error","back":"(noun) A mistake; something that is wrong or incorrect.","example":{"text":"This is a common error.","source":{"kind":"tatoeba","sentenceId":453131,"author":"CM"}},"audio":"audio/89434e347f57ac24.m4a"},{"id":"ex.vocab.escape","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"escape","back":"(verb) To get away from a place or a dangerous situation.","example":{"text":"Make sure that the dog does not escape.","source":{"kind":"tatoeba","sentenceId":48292,"author":"CK"}},"audio":"audio/40c694aee7f13806.m4a"},{"id":"ex.vocab.especially","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"especially","back":"(adverb) More than usual; more than other things or people.","example":{"text":"We liked the food, especially the fish.","source":{"kind":"tatoeba","sentenceId":2163202,"author":"Source_VOA"}},"audio":"audio/60059af22f8599fe.m4a"},{"id":"ex.vocab.evil","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"evil","back":"(adjective) Very bad and harmful, often morally wrong.","example":{"text":"He is an evil man.","source":{"kind":"tatoeba","sentenceId":303244,"author":"CK"}},"audio":"audio/31cfc0861079a384.m4a"},{"id":"ex.vocab.ex","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"ex","back":"(noun) A person who was formerly your husband, wife, boyfriend, or girlfriend.","example":{"text":"Tom is Mary's ex-husband.","source":{"kind":"tatoeba","sentenceId":1028545,"author":"CK"}},"audio":"audio/5debd89f8fd4bd1f.m4a"},{"id":"ex.vocab.exactly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"exactly","back":"(adverb) In an accurate or precise way; used to emphasize that something is correct.","example":{"text":"That's exactly what I want.","source":{"kind":"tatoeba","sentenceId":42708,"author":"CK"}},"audio":"audio/f670a39066cf1d6a.m4a"},{"id":"ex.vocab.examination","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"examination","back":"(noun) A formal test of knowledge or ability, or a careful look at something.","example":{"text":"We had an examination in biology yesterday.","source":{"kind":"tatoeba","sentenceId":63304,"author":"CK"}},"audio":"audio/ef9f955cf08f6d56.m4a"},{"id":"ex.vocab.examine","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"examine","back":"(verb) To look at something carefully, especially to find out if there is a problem.","example":{"text":"A doctor examined Mr. Brown.","source":{"kind":"tatoeba","sentenceId":805322,"author":"Source_VOA"}},"audio":"audio/25cb423fb5eb6b0d.m4a"},{"id":"ex.vocab.except","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"except","back":"(preposition) Not including; apart from.","example":{"text":"All will go except you.","source":{"kind":"tatoeba","sentenceId":237708,"author":"Dejo"}},"audio":"audio/c2d8607438f1aa57.m4a"},{"id":"ex.vocab.exchange","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"exchange","back":"(verb) To give something to someone and receive something else from them.","example":{"text":"May I exchange this shirt for a smaller size?","source":{"kind":"tatoeba","sentenceId":61026,"author":"CK"}},"audio":"audio/095be9be921d89fe.m4a"},{"id":"ex.vocab.excuse","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"excuse","back":"(noun) A reason you give to explain why you did something wrong or why you cannot do something.","example":{"text":"That is a fine excuse.","source":{"kind":"tatoeba","sentenceId":38403,"author":"TracyPoff"}},"audio":"audio/b4dcca5f10ea96f8.m4a"},{"id":"ex.vocab.exhausted","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"exhausted","back":"(adjective) Very tired.","example":{"text":"I was exhausted from work.","source":{"kind":"tatoeba","sentenceId":257900,"author":"CK"}},"audio":"audio/41ca5b01f3bc0ecb.m4a"},{"id":"ex.vocab.expect","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"expect","back":"(verb) To think that something will happen or that someone will arrive.","example":{"text":"Everything went better than I had expected.","source":{"kind":"tatoeba","sentenceId":24831,"author":"CK"}},"audio":"audio/0433dc7b8197f002.m4a"},{"id":"ex.vocab.experience","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"experience","back":"(noun) Knowledge or skill gained over time from doing or seeing things.","example":{"text":"You must make allowance for his lack of experience.","source":{"kind":"tatoeba","sentenceId":15820,"author":"Zifre"}},"audio":"audio/2cc6a5bd20b38ccd.m4a"},{"id":"ex.vocab.experiment","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"experiment","back":"(noun) A scientific test done to discover something or to prove a theory.","example":{"text":"Today we will carry out an experiment about Ohm's Law.","source":{"kind":"tatoeba","sentenceId":328625,"author":"fcbond"}},"audio":"audio/077708d67d923d94.m4a"},{"id":"ex.vocab.expert","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"expert","back":"(noun) A person who has a lot of special knowledge or skill in a particular area.","example":{"text":"He is something of an expert on oriental art.","source":{"kind":"tatoeba","sentenceId":301936,"author":"Zifre"}},"audio":"audio/98cb02477a95fc49.m4a"},{"id":"ex.vocab.explanation","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"explanation","back":"(noun) The reasons or details that make something clear or easy to understand.","example":{"text":"I need a concise explanation.","source":{"kind":"tatoeba","sentenceId":20964,"author":"CK"}},"audio":"audio/4a4cac8674a76309.m4a"},{"id":"ex.vocab.explore","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"explore","back":"(verb) To travel around a place to learn about it, or to think about an idea carefully.","example":{"text":"He explored the Amazon jungle.","source":{"kind":"tatoeba","sentenceId":288796,"author":"CK"}},"audio":"audio/af5ddbbac88e7e17.m4a"},{"id":"ex.vocab.express","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"express","back":"(verb) To show or say what you think or feel.","example":{"text":"Express yourself as clearly as you can.","source":{"kind":"tatoeba","sentenceId":39550,"author":"CM"}},"audio":"audio/52fbfece4265cb1a.m4a"},{"id":"ex.vocab.expression","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"expression","back":"(noun) A look on someone's face that shows their feelings; a word or phrase.","example":{"text":"She wore a sad expression.","source":{"kind":"tatoeba","sentenceId":316542,"author":"CM"}},"audio":"audio/9e509c45615c0d0a.m4a"},{"id":"ex.vocab.extremely","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"extremely","back":"(adverb) To a very great degree; very.","example":{"text":"So far, he has been extremely happy.","source":{"kind":"tatoeba","sentenceId":296524,"author":"CK"}},"audio":"audio/470f2c51cea15da0.m4a"},{"id":"ex.vocab.fact","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fact","back":"(noun) Something that is known to be true or to have happened.","example":{"text":"Tom is not a lazy boy. As a matter of fact, he works hard.","source":{"kind":"tatoeba","sentenceId":37066,"author":"CK"}},"audio":"audio/97bf1ed083163464.m4a"},{"id":"ex.vocab.failure","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"failure","back":"(noun) The state of not succeeding in doing something; a lack of success.","example":{"text":"The party was a failure.","source":{"kind":"tatoeba","sentenceId":35629,"author":"CK"}},"audio":"audio/6c6b03515411750d.m4a"},{"id":"ex.vocab.fair","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fair","back":"(adjective) Treating everyone equally and in a way that is right and reasonable.","example":{"text":"We want to be fair.","source":{"kind":"tatoeba","sentenceId":2042933,"author":"CK"}},"audio":"audio/f514773ebb4e0c87.m4a"},{"id":"ex.vocab.fairly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fairly","back":"(adverb) To some extent, but not completely; quite.","example":{"text":"I thought you did fairly well.","source":{"kind":"tatoeba","sentenceId":1961599,"author":"CK"}},"audio":"audio/0a6428d355e69c71.m4a"},{"id":"ex.vocab.fake","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fake","back":"(adjective) Not real, but made to look like something real.","example":{"text":"He has a fake tan.","source":{"kind":"tatoeba","sentenceId":3223293,"author":"Hybrid"}},"audio":"audio/15dbd89926365a6b.m4a"},{"id":"ex.vocab.false","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"false","back":"(adjective) Not true or real; based on incorrect information.","example":{"text":"It turned out that the rumor was false.","source":{"kind":"tatoeba","sentenceId":2155922,"author":"CM"}},"audio":"audio/c669fa64522f5afa.m4a"},{"id":"ex.vocab.familiar","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"familiar","back":"(adjective) Well-known or easily recognized.","example":{"text":"His name is familiar to us.","source":{"kind":"tatoeba","sentenceId":263221,"author":"CK"}},"audio":"audio/cd495bdb4b53a7b0.m4a"},{"id":"ex.vocab.fan","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fan","back":"(noun) A device that moves air to make a room cooler, or someone who admires a person or team.","example":{"text":"It was hot, so I turned on the fan.","source":{"kind":"tatoeba","sentenceId":1304537,"author":"CK"}},"audio":"audio/1270ba03993370f0.m4a"},{"id":"ex.vocab.fashion","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fashion","back":"(noun) A popular style of clothes, hair, or behavior at a particular time.","example":{"text":"That kind of dress is now in fashion.","source":{"kind":"tatoeba","sentenceId":68267,"author":"CK"}},"audio":"audio/dc799e410b807150.m4a"},{"id":"ex.vocab.fault","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fault","back":"(noun) Responsibility for a mistake or something bad that has happened.","example":{"text":"It was all our fault.","source":{"kind":"tatoeba","sentenceId":42736,"author":"AlanF_US"}},"audio":"audio/8810c33f56e16d31.m4a"},{"id":"ex.vocab.favor","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"favor","back":"(noun) A kind or helpful act that you do for someone.","example":{"text":"May I ask you a favor?","source":{"kind":"tatoeba","sentenceId":34682,"author":"CK"}},"audio":"audio/f236ee674238b4a5.m4a"},{"id":"ex.vocab.fear","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fear","back":"(noun) An unpleasant emotion caused by the belief that someone or something is dangerous.","example":{"text":"His son trembled with fear.","source":{"kind":"tatoeba","sentenceId":287056,"author":"CM"}},"audio":"audio/35c40ad738c30da6.m4a"},{"id":"ex.vocab.female","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"female","back":"(adjective) Belonging to the sex that can give birth or lay eggs.","example":{"text":"I keep a female cat.","source":{"kind":"tatoeba","sentenceId":258086,"author":"shekitten"}},"audio":"audio/391668b2a9738c0c.m4a"},{"id":"ex.vocab.fence","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fence","back":"(noun) A barrier, usually made of wood or wire, that separates two areas of land.","example":{"text":"I painted the fence green.","source":{"kind":"tatoeba","sentenceId":257856,"author":"CK"}},"audio":"audio/129624bf4d960023.m4a"},{"id":"ex.vocab.fever","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fever","back":"(noun) A medical condition where your body temperature is higher than normal.","example":{"text":"I have a high fever.","source":{"kind":"tatoeba","sentenceId":387437,"author":"CK"}},"audio":"audio/6e4cee94f8d00d67.m4a"},{"id":"ex.vocab.figure","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"figure","back":"(noun) A number, especially an official one.","example":{"text":"Will you please check these figures?","source":{"kind":"tatoeba","sentenceId":55155,"author":"CK"}},"audio":"audio/06bcb87aa97ba467.m4a"},{"id":"ex.vocab.file","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"file","back":"(noun) A collection of papers or information kept together, or a tool for smoothing nails.","example":{"text":"The correspondence is kept in several files.","source":{"kind":"tatoeba","sentenceId":2259301,"author":"_undertoad"}},"audio":"audio/73d2cc97c95daad0.m4a"},{"id":"ex.vocab.final","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"final","back":"(adjective) Happening at the end of a series of events or actions.","example":{"text":"We left the final decision to him.","source":{"kind":"tatoeba","sentenceId":22966,"author":"CK"}},"audio":"audio/173d19d099260ac5.m4a"},{"id":"ex.vocab.finally","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"finally","back":"(adverb) After a long time, or at the end of a series of events.","example":{"text":"I finally got a job.","source":{"kind":"tatoeba","sentenceId":30231,"author":"CK"}},"audio":"audio/5eebc6861396f40a.m4a"},{"id":"ex.vocab.fit","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fit","back":"(adjective) Healthy and strong, or suitable for a particular purpose.","example":{"text":"In my opinion he is not fit for the work.","source":{"kind":"tatoeba","sentenceId":33510,"author":"AlanF_US"}},"audio":"audio/c10c0e1e71d8f8b7.m4a"},{"id":"ex.vocab.flirt","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"flirt","back":"(verb) To behave in a way that shows you are sexually attracted to someone, but not seriously.","example":{"text":"Tom didn't notice that Mary was flirting with him.","source":{"kind":"tatoeba","sentenceId":2916584,"author":"Hybrid"}},"audio":"audio/38c7b791c4fa357a.m4a"},{"id":"ex.vocab.flood","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"flood","back":"(noun) A large amount of water covering an area that is usually dry.","example":{"text":"The village was isolated by the flood.","source":{"kind":"tatoeba","sentenceId":45557,"author":"CK"}},"audio":"audio/84e9cfc756a70056.m4a"},{"id":"ex.vocab.flow","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"flow","back":"(verb) To move steadily and continuously in one direction, like water or air.","example":{"text":"The Mississippi River flows into the Gulf of Mexico.","source":{"kind":"tatoeba","sentenceId":32284,"author":"CK"}},"audio":"audio/a85929947ec63aa9.m4a"},{"id":"ex.vocab.fluent","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fluent","back":"(adjective) Able to speak a language easily, clearly, and without mistakes.","example":{"text":"He is fluent in French.","source":{"kind":"tatoeba","sentenceId":292607,"author":"CK"}},"audio":"audio/655a95e2320f4913.m4a"},{"id":"ex.vocab.focus","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"focus","back":"(verb) To give all your attention to one particular thing; to adjust a camera to make an image clear.","example":{"text":"Don't look back. Focus on the future.","source":{"kind":"tatoeba","sentenceId":3592618,"author":"karloelkebekio"}},"audio":"audio/694c7c9463cc05eb.m4a"},{"id":"ex.vocab.fool","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fool","back":"(noun) A person who acts unwisely or stupidly.","example":{"text":"What a fool I was!","source":{"kind":"tatoeba","sentenceId":255332,"author":"CM"}},"audio":"audio/0d7f2177380b51e1.m4a"},{"id":"ex.vocab.force","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"force","back":"(noun) Physical strength or power, or a strong influence.","example":{"text":"The strong wind had enough force to push the door open.","source":{"kind":"generated"}},"audio":"audio/549ceadd202354b6.m4a"},{"id":"ex.vocab.foreign","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"foreign","back":"(adjective) From or relating to a country that is not your own.","example":{"text":"It is important for you to learn a foreign language.","source":{"kind":"tatoeba","sentenceId":17902,"author":"Zifre"}},"audio":"audio/c73a75ef7bc967c6.m4a"},{"id":"ex.vocab.forever","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"forever","back":"(adverb) For all time, or for a very long time.","example":{"text":"I want to live forever.","source":{"kind":"tatoeba","sentenceId":256167,"author":"CK"}},"audio":"audio/4f5464d40c286cba.m4a"},{"id":"ex.vocab.forgive","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"forgive","back":"(verb) To stop being angry with someone for something they have done.","example":{"text":"Please forgive me for not having written sooner.","source":{"kind":"tatoeba","sentenceId":30413,"author":"CK"}},"audio":"audio/448da0e4a24a12b7.m4a"},{"id":"ex.vocab.forward","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"forward","back":"(adverb) Towards the front; in the direction that is in front of you.","example":{"text":"Please step forward and introduce yourself.","source":{"kind":"generated"}},"audio":"audio/e320e7600636b896.m4a"},{"id":"ex.vocab.freedom","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"freedom","back":"(noun) The state of being able to do what you want without being controlled or limited.","example":{"text":"What we want is freedom.","source":{"kind":"tatoeba","sentenceId":2011977,"author":"CK"}},"audio":"audio/ace4e11a4355d9ec.m4a"},{"id":"ex.vocab.freeze","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"freeze","back":"(verb) To turn into ice or become very cold; to stop moving suddenly.","example":{"text":"I think it'll freeze tonight.","source":{"kind":"tatoeba","sentenceId":243391,"author":"CK"}},"audio":"audio/69fd71216a0fb4a3.m4a"},{"id":"ex.vocab.friendship","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"friendship","back":"(noun) The relationship between friends; a feeling of liking and caring for someone.","example":{"text":"Nothing is more valuable than friendship.","source":{"kind":"tatoeba","sentenceId":660412,"author":"CK"}},"audio":"audio/b8b90f8384d38db4.m4a"},{"id":"ex.vocab.fully","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"fully","back":"(adverb) Completely or entirely.","example":{"text":"I'm fully aware of that.","source":{"kind":"tatoeba","sentenceId":2546024,"author":"CK"}},"audio":"audio/944e1c2e6619b6c3.m4a"},{"id":"ex.vocab.gain","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"gain","back":"(verb) To get or obtain something, often something useful or positive.","example":{"text":"We gain wisdom with age.","source":{"kind":"tatoeba","sentenceId":248734,"author":"CM"}},"audio":"audio/51efd9dbd4c647e3.m4a"},{"id":"ex.vocab.gather","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"gather","back":"(verb) To come together in a group, or to collect things.","example":{"text":"We gather here once a week.","source":{"kind":"tatoeba","sentenceId":248851,"author":"CK"}},"audio":"audio/b5cf35aa172e1289.m4a"},{"id":"ex.vocab.gay","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"gay","back":"(adjective) Attracted to people of the same sex.","example":{"text":"His sister doesn't know he's gay.","source":{"kind":"tatoeba","sentenceId":8319102,"author":"Amastan"}},"audio":"audio/51984f24473b9958.m4a"},{"id":"ex.vocab.general","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"general","back":"(adjective) Including or affecting most people or things, or not specific.","example":{"text":"There is a general agreement on the plan.","source":{"kind":"generated"}},"audio":"audio/329771cec42dbb43.m4a"},{"id":"ex.vocab.gentleman","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"gentleman","back":"(noun) A polite and well-mannered man.","example":{"text":"He is a real gentleman.","source":{"kind":"tatoeba","sentenceId":284369,"author":"CK"}},"audio":"audio/87c4c5cfd029006c.m4a"},{"id":"ex.vocab.ghost","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"ghost","back":"(noun) The spirit of a dead person that some people believe can appear to the living.","example":{"text":"My friend doesn't believe in ghosts.","source":{"kind":"tatoeba","sentenceId":1506974,"author":"CM"}},"audio":"audio/b01fbec312c9dcb0.m4a"},{"id":"ex.vocab.giant","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"giant","back":"(adjective) Extremely large.","example":{"text":"Jupiter is a giant planet.","source":{"kind":"tatoeba","sentenceId":5253778,"author":"Hybrid"}},"audio":"audio/35ad6e03cfb8a35e.m4a"},{"id":"ex.vocab.glance","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"glance","back":"(verb) To look quickly at something or someone.","example":{"text":"He just glanced at me.","source":{"kind":"tatoeba","sentenceId":298080,"author":"CM"}},"audio":"audio/45de7cd6d5608131.m4a"},{"id":"ex.vocab.goal","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"goal","back":"(noun) Something you want to achieve in the future.","example":{"text":"Tom's goal is to own a home before he's thirty.","source":{"kind":"tatoeba","sentenceId":681080,"author":"Source_VOA"}},"audio":"audio/d408ac1144545a28.m4a"},{"id":"ex.vocab.government","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"government","back":"(noun) The group of people who control a country or state.","example":{"text":"The government will have to deal with the financial problem.","source":{"kind":"tatoeba","sentenceId":271425,"author":"CK"}},"audio":"audio/500aed84640bc5b3.m4a"},{"id":"ex.vocab.grab","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"grab","back":"(verb) To take hold of something or someone suddenly and roughly.","example":{"text":"Someone grabbed me from behind.","source":{"kind":"tatoeba","sentenceId":40463,"author":"CK"}},"audio":"audio/ef71675be3e088a8.m4a"},{"id":"ex.vocab.grade","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"grade","back":"(noun) A mark indicating the quality of a student's work, or a level in school.","example":{"text":"I got a good grade in English.","source":{"kind":"tatoeba","sentenceId":256190,"author":"CK"}},"audio":"audio/058849e680d2f202.m4a"},{"id":"ex.vocab.guard","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"guard","back":"(noun) A person or thing that protects someone or something.","example":{"text":"A security guard stood at the entrance.","source":{"kind":"generated"}},"audio":"audio/4cf342317c0ad4f2.m4a"},{"id":"ex.vocab.guide","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"guide","back":"(noun) A person who shows others the way, or a book that gives information.","example":{"text":"This book is a good guide for beginners.","source":{"kind":"tatoeba","sentenceId":56919,"author":"CK"}},"audio":"audio/7c30a48d817c57b4.m4a"},{"id":"ex.vocab.guilty","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"guilty","back":"(adjective) Having done something wrong or against the law.","example":{"text":"It is clear that he is guilty.","source":{"kind":"tatoeba","sentenceId":283312,"author":"CK"}},"audio":"audio/b64412abdaefbfe6.m4a"},{"id":"ex.vocab.gun","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"gun","back":"(noun) A weapon that shoots bullets or other projectiles.","example":{"text":"The toy gun made a loud popping sound.","source":{"kind":"generated"}},"audio":"audio/e567f0d03c170695.m4a"},{"id":"ex.vocab.habit","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"habit","back":"(noun) Something that you do often or regularly, sometimes without thinking about it.","example":{"text":"You must rid yourself of bad habits.","source":{"kind":"tatoeba","sentenceId":16328,"author":"Zifre"}},"audio":"audio/427e94812e03702a.m4a"},{"id":"ex.vocab.hallway","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"hallway","back":"(noun) A long, narrow passage inside a building with rooms on either side.","example":{"text":"Why is all this trash in the hallway?","source":{"kind":"tatoeba","sentenceId":8559215,"author":"CK"}},"audio":"audio/df0cee0f4197685e.m4a"},{"id":"ex.vocab.handle","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"handle","back":"(verb) To deal with a situation, problem, or person.","example":{"text":"I think I can handle it.","source":{"kind":"tatoeba","sentenceId":24925,"author":"CK"}},"audio":"audio/3ecff83c1d14e635.m4a"},{"id":"ex.vocab.handsome","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"handsome","back":"(adjective) (Of a man) attractive in a strong, healthy way.","example":{"text":"Am I handsome or not?","source":{"kind":"tatoeba","sentenceId":255441,"author":"CM"}},"audio":"audio/86424c8a2dfc5755.m4a"},{"id":"ex.vocab.happiness","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"happiness","back":"(noun) The state of feeling or showing pleasure or contentment.","example":{"text":"We all wish for happiness.","source":{"kind":"tatoeba","sentenceId":248314,"author":"CK"}},"audio":"audio/d8eb3b6bfbe6ecd9.m4a"},{"id":"ex.vocab.hardly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"hardly","back":"(adverb) Almost not at all; only just.","example":{"text":"I can hardly hear you.","source":{"kind":"tatoeba","sentenceId":16857,"author":"CK"}},"audio":"audio/df3f64eb50c886a5.m4a"},{"id":"ex.vocab.harm","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"harm","back":"(noun) Physical injury or damage; negative effect.","example":{"text":"The storm did great harm to the crop.","source":{"kind":"tatoeba","sentenceId":325305,"author":"AlanF_US"}},"audio":"audio/a2688e010db04279.m4a"},{"id":"ex.vocab.height","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"height","back":"(noun) The measurement of how tall someone or something is.","example":{"text":"She and I are about the same height.","source":{"kind":"tatoeba","sentenceId":410070,"author":"CK"}},"audio":"audio/29fa3ae90d5988d0.m4a"},{"id":"ex.vocab.hell","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"hell","back":"(noun) A very difficult and unpleasant situation.","example":{"text":"The traffic jam was pure hell.","source":{"kind":"generated"}},"audio":"audio/1261d73cec7e3305.m4a"},{"id":"ex.vocab.hero","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"hero","back":"(noun) A person admired for brave actions or great qualities.","example":{"text":"He became a national hero.","source":{"kind":"tatoeba","sentenceId":296439,"author":"CK"}},"audio":"audio/b3da45c5944121ea.m4a"},{"id":"ex.vocab.hike","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"hike","back":"(noun) A long walk, especially in the countryside or mountains.","example":{"text":"We are to go on a hike tomorrow.","source":{"kind":"tatoeba","sentenceId":33576,"author":"AlanF_US"}},"audio":"audio/3834c9cd87386b6b.m4a"},{"id":"ex.vocab.hire","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"hire","back":"(verb) To employ someone or to pay to use something for a short time.","example":{"text":"I was hired by my uncle.","source":{"kind":"tatoeba","sentenceId":253230,"author":"CK"}},"audio":"audio/d8b014490a8660e1.m4a"},{"id":"ex.vocab.homeless","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"homeless","back":"(adjective) Without a home, and therefore usually living on the streets or in temporary shelters.","example":{"text":"Many homeless people live in parks.","source":{"kind":"tatoeba","sentenceId":2540029,"author":"CK"}},"audio":"audio/70403ef74f14a6c7.m4a"},{"id":"ex.vocab.honest","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"honest","back":"(adjective) Always telling the truth and not cheating or stealing.","example":{"text":"A man must be honest.","source":{"kind":"tatoeba","sentenceId":270089,"author":"CM"}},"audio":"audio/4175b3ab5ddbc3f7.m4a"},{"id":"ex.vocab.horrible","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"horrible","back":"(adjective) Very unpleasant, shocking, or bad.","example":{"text":"I've had a horrible day.","source":{"kind":"tatoeba","sentenceId":1891190,"author":"CK"}},"audio":"audio/e5c700e6adb9b887.m4a"},{"id":"ex.vocab.horror","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"horror","back":"(noun) A strong feeling of shock and fear, or something that causes this feeling.","example":{"text":"She threw her arms around him in horror.","source":{"kind":"tatoeba","sentenceId":313240,"author":"CK"}},"audio":"audio/344186bfd6afcbea.m4a"},{"id":"ex.vocab.however","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"however","back":"(adverb) Used to introduce a statement that contrasts with something just said.","example":{"text":"It's already September; however, it is very hot.","source":{"kind":"tatoeba","sentenceId":31682,"author":"AlanF_US"}},"audio":"audio/9527842781edb5d2.m4a"},{"id":"ex.vocab.hug","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"hug","back":"(verb) To put your arms around someone and hold them tightly, usually to show love.","example":{"text":"Have you ever hugged a stranger?","source":{"kind":"tatoeba","sentenceId":1885974,"author":"CK"}},"audio":"audio/d6e9648bafe37135.m4a"},{"id":"ex.vocab.human","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"human","back":"(adjective) Relating to people, rather than animals or machines.","example":{"text":"Air, like food, is a basic human need.","source":{"kind":"tatoeba","sentenceId":18233,"author":"Zifre"}},"audio":"audio/187c516cbcbcdd5b.m4a"},{"id":"ex.vocab.hunt","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"hunt","back":"(verb) To chase and kill wild animals for food or sport.","example":{"text":"An owl sleeps by day and hunts by night.","source":{"kind":"tatoeba","sentenceId":34362,"author":"AlanF_US"}},"audio":"audio/3d2c631d8e920722.m4a"},{"id":"ex.vocab.idiot","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"idiot","back":"(noun) A very stupid person.","example":{"text":"The characters in this movie are all complete idiots.","source":{"kind":"tatoeba","sentenceId":6010871,"author":"mailohilohi"}},"audio":"audio/7586f9451f78fc5b.m4a"},{"id":"ex.vocab.ignore","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"ignore","back":"(verb) To pay no attention to someone or something.","example":{"text":"She ignored him all day.","source":{"kind":"tatoeba","sentenceId":887219,"author":"CK"}},"audio":"audio/b0106e398f53c018.m4a"},{"id":"ex.vocab.illegal","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"illegal","back":"(adjective) Not allowed by law.","example":{"text":"What you did was illegal.","source":{"kind":"tatoeba","sentenceId":2644683,"author":"CK"}},"audio":"audio/f50caffb97d89df9.m4a"},{"id":"ex.vocab.illness","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"illness","back":"(noun) A disease or period of being unhealthy in your body or mind.","example":{"text":"I recovered from my illness.","source":{"kind":"tatoeba","sentenceId":261453,"author":"CM"}},"audio":"audio/1dd180b7e309e880.m4a"},{"id":"ex.vocab.imagine","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"imagine","back":"(verb) To form a picture or idea of something in your mind.","example":{"text":"I can imagine how you felt.","source":{"kind":"tatoeba","sentenceId":17971,"author":"CK"}},"audio":"audio/b399ff36d7a16f44.m4a"},{"id":"ex.vocab.immediately","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"immediately","back":"(adverb) Without any delay; at once.","example":{"text":"Get out of here immediately!","source":{"kind":"tatoeba","sentenceId":52169,"author":"CK"}},"audio":"audio/a271b00d73bda23c.m4a"},{"id":"ex.vocab.impressed","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"impressed","back":"(adjective) Feeling admiration or respect for someone or something.","example":{"text":"I was impressed by his music.","source":{"kind":"tatoeba","sentenceId":260551,"author":"CK"}},"audio":"audio/29cd5edbc741ece0.m4a"},{"id":"ex.vocab.improve","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"improve","back":"(verb) To make something better, or to become better.","example":{"text":"I want to improve myself.","source":{"kind":"tatoeba","sentenceId":258057,"author":"RJH"}},"audio":"audio/dc63d86c947817fd.m4a"},{"id":"ex.vocab.increase","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"increase","back":"(verb) To become larger in amount, number, or degree; to make something larger.","example":{"text":"The driver increased his speed.","source":{"kind":"tatoeba","sentenceId":26594,"author":"CM"}},"audio":"audio/fa4f03e096403697.m4a"},{"id":"ex.vocab.industry","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"industry","back":"(noun) The production of goods or services, especially in factories or businesses.","example":{"text":"He works in the car industry.","source":{"kind":"tatoeba","sentenceId":454473,"author":"FeuDRenais"}},"audio":"audio/b0022d3efee5a12b.m4a"},{"id":"ex.vocab.inform","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"inform","back":"(verb) To tell someone about something, especially officially.","example":{"text":"I informed her of my success.","source":{"kind":"tatoeba","sentenceId":261185,"author":"CM"}},"audio":"audio/f40f79d94b6d2478.m4a"},{"id":"ex.vocab.injure","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"injure","back":"(verb) To hurt yourself or another person or animal physically.","example":{"text":"Don't injure your stomach by eating too much.","source":{"kind":"tatoeba","sentenceId":268635,"author":"Zifre"}},"audio":"audio/34ddace0c9852a28.m4a"},{"id":"ex.vocab.injury","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"injury","back":"(noun) Physical harm or damage to a part of the body.","example":{"text":"The bus driver suffered minor injuries.","source":{"kind":"tatoeba","sentenceId":756400,"author":"CK"}},"audio":"audio/3608619eec98e835.m4a"},{"id":"ex.vocab.insist","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"insist","back":"(verb) To demand something forcefully and refuse to accept any opposition.","example":{"text":"My brother insisted on going there alone.","source":{"kind":"tatoeba","sentenceId":278547,"author":"CK"}},"audio":"audio/6431c972c64cae69.m4a"},{"id":"ex.vocab.inspire","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"inspire","back":"(verb) To make someone feel enthusiastic or want to do something good.","example":{"text":"I inspired my students to work harder.","source":{"kind":"tatoeba","sentenceId":258993,"author":"CK"}},"audio":"audio/b4cc18908a0a92fe.m4a"},{"id":"ex.vocab.install","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"install","back":"(verb) To put a piece of equipment or software into place so it is ready to be used.","example":{"text":"Their job is to install new software on the company's computers.","source":{"kind":"tatoeba","sentenceId":1771347,"author":"Amastan"}},"audio":"audio/b94b33b5ce3f5715.m4a"},{"id":"ex.vocab.instead","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"instead","back":"(adverb) In place of someone or something else.","example":{"text":"I'd like to have tea instead of coffee.","source":{"kind":"tatoeba","sentenceId":62206,"author":"CK"}},"audio":"audio/f37669cdc388d876.m4a"},{"id":"ex.vocab.instruction","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"instruction","back":"(noun) Detailed information telling you how to do or use something.","example":{"text":"To use this, follow these instructions.","source":{"kind":"tatoeba","sentenceId":2269002,"author":"_undertoad"}},"audio":"audio/254b3af3908a8d17.m4a"},{"id":"ex.vocab.intelligent","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"intelligent","back":"(adjective) Having the ability to learn, understand, and think in a smart way.","example":{"text":"She is a very intelligent young lady.","source":{"kind":"tatoeba","sentenceId":314851,"author":"CK"}},"audio":"audio/922cca14a539464b.m4a"},{"id":"ex.vocab.intend","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"intend","back":"(verb) To have a plan or purpose in your mind.","example":{"text":"I intend to go there.","source":{"kind":"tatoeba","sentenceId":50878,"author":"CK"}},"audio":"audio/fcd1ff9e8e5c821a.m4a"},{"id":"ex.vocab.interrupt","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"interrupt","back":"(verb) To stop someone from speaking or doing something by saying or doing something else.","example":{"text":"Don't interrupt me while I am talking.","source":{"kind":"tatoeba","sentenceId":247144,"author":"CK"}},"audio":"audio/282dd643dc1a20de.m4a"},{"id":"ex.vocab.interview","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"interview","back":"(noun) A formal meeting where someone asks you questions to see if you are suitable for a job.","example":{"text":"I've got a job interview.","source":{"kind":"tatoeba","sentenceId":2359590,"author":"CK"}},"audio":"audio/13eaab4b53d1fdf8.m4a"},{"id":"ex.vocab.invest","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"invest","back":"(verb) To put money into a business or project to make a profit.","example":{"text":"I like to invest money in interesting projects.","source":{"kind":"tatoeba","sentenceId":1762556,"author":"Amastan"}},"audio":"audio/bde65be2a4ffd640.m4a"},{"id":"ex.vocab.involve","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"involve","back":"(verb) To include someone or something in an activity or situation.","example":{"text":"This job involves lots of hard work.","source":{"kind":"tatoeba","sentenceId":59124,"author":"CK"}},"audio":"audio/4f656e62eca554a0.m4a"},{"id":"ex.vocab.iron","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"iron","back":"(noun) A common, strong, grey metal used to make tools, machines, and buildings.","example":{"text":"Iron is a useful metal.","source":{"kind":"tatoeba","sentenceId":467339,"author":"CK"}},"audio":"audio/659955877e6ac4bb.m4a"},{"id":"ex.vocab.issue","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"issue","back":"(noun) An important topic or problem that people are discussing or arguing about.","example":{"text":"Opinions are divided on the issue of taxes.","source":{"kind":"tatoeba","sentenceId":23664,"author":"CK"}},"audio":"audio/8a5da01717cb4d5f.m4a"},{"id":"ex.vocab.jail","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"jail","back":"(noun) A place where people are kept as punishment for a crime or while waiting for trial.","example":{"text":"He spent a year in jail.","source":{"kind":"generated"}},"audio":"audio/478c21b32838fe44.m4a"},{"id":"ex.vocab.jazz","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"jazz","back":"(noun) A type of music with a strong rhythm, often played with trumpets and saxophones.","example":{"text":"Tom performs in a jazz club three nights a week.","source":{"kind":"tatoeba","sentenceId":681712,"author":"Source_VOA"}},"audio":"audio/9a8818c2d06346e0.m4a"},{"id":"ex.vocab.jealous","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"jealous","back":"(adjective) Feeling unhappy or angry because someone else has something you want.","example":{"text":"Mr Brown is jealous of his colleague's success.","source":{"kind":"tatoeba","sentenceId":34235,"author":"AlanF_US"}},"audio":"audio/3238921b75af3b46.m4a"},{"id":"ex.vocab.journey","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"journey","back":"(noun) An act of traveling from one place to another, especially over a long distance.","example":{"text":"He made a journey around the world.","source":{"kind":"tatoeba","sentenceId":300272,"author":"CK"}},"audio":"audio/cea53d8269f26a41.m4a"},{"id":"ex.vocab.joy","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"joy","back":"(noun) A feeling of great happiness and pleasure.","example":{"text":"She was full of joy.","source":{"kind":"tatoeba","sentenceId":313098,"author":"CM"}},"audio":"audio/00a20c039e75e671.m4a"},{"id":"ex.vocab.judge","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"judge","back":"(noun) A public official who decides cases in a court of law.","example":{"text":"You cannot buy that judge.","source":{"kind":"tatoeba","sentenceId":16805,"author":"Dejo"}},"audio":"audio/0b829ed34f4aa8fa.m4a"},{"id":"ex.vocab.ladder","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"ladder","back":"(noun) A piece of equipment with steps, used for climbing up or down.","example":{"text":"I need a ladder so I can get up to my roof.","source":{"kind":"tatoeba","sentenceId":2387444,"author":"CK"}},"audio":"audio/75f8076e46c6d632.m4a"},{"id":"ex.vocab.lately","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"lately","back":"(adverb) In the recent past; recently.","example":{"text":"I haven't seen Tom lately.","source":{"kind":"tatoeba","sentenceId":243772,"author":"CK"}},"audio":"audio/51e161c26bcee054.m4a"},{"id":"ex.vocab.law","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"law","back":"(noun) A rule made by a government that people must obey.","example":{"text":"The law forbids the building of any skyscraper on this land.","source":{"kind":"tatoeba","sentenceId":57683,"author":"Lumi"}},"audio":"audio/956ec23296f75db5.m4a"},{"id":"ex.vocab.lawn","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"lawn","back":"(noun) An area of grass, especially in a garden or park, that is cut regularly.","example":{"text":"Tom is mowing the lawn.","source":{"kind":"tatoeba","sentenceId":3442185,"author":"CK"}},"audio":"audio/5a16a5a5498dbeb2.m4a"},{"id":"ex.vocab.lawyer","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"lawyer","back":"(noun) A person whose job is to give advice about the law and represent people in court.","example":{"text":"I have the right to call my lawyer.","source":{"kind":"tatoeba","sentenceId":249759,"author":"CK"}},"audio":"audio/b59f2ec3d420a1f2.m4a"},{"id":"ex.vocab.lazy","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"lazy","back":"(adjective) Not wanting to work or use effort.","example":{"text":"He is lazy by nature.","source":{"kind":"tatoeba","sentenceId":300451,"author":"CK"}},"audio":"audio/f5f765d8a677efb5.m4a"},{"id":"ex.vocab.leak","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"leak","back":"(verb) To allow liquid or gas to escape through a hole or crack.","example":{"text":"Every time it rains, the roof leaks.","source":{"kind":"tatoeba","sentenceId":26858,"author":"CK"}},"audio":"audio/59033febe96ca3f6.m4a"},{"id":"ex.vocab.lean","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"lean","back":"(verb) To bend or move your body or an object so that it rests against something.","example":{"text":"She just leaned against me.","source":{"kind":"tatoeba","sentenceId":291754,"author":"CM"}},"audio":"audio/0a38f50db9f43536.m4a"},{"id":"ex.vocab.least","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"least","back":"(adjective) The smallest amount or degree; the minimum.","example":{"text":"I would like the least expensive one.","source":{"kind":"tatoeba","sentenceId":36258,"author":"CK"}},"audio":"audio/aaac4a4a6fc3a67c.m4a"},{"id":"ex.vocab.lecture","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"lecture","back":"(noun) A formal talk given to a group of people, often at a university.","example":{"text":"As many as fifty students gathered to hear his lecture.","source":{"kind":"tatoeba","sentenceId":72552,"author":"CM"}},"audio":"audio/dd0fc11736b0a858.m4a"},{"id":"ex.vocab.level","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"level","back":"(noun) A position on a scale of amount, quality, or importance.","example":{"text":"I must say that your writing is at a pretty good level!","source":{"kind":"tatoeba","sentenceId":790566,"author":"FeuDRenais2"}},"audio":"audio/53e11e12380cf296.m4a"},{"id":"ex.vocab.liar","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"liar","back":"(noun) A person who tells things that are not true.","example":{"text":"Tom called Mary a liar.","source":{"kind":"tatoeba","sentenceId":1029547,"author":"CK"}},"audio":"audio/ed83dcf90f82d343.m4a"},{"id":"ex.vocab.license","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"license","back":"(noun) An official document that gives you permission to do something, like drive a car.","example":{"text":"May I see your license?","source":{"kind":"tatoeba","sentenceId":323499,"author":"CK"}},"audio":"audio/945ab501b3fd9735.m4a"},{"id":"ex.vocab.likely","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"likely","back":"(adjective) Probable or expected to happen or be true.","example":{"text":"He is likely to come.","source":{"kind":"tatoeba","sentenceId":289421,"author":"CK"}},"audio":"audio/ce592bb251b6a5d0.m4a"},{"id":"ex.vocab.limit","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"limit","back":"(noun) A point or level beyond which something cannot or may not go.","example":{"text":"Don't go above the speed limit.","source":{"kind":"tatoeba","sentenceId":495871,"author":"CK"}},"audio":"audio/fb275af44e1bf4e7.m4a"},{"id":"ex.vocab.load","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"load","back":"(verb) To put a large quantity of things or people onto a vehicle or into a container.","example":{"text":"Tom loaded the bags into the trunk of his car.","source":{"kind":"tatoeba","sentenceId":2640271,"author":"CK"}},"audio":"audio/ac97769c0bd4c704.m4a"},{"id":"ex.vocab.locate","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"locate","back":"(verb) To find the exact position of something or someone; or, to be situated in a place.","example":{"text":"I located the town on a map.","source":{"kind":"tatoeba","sentenceId":277227,"author":"CK"}},"audio":"audio/948f14984dd2deba.m4a"},{"id":"ex.vocab.lonely","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"lonely","back":"(adjective) Unhappy because you are alone or have no friends.","example":{"text":"I get lonely at times.","source":{"kind":"tatoeba","sentenceId":264116,"author":"CK"}},"audio":"audio/9d337b8bdfe6d2df.m4a"},{"id":"ex.vocab.loss","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"loss","back":"(noun) The act of no longer having something or someone.","example":{"text":"We must make up for the loss.","source":{"kind":"tatoeba","sentenceId":28841,"author":"CK"}},"audio":"audio/885b65feaa2bc4fb.m4a"},{"id":"ex.vocab.lower","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"lower","back":"(verb) To move something down, or to make an amount or level smaller.","example":{"text":"The university administration lowered tuition.","source":{"kind":"tatoeba","sentenceId":680082,"author":"Source_VOA"}},"audio":"audio/fcf182a94804a9b1.m4a"},{"id":"ex.vocab.machine","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"machine","back":"(noun) A piece of equipment with moving parts that does a particular job.","example":{"text":"The salesman demonstrated how to use the machine.","source":{"kind":"tatoeba","sentenceId":51351,"author":"CM"}},"audio":"audio/2957860b4f9615d2.m4a"},{"id":"ex.vocab.major","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"major","back":"(adjective) Very important, serious, or large.","example":{"text":"Reducing the budget deficit is a major concern of the government.","source":{"kind":"tatoeba","sentenceId":244269,"author":"CK"}},"audio":"audio/ecaf39c20a6f94aa.m4a"},{"id":"ex.vocab.male","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"male","back":"(adjective) Relating to men or boys.","example":{"text":"Was the victim male or female?","source":{"kind":"tatoeba","sentenceId":3475969,"author":"Hybrid"}},"audio":"audio/c3923651f4f68ee2.m4a"},{"id":"ex.vocab.manage","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"manage","back":"(verb) To succeed in doing something difficult, or to be in control of something.","example":{"text":"I managed to get in.","source":{"kind":"tatoeba","sentenceId":2417,"author":"CK"}},"audio":"audio/edfd686f8d698a08.m4a"},{"id":"ex.vocab.manager","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"manager","back":"(noun) A person who is in charge of a business, department, or team.","example":{"text":"The manager deals with many problems.","source":{"kind":"tatoeba","sentenceId":32503,"author":"CK"}},"audio":"audio/a6ac588d1ee446eb.m4a"},{"id":"ex.vocab.marry","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"marry","back":"(verb) To become someone's husband or wife in a legal ceremony.","example":{"text":"My sister married a high school teacher last June.","source":{"kind":"tatoeba","sentenceId":19451,"author":"CK"}},"audio":"audio/07824779a1fb24f2.m4a"},{"id":"ex.vocab.mask","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"mask","back":"(noun) A covering for the face, worn to hide identity or for protection.","example":{"text":"He wore a mask so that no one could recognize him.","source":{"kind":"tatoeba","sentenceId":300389,"author":"AlanF_US"}},"audio":"audio/9f737f9fdf26185b.m4a"},{"id":"ex.vocab.material","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"material","back":"(noun) The substance from which something is made or can be made.","example":{"text":"Furniture made of good materials sells well.","source":{"kind":"tatoeba","sentenceId":52105,"author":"CM"}},"audio":"audio/e5ebcc8faabe3c98.m4a"},{"id":"ex.vocab.matter","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"matter","back":"(noun) A subject or situation that you need to think about or deal with.","example":{"text":"We went on talking about the matter.","source":{"kind":"tatoeba","sentenceId":23184,"author":"CK"}},"audio":"audio/19ebbe25dfe85951.m4a"},{"id":"ex.vocab.meaning","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"meaning","back":"(noun) The idea or message that something expresses or represents.","example":{"text":"I can't make out the meaning of this sentence.","source":{"kind":"tatoeba","sentenceId":253724,"author":"CK"}},"audio":"audio/ab34b7c3acec2f07.m4a"},{"id":"ex.vocab.measure","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"measure","back":"(verb) To find the size, amount, or degree of something using a tool or standard.","example":{"text":"He measured the length of the bed.","source":{"kind":"tatoeba","sentenceId":288201,"author":"CK"}},"audio":"audio/9d984bc3c3d1644d.m4a"},{"id":"ex.vocab.media","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"media","back":"(noun) The main ways that information and news are communicated to the public.","example":{"text":"They wanted to get some media attention.","source":{"kind":"tatoeba","sentenceId":3881483,"author":"Amastan"}},"audio":"audio/a8888034c5dacaf5.m4a"},{"id":"ex.vocab.medical","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"medical","back":"(adjective) Relating to the treatment of illness and injuries, or to medicine.","example":{"text":"He is a medical student.","source":{"kind":"tatoeba","sentenceId":293599,"author":"CK"}},"audio":"audio/c849c2deacc64b48.m4a"},{"id":"ex.vocab.medication","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"medication","back":"(noun) A substance, usually a liquid or pill, that you take to treat an illness or pain.","example":{"text":"Tom had an allergic reaction to the medication.","source":{"kind":"tatoeba","sentenceId":3186759,"author":"patgfisher"}},"audio":"audio/d8cae8dd868d6e30.m4a"},{"id":"ex.vocab.medicine","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"medicine","back":"(noun) A substance used for treating illness, especially one you drink or swallow.","example":{"text":"I have to take medicine.","source":{"kind":"tatoeba","sentenceId":5999,"author":"CK"}},"audio":"audio/bf57fdef4b7eba15.m4a"},{"id":"ex.vocab.melt","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"melt","back":"(verb) To change from a solid to a liquid because of heat.","example":{"text":"Ice melts in the sun.","source":{"kind":"tatoeba","sentenceId":318330,"author":"CM"}},"audio":"audio/bcbc0883a14fb520.m4a"},{"id":"ex.vocab.memory","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"memory","back":"(noun) The ability to remember things, or a specific thing that you remember.","example":{"text":"What a memory you have.","source":{"kind":"tatoeba","sentenceId":17688,"author":"Zifre"}},"audio":"audio/a3ae7ad8ecfd9fd1.m4a"},{"id":"ex.vocab.mention","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"mention","back":"(verb) To speak or write about something briefly, without giving many details.","example":{"text":"He did not mention it.","source":{"kind":"tatoeba","sentenceId":290481,"author":"CK"}},"audio":"audio/f739b9783221c781.m4a"},{"id":"ex.vocab.mess","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"mess","back":"(noun) A dirty or untidy state, or a difficult situation.","example":{"text":"Don't leave the bathroom in such a mess.","source":{"kind":"tatoeba","sentenceId":324959,"author":"CM"}},"audio":"audio/7ad74a34dd755db2.m4a"},{"id":"ex.vocab.military","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"military","back":"(noun) The armed forces of a country, such as the army, navy, and air force.","example":{"text":"Were you in the military?","source":{"kind":"tatoeba","sentenceId":2644707,"author":"CK"}},"audio":"audio/8374960e8edac499.m4a"},{"id":"ex.vocab.mind","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"mind","back":"(noun) The part of a person that thinks, feels, and remembers.","example":{"text":"Scientific truth is a creation of the human mind.","source":{"kind":"tatoeba","sentenceId":23965,"author":"Dejo"}},"audio":"audio/778c3ec1df794624.m4a"},{"id":"ex.vocab.miserable","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"miserable","back":"(adjective) Feeling very unhappy or uncomfortable.","example":{"text":"Because of her, he lived a miserable life.","source":{"kind":"tatoeba","sentenceId":388314,"author":"CK"}},"audio":"audio/64e0c13ce1c2da12.m4a"},{"id":"ex.vocab.missing","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"missing","back":"(adjective) Not in its usual place, or not present when it should be.","example":{"text":"The last page of this book is missing.","source":{"kind":"tatoeba","sentenceId":56953,"author":"Tangobango"}},"audio":"audio/fb0c4da60af7330b.m4a"},{"id":"ex.vocab.model","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"model","back":"(noun) A small copy of an object, or a particular design or type of product.","example":{"text":"I made a model plane.","source":{"kind":"tatoeba","sentenceId":261960,"author":"CK"}},"audio":"audio/8e8b843577a75942.m4a"},{"id":"ex.vocab.modern","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"modern","back":"(adjective) Relating to the present time or recent times, not old-fashioned.","example":{"text":"The furniture in his office is very modern.","source":{"kind":"tatoeba","sentenceId":286527,"author":"CK"}},"audio":"audio/785520a1beed1cec.m4a"},{"id":"ex.vocab.mood","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"mood","back":"(noun) The way you are feeling at a particular time.","example":{"text":"She's in a good mood today.","source":{"kind":"tatoeba","sentenceId":745685,"author":"CK"}},"audio":"audio/55f8235e2073ea83.m4a"},{"id":"ex.vocab.mosque","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"mosque","back":"(noun) A building where Muslims go to pray and worship God.","example":{"text":"I used to pray in the mosque.","source":{"kind":"tatoeba","sentenceId":7343407,"author":"Amastan"}},"audio":"audio/42a6435416559333.m4a"},{"id":"ex.vocab.mystery","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"mystery","back":"(noun) Something that is difficult to understand or explain.","example":{"text":"What happened to them is still a mystery.","source":{"kind":"tatoeba","sentenceId":305233,"author":"CK"}},"audio":"audio/9b38cf8a63f80973.m4a"},{"id":"ex.vocab.naked","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"naked","back":"(adjective) Not wearing any clothes.","example":{"text":"The baby was naked after its bath.","source":{"kind":"generated"}},"audio":"audio/4a17c25462f95a4f.m4a"},{"id":"ex.vocab.nap","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"nap","back":"(noun) A short sleep, usually during the day.","example":{"text":"I am having a nap.","source":{"kind":"tatoeba","sentenceId":1661101,"author":"Amastan"}},"audio":"audio/2592aa470df15c74.m4a"},{"id":"ex.vocab.narrow","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"narrow","back":"(adjective) Not wide; having a small distance from one side to the other.","example":{"text":"We walked down a narrow and winding path.","source":{"kind":"tatoeba","sentenceId":681700,"author":"Source_VOA"}},"audio":"audio/730091f48a4d5538.m4a"},{"id":"ex.vocab.nation","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"nation","back":"(noun) A large group of people who live in one country and share a common culture.","example":{"text":"Japan is a mighty nation.","source":{"kind":"tatoeba","sentenceId":281518,"author":"Lumi"}},"audio":"audio/2cb6932683570ce8.m4a"},{"id":"ex.vocab.national","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"national","back":"(adjective) Relating to a particular country or its people.","example":{"text":"He became a national hero.","source":{"kind":"tatoeba","sentenceId":296439,"author":"CK"}},"audio":"audio/17d2a1138db929f2.m4a"},{"id":"ex.vocab.natural","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"natural","back":"(adjective) Existing in nature and not made or caused by people.","example":{"text":"It's a shame the way natural resources are wasted.","source":{"kind":"tatoeba","sentenceId":278974,"author":"CM"}},"audio":"audio/80f1b3db7a5cb164.m4a"},{"id":"ex.vocab.nature","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"nature","back":"(noun) All the plants, animals, and things in the world not made by people.","example":{"text":"We are to preserve nature.","source":{"kind":"tatoeba","sentenceId":22929,"author":"Whiskkebarr"}},"audio":"audio/4049cf479c91a45b.m4a"},{"id":"ex.vocab.nearly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"nearly","back":"(adverb) Almost; very close to.","example":{"text":"I nearly made a mistake.","source":{"kind":"tatoeba","sentenceId":67451,"author":"CK"}},"audio":"audio/7e86fdbf8df36636.m4a"},{"id":"ex.vocab.necessary","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"necessary","back":"(adjective) Needed for a purpose or a reason; essential.","example":{"text":"Pure water is necessary to our daily life.","source":{"kind":"tatoeba","sentenceId":63078,"author":"Zifre"}},"audio":"audio/da9b5f1a3eb73ddd.m4a"},{"id":"ex.vocab.negative","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"negative","back":"(adjective) Bad or harmful; not positive or hopeful.","example":{"text":"Tom's behaviour had very negative effects on his workmates.","source":{"kind":"tatoeba","sentenceId":2942899,"author":"patgfisher"}},"audio":"audio/e3516de64c15d59b.m4a"},{"id":"ex.vocab.neither","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"neither","back":"(determiner) Not one and not the other of two things or people.","example":{"text":"I like neither of them.","source":{"kind":"tatoeba","sentenceId":37918,"author":"CK"}},"audio":"audio/f24124713c88f6c3.m4a"},{"id":"ex.vocab.nervous","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"nervous","back":"(adjective) Feeling worried or a little afraid about something that is going to happen.","example":{"text":"He felt nervous about the result.","source":{"kind":"tatoeba","sentenceId":290740,"author":"CK"}},"audio":"audio/d1acab4e657974f1.m4a"},{"id":"ex.vocab.nightmare","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"nightmare","back":"(noun) A very frightening or unpleasant dream.","example":{"text":"I just had a nightmare.","source":{"kind":"tatoeba","sentenceId":2646055,"author":"CK"}},"audio":"audio/a069046e34544569.m4a"},{"id":"ex.vocab.none","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"none","back":"(pronoun) Not any amount or number of something.","example":{"text":"I wanted some salt, but there was none in the jar.","source":{"kind":"tatoeba","sentenceId":25757,"author":"CK"}},"audio":"audio/eaaf0d9dcbade3b9.m4a"},{"id":"ex.vocab.nor","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"nor","back":"(conjunction) Used after \"neither\" to introduce the second of two things that are not true.","example":{"text":"It's neither good nor bad.","source":{"kind":"tatoeba","sentenceId":42202,"author":"CK"}},"audio":"audio/26471f9ad28818c2.m4a"},{"id":"ex.vocab.northern","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"northern","back":"(adjective) In or from the north.","example":{"text":"Canada borders the northern part of the United States.","source":{"kind":"tatoeba","sentenceId":63632,"author":"Luornu"}},"audio":"audio/88b9ed65d41b089b.m4a"},{"id":"ex.vocab.notice","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"notice","back":"(verb) To see or become aware of something.","example":{"text":"Did you notice any change?","source":{"kind":"tatoeba","sentenceId":25314,"author":"CK"}},"audio":"audio/cfee3cfa78929d4c.m4a"},{"id":"ex.vocab.novel","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"novel","back":"(noun) A long written story about imaginary people and events.","example":{"text":"The novel is very exciting.","source":{"kind":"tatoeba","sentenceId":58484,"author":"CK"}},"audio":"audio/7c0ad0fc9abba231.m4a"},{"id":"ex.vocab.nowadays","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"nowadays","back":"(adverb) At the present time; in these modern times.","example":{"text":"Nowadays many people travel by car.","source":{"kind":"tatoeba","sentenceId":243821,"author":"CK"}},"audio":"audio/6d44fab17c12b33d.m4a"},{"id":"ex.vocab.nowhere","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"nowhere","back":"(adverb) Not in or to any place.","example":{"text":"Tom has nowhere to go.","source":{"kind":"tatoeba","sentenceId":2547015,"author":"CK"}},"audio":"audio/07bd4b0deb6033c0.m4a"},{"id":"ex.vocab.obey","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"obey","back":"(verb) To do what someone tells you to do, or to follow a rule or law.","example":{"text":"You should obey your parents.","source":{"kind":"tatoeba","sentenceId":237640,"author":"CK"}},"audio":"audio/837243e1ae825f13.m4a"},{"id":"ex.vocab.observe","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"observe","back":"(verb) To watch carefully, especially to learn something, or to notice something.","example":{"text":"The doctor continued to observe the patient's behavior.","source":{"kind":"tatoeba","sentenceId":27993,"author":"CK"}},"audio":"audio/fbe563990d376022.m4a"},{"id":"ex.vocab.obvious","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"obvious","back":"(adjective) Easy to see, understand, or recognize.","example":{"text":"I thought it was obvious.","source":{"kind":"tatoeba","sentenceId":2545613,"author":"CK"}},"audio":"audio/6642d2f2f4a0a646.m4a"},{"id":"ex.vocab.obviously","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"obviously","back":"(adverb) In a way that is easy to see, understand, or know.","example":{"text":"It was obviously a joke.","source":{"kind":"tatoeba","sentenceId":2182771,"author":"Hybrid"}},"audio":"audio/577a874898fd372c.m4a"},{"id":"ex.vocab.odd","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"odd","back":"(adjective) Strange or unusual; different from what is expected.","example":{"text":"Tom is a little odd.","source":{"kind":"tatoeba","sentenceId":2400187,"author":"CK"}},"audio":"audio/d8c9c08322a6b179.m4a"},{"id":"ex.vocab.offer","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"offer","back":"(verb) To present something for someone to accept or reject; to say you are willing to do something.","example":{"text":"May I offer you a drink?","source":{"kind":"tatoeba","sentenceId":27108,"author":"CK"}},"audio":"audio/92091c5265781748.m4a"},{"id":"ex.vocab.official","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"official","back":"(adjective) Approved by or coming from someone in authority.","example":{"text":"The soldier received official permission to leave.","source":{"kind":"tatoeba","sentenceId":681628,"author":"Source_VOA"}},"audio":"audio/7ff7ff982704fa23.m4a"},{"id":"ex.vocab.oil","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"oil","back":"(noun) A thick, smooth liquid that does not mix with water, used for cooking or fuel.","example":{"text":"Put the meat in the frying pan after the oil has spread.","source":{"kind":"tatoeba","sentenceId":34282,"author":"CM"}},"audio":"audio/2cb83a298dfd5b68.m4a"},{"id":"ex.vocab.operate","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"operate","back":"(verb) To control a machine or system, or to perform a medical surgery.","example":{"text":"How do you operate this machine?","source":{"kind":"tatoeba","sentenceId":59810,"author":"CK"}},"audio":"audio/847020548fac28dd.m4a"},{"id":"ex.vocab.operation","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"operation","back":"(noun) A medical procedure where doctors cut into a body to repair or remove something.","example":{"text":"Do I need an operation?","source":{"kind":"tatoeba","sentenceId":266016,"author":"CK"}},"audio":"audio/a60c3fd6934d84a5.m4a"},{"id":"ex.vocab.opinion","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"opinion","back":"(noun) Your thoughts or beliefs about something, not necessarily based on facts.","example":{"text":"Do you have an opinion?","source":{"kind":"tatoeba","sentenceId":25198,"author":"CK"}},"audio":"audio/ac3eb19203be0603.m4a"},{"id":"ex.vocab.opportunity","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"opportunity","back":"(noun) A chance to do something, or a situation that makes it possible.","example":{"text":"You should see this film if you get the opportunity.","source":{"kind":"tatoeba","sentenceId":20494,"author":"CK"}},"audio":"audio/860e064313519688.m4a"},{"id":"ex.vocab.option","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"option","back":"(noun) A choice you can make, or something you can choose.","example":{"text":"We had no other option.","source":{"kind":"tatoeba","sentenceId":2645695,"author":"CK"}},"audio":"audio/b52550d3824dea48.m4a"},{"id":"ex.vocab.organize","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"organize","back":"(verb) To arrange or put things into a structured order, or to plan an event.","example":{"text":"I just organized my desk.","source":{"kind":"tatoeba","sentenceId":2372871,"author":"CK"}},"audio":"audio/37bb41c412febe81.m4a"},{"id":"ex.vocab.ourselves","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"ourselves","back":"(pronoun) Used to refer to 'we' or 'us' when we are the object of an action we perform.","example":{"text":"We enjoyed ourselves at the seaside.","source":{"kind":"tatoeba","sentenceId":262933,"author":"CK"}},"audio":"audio/30fe05808ca5cb10.m4a"},{"id":"ex.vocab.owe","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"owe","back":"(verb) To have to pay money back to someone.","example":{"text":"I owe you five dollars for the coffee.","source":{"kind":"generated"}},"audio":"audio/0f8d02e4294c4eb0.m4a"},{"id":"ex.vocab.package","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"package","back":"(noun) An object or set of objects wrapped in paper or packed in a box.","example":{"text":"Help me lift the package.","source":{"kind":"tatoeba","sentenceId":320951,"author":"CK"}},"audio":"audio/61e03dbbef89d3b5.m4a"},{"id":"ex.vocab.pale","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pale","back":"(adjective) Having skin that is lighter than usual, often because of illness or fear.","example":{"text":"Tom is a bit pale.","source":{"kind":"tatoeba","sentenceId":2548999,"author":"CK"}},"audio":"audio/0223ecc646223652.m4a"},{"id":"ex.vocab.panic","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"panic","back":"(noun) A sudden strong feeling of fear that makes you unable to think clearly.","example":{"text":"The fire caused a panic in the theater.","source":{"kind":"tatoeba","sentenceId":23835,"author":"CK"}},"audio":"audio/5529102d485c885f.m4a"},{"id":"ex.vocab.password","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"password","back":"(noun) A secret word or phrase you must use to prove who you are, often for computer access.","example":{"text":"What is the password to your computer?","source":{"kind":"tatoeba","sentenceId":3378150,"author":"Jesse"}},"audio":"audio/b9dbe8bdd8be0dc7.m4a"},{"id":"ex.vocab.path","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"path","back":"(noun) A narrow way made by people walking, or a route that someone takes.","example":{"text":"She was walking along a garden path.","source":{"kind":"tatoeba","sentenceId":315901,"author":"CM"}},"audio":"audio/2a2b4e3336442255.m4a"},{"id":"ex.vocab.patience","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"patience","back":"(noun) The ability to stay calm and not get annoyed when waiting or dealing with problems.","example":{"text":"Mastering a foreign language calls for patience.","source":{"kind":"tatoeba","sentenceId":21915,"author":"CK"}},"audio":"audio/375cb6721fdabf9a.m4a"},{"id":"ex.vocab.patient","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"patient","back":"(adjective) Able to wait calmly for a long time or deal with problems without becoming annoyed.","example":{"text":"You have to be patient.","source":{"kind":"tatoeba","sentenceId":20305,"author":"CK"}},"audio":"audio/7635f2f992e6eec8.m4a"},{"id":"ex.vocab.peace","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"peace","back":"(noun) A state of quiet and calm, or a time without war.","example":{"text":"We all hope for peace.","source":{"kind":"tatoeba","sentenceId":248327,"author":"CK"}},"audio":"audio/ddd32bf584f39a25.m4a"},{"id":"ex.vocab.peel","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"peel","back":"(verb) To remove the skin or outer layer from a fruit or vegetable.","example":{"text":"Peel the orange and give me a piece.","source":{"kind":"tatoeba","sentenceId":2267643,"author":"_undertoad"}},"audio":"audio/8b13d4bc6d1063fc.m4a"},{"id":"ex.vocab.perfectly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"perfectly","back":"(adverb) In a way that is complete and without any mistakes or flaws.","example":{"text":"That word describes it perfectly.","source":{"kind":"tatoeba","sentenceId":48184,"author":"CK"}},"audio":"audio/13faffd45b66f73e.m4a"},{"id":"ex.vocab.perform","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"perform","back":"(verb) To do an action or a task, or to entertain an audience.","example":{"text":"You should perform regular maintenance on your car.","source":{"kind":"tatoeba","sentenceId":2451879,"author":"Hybrid"}},"audio":"audio/22eb48c5c95ce411.m4a"},{"id":"ex.vocab.performance","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"performance","back":"(noun) An act of entertaining people, like singing, dancing, or acting, in front of an audience.","example":{"text":"The spectators were moved by her graceful performance.","source":{"kind":"tatoeba","sentenceId":20944,"author":"Zifre"}},"audio":"audio/4792caa904bb29c3.m4a"},{"id":"ex.vocab.perhaps","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"perhaps","back":"(adverb) Used to say that something is possible, but not certain.","example":{"text":"Perhaps I'll like this book.","source":{"kind":"tatoeba","sentenceId":274983,"author":"CK"}},"audio":"audio/d3ef195f4def75b2.m4a"},{"id":"ex.vocab.period","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"period","back":"(noun) A length of time.","example":{"text":"The party stayed in Kyoto for a short period.","source":{"kind":"tatoeba","sentenceId":27787,"author":"CK"}},"audio":"audio/de941a7201fa02c3.m4a"},{"id":"ex.vocab.permission","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"permission","back":"(noun) The act of allowing someone to do something, or the official approval to do it.","example":{"text":"No one is to leave without permission.","source":{"kind":"tatoeba","sentenceId":276619,"author":"CK"}},"audio":"audio/455081387860db37.m4a"},{"id":"ex.vocab.personal","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"personal","back":"(adjective) Relating to a particular person, rather than to anyone else.","example":{"text":"Let me give you my personal opinion.","source":{"kind":"tatoeba","sentenceId":262466,"author":"CK"}},"audio":"audio/6a23f04e51afa0af.m4a"},{"id":"ex.vocab.personality","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"personality","back":"(noun) The qualities that make a person unique and affect how they behave.","example":{"text":"Tom has an outgoing personality.","source":{"kind":"tatoeba","sentenceId":1025437,"author":"CK"}},"audio":"audio/c59728ad22aadeb2.m4a"},{"id":"ex.vocab.personally","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"personally","back":"(adverb) Done by you and not by someone else, or giving your own opinion.","example":{"text":"Personally, I don't think we should be doing this.","source":{"kind":"tatoeba","sentenceId":1898276,"author":"CK"}},"audio":"audio/7e681f0540215076.m4a"},{"id":"ex.vocab.pilot","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pilot","back":"(noun) A person who operates the controls of an aircraft or spacecraft.","example":{"text":"The pilot will land the plane.","source":{"kind":"tatoeba","sentenceId":1056424,"author":"sundown"}},"audio":"audio/f55499d64162e0f3.m4a"},{"id":"ex.vocab.pleasant","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pleasant","back":"(adjective) Making you feel happy or comfortable.","example":{"text":"It was such a pleasant day that we went for a walk.","source":{"kind":"tatoeba","sentenceId":37836,"author":"CK"}},"audio":"audio/cd232185a5f50b7a.m4a"},{"id":"ex.vocab.pleasure","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pleasure","back":"(noun) A feeling of happiness, enjoyment, or satisfaction.","example":{"text":"We derive a lot of pleasure from books.","source":{"kind":"tatoeba","sentenceId":263279,"author":"CK"}},"audio":"audio/3fd69e1aa06d1524.m4a"},{"id":"ex.vocab.plenty","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"plenty","back":"(determiner) A large amount or number of something, more than enough.","example":{"text":"We have plenty of time.","source":{"kind":"tatoeba","sentenceId":248793,"author":"CK"}},"audio":"audio/2eda35db5ca605a9.m4a"},{"id":"ex.vocab.poem","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"poem","back":"(noun) A piece of writing that expresses feelings or ideas, often using rhythm and rhyme.","example":{"text":"The poet wrote many poems.","source":{"kind":"tatoeba","sentenceId":47319,"author":"shekitten"}},"audio":"audio/16f363f72093db4a.m4a"},{"id":"ex.vocab.polite","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"polite","back":"(adjective) Having good manners and showing respect for others.","example":{"text":"That nurse is very kind and polite.","source":{"kind":"tatoeba","sentenceId":68475,"author":"CK"}},"audio":"audio/71f140b1ac23e388.m4a"},{"id":"ex.vocab.politician","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"politician","back":"(noun) A person who works in government, often by being elected.","example":{"text":"Many politicians don't keep their promises.","source":{"kind":"tatoeba","sentenceId":619288,"author":"CK"}},"audio":"audio/29e05924865f21b8.m4a"},{"id":"ex.vocab.pond","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pond","back":"(noun) A small area of still water, smaller than a lake, either natural or artificial.","example":{"text":"There are a lot of fish in the pond.","source":{"kind":"tatoeba","sentenceId":277298,"author":"CK"}},"audio":"audio/42f36d5615faa97a.m4a"},{"id":"ex.vocab.pop","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pop","back":"(verb) To make a short, sharp sound, or to burst open.","example":{"text":"This popcorn tastes stale. I wonder when it was popped.","source":{"kind":"tatoeba","sentenceId":1075855,"author":"CK"}},"audio":"audio/2ec533ebeff0ac29.m4a"},{"id":"ex.vocab.porch","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"porch","back":"(noun) A covered area at the entrance to a house, usually with a roof and open sides.","example":{"text":"Let's wait on the porch.","source":{"kind":"tatoeba","sentenceId":3392557,"author":"CK"}},"audio":"audio/97821c4d266ee008.m4a"},{"id":"ex.vocab.position","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"position","back":"(noun) The place where someone or something is, or a job in a company.","example":{"text":"What position do you hold?","source":{"kind":"tatoeba","sentenceId":17075,"author":"Zifre"}},"audio":"audio/c646a772c76c8167.m4a"},{"id":"ex.vocab.positive","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"positive","back":"(adjective) Feeling good about things and expecting good results.","example":{"text":"You have to be positive.","source":{"kind":"tatoeba","sentenceId":3821431,"author":"CK"}},"audio":"audio/475684e26644beda.m4a"},{"id":"ex.vocab.possibility","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"possibility","back":"(noun) The chance that something might happen or be true.","example":{"text":"There's no possibility of his coming.","source":{"kind":"tatoeba","sentenceId":284303,"author":"CK"}},"audio":"audio/3d85a6fe0685f769.m4a"},{"id":"ex.vocab.possibly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"possibly","back":"(adverb) Used to say that something might happen or be true, but is not certain.","example":{"text":"Tom might possibly know the answer.","source":{"kind":"tatoeba","sentenceId":1024442,"author":"CK"}},"audio":"audio/beaa5cdd8b00afb8.m4a"},{"id":"ex.vocab.pot","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pot","back":"(noun) A round container, usually made of metal or clay, used for cooking or holding plants.","example":{"text":"Steam is rising from the pot.","source":{"kind":"tatoeba","sentenceId":268555,"author":"sundown"}},"audio":"audio/ee2a093075e4d410.m4a"},{"id":"ex.vocab.pour","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pour","back":"(verb) To make a liquid flow out of a container, or to flow in a steady stream.","example":{"text":"Tom poured himself a glass of milk.","source":{"kind":"tatoeba","sentenceId":1093134,"author":"CK"}},"audio":"audio/131b0f1778575fee.m4a"},{"id":"ex.vocab.power","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"power","back":"(noun) The ability to control people or things, or to do something.","example":{"text":"The king abused his power.","source":{"kind":"tatoeba","sentenceId":25640,"author":"CK"}},"audio":"audio/94e3bb053d782ad6.m4a"},{"id":"ex.vocab.powerful","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"powerful","back":"(adjective) Having great strength, influence, or effect.","example":{"text":"Tom is a powerful man.","source":{"kind":"tatoeba","sentenceId":2944587,"author":"Hybrid"}},"audio":"audio/739251a71ee45841.m4a"},{"id":"ex.vocab.praise","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"praise","back":"(verb) To express approval or admiration for someone or something.","example":{"text":"He praised the girl for her honesty.","source":{"kind":"tatoeba","sentenceId":291021,"author":"CK"}},"audio":"audio/15c1e98fe7755d96.m4a"},{"id":"ex.vocab.pray","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pray","back":"(verb) To speak to God or a god, often to ask for something or to give thanks.","example":{"text":"We prayed for their happiness.","source":{"kind":"tatoeba","sentenceId":305202,"author":"CK"}},"audio":"audio/0a32dab6eb557b1c.m4a"},{"id":"ex.vocab.pregnant","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pregnant","back":"(adjective) When a woman has a baby growing inside her body.","example":{"text":"My friend is pregnant and due next month.","source":{"kind":"generated"}},"audio":"audio/a1a0ca1b45d3e223.m4a"},{"id":"ex.vocab.president","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"president","back":"(noun) The leader of a country, a company, or an organization.","example":{"text":"Tell me three American presidents!","source":{"kind":"tatoeba","sentenceId":10620620,"author":"belvis"}},"audio":"audio/a196f3d712226874.m4a"},{"id":"ex.vocab.press","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"press","back":"(verb) To push something firmly, or to push a button to make a machine work.","example":{"text":"Press this button to start the machine.","source":{"kind":"tatoeba","sentenceId":20475,"author":"CK"}},"audio":"audio/1dc3f819096124a3.m4a"},{"id":"ex.vocab.pretend","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pretend","back":"(verb) To behave as if something is true when you know it is not.","example":{"text":"Let's pretend we are aliens.","source":{"kind":"tatoeba","sentenceId":32117,"author":"Hautis"}},"audio":"audio/a5a1ee8905df393e.m4a"},{"id":"ex.vocab.prison","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"prison","back":"(noun) A building where people are kept as punishment for a crime, or while waiting for trial.","example":{"text":"Prisons are where criminals go to be punished.","source":{"kind":"tatoeba","sentenceId":11132388,"author":"CK"}},"audio":"audio/cc491c84c9da9f05.m4a"},{"id":"ex.vocab.private","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"private","back":"(adjective) For the use of one person or group only, not for everyone.","example":{"text":"You are not allowed here. This is private property.","source":{"kind":"tatoeba","sentenceId":681798,"author":"Source_VOA"}},"audio":"audio/5a3fb0020c2d6e85.m4a"},{"id":"ex.vocab.probably","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"probably","back":"(adverb) Almost certainly; very likely to happen or be true.","example":{"text":"Those dark clouds will probably bring rain.","source":{"kind":"tatoeba","sentenceId":67018,"author":"CM"}},"audio":"audio/e058286235b2b237.m4a"},{"id":"ex.vocab.process","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"process","back":"(noun) A series of actions or steps taken to achieve a particular result.","example":{"text":"It's a very slow process.","source":{"kind":"tatoeba","sentenceId":5040299,"author":"CK"}},"audio":"audio/624cc47e135c731f.m4a"},{"id":"ex.vocab.produce","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"produce","back":"(verb) To make or create something, or to show something.","example":{"text":"Japan has produced more cars than ever this year.","source":{"kind":"tatoeba","sentenceId":281537,"author":"CM"}},"audio":"audio/8e50daf4dbd106ad.m4a"},{"id":"ex.vocab.product","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"product","back":"(noun) Something that is made or grown to be sold.","example":{"text":"The new product is on sale.","source":{"kind":"tatoeba","sentenceId":46089,"author":"sundown"}},"audio":"audio/a38102d146725055.m4a"},{"id":"ex.vocab.professor","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"professor","back":"(noun) A teacher of the highest rank in a university.","example":{"text":"This article was written by a college professor.","source":{"kind":"tatoeba","sentenceId":59737,"author":"CK"}},"audio":"audio/647bb0dde616155c.m4a"},{"id":"ex.vocab.progress","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"progress","back":"(noun) The process of improving or developing over a period of time.","example":{"text":"The students are making good progress in English.","source":{"kind":"tatoeba","sentenceId":21331,"author":"CK"}},"audio":"audio/914854d5099fab91.m4a"},{"id":"ex.vocab.project","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"project","back":"(noun) A planned piece of work that has a specific purpose and usually takes a lot of time.","example":{"text":"We began on a new project.","source":{"kind":"tatoeba","sentenceId":22888,"author":"CK"}},"audio":"audio/54ba82924935bcad.m4a"},{"id":"ex.vocab.promise","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"promise","back":"(verb) To tell someone that you will definitely do something or that something will happen.","example":{"text":"She promised to look into the matter immediately.","source":{"kind":"tatoeba","sentenceId":43633,"author":"CM"}},"audio":"audio/490a4af833adbe49.m4a"},{"id":"ex.vocab.properly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"properly","back":"(adverb) In a correct or suitable way.","example":{"text":"The pump didn't work properly.","source":{"kind":"tatoeba","sentenceId":2073712,"author":"CK"}},"audio":"audio/cd89a21d90d279f4.m4a"},{"id":"ex.vocab.property","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"property","back":"(noun) Something that someone owns, like land, a building, or objects.","example":{"text":"Tom owns a large piece of property.","source":{"kind":"tatoeba","sentenceId":3410868,"author":"CK"}},"audio":"audio/3f56fafdbec8e35e.m4a"},{"id":"ex.vocab.protect","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"protect","back":"(verb) To keep someone or something safe from harm, injury, or damage.","example":{"text":"We should tell children how to protect themselves.","source":{"kind":"tatoeba","sentenceId":263070,"author":"CK"}},"audio":"audio/9b008bdd9dcfb95b.m4a"},{"id":"ex.vocab.proud","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"proud","back":"(adjective) Feeling pleased and satisfied about something you own, have done, or are connected to.","example":{"text":"I'm proud of my son.","source":{"kind":"tatoeba","sentenceId":259233,"author":"CK"}},"audio":"audio/f8b1fa6085421fc7.m4a"},{"id":"ex.vocab.prove","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"prove","back":"(verb) To show that something is true or correct.","example":{"text":"He proved to be a spy.","source":{"kind":"tatoeba","sentenceId":290309,"author":"CM"}},"audio":"audio/7dd39e85575777aa.m4a"},{"id":"ex.vocab.provide","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"provide","back":"(verb) To give something to someone, or to make something available.","example":{"text":"Cows provide us with milk.","source":{"kind":"tatoeba","sentenceId":19495,"author":"CK"}},"audio":"audio/097ca929d1046e02.m4a"},{"id":"ex.vocab.public","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"public","back":"(adjective) Relating to all the people in a community or country, rather than private.","example":{"text":"Where is a public telephone?","source":{"kind":"tatoeba","sentenceId":240476,"author":"CK"}},"audio":"audio/c9d232a1bd400511.m4a"},{"id":"ex.vocab.publish","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"publish","back":"(verb) To produce and distribute books, magazines, or other written material.","example":{"text":"When will his new novel be published?","source":{"kind":"tatoeba","sentenceId":1938925,"author":"CK"}},"audio":"audio/773efc6cde19299a.m4a"},{"id":"ex.vocab.punch","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"punch","back":"(verb) To hit something or someone hard with your closed hand.","example":{"text":"Tom punched John's arm lightly.","source":{"kind":"tatoeba","sentenceId":7004743,"author":"Hybrid"}},"audio":"audio/5d2ab176e60f0c92.m4a"},{"id":"ex.vocab.punish","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"punish","back":"(verb) To make someone suffer because they have done something wrong.","example":{"text":"Because he lied, he was punished.","source":{"kind":"tatoeba","sentenceId":65623,"author":"CK"}},"audio":"audio/fca9438ef64d02fd.m4a"},{"id":"ex.vocab.pupil","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pupil","back":"(noun) A student, especially a young one in primary school.","example":{"text":"A teacher is sitting among the pupils.","source":{"kind":"tatoeba","sentenceId":272794,"author":"sundown"}},"audio":"audio/19253b6e51da3c4f.m4a"},{"id":"ex.vocab.pure","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"pure","back":"(adjective) Not mixed with anything else; clean and free from harmful substances.","example":{"text":"We must be careful to drink only pure water.","source":{"kind":"tatoeba","sentenceId":63079,"author":"Luornu"}},"audio":"audio/b3864fe3532a7f29.m4a"},{"id":"ex.vocab.purpose","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"purpose","back":"(noun) The reason for which something is done or created, or the aim you want to achieve.","example":{"text":"I have to attain my purpose at all costs.","source":{"kind":"tatoeba","sentenceId":36743,"author":"CM"}},"audio":"audio/048501ee12fade55.m4a"},{"id":"ex.vocab.puzzle","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"puzzle","back":"(noun) A game or problem that tests your knowledge or skill to solve it.","example":{"text":"I have a puzzle to solve.","source":{"kind":"tatoeba","sentenceId":2358792,"author":"CK"}},"audio":"audio/4d9179f0cd124921.m4a"},{"id":"ex.vocab.quality","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"quality","back":"(noun) How good or bad something is, or a feature that something has.","example":{"text":"I prefer quality to quantity.","source":{"kind":"tatoeba","sentenceId":262238,"author":"CK"}},"audio":"audio/f71fab2208e6efc3.m4a"},{"id":"ex.vocab.quit","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"quit","back":"(verb) To stop doing something or leave a job or place.","example":{"text":"I wanna quit my job.","source":{"kind":"tatoeba","sentenceId":241763,"author":"CM"}},"audio":"audio/6830ec93cb701af3.m4a"},{"id":"ex.vocab.rare","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rare","back":"(adjective) Not happening or seen very often; uncommon.","example":{"text":"It's rare to find big yards in Japan.","source":{"kind":"tatoeba","sentenceId":281227,"author":"CK"}},"audio":"audio/6f39e7f5e30c54d0.m4a"},{"id":"ex.vocab.rate","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rate","back":"(noun) The speed at which something happens or changes, or a cost for a service.","example":{"text":"Bank lending is rising because of lower interest rates.","source":{"kind":"tatoeba","sentenceId":18463,"author":"Zifre"}},"audio":"audio/10eca0eec3a860db.m4a"},{"id":"ex.vocab.rather","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rather","back":"(adverb) Used to mean \"more willingly\" or \"prefer to\".","example":{"text":"I would rather go out than stay at home.","source":{"kind":"tatoeba","sentenceId":24267,"author":"Dejo"}},"audio":"audio/2961ecfce8dda607.m4a"},{"id":"ex.vocab.react","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"react","back":"(verb) To behave in a particular way as a result of something that has happened.","example":{"text":"Tom reacted angrily to the sentence.","source":{"kind":"tatoeba","sentenceId":3851311,"author":"Amastan"}},"audio":"audio/fd7b40f3c6345e09.m4a"},{"id":"ex.vocab.reality","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"reality","back":"(noun) The state of things as they actually exist, rather than as they may be imagined.","example":{"text":"It is not always easy to face reality.","source":{"kind":"tatoeba","sentenceId":239600,"author":"CM"}},"audio":"audio/b3618b5696dfddcb.m4a"},{"id":"ex.vocab.reasonable","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"reasonable","back":"(adjective) Fair and sensible; not too expensive or extreme.","example":{"text":"If the price is reasonable, I want to buy the car.","source":{"kind":"tatoeba","sentenceId":276956,"author":"CK"}},"audio":"audio/d591d0ae5c60cdd8.m4a"},{"id":"ex.vocab.recently","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"recently","back":"(adverb) Not long ago; in the near past.","example":{"text":"I haven't seen much of him recently.","source":{"kind":"tatoeba","sentenceId":243851,"author":"CK"}},"audio":"audio/e938362b5aaf3c1f.m4a"},{"id":"ex.vocab.recognize","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"recognize","back":"(verb) To know who someone is or what something is because you have seen or heard them before.","example":{"text":"I recognized him at once.","source":{"kind":"tatoeba","sentenceId":253984,"author":"CK"}},"audio":"audio/fc092c70d8ac61d1.m4a"},{"id":"ex.vocab.recommend","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"recommend","back":"(verb) To suggest that someone or something is good or suitable.","example":{"text":"Can you recommend a hotel?","source":{"kind":"tatoeba","sentenceId":642536,"author":"CK"}},"audio":"audio/4f0e098097fb1552.m4a"},{"id":"ex.vocab.record","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"record","back":"(noun) A piece of information or a description of events kept for the future.","example":{"text":"Your record in mathematics is good.","source":{"kind":"tatoeba","sentenceId":69176,"author":"Lumi_alt"}},"audio":"audio/a4ec7dfa0f32858a.m4a"},{"id":"ex.vocab.recover","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"recover","back":"(verb) To get back to a normal state, especially after an illness, shock, or loss.","example":{"text":"I recovered from my illness.","source":{"kind":"tatoeba","sentenceId":261453,"author":"CM"}},"audio":"audio/fad2cdeeaa2c87f6.m4a"},{"id":"ex.vocab.reduce","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"reduce","back":"(verb) To make something smaller in amount, size, or degree.","example":{"text":"I've reduced the amount of meat I eat.","source":{"kind":"tatoeba","sentenceId":1293302,"author":"CK"}},"audio":"audio/193b882fba3eff27.m4a"},{"id":"ex.vocab.refuse","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"refuse","back":"(verb) To say that you will not do something or will not accept something.","example":{"text":"Unfortunately he refused to come.","source":{"kind":"tatoeba","sentenceId":71934,"author":"CK"}},"audio":"audio/2d60234c3489e71c.m4a"},{"id":"ex.vocab.region","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"region","back":"(noun) A large area of a country or the world, usually without exact borders.","example":{"text":"A dialect is a specific form of a language, spoken in a certain region.","source":{"kind":"tatoeba","sentenceId":3345601,"author":"_undertoad"}},"audio":"audio/3efe4f84ff9c6340.m4a"},{"id":"ex.vocab.register","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"register","back":"(verb) To put your name or information on an official list, or to show a measurement.","example":{"text":"The thermometer registered minus ten last night.","source":{"kind":"tatoeba","sentenceId":244774,"author":"CM"}},"audio":"audio/37a91b2cd6862ed3.m4a"},{"id":"ex.vocab.regular","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"regular","back":"(adjective) Happening or done often, or at fixed times, with equal amounts of time between.","example":{"text":"You must practice it at regular intervals.","source":{"kind":"tatoeba","sentenceId":16550,"author":"Zifre"}},"audio":"audio/db3292f32efc5d52.m4a"},{"id":"ex.vocab.reject","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"reject","back":"(verb) To refuse to accept or agree with something or someone.","example":{"text":"The chairman rejected his absurd proposal.","source":{"kind":"tatoeba","sentenceId":19996,"author":"CK"}},"audio":"audio/0e070a0c6eb52ecb.m4a"},{"id":"ex.vocab.relate","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"relate","back":"(verb) To show or make a connection between two or more things.","example":{"text":"How is the discovery related to the progress of science?","source":{"kind":"tatoeba","sentenceId":44441,"author":"Zifre"}},"audio":"audio/2894c16a315bcb06.m4a"},{"id":"ex.vocab.relationship","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"relationship","back":"(noun) The way in which two or more people or things are connected, or the state of being connected.","example":{"text":"Tom and Mary don't have a good relationship.","source":{"kind":"tatoeba","sentenceId":1095989,"author":"CK"}},"audio":"audio/3a195152b299cb4f.m4a"},{"id":"ex.vocab.relative","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"relative","back":"(noun) A member of your family.","example":{"text":"Tom's only living relative is an uncle living in Boston.","source":{"kind":"tatoeba","sentenceId":3619368,"author":"CK"}},"audio":"audio/5236ebcfcc098cbb.m4a"},{"id":"ex.vocab.release","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"release","back":"(verb) To let someone or something go free, or to make something available to the public.","example":{"text":"They refused to release the hostages.","source":{"kind":"tatoeba","sentenceId":802388,"author":"Source_VOA"}},"audio":"audio/d807b60bdef04ded.m4a"},{"id":"ex.vocab.religion","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"religion","back":"(noun) A system of faith and worship, often involving a belief in a god or gods.","example":{"text":"Tom has studied many religions.","source":{"kind":"tatoeba","sentenceId":6530520,"author":"CK"}},"audio":"audio/1e90ea13d952f807.m4a"},{"id":"ex.vocab.religious","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"religious","back":"(adjective) Believing in and worshipping a god or gods; connected with religion.","example":{"text":"Tom is a very religious man.","source":{"kind":"tatoeba","sentenceId":5825602,"author":"CK"}},"audio":"audio/9e97750d09d9e645.m4a"},{"id":"ex.vocab.rely","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rely","back":"(verb) To need or depend on someone or something.","example":{"text":"You can rely on me.","source":{"kind":"tatoeba","sentenceId":275739,"author":"CK"}},"audio":"audio/98a0b67f18833a41.m4a"},{"id":"ex.vocab.remain","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"remain","back":"(verb) To stay in the same place or condition; to not leave or change.","example":{"text":"Please remain seated until the bus stops completely.","source":{"kind":"tatoeba","sentenceId":35428,"author":"CK"}},"audio":"audio/9e3583f225859045.m4a"},{"id":"ex.vocab.remind","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"remind","back":"(verb) To make someone remember something, or to tell them to remember to do something.","example":{"text":"Will you remind me to post these letters?","source":{"kind":"tatoeba","sentenceId":55186,"author":"sundown"}},"audio":"audio/08d0554f276cb8a7.m4a"},{"id":"ex.vocab.remove","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"remove","back":"(verb) To take something away from where it is.","example":{"text":"Soap helps remove the dirt.","source":{"kind":"tatoeba","sentenceId":272214,"author":"CM"}},"audio":"audio/83cad5827713e905.m4a"},{"id":"ex.vocab.repair","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"repair","back":"(verb) To fix something that is broken or damaged.","example":{"text":"Can you get it repaired?","source":{"kind":"tatoeba","sentenceId":36526,"author":"CK"}},"audio":"audio/c5543f991d92eb6d.m4a"},{"id":"ex.vocab.replace","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"replace","back":"(verb) To take the place of something or someone, or to put something new in place of an old one.","example":{"text":"I'd like to replace it.","source":{"kind":"tatoeba","sentenceId":320461,"author":"CK"}},"audio":"audio/b6d3204835e06460.m4a"},{"id":"ex.vocab.reply","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"reply","back":"(verb) To answer someone by speaking or writing.","example":{"text":"\"That's fine,\" replied the girl. \"I'll take ten yards.\"","source":{"kind":"tatoeba","sentenceId":73771,"author":"Zifre"}},"audio":"audio/af23fd9bb4c6f615.m4a"},{"id":"ex.vocab.report","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"report","back":"(noun) A written or spoken description of an event or situation.","example":{"text":"When do we hand in the report?","source":{"kind":"tatoeba","sentenceId":66044,"author":"CM"}},"audio":"audio/032e96413098a3f8.m4a"},{"id":"ex.vocab.request","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"request","back":"(noun) An act of asking for something politely or formally.","example":{"text":"I did so at his request.","source":{"kind":"tatoeba","sentenceId":260541,"author":"CM"}},"audio":"audio/e7f1d3f0590f0180.m4a"},{"id":"ex.vocab.require","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"require","back":"(verb) To need something, or to make something necessary.","example":{"text":"The plan requires a large sum of money.","source":{"kind":"tatoeba","sentenceId":48562,"author":"CM"}},"audio":"audio/d8586e5ff9882f11.m4a"},{"id":"ex.vocab.rescue","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rescue","back":"(verb) To save someone or something from a dangerous or unpleasant situation.","example":{"text":"The brave fireman rescued a boy from the burning house.","source":{"kind":"tatoeba","sentenceId":46266,"author":"CK"}},"audio":"audio/ba871ef96d5223ae.m4a"},{"id":"ex.vocab.research","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"research","back":"(noun) Detailed study of a subject to discover new information or understand it better.","example":{"text":"He's doing in-depth research on ancient history.","source":{"kind":"tatoeba","sentenceId":329598,"author":"fcbond"}},"audio":"audio/35d514f493614fd0.m4a"},{"id":"ex.vocab.resource","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"resource","back":"(noun) A supply of something that a country, organization, or person has and can use.","example":{"text":"That country has natural resources.","source":{"kind":"tatoeba","sentenceId":47851,"author":"CK"}},"audio":"audio/cd72cc03b1a8a779.m4a"},{"id":"ex.vocab.respect","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"respect","back":"(noun) A feeling of admiration for someone because of their good qualities or achievements.","example":{"text":"Show respect for your teachers and classmates.","source":{"kind":"generated"}},"audio":"audio/894c1cd57cf2e293.m4a"},{"id":"ex.vocab.respond","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"respond","back":"(verb) To say or do something as a reaction to something that has been said or done.","example":{"text":"It's easy to respond to that question.","source":{"kind":"tatoeba","sentenceId":2860161,"author":"Luornu"}},"audio":"audio/28d83cecf90899de.m4a"},{"id":"ex.vocab.response","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"response","back":"(noun) An answer or reaction to something that has been said or done.","example":{"text":"Tom nodded in response to my question.","source":{"kind":"tatoeba","sentenceId":3725759,"author":"CM"}},"audio":"audio/30b3a3272c0a582f.m4a"},{"id":"ex.vocab.responsible","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"responsible","back":"(adjective) Having the duty to deal with something or take care of someone.","example":{"text":"The captain is responsible for the safety of passengers.","source":{"kind":"tatoeba","sentenceId":273507,"author":"CK"}},"audio":"audio/e255f5eb37b7209c.m4a"},{"id":"ex.vocab.result","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"result","back":"(noun) Something that happens or exists because of something else.","example":{"text":"Don't worry about the result of the test.","source":{"kind":"tatoeba","sentenceId":39453,"author":"CK"}},"audio":"audio/e2d0bbe66426df76.m4a"},{"id":"ex.vocab.retire","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"retire","back":"(verb) To stop working permanently, usually because of age.","example":{"text":"I have decided to retire.","source":{"kind":"tatoeba","sentenceId":256122,"author":"CK"}},"audio":"audio/4e53daec48f7f227.m4a"},{"id":"ex.vocab.rich","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rich","back":"(adjective) Having a lot of money or valuable possessions.","example":{"text":"I wish I were rich.","source":{"kind":"tatoeba","sentenceId":18531,"author":"CK"}},"audio":"audio/df1103ee77761cc9.m4a"},{"id":"ex.vocab.rise","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rise","back":"(verb) To move upwards, or to increase in amount or level.","example":{"text":"My living expense is rising year by year.","source":{"kind":"tatoeba","sentenceId":251297,"author":"CK"}},"audio":"audio/f1f03c848245e521.m4a"},{"id":"ex.vocab.risk","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"risk","back":"(noun) The possibility that something bad or dangerous will happen.","example":{"text":"I don't want to take risks.","source":{"kind":"tatoeba","sentenceId":41404,"author":"CK"}},"audio":"audio/188f1a9f4addf581.m4a"},{"id":"ex.vocab.rob","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rob","back":"(verb) To take money or property illegally from a person or place.","example":{"text":"Tom discovered that Mary was robbing the cash register.","source":{"kind":"tatoeba","sentenceId":12825906,"author":"Yepthatscool"}},"audio":"audio/f89f895624fe1064.m4a"},{"id":"ex.vocab.role","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"role","back":"(noun) The part someone plays in a particular situation or activity.","example":{"text":"Nature plays an important role in our life.","source":{"kind":"tatoeba","sentenceId":264462,"author":"CM"}},"audio":"audio/9a5f9d3d7384e3a0.m4a"},{"id":"ex.vocab.roll","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"roll","back":"(verb) To move by turning over and over; to make something move in this way.","example":{"text":"Tom rolled up the string and put it in his pocket.","source":{"kind":"tatoeba","sentenceId":1024267,"author":"CK"}},"audio":"audio/85f5689d1e28ecf1.m4a"},{"id":"ex.vocab.romantic","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"romantic","back":"(adjective) Showing or feeling love, or related to love stories and feelings.","example":{"text":"What's your favorite romantic movie?","source":{"kind":"tatoeba","sentenceId":906863,"author":"CK"}},"audio":"audio/327bac7389b5ea69.m4a"},{"id":"ex.vocab.root","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"root","back":"(noun) The part of a plant that grows under the ground and takes in water and food.","example":{"text":"The roots connect the tree to the ground.","source":{"kind":"tatoeba","sentenceId":4328921,"author":"AlanF_US"}},"audio":"audio/bc79dbff18bd1ec9.m4a"},{"id":"ex.vocab.rope","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rope","back":"(noun) A strong, thick string made by twisting together thinner strings or wires.","example":{"text":"Let go of the rope.","source":{"kind":"tatoeba","sentenceId":29430,"author":"CK"}},"audio":"audio/259707d536774efd.m4a"},{"id":"ex.vocab.rough","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rough","back":"(adjective) Not smooth or even; having an uneven surface.","example":{"text":"The surface of the object is fairly rough.","source":{"kind":"tatoeba","sentenceId":44132,"author":"CM"}},"audio":"audio/2abfc70ef91d03a9.m4a"},{"id":"ex.vocab.row","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"row","back":"(noun) A line of people or things arranged side by side.","example":{"text":"I don't like sitting in the front row.","source":{"kind":"tatoeba","sentenceId":2361326,"author":"CK"}},"audio":"audio/a411c9b8b54f3852.m4a"},{"id":"ex.vocab.rude","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rude","back":"(adjective) Not polite, or showing a lack of respect for others.","example":{"text":"He is a rude person.","source":{"kind":"tatoeba","sentenceId":303973,"author":"CK"}},"audio":"audio/c0654d926ddbf5cb.m4a"},{"id":"ex.vocab.rule","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rule","back":"(noun) An official instruction that says how things must be done or what is allowed.","example":{"text":"Drivers must observe the traffic rules.","source":{"kind":"tatoeba","sentenceId":26604,"author":"CK"}},"audio":"audio/be47a94989be3954.m4a"},{"id":"ex.vocab.rush","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"rush","back":"(verb) To move or do something very quickly.","example":{"text":"I rushed out of my house.","source":{"kind":"tatoeba","sentenceId":19721,"author":"CK"}},"audio":"audio/b8183d5f1d21b7db.m4a"},{"id":"ex.vocab.safety","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"safety","back":"(noun) The state of being protected from danger or harm.","example":{"text":"Parents are responsible for the safety of their children.","source":{"kind":"tatoeba","sentenceId":325716,"author":"CK"}},"audio":"audio/da66c407852c9eba.m4a"},{"id":"ex.vocab.sail","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"sail","back":"(verb) To travel on water in a boat or ship, especially using wind power.","example":{"text":"The ship is sailing to the west.","source":{"kind":"tatoeba","sentenceId":273459,"author":"CK"}},"audio":"audio/35a643eb1162c0e1.m4a"},{"id":"ex.vocab.salary","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"salary","back":"(noun) A fixed regular payment, usually paid monthly, made by an employer to an employee.","example":{"text":"He gets a good salary.","source":{"kind":"tatoeba","sentenceId":296380,"author":"CK"}},"audio":"audio/61bbf48d9fe3a803.m4a"},{"id":"ex.vocab.satisfy","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"satisfy","back":"(verb) To make someone feel pleased or happy because they have what they wanted or needed.","example":{"text":"Tom satisfied his hunger by eating some sandwiches.","source":{"kind":"tatoeba","sentenceId":37286,"author":"CK"}},"audio":"audio/4ff744696b7205b9.m4a"},{"id":"ex.vocab.scare","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"scare","back":"(verb) To make someone feel afraid or nervous.","example":{"text":"Don't let Tom scare you.","source":{"kind":"tatoeba","sentenceId":2275263,"author":"CK"}},"audio":"audio/376e6fa9115738a0.m4a"},{"id":"ex.vocab.scene","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"scene","back":"(noun) A part of a play, movie, or book, or a place where something happens.","example":{"text":"What I remember most about that movie is the last scene.","source":{"kind":"tatoeba","sentenceId":68576,"author":"CK"}},"audio":"audio/738c6c1a3e5abd71.m4a"},{"id":"ex.vocab.schedule","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"schedule","back":"(noun) A plan that lists all the things you have to do and when you will do them.","example":{"text":"He changes his schedule from day to day.","source":{"kind":"tatoeba","sentenceId":288442,"author":"CM"}},"audio":"audio/e61343a3c05d1317.m4a"},{"id":"ex.vocab.scientist","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"scientist","back":"(noun) A person who studies science and tries to understand how the world works.","example":{"text":"He is a great scientist.","source":{"kind":"tatoeba","sentenceId":293549,"author":"CK"}},"audio":"audio/d84c5511647288da.m4a"},{"id":"ex.vocab.scold","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"scold","back":"(verb) To speak angrily to someone because they have done something wrong.","example":{"text":"He scolded her for having left the door open.","source":{"kind":"tatoeba","sentenceId":291918,"author":"CK"}},"audio":"audio/d217c1ad3e3c44fb.m4a"},{"id":"ex.vocab.score","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"score","back":"(noun) The number of points that a team or player has in a game or competition.","example":{"text":"The score is one all.","source":{"kind":"tatoeba","sentenceId":52029,"author":"sundown"}},"audio":"audio/75c71508fd7b9936.m4a"},{"id":"ex.vocab.scratch","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"scratch","back":"(verb) To rub your skin with your nails, or to make a thin mark on a surface with something sharp.","example":{"text":"Can you scratch my back?","source":{"kind":"tatoeba","sentenceId":2650134,"author":"Hybrid"}},"audio":"audio/c95a213ccb32c39b.m4a"},{"id":"ex.vocab.scream","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"scream","back":"(verb) To make a loud, high cry because you are afraid, angry, or excited.","example":{"text":"Let go or I'll scream.","source":{"kind":"tatoeba","sentenceId":1860641,"author":"CK"}},"audio":"audio/4c0e9c1e58ede69a.m4a"},{"id":"ex.vocab.search","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"search","back":"(verb) To look carefully for something or someone.","example":{"text":"He searched the room for the lost key.","source":{"kind":"tatoeba","sentenceId":292251,"author":"CK"}},"audio":"audio/0bccd7e77763e484.m4a"},{"id":"ex.vocab.secret","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"secret","back":"(noun) Something that is kept hidden or known only by a few people.","example":{"text":"Can you keep a secret?","source":{"kind":"tatoeba","sentenceId":9594,"author":"CK"}},"audio":"audio/ef008092ed8ed324.m4a"},{"id":"ex.vocab.security","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"security","back":"(noun) The state of being safe from danger or threat; also, the people who protect a place.","example":{"text":"There is no one who doesn't long for peace and security.","source":{"kind":"tatoeba","sentenceId":320172,"author":"Lumi_alt"}},"audio":"audio/75c81579bffcb3a1.m4a"},{"id":"ex.vocab.seek","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"seek","back":"(verb) To try to find or get something.","example":{"text":"I am seeking a job.","source":{"kind":"tatoeba","sentenceId":2721517,"author":"Amastan"}},"audio":"audio/ffea95c9f6989af3.m4a"},{"id":"ex.vocab.sense","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"sense","back":"(noun) A feeling or understanding about something, or one of the five natural powers.","example":{"text":"Your answer doesn't make sense.","source":{"kind":"tatoeba","sentenceId":70437,"author":"CK"}},"audio":"audio/1fca028566d5d6a7.m4a"},{"id":"ex.vocab.sentence","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"sentence","back":"(noun) A group of words that expresses a complete thought and usually contains a subject and a verb.","example":{"text":"Make a sentence with each of these words.","source":{"kind":"tatoeba","sentenceId":55220,"author":"CM"}},"audio":"audio/8bb34c3442957526.m4a"},{"id":"ex.vocab.separate","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"separate","back":"(verb) To divide or split into different parts or groups; to move apart.","example":{"text":"The two towns are separated by a river.","source":{"kind":"tatoeba","sentenceId":280839,"author":"CK"}},"audio":"audio/af77d477a0f2f8e3.m4a"},{"id":"ex.vocab.serious","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"serious","back":"(adjective) Important and needing careful thought, or not joking.","example":{"text":"Getting married is a serious matter.","source":{"kind":"tatoeba","sentenceId":238700,"author":"CK"}},"audio":"audio/1a06d4f645ab9ee4.m4a"},{"id":"ex.vocab.seriously","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"seriously","back":"(adverb) In a serious way; not joking or lightly.","example":{"text":"You can let it slide with a \"oh?\" or you can take it seriously.","source":{"kind":"tatoeba","sentenceId":329039,"author":"fcbond"}},"audio":"audio/b842fa2e43bb60ee.m4a"},{"id":"ex.vocab.serve","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"serve","back":"(verb) To give food or drink to someone, or to do useful work for a purpose.","example":{"text":"What time is dinner served?","source":{"kind":"tatoeba","sentenceId":39680,"author":"CK"}},"audio":"audio/66a053f56131981f.m4a"},{"id":"ex.vocab.service","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"service","back":"(noun) Help or work that one person or organization provides for another.","example":{"text":"We complained about the poor service.","source":{"kind":"tatoeba","sentenceId":54199,"author":"CK"}},"audio":"audio/75deffad7904e0c6.m4a"},{"id":"ex.vocab.settle","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"settle","back":"(verb) To make a final decision or agreement about something, or to make a place your home.","example":{"text":"The matter is all settled.","source":{"kind":"tatoeba","sentenceId":43710,"author":"CK"}},"audio":"audio/c7bdb7ee98096a2f.m4a"},{"id":"ex.vocab.several","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"several","back":"(determiner) More than two but not many; an indefinite number.","example":{"text":"We have several bags here.","source":{"kind":"tatoeba","sentenceId":61840,"author":"CK"}},"audio":"audio/94c42c9e58562761.m4a"},{"id":"ex.vocab.sex","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"sex","back":"(noun) The state of being male or female.","example":{"text":"The clutch of eggs is incubated by both sexes.","source":{"kind":"tatoeba","sentenceId":5257467,"author":"Jesse"}},"audio":"audio/073e1bfe8561935c.m4a"},{"id":"ex.vocab.shall","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"shall","back":"(verb) Used to ask for advice, make an offer, or state a future action.","example":{"text":"How shall I put it?","source":{"kind":"tatoeba","sentenceId":38307,"author":"CM"}},"audio":"audio/afa1b899d50122b3.m4a"},{"id":"ex.vocab.sharp","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"sharp","back":"(adjective) Having a thin edge or point that can cut or pierce things easily.","example":{"text":"This pole is sharp at the end.","source":{"kind":"tatoeba","sentenceId":57112,"author":"CM"}},"audio":"audio/701d50bdfbcf964c.m4a"},{"id":"ex.vocab.shave","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"shave","back":"(verb) To remove hair from your skin, especially your face, using a razor.","example":{"text":"He shaves with an electric razor every morning.","source":{"kind":"tatoeba","sentenceId":303884,"author":"CK"}},"audio":"audio/1fa84156e428ddec.m4a"},{"id":"ex.vocab.sheep","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"sheep","back":"(noun) A farm animal with a thick woolly coat, kept for its wool, meat, or milk.","example":{"text":"I saw a flock of sheep.","source":{"kind":"tatoeba","sentenceId":262116,"author":"CK"}},"audio":"audio/1ed8ac33acfb0d80.m4a"},{"id":"ex.vocab.shock","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"shock","back":"(noun) A sudden, unpleasant surprise or a strong emotional upset.","example":{"text":"I got a horrible shock when I saw the car accident.","source":{"kind":"tatoeba","sentenceId":46949,"author":"CM"}},"audio":"audio/022e463a6a28ab98.m4a"},{"id":"ex.vocab.shocked","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"shocked","back":"(adjective) Very surprised and upset by something bad that has happened.","example":{"text":"I was shocked by yesterday's news.","source":{"kind":"tatoeba","sentenceId":244586,"author":"CK"}},"audio":"audio/c50ebd9d523f8fe5.m4a"},{"id":"ex.vocab.shoot","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"shoot","back":"(verb) To fire a gun or other weapon; to move quickly and suddenly.","example":{"text":"The pain shoots into my right leg.","source":{"kind":"tatoeba","sentenceId":278310,"author":"AlanF_US"}},"audio":"audio/9ab79f1694a2007f.m4a"},{"id":"ex.vocab.shout","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"shout","back":"(verb) To say something very loudly, often because you are angry or excited.","example":{"text":"He shouted to us to come.","source":{"kind":"tatoeba","sentenceId":297375,"author":"CK"}},"audio":"audio/d89208c6b97a7831.m4a"},{"id":"ex.vocab.shut","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"shut","back":"(verb) To close something, like a door or window.","example":{"text":"Shut the door, will you?","source":{"kind":"tatoeba","sentenceId":39031,"author":"CK"}},"audio":"audio/addc678db8a0286c.m4a"},{"id":"ex.vocab.shy","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"shy","back":"(adjective) Feeling nervous or uncomfortable around other people, especially strangers.","example":{"text":"I am a shy boy.","source":{"kind":"tatoeba","sentenceId":97592,"author":"fcbond"}},"audio":"audio/5c2e6580df0b8db0.m4a"},{"id":"ex.vocab.sight","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"sight","back":"(noun) The ability to see, or something that you see.","example":{"text":"I froze at the sight of the snake.","source":{"kind":"tatoeba","sentenceId":33905,"author":"CK"}},"audio":"audio/e72211336156cd13.m4a"},{"id":"ex.vocab.silence","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"silence","back":"(noun) A complete lack of sound or noise.","example":{"text":"The silence of the night comforts us.","source":{"kind":"tatoeba","sentenceId":323998,"author":"CM"}},"audio":"audio/dc48d9443ccf77f8.m4a"},{"id":"ex.vocab.silent","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"silent","back":"(adjective) Not making any sound; not speaking.","example":{"text":"She remained silent all day.","source":{"kind":"tatoeba","sentenceId":312597,"author":"CK"}},"audio":"audio/2da643269e9ffb4e.m4a"},{"id":"ex.vocab.similar","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"similar","back":"(adjective) Like something else in some ways, but not exactly the same.","example":{"text":"It's similar to a duck.","source":{"kind":"tatoeba","sentenceId":401429,"author":"CK"}},"audio":"audio/20b47c74bdbef386.m4a"},{"id":"ex.vocab.simply","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"simply","back":"(adverb) In a plain or easy way; also, used to emphasize something.","example":{"text":"I simply don't have the time.","source":{"kind":"tatoeba","sentenceId":2361699,"author":"CK"}},"audio":"audio/7d637d2eb364241e.m4a"},{"id":"ex.vocab.single","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"single","back":"(adjective) Only one; not more than one.","example":{"text":"We listened carefully in order not to miss a single word.","source":{"kind":"tatoeba","sentenceId":248421,"author":"CK"}},"audio":"audio/c7937df3ca6d7d8b.m4a"},{"id":"ex.vocab.site","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"site","back":"(noun) A place where something is located or where an event happens.","example":{"text":"The committee picked the site for the exhibition.","source":{"kind":"tatoeba","sentenceId":28234,"author":"CK"}},"audio":"audio/20cd5c874e91f2ec.m4a"},{"id":"ex.vocab.situation","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"situation","back":"(noun) The set of all things that are happening at a particular time and place.","example":{"text":"We were faced with an unusual situation because of the accident.","source":{"kind":"tatoeba","sentenceId":47159,"author":"CM"}},"audio":"audio/ade67d61adba09d7.m4a"},{"id":"ex.vocab.skill","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"skill","back":"(noun) The ability to do something well, usually learned through practice.","example":{"text":"Tiger Woods is famous for his skill as a golfer.","source":{"kind":"tatoeba","sentenceId":682039,"author":"Source_VOA"}},"audio":"audio/4851988599ffdf0a.m4a"},{"id":"ex.vocab.skip","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"skip","back":"(verb) To not do something that you usually do or are expected to do.","example":{"text":"I plan to skip lunch.","source":{"kind":"tatoeba","sentenceId":3199055,"author":"CK"}},"audio":"audio/a780e183cdbe0adc.m4a"},{"id":"ex.vocab.slam","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"slam","back":"(verb) To close a door or window with a lot of force, making a loud noise.","example":{"text":"Tom got into the car and slammed the door shut.","source":{"kind":"tatoeba","sentenceId":2640201,"author":"CK"}},"audio":"audio/f4be65a16d694c8e.m4a"},{"id":"ex.vocab.slice","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"slice","back":"(noun) A thin, flat piece cut from a larger food item.","example":{"text":"I am spreading mustard on a slice of bread.","source":{"kind":"tatoeba","sentenceId":1666017,"author":"Amastan"}},"audio":"audio/3672cd00d38b4a3b.m4a"},{"id":"ex.vocab.slightly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"slightly","back":"(adverb) A little bit; not very much.","example":{"text":"Tom is just slightly taller than Mary.","source":{"kind":"tatoeba","sentenceId":1028563,"author":"CK"}},"audio":"audio/57f5558dcbbc6081.m4a"},{"id":"ex.vocab.slip","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"slip","back":"(verb) To slide accidentally and lose your balance or fall.","example":{"text":"The plate slipped from her hand and crashed to the floor.","source":{"kind":"tatoeba","sentenceId":244965,"author":"CK"}},"audio":"audio/9e9c776e60a61bf7.m4a"},{"id":"ex.vocab.snore","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"snore","back":"(verb) To make a loud sound in your throat while you are sleeping.","example":{"text":"He was snoring loudly while he slept.","source":{"kind":"tatoeba","sentenceId":296379,"author":"CK"}},"audio":"audio/cdf3ecb80742b9f6.m4a"},{"id":"ex.vocab.social","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"social","back":"(adjective) Relating to society and the way people live together.","example":{"text":"We have a lot of social problems to think about today.","source":{"kind":"tatoeba","sentenceId":242413,"author":"CK"}},"audio":"audio/913f5e5a70319b26.m4a"},{"id":"ex.vocab.society","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"society","back":"(noun) People living together in an organized community with shared laws and customs.","example":{"text":"We all must abide by laws to live in any society.","source":{"kind":"tatoeba","sentenceId":37507,"author":"mailohilohi"}},"audio":"audio/d956d7097f02132e.m4a"},{"id":"ex.vocab.soldier","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"soldier","back":"(noun) A person who is a member of an army.","example":{"text":"The soldier gave his name.","source":{"kind":"tatoeba","sentenceId":44100,"author":"CK"}},"audio":"audio/87ea47158fee61d1.m4a"},{"id":"ex.vocab.solution","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"solution","back":"(noun) An answer to a problem or a way to deal with a difficult situation.","example":{"text":"Nobody was able to suggest a solution.","source":{"kind":"tatoeba","sentenceId":276617,"author":"CK"}},"audio":"audio/6a50f96c30b2bc25.m4a"},{"id":"ex.vocab.solve","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"solve","back":"(verb) To find an answer or explanation for a problem or mystery.","example":{"text":"Could you solve the problem?","source":{"kind":"tatoeba","sentenceId":16569,"author":"CK"}},"audio":"audio/9862c0e614a1c759.m4a"},{"id":"ex.vocab.someday","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"someday","back":"(adverb) At some time in the future, but not a specific time.","example":{"text":"I will be a doctor someday.","source":{"kind":"tatoeba","sentenceId":253091,"author":"CK"}},"audio":"audio/3ae9335f0469a506.m4a"},{"id":"ex.vocab.sometime","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"sometime","back":"(adverb) At an unknown or unspecified time in the future.","example":{"text":"Give me a call sometime.","source":{"kind":"tatoeba","sentenceId":2195196,"author":"Hybrid"}},"audio":"audio/493088484ab1a8a2.m4a"},{"id":"ex.vocab.sort","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"sort","back":"(noun) A type or kind of something.","example":{"text":"I'm not good at this sort of thing.","source":{"kind":"tatoeba","sentenceId":253433,"author":"CK"}},"audio":"audio/f005b915b0a47e61.m4a"},{"id":"ex.vocab.source","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"source","back":"(noun) The place, person, or thing from which something comes or starts.","example":{"text":"What are your sources of information?","source":{"kind":"tatoeba","sentenceId":2633303,"author":"meerkat"}},"audio":"audio/657fafd00cbfa144.m4a"},{"id":"ex.vocab.spare","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"spare","back":"(adjective) Extra; kept in case it is needed, or not currently being used.","example":{"text":"She has taken up knitting in her spare time.","source":{"kind":"tatoeba","sentenceId":317326,"author":"CM"}},"audio":"audio/08f391c9bb1c64bc.m4a"},{"id":"ex.vocab.speaker","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"speaker","back":"(noun) A person who gives a talk to an audience.","example":{"text":"The speaker stressed the need for thrift.","source":{"kind":"tatoeba","sentenceId":241166,"author":"sundown"}},"audio":"audio/94f1858458a59cc6.m4a"},{"id":"ex.vocab.speech","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"speech","back":"(noun) A formal talk given to a group of people.","example":{"text":"How did your speech go?","source":{"kind":"tatoeba","sentenceId":51830,"author":"CK"}},"audio":"audio/cf470ad4fd840032.m4a"},{"id":"ex.vocab.spill","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"spill","back":"(verb) To accidentally cause liquid to flow over the edge of a container.","example":{"text":"She spilled coffee on the table.","source":{"kind":"tatoeba","sentenceId":2880555,"author":"Amastan"}},"audio":"audio/126f3a59f1590be6.m4a"},{"id":"ex.vocab.spirit","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"spirit","back":"(noun) A person's mood or emotional state.","example":{"text":"I was in good spirits.","source":{"kind":"tatoeba","sentenceId":258721,"author":"CM"}},"audio":"audio/df0a964005a9a3fb.m4a"},{"id":"ex.vocab.spoil","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"spoil","back":"(verb) To damage something so it is no longer good or useful; to give a child too much.","example":{"text":"Our school trip was spoiled by an unusual snowfall.","source":{"kind":"tatoeba","sentenceId":247430,"author":"CM"}},"audio":"audio/1458cc418949a199.m4a"},{"id":"ex.vocab.spot","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"spot","back":"(noun) A small, round mark, or a particular place.","example":{"text":"Her dress is blue with white spots.","source":{"kind":"tatoeba","sentenceId":1655336,"author":"sundown"}},"audio":"audio/73fb5a48928b1d7c.m4a"},{"id":"ex.vocab.spread","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"spread","back":"(verb) To open something out so that it covers a larger area; to become known by many people.","example":{"text":"The good news spread through the village quickly.","source":{"kind":"tatoeba","sentenceId":48742,"author":"CM"}},"audio":"audio/2c6bef0feceb5873.m4a"},{"id":"ex.vocab.spy","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"spy","back":"(noun) A person whose job is to secretly get information about another country or organization.","example":{"text":"I know you're a spy.","source":{"kind":"tatoeba","sentenceId":2376649,"author":"CK"}},"audio":"audio/2bdaa5e5c4645f74.m4a"},{"id":"ex.vocab.squirrel","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"squirrel","back":"(noun) A small animal with a long bushy tail that lives in trees and eats nuts.","example":{"text":"Tom took a picture of a squirrel while it was eating a nut.","source":{"kind":"tatoeba","sentenceId":2833418,"author":"Hybrid"}},"audio":"audio/60eb611de56c305e.m4a"},{"id":"ex.vocab.stage","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"stage","back":"(noun) A raised platform in a theater where actors perform.","example":{"text":"The actor went on stage to deliver his lines.","source":{"kind":"tatoeba","sentenceId":44506,"author":"sundown"}},"audio":"audio/83e39aa9636bf322.m4a"},{"id":"ex.vocab.stare","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"stare","back":"(verb) To look at someone or something for a long time with your eyes wide open.","example":{"text":"She stared at the man in silent astonishment.","source":{"kind":"tatoeba","sentenceId":320959,"author":"Dejo"}},"audio":"audio/317cb9375c55fd6d.m4a"},{"id":"ex.vocab.starve","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"starve","back":"(verb) To suffer or die because you do not have enough food.","example":{"text":"It was a dry year, and many animals starved.","source":{"kind":"tatoeba","sentenceId":682064,"author":"Source_VOA"}},"audio":"audio/1b0b2ad1320a4fff.m4a"},{"id":"ex.vocab.state","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"state","back":"(noun) The condition of a person or thing at a particular time.","example":{"text":"She was in a sad state.","source":{"kind":"tatoeba","sentenceId":313133,"author":"sundown"}},"audio":"audio/680b9b360dcd63d4.m4a"},{"id":"ex.vocab.statement","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"statement","back":"(noun) Something that someone says or writes officially.","example":{"text":"I have a brief statement.","source":{"kind":"tatoeba","sentenceId":2358665,"author":"CK"}},"audio":"audio/2bb558cf7c398122.m4a"},{"id":"ex.vocab.steal","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"steal","back":"(verb) To take something that belongs to someone else without permission.","example":{"text":"He was accused of stealing money.","source":{"kind":"tatoeba","sentenceId":289471,"author":"CK"}},"audio":"audio/05da2f7eb5581916.m4a"},{"id":"ex.vocab.stove","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"stove","back":"(noun) A piece of kitchen equipment used for cooking or heating a room.","example":{"text":"Tom put the frying pan on the stove.","source":{"kind":"tatoeba","sentenceId":1164290,"author":"CK"}},"audio":"audio/af4be629aed1f5cb.m4a"},{"id":"ex.vocab.strength","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"strength","back":"(noun) The physical power that allows you to lift heavy things or do difficult tasks.","example":{"text":"My strength is all gone.","source":{"kind":"tatoeba","sentenceId":325907,"author":"CK"}},"audio":"audio/b81f9ac691b014a5.m4a"},{"id":"ex.vocab.stress","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"stress","back":"(noun) A feeling of worry or tension caused by difficult situations.","example":{"text":"Tom was under a lot of stress at the time.","source":{"kind":"tatoeba","sentenceId":3635886,"author":"CK"}},"audio":"audio/cabf4042f1ee3799.m4a"},{"id":"ex.vocab.stretch","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"stretch","back":"(verb) To make something longer or wider, or to extend your body or a part of it.","example":{"text":"I stretched out my arms.","source":{"kind":"tatoeba","sentenceId":1887693,"author":"CK"}},"audio":"audio/9762e976c6ddba42.m4a"},{"id":"ex.vocab.strict","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"strict","back":"(adjective) Demanding that rules are obeyed exactly; not allowing much freedom.","example":{"text":"My dad is very strict.","source":{"kind":"tatoeba","sentenceId":4269258,"author":"CK"}},"audio":"audio/a2378854f76ec3a9.m4a"},{"id":"ex.vocab.stuff","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"stuff","back":"(noun) A general word for things, materials, or possessions.","example":{"text":"Greedy people always want more stuff.","source":{"kind":"tatoeba","sentenceId":681514,"author":"Source_VOA"}},"audio":"audio/ba18672b0fb4fe75.m4a"},{"id":"ex.vocab.stupid","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"stupid","back":"(adjective) Not intelligent; showing a lack of good sense or judgment.","example":{"text":"That's the stupidest thing I've ever heard.","source":{"kind":"tatoeba","sentenceId":3113964,"author":"CK"}},"audio":"audio/aba86b62be1e3cbc.m4a"},{"id":"ex.vocab.style","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"style","back":"(noun) A particular way of doing something or a particular design.","example":{"text":"Tom has no sense of style.","source":{"kind":"tatoeba","sentenceId":1025325,"author":"CK"}},"audio":"audio/59acd10bc1381269.m4a"},{"id":"ex.vocab.succeed","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"succeed","back":"(verb) To achieve something that you have been trying to do.","example":{"text":"You must work hard if you are to succeed.","source":{"kind":"tatoeba","sentenceId":30872,"author":"CM"}},"audio":"audio/fa55048f4295e97b.m4a"},{"id":"ex.vocab.success","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"success","back":"(noun) The achievement of a goal or purpose.","example":{"text":"I'm sure of your success.","source":{"kind":"tatoeba","sentenceId":17021,"author":"Zifre"}},"audio":"audio/eea6bd0bb425333a.m4a"},{"id":"ex.vocab.successful","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"successful","back":"(adjective) Achieving the results that you wanted or hoped for.","example":{"text":"He became a successful lawyer.","source":{"kind":"tatoeba","sentenceId":803006,"author":"Source_VOA"}},"audio":"audio/b456a27a2a8e2974.m4a"},{"id":"ex.vocab.sudden","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"sudden","back":"(adjective) Happening quickly and unexpectedly.","example":{"text":"I felt a sudden pain in my side.","source":{"kind":"tatoeba","sentenceId":256858,"author":"CK"}},"audio":"audio/b87c50ff41eb043e.m4a"},{"id":"ex.vocab.suddenly","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"suddenly","back":"(adverb) Happening quickly and unexpectedly, without warning.","example":{"text":"Suddenly rain began to fall.","source":{"kind":"tatoeba","sentenceId":19627,"author":"orcrist"}},"audio":"audio/bdc28a3a3da73ba8.m4a"},{"id":"ex.vocab.suggest","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"suggest","back":"(verb) To put forward an idea or plan for others to consider.","example":{"text":"I suggest that we go out on Friday.","source":{"kind":"tatoeba","sentenceId":2222,"author":"CK"}},"audio":"audio/71e408db34055c2e.m4a"},{"id":"ex.vocab.suggestion","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"suggestion","back":"(noun) An idea or plan that someone offers for others to consider.","example":{"text":"I'm all for your suggestion.","source":{"kind":"tatoeba","sentenceId":70455,"author":"CM"}},"audio":"audio/90bae51a38a76581.m4a"},{"id":"ex.vocab.support","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"support","back":"(verb) To help someone or something, or to agree with an idea or plan.","example":{"text":"You are now old enough to support yourself.","source":{"kind":"tatoeba","sentenceId":16415,"author":"CK"}},"audio":"audio/bff7080bfd0eefa9.m4a"},{"id":"ex.vocab.suppose","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"suppose","back":"(verb) To think that something is true or likely, based on what you know.","example":{"text":"I suppose you like her.","source":{"kind":"tatoeba","sentenceId":68996,"author":"CK"}},"audio":"audio/a1e7090a92380984.m4a"},{"id":"ex.vocab.surround","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"surround","back":"(verb) To be all around something or someone.","example":{"text":"Japan is surrounded by sea.","source":{"kind":"tatoeba","sentenceId":281509,"author":"Lumi"}},"audio":"audio/f4c240b7f2b89d6b.m4a"},{"id":"ex.vocab.survive","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"survive","back":"(verb) To continue to live or exist after a difficult or dangerous event.","example":{"text":"He survived the plane crash.","source":{"kind":"tatoeba","sentenceId":303027,"author":"CK"}},"audio":"audio/fb138a6ef86e23fb.m4a"},{"id":"ex.vocab.sweat","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"sweat","back":"(verb) To produce liquid from your skin when you are hot or nervous.","example":{"text":"We were sweating in the heat.","source":{"kind":"tatoeba","sentenceId":28788,"author":"CK"}},"audio":"audio/b5982f114aa9bbd9.m4a"},{"id":"ex.vocab.switch","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"switch","back":"(verb) To change from one thing to another, or to turn an electrical device on or off.","example":{"text":"I didn't know when to switch the machine off.","source":{"kind":"tatoeba","sentenceId":253096,"author":"CK"}},"audio":"audio/dfb41ff8be79a1c2.m4a"},{"id":"ex.vocab.system","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"system","back":"(noun) A set of connected things or parts working together as a whole.","example":{"text":"The transportation system in that city is quite good.","source":{"kind":"tatoeba","sentenceId":45068,"author":"CM"}},"audio":"audio/7d1fff387a8a1259.m4a"},{"id":"ex.vocab.talent","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"talent","back":"(noun) A natural ability to do something well.","example":{"text":"She has a talent for dance.","source":{"kind":"tatoeba","sentenceId":308704,"author":"CM"}},"audio":"audio/aa7396bf274541bf.m4a"},{"id":"ex.vocab.talented","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"talented","back":"(adjective) Having a natural ability to do something well.","example":{"text":"Tom is a talented actor.","source":{"kind":"tatoeba","sentenceId":1167533,"author":"CK"}},"audio":"audio/537de36997375a77.m4a"},{"id":"ex.vocab.tap","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"tap","back":"(noun) A device that controls the flow of water from a pipe, often in a kitchen or bathroom.","example":{"text":"I turned off the tap.","source":{"kind":"tatoeba","sentenceId":799855,"author":"CM"}},"audio":"audio/8736ccbda6b8680c.m4a"},{"id":"ex.vocab.task","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"task","back":"(noun) A piece of work that needs to be done, especially one that is difficult or unpleasant.","example":{"text":"He was assigned a task.","source":{"kind":"tatoeba","sentenceId":299760,"author":"CS"}},"audio":"audio/e955f8bf88aac54a.m4a"},{"id":"ex.vocab.tax","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"tax","back":"(noun) Money that you have to pay to the government, used for public services.","example":{"text":"We must pay the tax.","source":{"kind":"tatoeba","sentenceId":248959,"author":"CK"}},"audio":"audio/31c3d8202bf1885a.m4a"},{"id":"ex.vocab.tear","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"tear","back":"(noun) A drop of salty liquid that comes from your eye when you cry.","example":{"text":"I was moved to tears.","source":{"kind":"tatoeba","sentenceId":21038,"author":"fishda"}},"audio":"audio/1b6fa73ecc8e4978.m4a"},{"id":"ex.vocab.tease","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"tease","back":"(verb) To laugh at someone or make jokes about them in a friendly or unkind way.","example":{"text":"The girls teased Tom and they made fun of him.","source":{"kind":"tatoeba","sentenceId":3059149,"author":"Hybrid"}},"audio":"audio/adc541494b286956.m4a"},{"id":"ex.vocab.technology","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"technology","back":"(noun) The use of scientific knowledge to create new machines and methods.","example":{"text":"She does not understand modern technology.","source":{"kind":"tatoeba","sentenceId":3202881,"author":"CM"}},"audio":"audio/bd7169ee745ae733.m4a"},{"id":"ex.vocab.tend","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"tend","back":"(verb) To usually do something or be in a particular way.","example":{"text":"He tends to be idle.","source":{"kind":"tatoeba","sentenceId":292271,"author":"CM"}},"audio":"audio/b9e71c98eeeb69af.m4a"},{"id":"ex.vocab.term","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"term","back":"(noun) A word or phrase used to describe something, or a period of time.","example":{"text":"The school term ends in June.","source":{"kind":"generated"}},"audio":"audio/d4cf0f15ec5bc8d7.m4a"},{"id":"ex.vocab.themselves","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"themselves","back":"(pronoun) Used to refer to a group of people or things when they are the object of an action they perform.","example":{"text":"Let them take care of themselves.","source":{"kind":"tatoeba","sentenceId":305123,"author":"Dejo"}},"audio":"audio/5d6000a5ae536b12.m4a"},{"id":"ex.vocab.thick","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"thick","back":"(adjective) Having a large distance between two opposite surfaces; not thin.","example":{"text":"He has a thick neck.","source":{"kind":"tatoeba","sentenceId":301140,"author":"CM"}},"audio":"audio/5ea87481e4433811.m4a"},{"id":"ex.vocab.thief","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"thief","back":"(noun) A person who steals things from another person or place.","example":{"text":"The thieves entered by the window.","source":{"kind":"tatoeba","sentenceId":4823881,"author":"whitefishglobal"}},"audio":"audio/d53d9e02fc7e46a5.m4a"},{"id":"ex.vocab.though","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"though","back":"(conjunction) Used to introduce a statement that makes the main statement seem surprising.","example":{"text":"Though very busy, she came to see me off.","source":{"kind":"tatoeba","sentenceId":37753,"author":"orcrist"}},"audio":"audio/75935ecefddbf1df.m4a"},{"id":"ex.vocab.threaten","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"threaten","back":"(verb) To say that you will cause harm or trouble if someone does not do what you want.","example":{"text":"I threatened to reveal his secret.","source":{"kind":"tatoeba","sentenceId":260739,"author":"CK"}},"audio":"audio/64c679246c7d3f76.m4a"},{"id":"ex.vocab.throat","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"throat","back":"(noun) The front part of the neck, or the tube inside the neck that food and air pass through.","example":{"text":"I have a sore throat.","source":{"kind":"tatoeba","sentenceId":417891,"author":"CK"}},"audio":"audio/4f8bf3bee472abfd.m4a"},{"id":"ex.vocab.tie","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"tie","back":"(verb) To fasten two things together, or to fasten something to something else, using string or rope.","example":{"text":"Please tie your shoelaces before you trip.","source":{"kind":"generated"}},"audio":"audio/be41da2527a39f41.m4a"},{"id":"ex.vocab.tight","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"tight","back":"(adjective) Held firmly in place; fitting very closely.","example":{"text":"This lid is so tight I can't open it.","source":{"kind":"tatoeba","sentenceId":60582,"author":"CK"}},"audio":"audio/3240bb8c859c1327.m4a"},{"id":"ex.vocab.till","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"till","back":"(preposition) Up to the time that; until.","example":{"text":"Wait till I count to ten.","source":{"kind":"tatoeba","sentenceId":246401,"author":"CK"}},"audio":"audio/ec264103a2c58c49.m4a"},{"id":"ex.vocab.tip","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"tip","back":"(noun) A small amount of extra money given to someone for good service.","example":{"text":"Did you leave a tip?","source":{"kind":"tatoeba","sentenceId":2423,"author":"CK"}},"audio":"audio/ecc35338271d357a.m4a"},{"id":"ex.vocab.tire","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"tire","back":"(verb) To make someone feel sleepy or without energy.","example":{"text":"Long walks can tire you out.","source":{"kind":"generated"}},"audio":"audio/e27503557e4a627c.m4a"},{"id":"ex.vocab.tongue","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"tongue","back":"(noun) The soft, movable part inside your mouth that you use for tasting, eating, and speaking.","example":{"text":"She touched her tongue to the ice cream.","source":{"kind":"generated"}},"audio":"audio/d267ad1c1f8b6341.m4a"},{"id":"ex.vocab.total","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"total","back":"(adjective) Complete or absolute.","example":{"text":"That was a total waste of my time.","source":{"kind":"tatoeba","sentenceId":3281692,"author":"CK"}},"audio":"audio/41562bc160661ff4.m4a"},{"id":"ex.vocab.totally","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"totally","back":"(adverb) Completely or entirely.","example":{"text":"It's totally up to you.","source":{"kind":"tatoeba","sentenceId":2891656,"author":"CK"}},"audio":"audio/7e76414fba5711ec.m4a"},{"id":"ex.vocab.tough","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"tough","back":"(adjective) Strong and able to deal with difficult conditions or situations.","example":{"text":"We had a tough job.","source":{"kind":"tatoeba","sentenceId":39751,"author":"Lumi"}},"audio":"audio/cd34e69d9bf75f6d.m4a"},{"id":"ex.vocab.track","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"track","back":"(noun) A path or rough road, or marks left by a person or animal.","example":{"text":"We followed the deer's tracks.","source":{"kind":"tatoeba","sentenceId":247999,"author":"CK"}},"audio":"audio/1c8452146369882f.m4a"},{"id":"ex.vocab.trade","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"trade","back":"(noun) The activity of buying and selling goods and services.","example":{"text":"The summit nations put free trade at the top of the agenda.","source":{"kind":"tatoeba","sentenceId":54043,"author":"CK"}},"audio":"audio/5d0deb5aa801da9b.m4a"},{"id":"ex.vocab.traditional","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"traditional","back":"(adjective) Following old customs or beliefs that have existed for a long time.","example":{"text":"They organized a traditional bread fair.","source":{"kind":"tatoeba","sentenceId":4563675,"author":"mailohilohi"}},"audio":"audio/bbcc8c57861e9140.m4a"},{"id":"ex.vocab.training","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"training","back":"(noun) The process of learning or teaching the skills needed for a job or activity.","example":{"text":"I was given training in that school.","source":{"kind":"tatoeba","sentenceId":29005,"author":"CM"}},"audio":"audio/8227cf3ea0fa23dc.m4a"},{"id":"ex.vocab.translate","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"translate","back":"(verb) To change words or text from one language into another.","example":{"text":"He translated Homer from the Greek into English.","source":{"kind":"tatoeba","sentenceId":292779,"author":"CK"}},"audio":"audio/81abcf32fc298982.m4a"},{"id":"ex.vocab.translation","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"translation","back":"(noun) The process of changing words from one language into another.","example":{"text":"There are some mistakes in your translation.","source":{"kind":"tatoeba","sentenceId":1840412,"author":"Amastan"}},"audio":"audio/e53ee336c2c79a53.m4a"},{"id":"ex.vocab.treat","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"treat","back":"(verb) To behave towards someone or something in a particular way.","example":{"text":"I object to being treated like that.","source":{"kind":"tatoeba","sentenceId":49820,"author":"CK"}},"audio":"audio/96470247a0c4bd2a.m4a"},{"id":"ex.vocab.trick","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"trick","back":"(noun) Something done to deceive someone, or a clever action that seems magical.","example":{"text":"She played a trick on my sister.","source":{"kind":"tatoeba","sentenceId":314386,"author":"CK"}},"audio":"audio/6319a33763456f5f.m4a"},{"id":"ex.vocab.trunk","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"trunk","back":"(noun) The main woody stem of a tree, or the storage area at the back of a car.","example":{"text":"Tom opened the trunk of the car.","source":{"kind":"tatoeba","sentenceId":3431152,"author":"CK"}},"audio":"audio/53af0b7332bafa32.m4a"},{"id":"ex.vocab.trust","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"trust","back":"(verb) To believe that someone is honest and will not harm you, or that something is reliable.","example":{"text":"I trusted him with the money.","source":{"kind":"tatoeba","sentenceId":260373,"author":"CK"}},"audio":"audio/4c0ba9f88e5049cc.m4a"},{"id":"ex.vocab.truth","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"truth","back":"(noun) The real facts about something, not what is imagined or invented.","example":{"text":"Please tell me the truth.","source":{"kind":"tatoeba","sentenceId":38455,"author":"CK"}},"audio":"audio/08de3e7dadcb03cc.m4a"},{"id":"ex.vocab.tune","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"tune","back":"(noun) A series of musical notes that form a pleasant melody.","example":{"text":"Tom whistled a tune as he walked along the river.","source":{"kind":"tatoeba","sentenceId":1023902,"author":"CK"}},"audio":"audio/a2f0a37b9c921bae.m4a"},{"id":"ex.vocab.unable","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"unable","back":"(adjective) Not having the ability or power to do something.","example":{"text":"He is unable to do it.","source":{"kind":"tatoeba","sentenceId":284693,"author":"CK"}},"audio":"audio/1cdc3febfff63997.m4a"},{"id":"ex.vocab.uncomfortable","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"uncomfortable","back":"(adjective) Not feeling physically or mentally at ease; causing slight pain or worry.","example":{"text":"You have no idea how uncomfortable these shoes are.","source":{"kind":"tatoeba","sentenceId":2954539,"author":"CK"}},"audio":"audio/2a833a6b15efd9dd.m4a"},{"id":"ex.vocab.unfortunately","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"unfortunately","back":"(adverb) Used to say that something bad or unlucky has happened.","example":{"text":"Unfortunately, I'm now too busy.","source":{"kind":"tatoeba","sentenceId":2368585,"author":"AlanF_US"}},"audio":"audio/5d243b8b24cef6aa.m4a"},{"id":"ex.vocab.unless","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"unless","back":"(conjunction) Used to say that something will happen only if something else does not happen.","example":{"text":"Let's go out unless it rains.","source":{"kind":"tatoeba","sentenceId":26990,"author":"fcbond"}},"audio":"audio/651162f7f7beebad.m4a"},{"id":"ex.vocab.unusual","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"unusual","back":"(adjective) Not common or normal; different from what is expected.","example":{"text":"I heard an unusual sound.","source":{"kind":"tatoeba","sentenceId":321714,"author":"CK"}},"audio":"audio/eeb61f9a0b75a8e3.m4a"},{"id":"ex.vocab.upset","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"upset","back":"(adjective) Unhappy, worried, or disappointed about something.","example":{"text":"The man carrying a violin seemed upset.","source":{"kind":"tatoeba","sentenceId":1898211,"author":"CK"}},"audio":"audio/b2e7e28c19530a2f.m4a"},{"id":"ex.vocab.valuable","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"valuable","back":"(adjective) Worth a lot of money, or very useful and important.","example":{"text":"Can you spare me a few minutes of your valuable time?","source":{"kind":"tatoeba","sentenceId":20157,"author":"CK"}},"audio":"audio/94bf2ebdb399555c.m4a"},{"id":"ex.vocab.value","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"value","back":"(noun) How much something is worth, or how important or useful it is.","example":{"text":"Milk is of great value to babies.","source":{"kind":"tatoeba","sentenceId":32215,"author":"AlanF_US"}},"audio":"audio/b91ea942b00d629f.m4a"},{"id":"ex.vocab.various","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"various","back":"(adjective) Many different types of something.","example":{"text":"She kept various kinds of pets.","source":{"kind":"tatoeba","sentenceId":310511,"author":"CK"}},"audio":"audio/566097e25e38f002.m4a"},{"id":"ex.vocab.vegetarian","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"vegetarian","back":"(noun) A person who does not eat meat or fish.","example":{"text":"My wife is a vegetarian.","source":{"kind":"tatoeba","sentenceId":644856,"author":"CK"}},"audio":"audio/c6ebfda9b217c233.m4a"},{"id":"ex.vocab.vehicle","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"vehicle","back":"(noun) A machine, such as a car, bus, or truck, that carries people or things.","example":{"text":"He may not drive a vehicle.","source":{"kind":"tatoeba","sentenceId":4861691,"author":"theupandup"}},"audio":"audio/213ae17968919181.m4a"},{"id":"ex.vocab.victim","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"victim","back":"(noun) A person who has been hurt, killed, or suffered because of an event or action.","example":{"text":"The firefighter helped the car-accident victim.","source":{"kind":"tatoeba","sentenceId":682321,"author":"Source_VOA"}},"audio":"audio/eae8437be59f125d.m4a"},{"id":"ex.vocab.view","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"view","back":"(noun) What you can see from a particular place, or an opinion about something.","example":{"text":"This is a view of the Alps.","source":{"kind":"tatoeba","sentenceId":55969,"author":"CK"}},"audio":"audio/41ad3c1c815eb512.m4a"},{"id":"ex.vocab.violin","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"violin","back":"(noun) A musical instrument with four strings, played with a bow.","example":{"text":"She was heard playing the violin.","source":{"kind":"tatoeba","sentenceId":311948,"author":"CK"}},"audio":"audio/05d832d378aba36a.m4a"},{"id":"ex.vocab.volunteer","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"volunteer","back":"(noun) A person who offers to do something without being paid for it.","example":{"text":"There is an urgent need for volunteers.","source":{"kind":"tatoeba","sentenceId":903715,"author":"CK"}},"audio":"audio/08a3dd45ffb43a0c.m4a"},{"id":"ex.vocab.vote","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"vote","back":"(verb) To formally express your choice in an election or decision.","example":{"text":"Who did you vote for in the election?","source":{"kind":"tatoeba","sentenceId":69149,"author":"CK"}},"audio":"audio/7d5b15706a204f22.m4a"},{"id":"ex.vocab.wander","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"wander","back":"(verb) To walk around slowly without a clear purpose or direction.","example":{"text":"She was wandering in the woods.","source":{"kind":"tatoeba","sentenceId":315168,"author":"CK"}},"audio":"audio/06e42aaf17d66d40.m4a"},{"id":"ex.vocab.warn","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"warn","back":"(verb) To tell someone about a possible danger or problem.","example":{"text":"I warned him of the danger.","source":{"kind":"tatoeba","sentenceId":260301,"author":"CK"}},"audio":"audio/69b7ad4284780048.m4a"},{"id":"ex.vocab.warning","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"warning","back":"(noun) A statement or event that tells you that something bad may happen.","example":{"text":"He got off with a warning.","source":{"kind":"tatoeba","sentenceId":295737,"author":"CM"}},"audio":"audio/e6cc8071867c17db.m4a"},{"id":"ex.vocab.waste","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"waste","back":"(verb) To use something badly or not completely, so that it is not used for a good purpose.","example":{"text":"Students are apt to waste time.","source":{"kind":"tatoeba","sentenceId":21370,"author":"letsgolanguages"}},"audio":"audio/9191ec116e11dd78.m4a"},{"id":"ex.vocab.wealthy","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"wealthy","back":"(adjective) Having a lot of money, property, or valuable possessions.","example":{"text":"Tom is a wealthy man.","source":{"kind":"tatoeba","sentenceId":1025123,"author":"CK"}},"audio":"audio/eb11d6b56b132987.m4a"},{"id":"ex.vocab.weapon","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"weapon","back":"(noun) An object used for fighting or for causing harm.","example":{"text":"The police found a small weapon in the car.","source":{"kind":"generated"}},"audio":"audio/eb38966c91ecffdb.m4a"},{"id":"ex.vocab.wedding","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"wedding","back":"(noun) A ceremony at which two people get married.","example":{"text":"The wedding will take place on Saturday.","source":{"kind":"tatoeba","sentenceId":238736,"author":"Dejo"}},"audio":"audio/8018aff3c698a584.m4a"},{"id":"ex.vocab.weed","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"weed","back":"(noun) A wild plant that grows where it is not wanted, often in a garden.","example":{"text":"Many weeds were growing among the flowers.","source":{"kind":"tatoeba","sentenceId":23761,"author":"CK"}},"audio":"audio/8737b4345677651e.m4a"},{"id":"ex.vocab.weigh","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"weigh","back":"(verb) To measure how heavy something is.","example":{"text":"He cut up the meat and weighed it.","source":{"kind":"tatoeba","sentenceId":302187,"author":"CK"}},"audio":"audio/84a64a5f52902fbe.m4a"},{"id":"ex.vocab.weight","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"weight","back":"(noun) How heavy something is, or the amount it weighs.","example":{"text":"What's the weight of your suitcase?","source":{"kind":"tatoeba","sentenceId":17381,"author":"Zifre"}},"audio":"audio/57a5a27c71aa46b0.m4a"},{"id":"ex.vocab.weird","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"weird","back":"(adjective) Very strange and unusual, often in a way that is a bit frightening.","example":{"text":"Tom is a weird guy.","source":{"kind":"tatoeba","sentenceId":2957039,"author":"CK"}},"audio":"audio/9b0d69b3e85ce045.m4a"},{"id":"ex.vocab.whenever","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"whenever","back":"(conjunction) At any time; every time that.","example":{"text":"Come to my house whenever you like.","source":{"kind":"tatoeba","sentenceId":66198,"author":"CK"}},"audio":"audio/277b03a547f41c07.m4a"},{"id":"ex.vocab.whether","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"whether","back":"(conjunction) Used to introduce two or more possibilities or choices.","example":{"text":"You'll have to do it, whether you like it or not.","source":{"kind":"tatoeba","sentenceId":38452,"author":"CK"}},"audio":"audio/5fcb2859d7a23a74.m4a"},{"id":"ex.vocab.whisper","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"whisper","back":"(verb) To speak very softly, using only your breath, so that only nearby people can hear.","example":{"text":"She whispered it in my ear.","source":{"kind":"tatoeba","sentenceId":311080,"author":"CK"}},"audio":"audio/31897d57c18cef90.m4a"},{"id":"ex.vocab.whistle","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"whistle","back":"(noun) A high sound made by forcing air through a small hole, or a small device that makes this sound.","example":{"text":"The referee blew his whistle to start the game.","source":{"kind":"generated"}},"audio":"audio/7425470fa2f8d582.m4a"},{"id":"ex.vocab.whole","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"whole","back":"(adjective) Complete; including every part of something.","example":{"text":"I read the whole book in one evening.","source":{"kind":"tatoeba","sentenceId":27300,"author":"CK"}},"audio":"audio/59921fce86d9314c.m4a"},{"id":"ex.vocab.windshield","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"windshield","back":"(noun) The large window at the front of a car, truck, or bus.","example":{"text":"A rock broke the windshield.","source":{"kind":"tatoeba","sentenceId":7356102,"author":"Eccles17"}},"audio":"audio/1e24e2a691a1c32d.m4a"},{"id":"ex.vocab.wing","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"wing","back":"(noun) One of the parts of a bird or insect that it uses for flying.","example":{"text":"The bird's wing was broken.","source":{"kind":"tatoeba","sentenceId":45018,"author":"CK"}},"audio":"audio/b44c696be9f7942a.m4a"},{"id":"ex.vocab.wipe","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"wipe","back":"(verb) To clean or dry something by rubbing its surface with a cloth or hand.","example":{"text":"Their job is to wipe the tables.","source":{"kind":"tatoeba","sentenceId":1771151,"author":"Amastan"}},"audio":"audio/c7a15e1355253b1e.m4a"},{"id":"ex.vocab.wise","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"wise","back":"(adjective) Having or showing the ability to make good judgments and decisions.","example":{"text":"Not all men are wise.","source":{"kind":"tatoeba","sentenceId":51742,"author":"CM"}},"audio":"audio/e87e3be389e9ed6f.m4a"},{"id":"ex.vocab.wish","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"wish","back":"(verb) To want something to happen or be true, especially something that is not possible.","example":{"text":"I wish I were rich.","source":{"kind":"tatoeba","sentenceId":18531,"author":"CK"}},"audio":"audio/1e25f34966842ff4.m4a"},{"id":"ex.vocab.wonder","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"wonder","back":"(verb) To want to know something or to think about something with curiosity.","example":{"text":"I wonder who to invite.","source":{"kind":"tatoeba","sentenceId":40331,"author":"CK"}},"audio":"audio/df69c671f9a9f946.m4a"},{"id":"ex.vocab.worth","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"worth","back":"(adjective) Having a particular value, or being important or interesting enough to do something.","example":{"text":"The writer's latest novel is well worth reading.","source":{"kind":"tatoeba","sentenceId":47792,"author":"orcrist"}},"audio":"audio/7239ff917f83ce12.m4a"},{"id":"ex.vocab.wrap","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"wrap","back":"(verb) To cover something completely in paper or cloth.","example":{"text":"Could you gift wrap it?","source":{"kind":"tatoeba","sentenceId":34095,"author":"CK"}},"audio":"audio/f3201ce92facf2f3.m4a"},{"id":"ex.vocab.yell","kind":"flashcard","level":"B1","grammarPointIds":[],"prompt":"Do you know this word?","front":"yell","back":"(verb) To shout loudly, often because you are angry or excited.","example":{"text":"You can't yell at Tom.","source":{"kind":"tatoeba","sentenceId":1955145,"author":"CK"}},"audio":"audio/62ce717b3dc8a020.m4a"},{"id":"ex.b1.dictation.250296","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"I owe what I am today to my uncle.","audio":"audio/a38ed41bba9ff179.m4a","source":{"kind":"tatoeba","sentenceId":250296,"author":"CM"}},{"id":"ex.b1.dictation.403304","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"I think his opinion is very important.","audio":"audio/52f2cabf0ac226d0.m4a","source":{"kind":"tatoeba","sentenceId":403304,"author":"CK"}},{"id":"ex.b1.dictation.1708918","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"You accept the money he gives you.","audio":"audio/50c3f64fec1fad34.m4a","source":{"kind":"tatoeba","sentenceId":1708918,"author":"Amastan"}},{"id":"ex.b1.dictation.1893745","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"We need to protect Tom.","audio":"audio/001c5db655d923ec.m4a","source":{"kind":"tatoeba","sentenceId":1893745,"author":"CK"}},{"id":"ex.b1.dictation.2360861","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"I hope I'm not interrupting anything.","audio":"audio/d6cc9727de0ebe57.m4a","source":{"kind":"tatoeba","sentenceId":2360861,"author":"CK"}},{"id":"ex.b1.dictation.2540613","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"I wonder where Tom parked the car.","audio":"audio/7fcc6d10b9376e1f.m4a","source":{"kind":"tatoeba","sentenceId":2540613,"author":"CK"}},{"id":"ex.b1.dictation.2541535","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"I told Tom to handle it himself.","audio":"audio/c7d3f2b77db7fe1e.m4a","source":{"kind":"tatoeba","sentenceId":2541535,"author":"CK"}},{"id":"ex.b1.dictation.3310967","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"We're looking for the truth.","audio":"audio/620787b6c777654b.m4a","source":{"kind":"tatoeba","sentenceId":3310967,"author":"CK"}},{"id":"ex.b1.dictation.3328508","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Can you excuse me a moment?","audio":"audio/13b4781770c7903a.m4a","source":{"kind":"tatoeba","sentenceId":3328508,"author":"CK"}},{"id":"ex.b1.dictation.3724991","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"People are beginning to notice Tom.","audio":"audio/aff16d18c4768e2d.m4a","source":{"kind":"tatoeba","sentenceId":3724991,"author":"CM"}},{"id":"ex.b1.dictation.5604807","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"When is your sister's flight?","audio":"audio/79c08fff71d2fdb5.m4a","source":{"kind":"tatoeba","sentenceId":5604807,"author":"marcj794"}},{"id":"ex.b1.dictation.5850565","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"I haven't yet deleted any messages.","audio":"audio/8d455c36e0e34c7b.m4a","source":{"kind":"tatoeba","sentenceId":5850565,"author":"CK"}},{"id":"ex.b1.dictation.6256118","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"You should go ahead and do that.","audio":"audio/82083479c083d3a3.m4a","source":{"kind":"tatoeba","sentenceId":6256118,"author":"CK"}},{"id":"ex.b1.dictation.6353456","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"I don't think Tom knows what Mary expects from him.","audio":"audio/54df078398c151aa.m4a","source":{"kind":"tatoeba","sentenceId":6353456,"author":"CK"}},{"id":"ex.b1.dictation.6508283","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Actually, Tom and Mary have already done that.","audio":"audio/acdd018bfaae3e47.m4a","source":{"kind":"tatoeba","sentenceId":6508283,"author":"CT"}},{"id":"ex.b1.dictation.6627468","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"A policeman was beside us, his notebook in his hand.","audio":"audio/8ed114afb76cfc16.m4a","source":{"kind":"tatoeba","sentenceId":6627468,"author":"Hybrid"}},{"id":"ex.b1.dictation.7653673","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"I gave Tom a piece of my mind.","audio":"audio/2f73529568327b67.m4a","source":{"kind":"tatoeba","sentenceId":7653673,"author":"karloelkebekio"}},{"id":"ex.b1.dictation.7803178","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"My home is on the fourth floor.","audio":"audio/dd044577e6a61d84.m4a","source":{"kind":"tatoeba","sentenceId":7803178,"author":"sharris123"}},{"id":"ex.b1.dictation.7900286","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"I have a similar feeling.","audio":"audio/d188003057e19fbd.m4a","source":{"kind":"tatoeba","sentenceId":7900286,"author":"shekitten"}},{"id":"ex.b1.dictation.8999508","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Unfortunately, he's on another call.","audio":"audio/182c4ee48abb60f5.m4a","source":{"kind":"tatoeba","sentenceId":8999508,"author":"mccarras"}},{"id":"ex.b1.dictation.11506211","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"James dragged Amanda to a restaurant.","audio":"audio/dcf2f2bcbbe992b5.m4a","source":{"kind":"tatoeba","sentenceId":11506211,"author":"Amastan"}},{"id":"ex.b1.dictation.11690893","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"My part of town also has a railway station.","audio":"audio/3cc39f8f529ad0ad.m4a","source":{"kind":"tatoeba","sentenceId":11690893,"author":"sundown"}},{"id":"ex.b1.dictation.11757311","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"Gabriel protected himself from the sun.","audio":"audio/40c1775af7dcba93.m4a","source":{"kind":"tatoeba","sentenceId":11757311,"author":"Amastan"}},{"id":"ex.b1.dictation.13853818","kind":"dictation","level":"B1","grammarPointIds":[],"prompt":"Listen and type what you hear.","text":"A person born in Russia is Russian.","audio":"audio/378eeec915b1f31f.m4a","source":{"kind":"tatoeba","sentenceId":13853818,"author":"rul"}}]}