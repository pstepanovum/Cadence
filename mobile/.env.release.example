# Copy to .env.release for `npm run ios:archive`, `ios:upload` and `testflight`.
# These identify the Apple account; none is a secret, but they stay out of the
# repo. The .p8 key itself is a secret: keep it outside the repo.

# Apple Developer team ID (Membership details in the developer portal).
APPLE_TEAM_ID=XXXXXXXXXX

# App Store Connect API key (Users and Access > Integrations > App Store Connect API).
ASC_KEY_PATH=~/.config/appstoreconnect/AuthKey_XXXXXXXXXX.p8
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
