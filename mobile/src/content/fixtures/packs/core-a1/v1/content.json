  "grammarPoints": [
    {
      "id": "gp.a1.present-simple-third-person",
      "level": "A1",
      "topicId": "topic.a1.present-simple",
      "title": "He works, she lives: the -s ending",
      "summary": "Add -s to the verb after he, she and it in the present simple.",
      "explanation": "In the present simple the verb has no ending after I, you, we and they. After *he*, *she* and *it* (or one person or thing), add *-s*.\n\nVerbs that end in -sh, -ch, -ss, -x or -o take *-es*: watches, goes. A consonant plus -y becomes *-ies*: study, studies.",
      "patterns": ["he / she / it + verb-s", "I / you / we / they + verb"],
      "examples": [
        { "text": "She works in a small bakery.", "source": { "kind": "generated" } },
        { "text": "My brother watches football every Sunday.", "note": "watch takes -es", "source": { "kind": "generated" } },
        { "text": "They live near the station.", "source": { "kind": "generated" } }
      ],
      "commonErrors": [
        { "wrong": "He work at home.", "right": "He works at home.", "note": "One person needs the -s ending." },
        { "wrong": "She studys English.", "right": "She studies English.", "note": "Consonant + y becomes -ies." }
      ],
      "related": ["gp.a1.present-simple-negatives"]
    },
    {
      "id": "gp.a1.present-simple-negatives",
      "level": "A1",
      "topicId": "topic.a1.present-simple",
      "title": "Don't and doesn't",
      "summary": "Make the present simple negative with don't or doesn't plus the base verb.",
      "explanation": "Use *don't* after I, you, we and they, and *doesn't* after he, she and it. The main verb stays in its base form: the -s moves to *doesn't*.",
      "patterns": ["I / you / we / they + don't + verb", "he / she / it + doesn't + verb"],
      "examples": [
        { "text": "I don't drink coffee in the evening.", "source": { "kind": "generated" } },
        { "text": "He doesn't like loud music.", "source": { "kind": "generated" } }
      ],
      "commonErrors": [
        { "wrong": "She doesn't likes tea.", "right": "She doesn't like tea.", "note": "Only one -s: it is already in doesn't." }
      ],
      "related": ["gp.a1.present-simple-third-person"]
    },
    {
      "id": "gp.a1.a-an",
      "level": "A1",
      "topicId": "topic.a1.articles",
      "title": "A or an",
      "summary": "Use an before a vowel sound and a before a consonant sound.",
      "explanation": "The choice depends on the *sound*, not the letter. Say *an hour* (the h is silent) but *a university* (it starts with a y sound).",
      "patterns": ["a + consonant sound", "an + vowel sound"],
      "examples": [
        { "text": "I had an apple and a banana.", "source": { "kind": "generated" } },
        { "text": "We waited for an hour.", "note": "silent h", "source": { "kind": "generated" } }
      ],
      "commonErrors": [
        { "wrong": "She is a engineer.", "right": "She is an engineer.", "note": "Engineer starts with a vowel sound." }
      ],
      "related": []
    }
  ],
