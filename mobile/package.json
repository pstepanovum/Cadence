  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "ios:bump": "node scripts/bump-ios-build.mjs",
    "ios:archive": "expo prebuild -p ios --clean && xcodebuild -workspace ios/Cadence.xcworkspace -scheme Cadence -configuration Release -destination 'generic/platform=iOS' -archivePath build/Cadence.xcarchive DEVELOPMENT_TEAM=V7H9Y9K6Z7 CODE_SIGN_STYLE=Automatic -allowProvisioningUpdates -authenticationKeyPath \"${ASC_KEY_PATH:-$HOME/.config/pstepanov/AuthKey_3WFKQQ2M25.p8}\" -authenticationKeyID \"${ASC_KEY_ID:-3WFKQQ2M25}\" -authenticationKeyIssuerID \"${ASC_ISSUER_ID:-10d4ffe1-cedf-4e43-b1cd-d1e6396a43c6}\" archive",
    "ios:upload": "xcodebuild -exportArchive -archivePath build/Cadence.xcarchive -exportOptionsPlist ExportOptions.plist -exportPath build/upload -allowProvisioningUpdates -authenticationKeyPath \"${ASC_KEY_PATH:-$HOME/.config/pstepanov/AuthKey_3WFKQQ2M25.p8}\" -authenticationKeyID \"${ASC_KEY_ID:-3WFKQQ2M25}\" -authenticationKeyIssuerID \"${ASC_ISSUER_ID:-10d4ffe1-cedf-4e43-b1cd-d1e6396a43c6}\"",
    "testflight": "npm run ios:bump && npm run ios:archive && npm run ios:upload",
    "test": "node --test \"tests/*.test.ts\""
  },
  "private": true
}
