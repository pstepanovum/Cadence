# Copy to .env and fill in, or leave it empty.
#
# None of these is required. If you connect the phone to Cadence running on
# your own computer (scan the QR from `pnpm serve` or the desktop app's Phone
# menu), the phone learns the address from the code and there is no account.
# See docs/CONNECT_YOUR_PHONE.md.
#
# Fill these in only if you also want the hosted "Cadence Cloud" option to
# appear in the app. It appears only when all five are set. EXPO_PUBLIC_*
# values are baked into the JS bundle at build time, so they must be public
# client config, never a server secret.

# The hosted Cadence deployment.
EXPO_PUBLIC_API_URL=https://your-deployment.example.com

# The Web app config of the same Firebase project as the web app's cloud mode
# (Firebase console > Project settings > Your apps).
EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
