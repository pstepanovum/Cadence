# Copy to .env and fill in, or leave it empty.
#
# None of these is required. If you connect the phone to Cadence running on
# your own computer (scan the QR from `pnpm serve` or the desktop app's Phone
# menu), the phone learns the address from the code and there is no account.
# See docs/CONNECT_YOUR_PHONE.md.
#
# Fill these in only if you also want the hosted "Cadence Cloud" option to
# appear in the app. It appears only when all five are set. EXPO_PUBLIC_*
# values are baked into the JS bundle at build time, so they must be public
# client config, never a server secret.

# The hosted Cadence deployment.
EXPO_PUBLIC_API_URL=https://your-deployment.example.com

# The Web app config of the same Firebase project as the web app's cloud mode
# (Firebase console > Project settings > Your apps).
EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Cadence Plus in the iOS app (RevenueCat public iOS key). Without it the
# paywall says purchases are unavailable.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# 1 swaps in an offline purchase stub for simulator flows. Never set it for a
# store build.
EXPO_PUBLIC_PURCHASES_STUB=

# Firebase App Check: the iOS app's Firebase app id (App Attest on devices),
# and a debug token registered in the Firebase console for the simulator and
# Expo Go (development builds only).
EXPO_PUBLIC_FIREBASE_IOS_APP_ID=
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Google Sign-In: the iOS OAuth client from the same Google Cloud project as
# Firebase (…apps.googleusercontent.com). Its reversed id becomes the app's
# URL scheme at prebuild (app.config.js). Optional: the project's web client
# id, used as the ID token's audience. Without the iOS id there is no Google
# button. Sign in with Apple needs no value here (the capability is in
# app.json).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Point Auth at the local emulator, e.g. 127.0.0.1:9099, together with a
# demo- project id above and a local API (`pnpm dev` with the emulators). The
# app uses the emulator only with a demo- project, so a build with the real
# project can never be pointed at one. Test builds only (the e2e flows, which
# also set EXPO_PUBLIC_PURCHASES_STUB=1): `npm run ios:archive` refuses to
# archive while any of these test values are set, and checks the bundle.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR=
# Remote push needs the EAS project id the Expo push service knows this app by.
# Without it the app schedules its own reminders but registers no push token.
EXPO_PUBLIC_EAS_PROJECT_ID=
