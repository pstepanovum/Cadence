{
  "name": "cadence",
  "version": "0.1.0",
  "description": "Open-source pronunciation training with AI feedback, guided speaking modules, and an open-topic coach.",
  "license": "MIT",
  "private": false,
  "author": "Pavel Stepanov",
  "homepage": "https://github.com/pstepanovum/Cadence",
  "repository": {
    "type": "git",
    "url": "https://github.com/pstepanovum/Cadence.git"
  },
  "bugs": {
    "url": "https://github.com/pstepanovum/Cadence/issues"
  },
  "keywords": [
    "nextjs",
    "typescript",
    "pronunciation",
    "accent-training",
    "speech",
    "ai",
    "education",
    "firebase",
    "stripe",
    "language-learning",
    "text-to-speech",
    "speech-recognition"
  ],
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:all": "node ./scripts/dev-all.mjs",
    "serve": "node ./scripts/serve.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "node --test --import ./tests/register.mjs \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:server": "firebase emulators:exec --only auth,firestore --project demo-cadence \"node --test --test-concurrency=1 --import ./tests/register.mjs 'tests/server/**/*.test.ts'\"",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-cadence \"node --test tests/rules/firestore.test.ts\"",
    "email:preview": "node --import ./tests/register.mjs scripts/email/preview.ts",
    "email:lint": "node --import ./tests/register.mjs scripts/email/lint.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-slot": "^1.2.4",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "griddy-icons": "^0.2.0",
    "lenis": "^1.3.21",
    "next": "16.2.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
