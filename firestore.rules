rules_version = '2';

// Cadence reads and writes Firestore only from its own server, through the
// Admin SDK, which these rules do not apply to. No browser, phone or desktop
// client talks to Firestore directly, so every client request is refused.
// Profile edits go through PATCH /api/profile and billing through the Stripe
// webhook, both on the server.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
